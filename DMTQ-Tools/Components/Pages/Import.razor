@page "/import"
@inject GameTableManagerState State
@inject GameTableManagerWorkflow Workflow

<h1>Import</h1>

<section class="toolbar-panel">
    <label class="form-label" for="platform">Platform</label>
    <select id="platform" class="form-control narrow-control" @bind="platform">
        <option value="android">android</option>
        <option value="ios">ios</option>
    </select>
    <label class="form-label" for="packageRoot">Source package directory</label>
    <div class="input-row">
        <input id="packageRoot" class="form-control" @bind="packageRoot" placeholder="D:\GitHub\DMTQ-Tools\external\patch\phone_new\1.003.005\android" />
        <button class="btn btn-primary" @onclick="ImportPlatformPackage" disabled="@isBusy">Import Platform</button>
    </div>
    <div class="hint">Create or open a project on the Project page before importing.</div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-message">@message</div>
    }
</section>

@if (State.CurrentPackage is not null)
{
    <section class="metrics-grid">
        <div class="metric">
            <span class="metric-label">Manifest entries</span>
            <strong>@State.CurrentPackage.Manifest.Entries.Count</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Tables</span>
            <strong>@State.CurrentPackage.Tables.Tables.Count</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Resources</span>
            <strong>@State.CurrentPackage.Resources.Count</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Languages</span>
            <strong>@LanguageSummary</strong>
        </div>
    </section>

    @if (State.Platforms.Count > 0)
    {
        <section class="toolbar-panel">
            <h2>Platforms</h2>
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>Platform</th>
                        <th>Baseline entries</th>
                        <th>Imported tables</th>
                        <th>Imported resources</th>
                        <th>Missing physical files</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in State.Platforms.OrderBy(p => p.Platform))
                    {
                        <tr>
                            <td>@item.Platform</td>
                            <td>@item.BaselineManifestEntries.Count</td>
                            <td>@item.ImportedTableFileCount</td>
                            <td>@item.ImportedResourceFileCount</td>
                            <td>@item.MissingPhysicalFileCount</td>
                            <td>@item.SourcePackageRoot</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private string packageRoot = string.Empty;
    private string platform = "android";
    private string? message;
    private bool isBusy;

    private string LanguageSummary => State.CurrentPackage is null
        ? "-"
        : string.Join(", ", State.CurrentPackage.Tables.Tables
            .Select(t => t.LanguageCode)
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .Distinct()
            .OrderBy(code => code));

    private async Task ImportPlatformPackage()
    {
        isBusy = true;
        message = "Importing platform package...";
        try
        {
            await Workflow.ImportPlatformPackageAsync(packageRoot, platform);
            message = "Import completed.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Import error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
