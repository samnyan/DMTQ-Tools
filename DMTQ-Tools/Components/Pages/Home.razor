@page "/"
@inject GameTableManagerState State
@inject GameTableManagerWorkflow Workflow

<h1>Project</h1>

<section class="toolbar-panel">
    <label class="form-label" for="projectRoot">Project directory</label>
    <div class="input-row project-actions">
        <input id="projectRoot" class="form-control" @bind="projectRoot" placeholder="D:\DMTQProjects\MyPatch" />
        <button class="btn btn-primary" @onclick="CreateProject" disabled="@isBusy">Create</button>
        <button class="btn btn-secondary" @onclick="OpenProject" disabled="@isBusy">Open Saved</button>
        <button class="btn btn-secondary" @onclick="SaveProject" disabled="@(!State.HasPackage || isBusy)">Save</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-message">@message</div>
    }
</section>

<section class="metrics-grid">
    <div class="metric">
        <span class="metric-label">Project</span>
        <strong>@(State.ProjectRoot ?? "Not selected")</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Source</span>
        <strong>@(State.CurrentPackage?.ProjectInfo.SourcePackageRoot ?? "Not imported")</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Version</span>
        <strong>@(State.CurrentPackage?.ProjectInfo.Version ?? "-")</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Primary platform</span>
        <strong>@(State.CurrentPackage?.ProjectInfo.Platform ?? "-")</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Imported platforms</span>
        <strong>@PlatformSummary</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Manifest entries</span>
        <strong>@(State.CurrentPackage?.Manifest.Entries.Count ?? 0)</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Tables</span>
        <strong>@(State.CurrentPackage?.Tables.Tables.Count ?? 0)</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Resources</span>
        <strong>@(State.CurrentPackage?.Resources.Count ?? 0)</strong>
    </div>
    <div class="metric">
        <span class="metric-label">Last validation</span>
        <strong>@ValidationText</strong>
    </div>
</section>

@code {
    private string projectRoot = string.Empty;
    private string? message;
    private bool isBusy;

    private string PlatformSummary => State.Platforms.Count == 0
        ? "-"
        : string.Join(", ", State.Platforms.Select(p => $"{p.Platform} ({p.BaselineManifestEntries.Count})"));

    private string ValidationText => State.LastValidationResult is null
        ? "Not run"
        : State.LastValidationResult.IsValid ? "Passed" : $"{State.LastValidationResult.Errors.Count} errors";

    private async Task CreateProject()
    {
        isBusy = true;
        message = "Creating project...";
        try
        {
            await Workflow.CreateProjectAsync(projectRoot);
            message = "Project created and saved.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Project error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OpenProject()
    {
        isBusy = true;
        message = "Opening project...";
        try
        {
            await Workflow.OpenProjectAsync(projectRoot);
            message = "Project opened.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Open project error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveProject()
    {
        isBusy = true;
        message = "Saving project...";
        try
        {
            await Workflow.SaveProjectAsync();
            message = "Project saved.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Save project error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
