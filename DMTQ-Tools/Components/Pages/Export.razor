@page "/export"
@inject GameTableManagerState State
@inject GameTableManagerWorkflow Workflow
@inject PackageQaService QaService

<h1>Export</h1>

<section class="toolbar-panel">
    <label class="form-label" for="platform">Platform</label>
    <select id="platform" class="form-control narrow-control" @bind="State.SelectedExportPlatform">
        @foreach (var platform in State.Platforms.Select(p => p.Platform).OrderBy(p => p))
        {
            <option value="@platform">@platform</option>
        }
    </select>

    <label class="form-label" for="platformExportMode">Package output</label>
    <select id="platformExportMode" class="form-control narrow-control" @bind="State.PlatformExportMode">
        <option value="@DMTQ.Tools.Core.Models.PlatformExportMode.Delta">Delta: skip unchanged baseline files</option>
        <option value="@DMTQ.Tools.Core.Models.PlatformExportMode.Full">Full: write every current file</option>
    </select>

    <label class="form-label" for="compressionMode">Compression policy</label>
    <select id="compressionMode" class="form-control narrow-control" @bind="State.ExportCompressionMode">
        <option value="Keep">Keep imported manifest flags</option>
        <option value="CompressAll">Compress every manifest entry</option>
        <option value="UncompressAll">Uncompress every manifest entry</option>
    </select>

    <label class="form-label" for="exportRoot">Output directory</label>
    <div class="input-row">
        <input id="exportRoot" class="form-control" @bind="exportRoot" placeholder="D:\DMTQExports\android" />
        <button class="btn btn-secondary" @onclick="PickExportFolder" disabled="@(!State.HasPackage || isBusy)" type="button">Browse...</button>
        <button class="btn btn-primary" @onclick="ExportPlatformPackage" disabled="@(!State.HasPackage || State.Platforms.Count == 0 || isBusy)">Export</button>
    </div>

    @if (!State.HasPackage)
    {
        <div class="status-message">Import a package before exporting.</div>
    }

    @if (qaSummary is not null)
    {
        <div class="qa-summary @(qaSummary.IsClean ? "success" : qaSummary.HasErrors ? "error" : "warning")">
            Pre-export QA: @qaSummary.Summary
            @if (qaSummary.HasErrors)
            {
                <span> — Fix errors before exporting.</span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-message">@message</div>
    }
</section>

@if (State.LastPlatformExportResult is not null)
{
    <section class="metrics-grid">
        <div class="metric">
            <span class="metric-label">Platform</span>
            <strong>@State.LastPlatformExportResult.Platform</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Manifest entries</span>
            <strong>@State.LastPlatformExportResult.ManifestEntryCount</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Files written</span>
            <strong>@State.LastPlatformExportResult.FilesWritten</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Skipped baseline</span>
            <strong>@State.LastPlatformExportResult.FilesSkippedAsBaseline</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Missing current files</span>
            <strong>@State.LastPlatformExportResult.MissingCurrentFiles</strong>
        </div>
        <div class="metric">
            <span class="metric-label">Validation</span>
            <strong>@ValidationText</strong>
        </div>
    </section>
}

@if (State.LastValidationResult is not null && !State.LastValidationResult.IsValid)
{
    <section class="toolbar-panel">
        <h2>Validation errors</h2>
        <ul class="diagnostic-list">
            @foreach (var error in State.LastValidationResult.Errors.Take(100))
            {
                <li>@error</li>
            }
        </ul>
    </section>
}

@code {
    private string exportRoot = string.Empty;
    private string? message;
    private bool isBusy;
    private QaReport? qaSummary;

    private string ValidationText => State.LastValidationResult is null
        ? "Not run"
        : State.LastValidationResult.IsValid ? "Passed" : $"{State.LastValidationResult.Errors.Count} errors";

    private async Task PickExportFolder()
    {
        try
        {
            var result = await CommunityToolkit.Maui.Storage.FolderPicker.Default.PickAsync(default);
            if (result.IsSuccessful && result.Folder is not null)
            {
                exportRoot = result.Folder.Path;
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private async Task ExportPlatformPackage()
    {
        isBusy = true;
        message = "Running QA...";
        try
        {
            if (State.CurrentPackage is not null)
            {
                qaSummary = QaService.Run(State.CurrentPackage);
                if (qaSummary.HasErrors)
                {
                    message = $"QA found {qaSummary.ErrorCount} error(s). Fix them before exporting.";
                    State.Diagnostics.Add($"Pre-export QA: {qaSummary.Summary}");
                    return;
                }
            }

            message = "Exporting platform package...";
            await Workflow.ExportPlatformPackageAsync(
                exportRoot,
                State.SelectedExportPlatform,
                State.PlatformExportMode);
            message = State.LastPlatformExportResult?.Validation.IsValid == true
                ? "Platform export completed and validation passed."
                : "Platform export completed with validation errors.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Platform export error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
