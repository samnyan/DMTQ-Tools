@using DMTQ.Tools.Core.Models.Entity

<section>
    <h2 class="section-heading">@L["Editor.LocalizedDescriptions"]</h2>
    <p class="section-hint">@L["Editor.ItemDescriptionsHint"]</p>
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" class="localized-item-actions">
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CopyBaseToAllLanguages">
                @L["Editor.CopyBaseToLanguages"]
            </FluentButton>
            <FluentSwitch @bind-Value="syncOriginalText" Label='@L["Editor.SyncOriginalText"]' />
    </FluentStack>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Stretch">
        @foreach (var language in Languages)
        {
            <div @key="language">
                <h3 class="lang-heading">@language</h3>
                <FluentGrid Spacing="2">
                    <FluentGridItem Xs="12" Md="4">
                        <FluentTextInput style="width: 100%;" @bind-Value="Content.NamesByLanguage[language]" Label='@L["Fields.Name"]' />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6">
                        <FluentTextArea style="width: 100%;" @bind-Value="Content.DescriptionsByLanguage[language]" Label='@L["Fields.Description"]' Height="100px" Resize="TextAreaResize.Vertical" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6">
                        <FluentTextArea style="width: 100%;" @bind-Value="Content.SummariesByLanguage[language]" Label='@L["Fields.Summary"]' Height="100px" Resize="TextAreaResize.Vertical" />
                    </FluentGridItem>
                </FluentGrid>
            </div>
        }
    </FluentStack>
</section>

@code {
    private static readonly string[] Languages = ["CN", "JP", "KR", "TW", "US"];

    [Parameter, EditorRequired] public Item Content { get; set; } = default!;

    public bool IsSyncOriginalText => _syncOriginalText;

    private bool _syncOriginalText;

    private bool syncOriginalText
    {
        get => _syncOriginalText;
        set
        {
            _syncOriginalText = value;
            if (value)
                CopyBaseToAllLanguages();
        }
    }

    protected override void OnParametersSet()
    {
        foreach (var language in Languages)
        {
            Content.NamesByLanguage.TryAdd(language, string.Empty);
            Content.DescriptionsByLanguage.TryAdd(language, string.Empty);
            Content.SummariesByLanguage.TryAdd(language, string.Empty);
        }
    }

    public void CopyBaseToAllLanguages()
    {
        foreach (var language in Languages)
        {
            Content.NamesByLanguage[language] = Content.ItemName;
            Content.DescriptionsByLanguage[language] = Content.Description;
            Content.SummariesByLanguage[language] = Content.Summary;
        }
    }
}
