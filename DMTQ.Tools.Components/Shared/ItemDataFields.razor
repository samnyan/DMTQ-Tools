@using DMTQ.Tools.Core.Models.Entity

<section>
    <h2 class="section-heading">@L["Editor.ItemInformation"]</h2>
    <FluentGrid Spacing="1">
        @if (ShowItemId)
        {
            <FluentGridItem Xs="12" Md="6">
                <FluentTextInput style="width: 100%;" Value="@ItemId" ValueChanged="ItemIdChanged" Label='@L["Fields.ItemId"]' Required="@IsItemIdRequired" ReadOnly="@IsItemIdReadOnly" />
            </FluentGridItem>
        }
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="itemName" Label='@L["Fields.ItemName"]' Immediate="true" />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.ImgUrl1" Label='@L["Fields.ImageUrl1"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.ImgUrl2" Label='@L["Fields.ImageUrl2"]' />
        </FluentGridItem>
    </FluentGrid>
</section>

<section>
    <h3 class="section-subheading">@L["Editor.ItemText"]</h3>
    <FluentGrid Spacing="1">
        <FluentGridItem Xs="12" Md="6">
            <FluentTextArea style="width: 100%;" @bind-Value="itemDescription" Label='@L["Fields.Description"]' Immediate="true" Height="120px" Resize="TextAreaResize.Vertical" />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="6">
            <FluentTextArea style="width: 100%;" @bind-Value="itemSummary" Label='@L["Fields.Summary"]' Immediate="true" Height="120px" Resize="TextAreaResize.Vertical" />
        </FluentGridItem>
    </FluentGrid>
</section>

<section>
    <h3 class="section-subheading">@L["Editor.ItemRules"]</h3>
    <FluentGrid Spacing="1">
        <FluentGridItem Xs="12" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.RepeatCount" Label='@L["Fields.RepeatCount"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="4">
            <FluentSelect Items="ItemTypeOptions" @bind-Value="selectedItemType" Label='@L["Fields.ItemType"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.LimitMinute" Label='@L["Fields.LimitMinute"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.Status" Label='@L["Fields.Status"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.BuyLevel" Label='@L["Fields.BuyLevel"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="4">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.BuyLimitCount" Label='@L["Fields.BuyLimitCount"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="6">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.BuyLimitType" Label='@L["Fields.BuyLimitType"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Md="6">
            <FluentTextInput style="width: 100%;" @bind-Value="Content.Update" Label='@L["Fields.Update"]' />
        </FluentGridItem>
    </FluentGrid>
</section>

<LocalizedItemFields @ref="localizedFields" Content="@Content" />

@code {
    private string[] ItemTypeOptions
    {
        get
        {
            var options = new[]
            {
                $" — {L["Options.EffectTypeNone"].Value}", $"S — {L["Options.ItemTypeMusic"].Value}", $"N — {L["Options.ItemTypeNoteSkin"].Value}",
            $"K — {L["Options.ItemTypeStatusBarSkin"].Value}", $"C — {L["Options.ItemTypePartner"].Value}",
                $"F — {L["Options.ItemTypeAddOn"].Value}", $"M — {L["Options.ItemTypeMaxPoint"].Value}",
            $"Q — {L["Options.ItemTypeQPoint"].Value}", $"T — {L["Options.ItemTypeUnlock"].Value}",
                $"I — {L["Options.ItemTypeIngame"].Value}", $"P — {L["Options.ItemTypeMusicPack"].Value}",
                $"itempack — {L["Options.ItemTypeItemPack"].Value}",
                $"ticket — {L["Options.ItemTypeTicket"].Value}",
                $"L — {L["Options.ItemTypeRawCode"].Value}"
            };
            return string.IsNullOrWhiteSpace(Content.ItemType)
                   || options.Any(option => option.StartsWith(Content.ItemType + " — ", StringComparison.OrdinalIgnoreCase))
                ? options
                : [.. options, $"{Content.ItemType} — {L["Fields.ExistingValue"].Value}"];
        }
    }

    [Parameter, EditorRequired] public Item Content { get; set; } = default!;
    [Parameter] public bool ShowItemId { get; set; }
    [Parameter] public string ItemId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ItemIdChanged { get; set; }
    [Parameter] public bool IsItemIdReadOnly { get; set; }
    [Parameter] public bool IsItemIdRequired { get; set; }

    private LocalizedItemFields? localizedFields;

    public bool IsSyncOriginalText => localizedFields?.IsSyncOriginalText == true;

    public void SyncLocalizedFields() => localizedFields?.CopyBaseToAllLanguages();

    private string itemName
    {
        get => Content.ItemName;
        set => SetBaseField(item => item.ItemName = value);
    }

    private string itemDescription
    {
        get => Content.Description;
        set => SetBaseField(item => item.Description = value);
    }

    private string itemSummary
    {
        get => Content.Summary;
        set => SetBaseField(item => item.Summary = value);
    }

    private string selectedItemType
    {
        get => string.IsNullOrWhiteSpace(Content.ItemType)
            ? ItemTypeOptions[0]
            : ItemTypeOptions.FirstOrDefault(option => option.StartsWith(Content.ItemType + " — ", StringComparison.OrdinalIgnoreCase))
              ?? $"{Content.ItemType} — {L["Fields.ExistingValue"].Value}";
        set => Content.ItemType = GetOptionValue(value);
    }

    private static string GetOptionValue(string option)
    {
        var separatorIndex = option.LastIndexOf(" — ", StringComparison.Ordinal);
        return separatorIndex < 0 ? option : option[..separatorIndex];
    }

    private void SetBaseField(Action<Item> update)
    {
        update(Content);
        if (localizedFields?.IsSyncOriginalText == true)
            localizedFields.CopyBaseToAllLanguages();
    }
}
