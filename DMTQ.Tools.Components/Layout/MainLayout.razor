@inherits LayoutComponentBase
@inject IThemeService ThemeService
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ILanguagePreferenceStore PreferenceStore
@implements IDisposable

<FluentProviders />

@* ────────────────────────────────────────────────────────────
   Layout: plain HTML flex (no FluentLayout / FluentStack)
   FluentUI components add hidden default gap/margin that
   breaks precise height calculation. Plain divs guarantee
   exact flex constraint chain: html→body→#app→wrapper.
   ──────────────────────────────────────────────────────────── *@
<div @key="Language.CurrentCulture.Name" style="height: 100%; display: flex; flex-direction: column; overflow: hidden;">

    @* ── Sticky Header ── *@
    <header class="app-header">
        <div class="header-identity">
            <FluentButton class="header-nav-toggle"
                          Appearance="ButtonAppearance.Subtle"
                          IconStart="@(new Icons.Regular.Size20.Navigation())"
                          Title='@L["Header.ToggleNavigation"]'
                          aria-label='@L["Header.ToggleNavigation"]'
                          aria-expanded="@(_isNavigationExpanded ? "true" : "false")"
                          OnClick="ToggleNavigation" />
            <span class="header-brand">@L["App.Title"]</span>
        </div>

        <div class="header-breadcrumb"><GlobalBreadcrumb /></div>

        <div class="header-actions">
            @if (EditablePlatforms.Count > 1)
            {
                <div class="header-platform">
                    <span>@L["Header.DataPlatform"]</span>
                    <FluentSelect Items="@EditablePlatforms"
                                  @bind-Value="State.SelectedExportPlatform"
                                  Style="min-width: 6rem;" />
                </div>
            }

            @if (State.HasProject)
            {
                <div class="header-project-actions">
                    <span class="header-project-name @(State.IsDirty ? "is-dirty" : null)"
                          title="@(State.IsDirty ? L["Header.UnsavedChanges"].Value : State.ProjectRoot)">
                        @ProjectDisplayName
                    </span>
                    <FluentButton class="header-save-button"
                                  Appearance="ButtonAppearance.Default"
                                  OnClick="SaveProjectAsync"
                                  Disabled="@(!State.HasPackage || _isSaving)"
                                  Title='@L["Header.SaveProject"]'>
                        @(_isSaving ? L["Header.Saving"] : L["Header.SaveProject"])
                    </FluentButton>
                    <FluentSwitch class="header-auto-save"
                                  Value="@_autoSaveEnabled"
                                  ValueChanged="SetAutoSaveEnabled"
                                  Label='@L["Header.AutoSave"]'
                                  Title='@L["Header.AutoSaveHint"]' />
                    @if (!string.IsNullOrWhiteSpace(_saveError))
                    {
                        <span class="header-save-error" title="@_saveError">@(_autoSaveFailure ? L["Header.AutoSaveFailed"] : L["Header.SaveFailed"])</span>
                    }
                </div>
            }

            <FluentMenu>
                <FluentMenuButton Id="header-language"
                                  class="header-language"
                                  Label="@CurrentLanguageLabel"
                                  Appearance="ButtonAppearance.Subtle"
                                  Color="var(--colorNeutralForegroundOnBrand)"
                                  IconStart="@(new Icons.Regular.Size20.Globe())"
                                  Title='@L["Language.Title"]' />
                <FluentMenuList>
                    <FluentMenuItem Label='@L["Language.English"]' Checked='@(Language.CurrentCulture.Name == "en-US")'
                                    OnClick="UseEnglish" />
                    <FluentMenuItem Label='@L["Language.Chinese"]' Checked='@(Language.CurrentCulture.Name == "zh-CN")'
                                    OnClick="UseChinese" />
                </FluentMenuList>
            </FluentMenu>
        </div>
    </header>

    @* ── Sidebar + Content (row flex, constrained by parent column) ── *@
    <div class="app-workspace">
        <aside class="app-sidebar @(_isNavigationExpanded ? "is-expanded" : "is-collapsed")"
               aria-hidden="@(!_isNavigationExpanded)">
            <FluentNav class="app-navigation" Width="100%">
                <FluentNavItem Href="/" IconRest="@(new Icons.Regular.Size20.Home())" Match="NavLinkMatch.All">@L["Nav.Project"]</FluentNavItem>
                <FluentNavItem Href="import" IconRest="@(new Icons.Regular.Size20.ArrowDownload())">@L["Nav.Import"]</FluentNavItem>
                <FluentNavItem Href="tables" IconRest="@(new Icons.Regular.Size20.Table())">@L["Nav.Tables"]</FluentNavItem>
                <FluentNavItem Href="songs" IconRest="@(new Icons.Regular.Size20.MusicNote1())">@L["Nav.Songs"]</FluentNavItem>
                <FluentNavItem Href="patterns" IconRest="@(new Icons.Regular.Size20.MusicNote1())">@L["Nav.PatternTool"]</FluentNavItem>
                <FluentNavItem Href="atlas-editor" IconRest="@(new Icons.Regular.Size20.Image())">@L["Nav.AtlasEditor"]</FluentNavItem>
                <FluentNavItem Href="products" IconRest="@(new Icons.Regular.Size20.Table())">@L["Nav.Products"]</FluentNavItem>
                <FluentNavItem Href="items" IconRest="@(new Icons.Regular.Size20.Table())">@L["Nav.Items"]</FluentNavItem>
                <FluentNavItem Href="achievements" IconRest="@(new Icons.Regular.Size20.Table())">@L["Nav.Achievements"]</FluentNavItem>
                <FluentNavItem Href="quests" IconRest="@(new Icons.Regular.Size20.Table())">@L["Nav.Quests"]</FluentNavItem>
                <FluentNavItem Href="slang" IconRest="@(new Icons.Regular.Size20.Table())">@L["Nav.Slang"]</FluentNavItem>
                <FluentNavItem Href="resources" IconRest="@(new Icons.Regular.Size20.Folder())">@L["Nav.Resources"]</FluentNavItem>
                <FluentNavItem Href="export" IconRest="@(new Icons.Regular.Size20.ArrowUpload())">@L["Nav.Export"]</FluentNavItem>
                <FluentNavItem Href="diagnostics" IconRest="@(new Icons.Regular.Size20.Wrench())">@L["Nav.Diagnostics"]</FluentNavItem>
            </FluentNav>
        </aside>

        <main class="app-main">
            <div class="route-viewport">
                @Body
            </div>
        </main>
    </div>

</div>

@* FluentUI providers — must be after the layout *@

@code {
    private const string AutoSavePreferenceKey = "project.autoSave";
    private static readonly TimeSpan AutoSaveDelay = TimeSpan.FromMilliseconds(700);
    private readonly SemaphoreSlim _saveGate = new(1, 1);
    private CancellationTokenSource? _autoSaveCancellation;
    private bool _isSaving;
    private bool _isNavigationExpanded = true;
    private bool _autoSaveEnabled;
    private bool _autoSaveFailure;
    private string? _saveError;

    private string ProjectDisplayName =>
        State.ProjectRoot is { Length: > 0 } root
            ? Path.GetFileName(root.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
            : "";

    private string CurrentLanguageLabel =>
        Language.CurrentCulture.Name == "zh-CN"
            ? L["Language.Chinese"].Value
            : L["Language.English"].Value;

    private IReadOnlyList<string> EditablePlatforms => State.CurrentPackage?.PlatformTables.Keys
        .OrderBy(platform => platform, StringComparer.OrdinalIgnoreCase)
        .ToArray() ?? [];

    protected override void OnInitialized()
    {
        _autoSaveEnabled = bool.TryParse(PreferenceStore.Get(AutoSavePreferenceKey), out var enabled) && enabled;
        State.StateChanged += OnStateChanged;
        Language.LanguageChanged += OnLanguageChanged;
        if (_autoSaveEnabled && State.IsDirty) QueueAutoSave();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.SetThemeAsync(new ThemeSettings(
                "#6264A7",
                HueTorsion: 0,
                Vibrancy: 0,
                Mode: ThemeMode.Light,
                IsExact: true));
        }
    }

    private void OnStateChanged() => InvokeAsync(() =>
    {
        StateHasChanged();
        if (_autoSaveEnabled && State.IsDirty)
            QueueAutoSave();
        else
            CancelAutoSave();
    });

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void ToggleNavigation() => _isNavigationExpanded = !_isNavigationExpanded;

    private void UseEnglish() => Language.SetLanguage("en-US");

    private void UseChinese() => Language.SetLanguage("zh-CN");

    private void SetAutoSaveEnabled(bool enabled)
    {
        _autoSaveEnabled = enabled;
        PreferenceStore.Set(AutoSavePreferenceKey, enabled.ToString());
        _saveError = null;
        if (enabled && State.IsDirty)
            QueueAutoSave();
        else
            CancelAutoSave();
    }

    private Task SaveProjectAsync() => SaveProjectCoreAsync(isAutoSave: false);

    private void QueueAutoSave()
    {
        CancelAutoSave();
        var cancellation = new CancellationTokenSource();
        _autoSaveCancellation = cancellation;
        _ = SaveAfterDelayAsync(cancellation);
    }

    private async Task SaveAfterDelayAsync(CancellationTokenSource cancellation)
    {
        try
        {
            await Task.Delay(AutoSaveDelay, cancellation.Token);
            if (_autoSaveEnabled && State.IsDirty && State.HasProject && State.HasPackage)
                await InvokeAsync(() => SaveProjectCoreAsync(isAutoSave: true));
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_autoSaveCancellation, cancellation))
                _autoSaveCancellation = null;
            cancellation.Dispose();
        }
    }

    private async Task SaveProjectCoreAsync(bool isAutoSave)
    {
        await _saveGate.WaitAsync();
        try
        {
            if (!State.HasProject || !State.HasPackage || (isAutoSave && (!_autoSaveEnabled || !State.IsDirty)))
                return;

            _isSaving = true;
            _saveError = null;
            _autoSaveFailure = false;
            StateHasChanged();
            await Workflow.SaveProjectAsync();
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
            _autoSaveFailure = isAutoSave;
        }
        finally
        {
            _isSaving = false;
            _saveGate.Release();
            StateHasChanged();
        }
    }

    private void CancelAutoSave()
    {
        if (_autoSaveCancellation is null) return;
        _autoSaveCancellation.Cancel();
        _autoSaveCancellation = null;
    }

    public void Dispose()
    {
        State.StateChanged -= OnStateChanged;
        Language.LanguageChanged -= OnLanguageChanged;
        CancelAutoSave();
    }
}
