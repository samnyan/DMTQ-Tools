@inherits LayoutComponentBase

<FluentDesignTheme Mode="DesignThemeModes.System"
                   OfficeColor="OfficeColor.Teams"
                   StorageName="dmtq-theme" />

<FluentMainLayout NavMenuTitle="DMTQ Tools"
                  NavMenuWidth="250">
    <Header>
        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                     Width="100%" Style="padding: 0 1rem;">
            <span style="font-weight: 600;">GameTableManager</span>
        </FluentStack>
    </Header>
    <NavMenuContent>
        <NavMenu />
    </NavMenuContent>
    <Body>
        <FluentBodyContent>
            <article style="padding: 1rem 1.5rem;">
                @Body
            </article>
        </FluentBodyContent>
    </Body>
</FluentMainLayout>

@* Required FluentUI providers. With Scoped lifetime, NavigationManager
   is available when these resolve during Blazor rendering. *@
<FluentToastProvider />
<FluentDialogProvider />
<FluentMessageBarProvider />
<FluentTooltipProvider />
<FluentMenuProvider />
<FluentKeyCodeProvider />
