@inherits LayoutComponentBase
@inject IProjectState State
@inject IProjectWorkflow Workflow
@implements IDisposable

<FluentDesignTheme Mode="DesignThemeModes.System"
                   OfficeColor="OfficeColor.Teams"
                   StorageName="dmtq-theme" />

@* ────────────────────────────────────────────────────────────
   Layout: plain HTML flex (no FluentLayout / FluentStack)
   FluentUI components add hidden default gap/margin that
   breaks precise height calculation. Plain divs guarantee
   exact flex constraint chain: html→body→#app→wrapper.
   ──────────────────────────────────────────────────────────── *@
<div @key="Language.CurrentCulture.Name" style="height: 100%; display: flex; flex-direction: column; overflow: hidden;">

    @* ── Sticky Header ── *@
    <FluentHeader Height="48" Style="border-bottom: 1px solid var(--neutral-stroke-rest); padding: 0 1.25rem;">
        <div style="font-weight: 600; font-size: 1rem;">@L["App.Title"]</div>

        <FluentSpacer />

        @if (State.HasProject)
        {
            <div Style="display: flex; align-items: center; gap: 0.5rem;">
                @if (State.IsDirty)
                {
                    <span style="color: var(--error); font-size: 0.85rem; font-weight: 500;" title='@L["Header.UnsavedChanges"]'>
                        @ProjectDisplayName
                    </span>
                }
                else
                {
                    <span style="font-size: 0.85rem; color: var(--neutral-foreground-rest); max-width: 20rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@State.ProjectRoot">
                        @ProjectDisplayName
                    </span>
                }
                <FluentButton Appearance="@(State.IsDirty ? Appearance.Accent : Appearance.Neutral)"
                              OnClick="SaveProjectAsync"
                              Disabled="@(!State.HasPackage || _isSaving)"
                              Style="font-size: 0.8rem; min-width: 4rem;">
                    @(_isSaving ? L["Header.Saving"] : L["Common.Save"])
                </FluentButton>
            </div>
        }

        <FluentMenuButton Text="@CurrentLanguageLabel" ButtonAppearance="Appearance.Neutral"
                          IconStart="@(new Icons.Regular.Size20.Globe())"
                          Title='@L["Language.Title"]'>
            <FluentMenuItem Label='@L["Language.English"]' Checked='@(Language.CurrentCulture.Name == "en-US")'
                            OnClick="UseEnglish" />
            <FluentMenuItem Label='@L["Language.Chinese"]' Checked='@(Language.CurrentCulture.Name == "zh-CN")'
                            OnClick="UseChinese" />
        </FluentMenuButton>
    </FluentHeader>

    @* ── Sidebar + Content (row flex, constrained by parent column) ── *@
    <div style="flex: 1; min-height: 0; display: flex; overflow: hidden;">
        <FluentNavMenu Width="250" Collapsible="true" Title="DMTQ Tools"
                       Style="flex-shrink: 0; border-right: 1px solid var(--neutral-stroke-rest);">
            <FluentNavLink Href="" Icon="@(new Icons.Regular.Size20.Home())" Match="NavLinkMatch.All">@L["Nav.Project"]</FluentNavLink>
            <FluentNavLink Href="import" Icon="@(new Icons.Regular.Size20.ArrowDownload())">@L["Nav.Import"]</FluentNavLink>
            <FluentNavLink Href="songs" Icon="@(new Icons.Regular.Size20.MusicNote1())">@L["Nav.Songs"]</FluentNavLink>
            <FluentNavLink Href="products" Icon="@(new Icons.Regular.Size20.Table())">@L["Nav.Products"]</FluentNavLink>
            <FluentNavLink Href="items" Icon="@(new Icons.Regular.Size20.Table())">@L["Nav.Items"]</FluentNavLink>
            <FluentNavLink Href="resources" Icon="@(new Icons.Regular.Size20.Folder())">@L["Nav.Resources"]</FluentNavLink>
            <FluentNavLink Href="export" Icon="@(new Icons.Regular.Size20.ArrowUpload())">@L["Nav.Export"]</FluentNavLink>
            <FluentNavLink Href="diagnostics" Icon="@(new Icons.Regular.Size20.Wrench())">@L["Nav.Diagnostics"]</FluentNavLink>
        </FluentNavMenu>

        <main style="flex: 1; min-width: 0; overflow-y: auto; padding: 1.25rem 1.5rem;">
            @Body
        </main>
    </div>

</div>

@* FluentUI providers — must be after the layout *@
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMenuProvider />
<FluentKeyCodeProvider />

@code {
    private bool _isSaving;

    private string ProjectDisplayName =>
        State.ProjectRoot is { Length: > 0 } root
            ? Path.GetFileName(root.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
            : "";

    private string CurrentLanguageLabel =>
        Language.CurrentCulture.Name == "zh-CN"
            ? L["Language.Chinese"].Value
            : L["Language.English"].Value;

    protected override void OnInitialized()
    {
        State.StateChanged += OnStateChanged;
        Language.LanguageChanged += OnLanguageChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void UseEnglish() => Language.SetLanguage("en-US");

    private void UseChinese() => Language.SetLanguage("zh-CN");

    private async Task SaveProjectAsync()
    {
        _isSaving = true;
        StateHasChanged();
        try
        {
            await Workflow.SaveProjectAsync();
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        State.StateChanged -= OnStateChanged;
        Language.LanguageChanged -= OnLanguageChanged;
    }
}
