@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using DMTQ.Tools.Core.Models
@using DMTQ.Tools.Core.Models.Entity
@using DMTQ.Tools.Core.Models.Export
@using DMTQ.Tools.Core.Models.Project
@using DMTQ_Tools.Components.Models
@inherits FluentDialogInstance

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="min-width: 360px;">

    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12" Sm="6">
            <FluentNumberInput @bind-Value="Content.PatternId" Label='@(L["Fields.PatternId"].Value + " *")'
                             Disabled="@(originalId is not null && !AllowPatternIdEdit)" Required />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentSelect Items="LineOptions" @bind-Value="selectedLine"
                          Label='@(L["Fields.ChartLine"].Value + (AllowPatternIdEdit ? " *" : ""))'
                          Required="@AllowPatternIdEdit"
                          MessageState="MessageState.Error"
                          Message='@L["Editor.PatternLineRequired"]'
                          MessageCondition="@(_ => showLineRequiredMessage && Content.Line == 0)" />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentSelect Items="SignatureOptions" @bind-Value="selectedSignature" Label='@L["Fields.ChartDifficulty"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentNumberInput @bind-Value="Content.Difficulty" Label='@L["Fields.StarRating"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentSelect Items="PointTypeOptions" @bind-Value="selectedPointType" Label='@L["Fields.PointType"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentNumberInput @bind-Value="Content.PointValue" Label='@L["Fields.PointValue"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentTextInput @bind-Value="Content.Update" Label='@L["Fields.UpdateVersion"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12">
            <FluentSwitch @bind-Value="flgChecked" Label='@L["Fields.PatternEnabled"]' />
        </FluentGridItem>
        @if (AllowPatternIdEdit)
        {
            <FluentGridItem Xs="12">
                <div class="pattern-file-drop" style="position: relative; border: 1px dashed var(--colorNeutralStroke1); border-radius: var(--borderRadiusMedium); padding: 14px; text-align: center;">
                    <strong>@L["PatternImport.DropTitle"]</strong>
                    <div>@(FileSelection?.FileName ?? L["PatternImport.DropHint"].Value)</div>
                    <InputFile OnChange="OnPatternFileChanged"
                               style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
                </div>
                @if (FileSelection?.Content is not null)
                {
                    <FluentCheckbox @bind-Value="FileSelection.IsHeadphone" Label='@L["PatternImport.IsHeadphone"]' />
                }
                @if (!string.IsNullOrWhiteSpace(fileError))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error" Title="@fileError" />
                }
            </FluentGridItem>
        }
    </FluentGrid>

</FluentStack>
</FluentDialogBody>

@code {
    [Parameter] public SongPattern Content { get; set; } = default!;
    [Parameter] public bool AllowPatternIdEdit { get; set; }
    [Parameter] public PatternFileSelection? FileSelection { get; set; }

    private int? originalId;
    private bool showLineRequiredMessage;
    private string fileError = string.Empty;

    private string[] LineOptions
    {
        get
        {
            var options = IncludeExisting(
                [$"3 — {L["Options.PatternLine2"].Value}", $"4 — {L["Options.PatternLine3"].Value}", $"5 — {L["Options.PatternLine4"].Value}"],
                Content.Line);
            return AllowPatternIdEdit && Content.Line == 0
                ? ["", .. options.Where(option => !option.StartsWith("0 — ", StringComparison.Ordinal))]
                : options;
        }
    }
    private string[] SignatureOptions =>
        IncludeExisting([$"0 — {L["Options.PatternEasy"].Value}", $"1 — {L["Options.PatternNormal"].Value}",
            $"2 — {L["Options.PatternHard"].Value}", $"3 — {L["Options.PatternExpert"].Value}"], Content.Signature);
    private string[] PointTypeOptions =>
        [$"0 — {L["Options.PointNone"].Value}", $"1 — {L["Options.PointMax"].Value}", $"2 — {L["Options.PointQ"].Value}"];

    private string selectedLine
    {
        get => AllowPatternIdEdit && Content.Line == 0 ? string.Empty : GetOption(LineOptions, Content.Line);
        set => Content.Line = GetCode(value);
    }

    private string selectedSignature
    {
        get => GetOption(SignatureOptions, Content.Signature);
        set => Content.Signature = GetCode(value);
    }

    private string selectedPointType
    {
        get => GetOption(PointTypeOptions, Content.PointType == 0 ? 0 : Content.PointType == 1 ? 1 : 2);
        set => Content.PointType = GetCode(value);
    }

    private bool flgChecked
    {
        get => Content.Flg == "Y";
        set => Content.Flg = value ? "Y" : "N";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Content.PatternId > 0)
            originalId = Content.PatternId;
    }

    protected override Task OnActionClickedAsync(bool primary)
    {
        if (!primary) return DialogInstance.CancelAsync();
        if (AllowPatternIdEdit && Content.Line == 0)
        {
            showLineRequiredMessage = true;
            StateHasChanged();
            return Task.CompletedTask;
        }

        return DialogInstance.CloseAsync(Content);
    }

    private async Task OnPatternFileChanged(InputFileChangeEventArgs args)
    {
        if (FileSelection is null) return;
        fileError = string.Empty;
        var file = args.File;
        try
        {
            await using var stream = file.OpenReadStream(32 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            FileSelection.FileName = file.Name;
            FileSelection.Content = buffer.ToArray();
            FileSelection.IsHeadphone = Path.GetFileNameWithoutExtension(file.Name)
                .EndsWith("_EARPHONE", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception exception)
        {
            FileSelection.FileName = null;
            FileSelection.Content = null;
            fileError = L["PatternImport.ReadFailed", exception.Message].Value;
        }
    }

    private string GetOption(IReadOnlyList<string> knownOptions, int value)
        => knownOptions.FirstOrDefault(option => GetCode(option) == value)
           ?? $"{value} — {L["Fields.ExistingValue"].Value}";

    private string[] IncludeExisting(string[] options, int value)
        => options.Any(option => GetCode(option) == value)
            ? options
            : [.. options, GetOption(options, value)];

    private static int GetCode(string? option)
        => int.TryParse(option?.Split(" — ", 2)[0], out var value) ? value : 0;
}
