@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using DMTQ.Tools.Core.Models
@using DMTQ.Tools.Core.Models.Entity
@using DMTQ.Tools.Core.Models.Export
@using DMTQ.Tools.Core.Models.Project
@inherits FluentDialogInstance

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="min-width: 360px;">

    <FluentGrid Spacing="3">
        <FluentGridItem Xs="12" Sm="6">
            <FluentNumberInput @bind-Value="Content.PatternId" Label='@(L["Fields.PatternId"].Value + " *")'
                             Disabled="@(originalId is not null)" Required />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentSelect Items="LineOptions" @bind-Value="selectedLine" Label='@L["Fields.ChartLine"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentSelect Items="SignatureOptions" @bind-Value="selectedSignature" Label='@L["Fields.ChartDifficulty"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentNumberInput @bind-Value="Content.Difficulty" Label='@L["Fields.StarRating"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentSelect Items="PointTypeOptions" @bind-Value="selectedPointType" Label='@L["Fields.PointType"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentNumberInput @bind-Value="Content.PointValue" Label='@L["Fields.PointValue"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentTextInput @bind-Value="Content.Name" Label='@L["Fields.PatternName"]' />
        </FluentGridItem>
        <FluentGridItem Xs="12">
            <FluentSwitch @bind-Value="flgChecked" Label='@L["Fields.PatternEnabled"]' />
        </FluentGridItem>
    </FluentGrid>

</FluentStack>
</FluentDialogBody>

@code {
    [Parameter] public SongPattern Content { get; set; } = default!;

    private int? originalId;

    private string[] LineOptions =>
        IncludeExisting([$"3 — {L["Options.PatternLine2"].Value}", $"4 — {L["Options.PatternLine3"].Value}", $"5 — {L["Options.PatternLine4"].Value}"], Content.Line);
    private string[] SignatureOptions =>
        IncludeExisting([$"0 — {L["Options.PatternEasy"].Value}", $"1 — {L["Options.PatternNormal"].Value}",
            $"2 — {L["Options.PatternHard"].Value}", $"3 — {L["Options.PatternExpert"].Value}"], Content.Signature);
    private string[] PointTypeOptions =>
        IncludeExisting([$"0 — {L["Options.PointNone"].Value}", $"1 — {L["Options.PointMax"].Value}", $"2 — {L["Options.PointQ"].Value}"], Content.PointType);

    private string selectedLine
    {
        get => GetOption(LineOptions, Content.Line);
        set => Content.Line = GetCode(value);
    }

    private string selectedSignature
    {
        get => GetOption(SignatureOptions, Content.Signature);
        set => Content.Signature = GetCode(value);
    }

    private string selectedPointType
    {
        get => GetOption(PointTypeOptions, Content.PointType);
        set => Content.PointType = GetCode(value);
    }

    private bool flgChecked
    {
        get => Content.Flg == "Y";
        set => Content.Flg = value ? "Y" : "N";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Content.PatternId > 0)
            originalId = Content.PatternId;
    }

    protected override Task OnActionClickedAsync(bool primary)
        => primary ? DialogInstance.CloseAsync(Content) : DialogInstance.CancelAsync();

    private string GetOption(IReadOnlyList<string> knownOptions, int value)
        => knownOptions.FirstOrDefault(option => GetCode(option) == value)
           ?? $"{value} — {L["Fields.ExistingValue"].Value}";

    private string[] IncludeExisting(string[] options, int value)
        => options.Any(option => GetCode(option) == value)
            ? options
            : [.. options, GetOption(options, value)];

    private static int GetCode(string? option)
        => int.TryParse(option?.Split(" — ", 2)[0], out var value) ? value : 0;
}
