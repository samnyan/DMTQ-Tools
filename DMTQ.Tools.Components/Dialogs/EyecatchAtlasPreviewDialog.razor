@using Assets.Lib.Models
@using DMTQ_Tools.Components.Services
@inherits FluentDialogInstance
@inject IProjectState State
@inject NavigationManager Navigation
@inject EyecatchIndexService IndexService
@inject EyecatchBundleBuildService BundleBuildService
@inject IDialogService DialogService

<FluentDialogBody>
    @if (_busy)
    {
        <FluentMessageBar Intent="MessageBarIntent.Info" Title="@_progress" />
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <FluentMessageBar Intent="@_messageIntent" Title="@_message" />
    }
    @if (_family is null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning" Title='@L["Eyecatch.NotIndexed"]' />
    }
    else
    {
        @if (_family.HasSpriteNameMismatch)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" Title='@L["Eyecatch.PlatformSpriteNameMismatch"]' />
        }
        @if (_family.HasPlatformLayoutMismatch)
        {
            <FluentMessageBar Intent="MessageBarIntent.Warning" Title='@L["Eyecatch.PlatformLayoutMismatch"]' />
        }
        <div class="eyecatch-preview-actions">
            <span>@L["Eyecatch.SpriteCount"] @(_family.Variants.Where(variant => variant.Status == EyecatchVariantStatus.Ready).Select(variant => variant.Document.Sprites.Count).DefaultIfEmpty(0).Max())</span>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="BuildAllVariantsAsync"
                          Disabled="@(_busy || !CanBuild(_family))">
                @L["Eyecatch.BuildAllVariants"]
            </FluentButton>
        </div>
        <div class="eyecatch-preview-grid">
            @foreach (var variant in OrderedVariants(_family))
            {
                <article class="eyecatch-preview-card">
                    <header>
                        <h3>@KindLabel(variant.Kind) · @PlatformLabel(variant.Platform)</h3>
                        <span class="eyecatch-preview-status @variant.Status.ToString().ToLowerInvariant()">@VariantStatus(variant)</span>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(variant.ResourcePath))
                    {
                        <p class="eyecatch-preview-path"><code>@variant.ResourcePath</code></p>
                    }
                    @if (_previewImages.TryGetValue(VariantKey(variant), out var imageUrl) && imageUrl is not null)
                    {
                        <img class="eyecatch-preview-image" src="@imageUrl" alt="@variant.AtlasName" />
                    }
                    else
                    {
                        <div class="eyecatch-preview-empty">@VariantErrorOrStatus(variant)</div>
                    }
                    <div class="eyecatch-preview-meta">
                        <span>@L["Eyecatch.SpriteCount"]: @(variant.Document?.Sprites.Count ?? 0)</span>
                        @if (variant.Document is not null && variant.Document.TextureWidth > 0)
                        {
                            <span>@variant.Document.TextureWidth × @variant.Document.TextureHeight</span>
                        }
                        @if (variant.IsDirty)
                        {
                            <span class="eyecatch-preview-dirty">@L["Eyecatch.Dirty"]</span>
                        }
                    </div>
                    @if (variant.Document is not null && variant.Document.Sprites.Count > 0)
                    {
                        <details class="eyecatch-preview-sprites">
                            <summary>@L["Eyecatch.Sprites"] (@variant.Document.Sprites.Count)</summary>
                            <ul>
                                @foreach (var sprite in variant.Document.Sprites)
                                {
                                    <li><code>@sprite.Name</code> <span>@((int)sprite.Width) × @((int)sprite.Height)</span></li>
                                }
                            </ul>
                        </details>
                    }
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(() => OpenEditorAsync(variant))"
                                  Disabled="@(_busy || !CanEdit(variant))">
                        @L["Eyecatch.EditThis"]
                    </FluentButton>
                </article>
            }
        </div>
    }
</FluentDialogBody>

@code {
    [Parameter, EditorRequired] public string AtlasKey { get; set; } = string.Empty;

    private EyecatchAtlasFamily? _family;
    private readonly Dictionary<string, string?> _previewImages = new(StringComparer.OrdinalIgnoreCase);
    private bool _busy;
    private string _progress = string.Empty;
    private string _message = string.Empty;
    private MessageBarIntent _messageIntent = MessageBarIntent.Info;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ReloadFamilyAsync();
    }

    protected override Task OnActionClickedAsync(bool primary) => DialogInstance.CancelAsync();

    private async Task ReloadFamilyAsync()
    {
        if (string.IsNullOrWhiteSpace(State.ProjectRoot)) return;
        var index = await IndexService.LoadAsync(State.ProjectRoot);
        _family = index.Atlases.FirstOrDefault(atlas => atlas.AtlasKey.Equals(AtlasKey, StringComparison.OrdinalIgnoreCase));
        _previewImages.Clear();
        if (_family is null) return;

        foreach (var variant in OrderedVariants(_family).Where(item => item.Status == EyecatchVariantStatus.Ready))
            _previewImages[VariantKey(variant)] = await IndexService.ReadImageDataUrlAsync(State.ProjectRoot, variant.AtlasImagePath);
    }

    private async Task BuildAllVariantsAsync()
    {
        if (_busy || _family is null || State.CurrentPackage is null || string.IsNullOrWhiteSpace(State.ProjectRoot)) return;
        if (HasSpriteNameMismatch(_family)) return;
        if (HasPlatformLayoutMismatch(_family))
        {
            var confirmation = await DialogService.ShowConfirmationAsync(
                message: L["Eyecatch.ConfirmLayoutRebuild"].Value,
                title: L["Eyecatch.PlatformLayoutMismatch"].Value,
                primaryButton: L["Eyecatch.AcceptReferenceLayout"].Value,
                secondaryButton: L["Common.Cancel"].Value);
            if (confirmation.Cancelled) return;
        }

        _busy = true;
        _message = string.Empty;
        _progress = L["Eyecatch.BuildStarting"].Value;
        try
        {
            var progress = new Progress<string>(value =>
            {
                _progress = value;
                StateHasChanged();
            });
            await BundleBuildService.BuildFamilyAsync(State.CurrentPackage, State.ProjectRoot, AtlasKey, progress);
            await ReloadFamilyAsync();
            _messageIntent = MessageBarIntent.Success;
            _message = L["Eyecatch.BundlesBuilt", AtlasKey].Value;
        }
        catch (Exception exception)
        {
            _messageIntent = MessageBarIntent.Error;
            _message = L["Eyecatch.BuildFailed", exception.Message].Value;
            State.Diagnostics.Add("Eyecatch bundle build failed: " + exception.Message);
        }
        finally
        {
            _busy = false;
            _progress = string.Empty;
        }
    }

    private async Task OpenEditorAsync(EyecatchAtlasVariant variant)
    {
        if (!CanEdit(variant)) return;
        await DialogInstance.CancelAsync();
        Navigation.NavigateTo($"/atlas-editor?projectFile={Uri.EscapeDataString(variant.ResourcePath)}&platform={Uri.EscapeDataString(variant.Platform)}");
    }

    private string KindLabel(SpriteAtlasKind kind) => kind == SpriteAtlasKind.NGUI3 ? L["AtlasEditor.NGUI3"].Value : L["AtlasEditor.NGUI2"].Value;
    private string VariantStatus(EyecatchAtlasVariant variant) => variant.Status switch
    {
        EyecatchVariantStatus.Ready => L["Eyecatch.Ready"].Value,
        EyecatchVariantStatus.Error => L["Eyecatch.Error"].Value,
        EyecatchVariantStatus.SourceChanged => L["Eyecatch.SourceChanged"].Value,
        EyecatchVariantStatus.Unindexed => L["Eyecatch.Unindexed"].Value,
        _ => L["Eyecatch.Missing"].Value
    };
    private string VariantErrorOrStatus(EyecatchAtlasVariant variant)
        => string.IsNullOrWhiteSpace(variant.Error) ? VariantStatus(variant) : variant.Error;
    private static string VariantKey(EyecatchAtlasVariant variant) => $"{variant.Kind}/{variant.Platform}";
    private static string PlatformLabel(string platform) => platform.Equals("ios", StringComparison.OrdinalIgnoreCase) ? "iOS" : "Android";
    private static IEnumerable<EyecatchAtlasVariant> OrderedVariants(EyecatchAtlasFamily family)
        => family.Variants.OrderBy(variant => variant.Kind).ThenBy(variant => variant.Platform == "android" ? 0 : 1);
    private static bool CanEdit(EyecatchAtlasVariant variant)
        => variant.Exists && variant.ResourceRegistered && !string.IsNullOrWhiteSpace(variant.ResourcePath)
            && variant.Status == EyecatchVariantStatus.Ready;
    private static bool CanBuild(EyecatchAtlasFamily family)
        => !HasSpriteNameMismatch(family)
            && !family.Variants.Any(variant => variant.Status == EyecatchVariantStatus.SourceChanged)
            && Enum.GetValues<SpriteAtlasKind>().All(kind => family.Variants.Any(variant =>
                variant.Kind == kind && variant.Status == EyecatchVariantStatus.Ready));
    private static bool HasSpriteNameMismatch(EyecatchAtlasFamily family)
        => family.HasSpriteNameMismatch;
    private static bool HasPlatformLayoutMismatch(EyecatchAtlasFamily family)
        => family.HasPlatformLayoutMismatch;
}
