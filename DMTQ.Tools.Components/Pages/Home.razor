@page "/"
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject IFolderPicker FolderPicker
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ILanguagePreferenceStore PreferenceStore

<h1>@L["Nav.Project"]</h1>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="margin-bottom: 1.25rem;">
    <div class="project-folder-row">
        <ToolbarField>
            <FluentTextInput @bind-Value="projectRoot"
                             Label='@L["Home.ProjectFolder"]'
                             Placeholder='@L["Home.ProjectFolderPlaceholder"]'
                             class="project-folder-input" />
        </ToolbarField>
        <ToolbarField Unlabeled>
            <FluentButton Appearance="ButtonAppearance.Default"
                          IconStart="@(new Icons.Regular.Size20.Folder())"
                          OnClick="BrowseFolder">@L["Home.Browse"]</FluentButton>
        </ToolbarField>
    </div>

    <div class="project-actions">
        <FluentButton Appearance="ButtonAppearance.Primary"
                      OnClick="ConfirmProject"
                      Disabled="@(string.IsNullOrWhiteSpace(projectRoot) || isBusy)">@L["Home.Confirm"]</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default"
                      OnClick="SaveProject"
                      Disabled="@(!State.HasPackage || isBusy)">@L["Common.Save"]</FluentButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <FluentMessageBar Title="@message" Intent="@messageIntent" />
    }
</FluentStack>

@if (recentProjects.Count > 0)
{
    <section class="recent-projects" aria-labelledby="recent-projects-heading">
        <h2 id="recent-projects-heading">@L["Home.RecentProjects"]</h2>
        <div class="recent-project-list">
            @foreach (var recentProject in recentProjects)
            {
                <div class="recent-project-row" @key="recentProject">
                    <div class="recent-project-details" title="@recentProject">
                        <strong>@ProjectDisplayName(recentProject)</strong>
                        <span>@recentProject</span>
                        @if (!Directory.Exists(recentProject))
                        {
                            <span class="recent-project-missing">@L["Home.RecentProjectMissing"]</span>
                        }
                    </div>
                    <div class="recent-project-actions">
                        <FluentButton Appearance="ButtonAppearance.Default"
                                      OnClick="() => OpenRecentProjectAsync(recentProject)"
                                      Disabled="@isBusy">
                            @L["Home.OpenRecent"]
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Default"
                                      IconStart="@(new Icons.Regular.Size20.Delete())"
                                      Title='@L["Home.RemoveRecent"]'
                                      OnClick="() => RemoveRecentProject(recentProject)"
                                      Disabled="@isBusy" />
                    </div>
                </div>
            }
        </div>
    </section>
}

<FluentGrid class="metric-grid" Spacing="3" Justify="JustifyContent.Center" AdaptiveRendering="true">
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Nav.Project"]</span>
            <p style="font-weight: 600; overflow-wrap: anywhere;">@(State.ProjectRoot ?? L["Home.NotSelected"].Value)</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Home.Source"]</span>
            <p style="font-weight: 600; overflow-wrap: anywhere;">@(State.CurrentPackage?.ProjectInfo.SourcePackageRoot ?? L["Home.NotImported"].Value)</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Home.Version"]</span>
            <p style="font-weight: 600;">@(State.CurrentPackage?.ProjectInfo.Version ?? "-")</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Home.PrimaryPlatform"]</span>
            <p style="font-weight: 600;">@(State.CurrentPackage?.ProjectInfo.Platform ?? "-")</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Home.ImportedPlatforms"]</span>
            <p style="font-weight: 600;">@PlatformSummary</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Nav.Songs"]</span>
            <p style="font-weight: 600;">@(State.CurrentPackage?.Songs.Count ?? 0)</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Home.Tables"]</span>
            <p style="font-weight: 600;">@(State.CurrentPackage?.Tables.Tables.Count ?? 0)</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Nav.Resources"]</span>
            <p style="font-weight: 600;">@(State.CurrentPackage?.Resources.Count ?? 0)</p>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
        <FluentCard>
            <span class="metric-label">@L["Home.LastValidation"]</span>
            <p style="font-weight: 600;">@ValidationText</p>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

@code {
    private const string RecentProjectsPreferenceKey = "project.recentFolders";
    private const int MaximumRecentProjects = 8;
    private static StringComparer ProjectPathComparer => OperatingSystem.IsWindows()
        ? StringComparer.OrdinalIgnoreCase
        : StringComparer.Ordinal;

    private string projectRoot = string.Empty;
    private List<string> recentProjects = [];
    private string? message;
    private MessageBarIntent messageIntent = MessageBarIntent.Info;
    private bool isBusy;

    protected override void OnInitialized()
    {
        recentProjects = LoadRecentProjects();
        projectRoot = State.ProjectRoot ?? recentProjects.FirstOrDefault() ?? string.Empty;
    }

    private string PlatformSummary => State.CurrentPackage is null
        ? "-"
        : string.Join(", ", State.CurrentPackage.Resources
            .SelectMany(r => r.PlatformManifest)
            .Select(m => m.Platform)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(p => p));

    private string ValidationText => State.LastValidationResult is null
        ? L["Common.NotRun"].Value
        : State.LastValidationResult.IsValid ? L["Common.Passed"].Value : L["Common.Errors", State.LastValidationResult.Errors.Count].Value;

    private async Task BrowseFolder()
    {
        var result = await FolderPicker.PickFolderAsync();
        if (!string.IsNullOrWhiteSpace(result))
            projectRoot = result;
    }

    private async Task ConfirmProject()
    {
        var root = projectRoot.Trim();
        if (string.IsNullOrWhiteSpace(root))
        {
            ShowMessage(L["Home.EnterProjectPath"].Value, MessageBarIntent.Warning);
            return;
        }

        if (!Directory.Exists(root))
        {
            ShowMessage(L["Home.FolderNotFound", root].Value, MessageBarIntent.Error);
            return;
        }

        isBusy = true;
        message = null;

        try
        {
            bool hasProjectFile = File.Exists(Path.Combine(root, "project.json"));
            bool isEmpty = !Directory.EnumerateFileSystemEntries(root).Any();

            if (hasProjectFile)
            {
                // Existing project — load it
                await Workflow.OpenProjectAsync(root);
                RememberRecentProject(root);
                ShowMessage(L["Home.ProjectLoaded"].Value, MessageBarIntent.Info);
            }
            else if (isEmpty)
            {
                // Empty directory — ask to create
                var result = await DialogService.ShowConfirmationAsync(
                    message: L["Home.EmptyFolderConfirm"].Value,
                    title: L["Home.Confirm"].Value,
                    primaryButton: L["Home.NewProject"].Value,
                    secondaryButton: L["Common.Cancel"].Value);
                if (!result.Cancelled)
                {
                    await Workflow.CreateProjectAsync(root);
                    RememberRecentProject(root);
                    ShowMessage(L["Home.ProjectCreated"].Value, MessageBarIntent.Info);
                }
            }
            else
            {
                // Has files but no project.json
                ShowMessage(
                    L["Home.InvalidFolder"].Value,
                    MessageBarIntent.Error);
            }
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, MessageBarIntent.Error);
            State.Diagnostics.Add("Project error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task OpenRecentProjectAsync(string path)
    {
        projectRoot = path;
        return ConfirmProject();
    }

    private void RemoveRecentProject(string path)
    {
        recentProjects.RemoveAll(project => ProjectPathComparer.Equals(project, path));
        PersistRecentProjects();
    }

    private List<string> LoadRecentProjects()
    {
        try
        {
            var storedProjects = System.Text.Json.JsonSerializer.Deserialize<List<string>>(
                PreferenceStore.Get(RecentProjectsPreferenceKey) ?? "[]") ?? [];
            return storedProjects
                .Where(path => !string.IsNullOrWhiteSpace(path))
                .Select(NormalizeProjectPath)
                .Where(path => path is not null)
                .Select(path => path!)
                .Distinct(ProjectPathComparer)
                .Take(MaximumRecentProjects)
                .ToList();
        }
        catch (System.Text.Json.JsonException)
        {
            return [];
        }
    }

    private void RememberRecentProject(string path)
    {
        var normalizedPath = NormalizeProjectPath(path);
        if (normalizedPath is null) return;

        recentProjects.RemoveAll(recent => ProjectPathComparer.Equals(recent, normalizedPath));
        recentProjects.Insert(0, normalizedPath);
        if (recentProjects.Count > MaximumRecentProjects)
            recentProjects.RemoveRange(MaximumRecentProjects, recentProjects.Count - MaximumRecentProjects);

        projectRoot = normalizedPath;
        PersistRecentProjects();
    }

    private void PersistRecentProjects()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(recentProjects);
        PreferenceStore.Set(RecentProjectsPreferenceKey, json);
    }

    private static string? NormalizeProjectPath(string path)
    {
        try
        {
            return Path.GetFullPath(path.Trim());
        }
        catch (ArgumentException)
        {
            return null;
        }
        catch (NotSupportedException)
        {
            return null;
        }
        catch (PathTooLongException)
        {
            return null;
        }
    }

    private static string ProjectDisplayName(string path)
    {
        var name = Path.GetFileName(path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
        return string.IsNullOrWhiteSpace(name) ? path : name;
    }

    private async Task SaveProject()
    {
        isBusy = true;
        message = null;
        try
        {
            await Workflow.SaveProjectAsync();
            ShowMessage(L["Home.ProjectSaved"].Value, MessageBarIntent.Info);
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, MessageBarIntent.Error);
            State.Diagnostics.Add("Save project error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowMessage(string? text, MessageBarIntent intent)
    {
        message = text;
        messageIntent = intent;
    }
}
