@page "/products"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ProductEditService ProductEditor
@inject ProductCatalogService ProductCatalog
@inject IDialogService DialogService

<ProjectListShell TItem="Product"
                  Title='@L["Nav.Products"]'
                  ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoProducts"]'
                  FilteredItems="@FilteredProducts"
                  Pagination="@pagination"
                  Message="@message"
                  ErrorMessage="@errorMessage">
    <Toolbar>
        <div class="list-toolbar-layout">
            <div class="list-toolbar-filters">
                <ToolbarField Unlabeled Search>
                    <FluentTextInput Value="@filter" ValueChanged="SetFilterAsync" Immediate="true" Placeholder='@L["Lists.FilterProducts"]'
                                     class="list-filter" />
                </ToolbarField>
            </div>
            <div class="list-toolbar-actions">
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  OnClick="CreateNewProduct">@L["Lists.AddProduct"]</FluentButton>
                </ToolbarField>
            </div>
        </div>
    </Toolbar>

    <Metrics>
        <FluentGrid class="metric-grid" Spacing="3" AdaptiveRendering="true">
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Lists.Products"]</span><strong>@Catalog.Count</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">Active</span><strong>@Catalog.Count(product => product.Status.Equals("Y", StringComparison.OrdinalIgnoreCase))</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Lists.WithStoreSku"]</span><strong>@Catalog.Count(product => !string.IsNullOrWhiteSpace(product.StoreProductId))</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Lists.Categories"]</span><strong>@Catalog.Sum(product => product.CategoryIds.Count)</strong></FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </Metrics>

    <Columns>
        <PropertyColumn TGridItem="Product" TProp="string" Property="@(product => product.Id)" Title='@L["Fields.ProductId"]' Sortable="true" Width="7rem" MinWidth="7rem" />
        <PropertyColumn TGridItem="Product" TProp="string" Property="@(product => product.ItemId)" Title='@L["Fields.ItemId"]' Sortable="true" Width="6.5rem" MinWidth="6.5rem" />
        <TemplateColumn TGridItem="Product" Title='@L["Fields.ProductType"]' Sortable="true" SortBy="@(GridSort<Product>.ByAscending(product => product.ProductType))" Width="14rem" MinWidth="12rem" Context="product">
            @GetProductTypeLabel(product.ProductType)
        </TemplateColumn>
        <TemplateColumn TGridItem="Product" Title='@L["Nav.ProductCategories"]' Width="2fr" MinWidth="18rem" Context="product">
            @GetProductCategoryLabels(product)
        </TemplateColumn>
        <PropertyColumn TGridItem="Product" TProp="string" Property="@(product => product.PlatformProductId)" Title='@L["Fields.PlatformProductId"]' Sortable="true" Width="7rem" MinWidth="7rem" />
        <PropertyColumn TGridItem="Product" TProp="string" Property="@(product => product.StoreProductId)" Title='@L["Fields.StoreProductId"]' Sortable="true" Width="1fr" MinWidth="18rem" />
        <PropertyColumn TGridItem="Product" TProp="string" Property="@(product => product.CostGamePoint)" Title='@L["Fields.CostGamePoint"]' Width="8rem" MinWidth="8rem" />
        <PropertyColumn TGridItem="Product" TProp="string" Property="@(product => product.CostGameCash)" Title='@L["Fields.CostGameCash"]' Width="7rem" MinWidth="7rem" />
        <PropertyColumn TGridItem="Product" TProp="string" Property="@(product => product.Status)" Title='@L["Fields.Status"]' Sortable="true" Width="6.25rem" MinWidth="6.25rem" />
        <TemplateColumn TGridItem="Product" Title='@L["Lists.Actions"]' Width="11rem" MinWidth="11rem" Context="product">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                              Size="ButtonSize.Small"
                              OnClick="() => EditProduct(product.Id)"
                              Title='@L["Common.Edit"]'>
                    @L["Common.Edit"]
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                              Size="ButtonSize.Small"
                              OnClick="() => DeleteProductAsync(product)"
                              Title='@L["Common.Delete"]' />
            </FluentStack>
        </TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    private string filter => SearchQuery ?? string.Empty;
    private string? message;
    private string? errorMessage;
    private PaginationState pagination = new() { ItemsPerPage = 25 };

    private PatchPackage? _lastPackage;
    private string? _lastPlatform;
    private IReadOnlyList<Product> _catalog = [];

    private IReadOnlyList<Product> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)
                && string.Equals(State.SelectedExportPlatform, _lastPlatform, StringComparison.OrdinalIgnoreCase)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _lastPlatform = State.SelectedExportPlatform;
            _catalog = State.CurrentPackage is null ? [] : ProductCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            return _catalog;
        }
    }

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            IEnumerable<Product> products = Catalog;
            if (!string.IsNullOrWhiteSpace(filter))
                products = products.Where(product =>
                    product.Id.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || product.ItemId.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || product.PlatformProductId.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || product.StoreProductId.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || product.ProductType.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || GetProductTypeLabel(product.ProductType).Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || GetProductCategoryLabels(product).Contains(filter, StringComparison.OrdinalIgnoreCase));
            return products.ByIdentifierDescending(product => product.Id);
        }
    }

    private string GetProductTypeLabel(string? type)
    {
        var code = type?.Trim() ?? string.Empty;
        var name = ProductTypeDisplay.GetName(code, L);
        return string.IsNullOrWhiteSpace(code) ? $"— {name}" : $"{code} — {name}";
    }

    private string GetProductCategoryLabels(Product product)
    {
        if (State.CurrentPackage is null || product.CategoryIds.Count == 0)
            return L["Lists.NoProductCategoriesForProduct"].Value;

        return string.Join(" · ", product.CategoryIds
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(id =>
            {
                var name = State.CurrentPackage.ProductCategoryMappings.GetValueOrDefault(id)?.Name;
                return string.IsNullOrWhiteSpace(name)
                    ? $"{id} — {L["Lists.UnknownProductCategory"].Value}"
                    : $"{id} — {name}";
            }));
    }

    private Task SetFilterAsync(string? value)
    {
        SearchQuery = value;
        TableNavigationState.UpdateQuery(Navigation, ("q", value), ("page", "1"));
        return Task.CompletedTask;
    }

    private void CreateNewProduct() => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, "/products/editor/new"));
    private void EditProduct(string productId) => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, $"/products/editor/{Uri.EscapeDataString(productId)}"));

    private async Task DeleteProductAsync(Product product)
    {
        if (State.CurrentPackage is null) return;

        message = null;
        errorMessage = null;
        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", L["Nav.Products"].Value.ToLowerInvariant(), product.Id].Value,
            title: L["Nav.Products"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;

        try
        {
            ProductEditor.RemoveProduct(State.CurrentPackage, product.Id, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            State.Diagnostics.Add($"Product deleted: {product.Id}");
            message = L["Lists.Deleted", L["Nav.Products"].Value, product.Id].Value;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Delete product error: " + ex.Message);
        }
    }
}
