@page "/quests"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject QuestCatalogService CatalogService
@inject QuestEditService EditService
@inject IDialogService DialogService

<ProjectListShell TItem="Quest" Title='@L["Nav.Quests"]' ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoQuests"]' FilteredItems="@FilteredItems" Pagination="@pagination"
                  Message="@message" ErrorMessage="@errorMessage">
    <Toolbar>
        <div class="list-toolbar-layout">
            <div class="list-toolbar-filters">
                <ToolbarField Unlabeled Search>
                    <FluentTextInput Value="@filter" ValueChanged="SetFilterAsync" Immediate="true" Placeholder='@L["Lists.FilterQuests"]' class="list-filter" />
                </ToolbarField>
            </div>
            <div class="list-toolbar-actions">
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="CreateNew">@L["Lists.AddQuest"]</FluentButton>
                </ToolbarField>
            </div>
        </div>
    </Toolbar>
    <Metrics><FluentGrid class="metric-grid" Spacing="3">
        <FluentGridItem Xs="12" Sm="6" Md="3"><FluentCard><span class="metric-label">@L["Nav.Quests"]</span><strong>@Catalog.Count</strong></FluentCard></FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="3"><FluentCard><span class="metric-label">@L["Editor.Missions"]</span><strong>@Catalog.Sum(q => q.Missions.Count)</strong></FluentCard></FluentGridItem>
    </FluentGrid></Metrics>
    <Columns>
        <PropertyColumn TGridItem="Quest" TProp="string" Property="@(q => q.Id)" Title='@L["Fields.QuestId"]' Sortable="true" Width="8rem" MinWidth="8rem" />
        <TemplateColumn TGridItem="Quest" Title='@L["Fields.Name"]' Width="1fr" MinWidth="20rem" Context="q">@CatalogService.GetDisplayName(q, PreviewLanguage)</TemplateColumn>
        <TemplateColumn TGridItem="Quest" Title='@L["Editor.Missions"]' Width="10.25rem" MinWidth="10.25rem" Context="q">@q.Missions.Count</TemplateColumn>
        <TemplateColumn TGridItem="Quest" Title='@L["Lists.Actions"]' Width="9rem" MinWidth="9rem" Context="q">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" Appearance="ButtonAppearance.Default" OnClick="() => Edit(q.Id)" Title='@L["Common.Edit"]' />
                <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())" Appearance="ButtonAppearance.Default" OnClick="() => DeleteAsync(q)" Title='@L["Common.Delete"]' />
            </FluentStack>
        </TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    private const string PreviewLanguage = "CN";
    private readonly PaginationState pagination = new() { ItemsPerPage = 25 };
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    private string filter => SearchQuery ?? string.Empty;
    private string? message;
    private string? errorMessage;
    private IReadOnlyList<Quest> Catalog => State.CurrentPackage is null ? [] : CatalogService.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
    private IEnumerable<Quest> FilteredItems => string.IsNullOrWhiteSpace(filter) ? Catalog : Catalog.Where(q =>
        q.Id.Contains(filter, StringComparison.OrdinalIgnoreCase)
        || CatalogService.GetDisplayName(q, PreviewLanguage).Contains(filter, StringComparison.OrdinalIgnoreCase));
    private Task SetFilterAsync(string? value)
    {
        SearchQuery = value;
        TableNavigationState.UpdateQuery(Navigation, ("q", value), ("page", "1"));
        return Task.CompletedTask;
    }

    private void CreateNew() => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, "/quests/editor/new"));
    private void Edit(string id) => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, $"/quests/editor/{Uri.EscapeDataString(id)}"));
    private async Task DeleteAsync(Quest quest)
    {
        if (State.CurrentPackage is null) return;
        var result = await DialogService.ShowConfirmationAsync(L["Lists.DeleteConfirm", L["Nav.Quests"].Value, quest.Id].Value,
            L["Common.Delete"].Value, L["Common.Cancel"].Value, L["Nav.Quests"].Value);
        if (result.Cancelled) return;
        try
        {
            EditService.RemoveQuest(State.CurrentPackage, quest.Id, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            message = L["Lists.Deleted", L["Nav.Quests"].Value, quest.Id].Value;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }
}
