@page "/export"
@using Assets.Lib.Models
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject PackageQaService QaService
@inject ILanguagePreferenceStore PreferenceStore
@inject IProjectFileSaver FileSaver
@inject EyecatchIndexService EyecatchIndexService

<h1>@L["Export.UpdatePackage"]</h1>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="margin-bottom: 1.25rem;">
    <FluentSelect Items="@(new[] { "android", "ios" })"
                  OptionText="@(i => i)"
                  OptionValue="@(i => i)"
                  @bind-Value="State.SelectedExportPlatform"
                  Label='@L["Import.Platform"]' />

    <FluentSelect Items="@(new[] { "Keep", "CompressAll", "UncompressAll" })"
                  OptionText="@(i => i)"
                  OptionValue="@(i => i)"
                  @bind-Value="State.ExportCompressionMode"
                  Label='@L["Export.CompressionPolicy"]' />

    <FluentTextInput @bind-Value="exportRoot"
                     Label='@L["Export.OutputDirectory"]'
                     Placeholder="D:\DMTQExports\android"
                     Style="width: 100%" />
    <FluentButton Appearance="ButtonAppearance.Primary"
                  @onclick="ExportPlatformPackage"
                  Disabled="@(!State.HasPackage || isBusy)">
        @L["Export.UpdatePackage"]
    </FluentButton>

    <FluentDivider />

    <section class="toolbar-panel">
        <h2>@L["Export.SongListExcel"]</h2>
        <p>@L["Export.SongListExcelDescription"]</p>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      OnClick="ExportSongListExcelAsync"
                      Disabled="@(!State.HasPackage || isBusy)">
            @if (isBusy) { <FluentSpinner /> }
            @L["Export.SongListExcelAction"]
        </FluentButton>
        @if (!string.IsNullOrWhiteSpace(songListMessage))
        {
            <div class="status-message">@songListMessage</div>
        }
    </section>

    @if (!State.HasPackage)
    {
        <div class="status-message">@L["Export.Precondition"]</div>
    }

    @if (qaSummary is not null)
    {
        <div class="qa-summary @(qaSummary.IsClean ? "success" : qaSummary.HasErrors ? "error" : "warning")">
            <strong>@L["Export.PreExportQa"]</strong> @qaSummary.Summary
            @if (qaSummary.HasErrors)
            {
                <span>@L["Export.FixErrors"]</span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-message">@message</div>
    }
</FluentStack>

@if (State.LastPlatformExportResult is not null)
{
    <FluentGrid Spacing="3" AdaptiveRendering="true">
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard>
                <span class="metric-label">Platform</span>
                <strong>@State.LastPlatformExportResult.Platform</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard>
                <span class="metric-label">@L["Export.ManifestEntries"]</span>
                <strong>@State.LastPlatformExportResult.ManifestEntryCount</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard>
                <span class="metric-label">@L["Export.FilesWritten"]</span>
                <strong>@State.LastPlatformExportResult.FilesWritten</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard>
                <span class="metric-label">@L["Export.SkippedBaseline"]</span>
                <strong>@State.LastPlatformExportResult.FilesSkippedAsBaseline</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard>
                <span class="metric-label">@L["Export.MissingCurrentFiles"]</span>
                <strong>@State.LastPlatformExportResult.MissingCurrentFiles</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6" Md="4">
            <FluentCard>
                <span class="metric-label">@L["Home.LastValidation"]</span>
                <strong>@ValidationText</strong>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>
}

@if (State.LastValidationResult is not null && !State.LastValidationResult.IsValid)
{
    <section class="toolbar-panel">
        <h2>@L["Export.ValidationErrors"]</h2>
        <ul class="diagnostic-list">
            @foreach (var error in State.LastValidationResult.Errors.Take(100))
            {
                <li>@error</li>
            }
        </ul>
    </section>
}

@code {
    private string exportRoot = string.Empty;
    private string? message;
    private string? songListMessage;
    private bool isBusy;
    private QaReport? qaSummary;
    private const string AutoSavePreferenceKey = "project.autoSave";

    private string ValidationText => State.LastValidationResult is null
        ? L["Common.NotRun"].Value
        : State.LastValidationResult.IsValid ? L["Common.Passed"].Value : L["Common.Errors", State.LastValidationResult.Errors.Count].Value;

    private async Task ExportPlatformPackage()
    {
        isBusy = true;
        message = L["Export.RunningQa"].Value;
        try
        {
            if (State.IsDirty)
            {
                var autoSaveEnabled = bool.TryParse(PreferenceStore.Get(AutoSavePreferenceKey), out var enabled) && enabled;
                if (!autoSaveEnabled)
                {
                    message = L["Export.SaveBeforeExport"].Value;
                    return;
                }

                await Workflow.SaveProjectAsync();
                if (State.IsDirty)
                {
                    message = L["Export.SaveBeforeExport"].Value;
                    return;
                }
            }

            if (State.CurrentPackage is not null)
            {
                qaSummary = QaService.Run(State.CurrentPackage);
                if (qaSummary.HasErrors)
                {
                    message = L["Export.QaFoundErrors", qaSummary.ErrorCount].Value;
                    State.Diagnostics.Add($"Pre-export QA: {qaSummary.Summary}");
                    return;
                }
            }

            message = L["Export.Exporting"].Value;
            await Workflow.ExportPlatformPackageAsync(
                exportRoot,
                State.SelectedExportPlatform,
                State.PlatformExportMode);
            message = State.LastPlatformExportResult?.Validation.IsValid == true
                ? L["Export.CompletedValid"].Value
                : L["Export.CompletedInvalid"].Value;
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Platform export error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ExportSongListExcelAsync()
    {
        if (isBusy || State.CurrentPackage is null) return;

        isBusy = true;
        songListMessage = L["Export.SongListExcelPreparing"].Value;
        try
        {
            var coverSprites = new List<(string AtlasName, string SpriteName)>();
            if (!string.IsNullOrWhiteSpace(State.ProjectRoot))
            {
                try
                {
                    var index = await EyecatchIndexService.LoadAsync(State.ProjectRoot);
                    coverSprites = index.Atlases
                        .SelectMany(atlas => atlas.Variants)
                        .Where(variant => variant.Status == EyecatchVariantStatus.Ready)
                        .SelectMany(variant => variant.SpriteAssets.Select(sprite =>
                            (AtlasName: string.IsNullOrWhiteSpace(variant.ResourcePath)
                                ? variant.AtlasName + ".unity3d"
                                : Path.GetFileName(variant.ResourcePath),
                             SpriteName: sprite.Name)))
                        .ToList();
                }
                catch (Exception exception)
                {
                    State.Diagnostics.Add("Song list Excel could not read the eyecatch index: " + exception.Message);
                }
            }

            var content = SongListExcelExporter.Export(
                State.CurrentPackage,
                coverSprites);
            await using var stream = new MemoryStream(content, writable: false);
            var savedPath = await FileSaver.SaveFileAsync(
                "DMTQ-Song-List.xlsx",
                stream);
            songListMessage = savedPath is null
                ? L["Export.SongListExcelCancelled"].Value
                : L["Export.SongListExcelCompleted", savedPath].Value;
        }
        catch (Exception exception)
        {
            songListMessage = L["Export.SongListExcelFailed", exception.Message].Value;
            State.Diagnostics.Add("Song list Excel export failed: " + exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
