@page "/items/editor/{ItemId}"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ItemEditService ItemEditSvc
@inject ItemCatalogService ItemCatalog
@inject EditorDraftStore DraftStore

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch">
    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenProjectFirst"]' Intent="MessageBarIntent.Warning" />
    }
    else if (currentItem is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Items"].Value, ItemId]' Intent="MessageBarIntent.Error" />
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Editor.BackTo", L["Nav.Items"].Value]</FluentButton>
    }
    else
    {
        <EditForm Model="@currentItem" OnValidSubmit="SaveAsync" FormName="item-editor" class="editor-form">
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" class="editor-form-sections">
                <ItemDataFields @ref="itemDataFields"
                                Content="@(currentItem!)"
                                ShowItemId="true"
                                ItemId="@(IsCreate ? itemIdInput : currentItem!.Id)"
                                ItemIdChanged="@(value => itemIdInput = value)"
                                IsItemIdReadOnly="@(!IsCreate)"
                                IsItemIdRequired="@IsCreate" />

                <section>
                    <div class="section-title-row">
                        <div>
                            <h2 class="section-heading">@L["Editor.ItemEffect"]</h2>
                            <p class="section-hint">@L["Editor.ItemEffectHint"]</p>
                        </div>
                        @if (effectDraft is null)
                        {
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="AddEffect"
                                          IconStart="@(new Icons.Regular.Size20.Add())">@L["Editor.AddEffect"]</FluentButton>
                        }
                        else
                        {
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="RemoveEffect"
                                          IconStart="@(new Icons.Regular.Size20.Delete())">@L["Editor.RemoveEffect"]</FluentButton>
                        }
                    </div>
                    @if (effectDraft is null)
                    {
                        <FluentMessageBar Title='@L["Editor.NoItemEffect"]' Intent="MessageBarIntent.Info" />
                    }
                    else
                    {
                        <FluentGrid Spacing="1">
                            <FluentGridItem Xs="12" Md="4"><FluentSelect TOption="string" TValue="string"
                                                                           Items="EffectTypeOptions"
                                                                           Value="@GetSelectedEffectType()"
                                                                           ValueChanged="SetEffectType"
                                                                           Label='@L["Fields.EffectType"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="effectDraft.EffectPoint" Label='@L["Fields.EffectPoint"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="effectDraft.EffectCount" Label='@L["Fields.EffectCount"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="8"><FluentTextInput style="width: 100%;" @bind-Value="effectDraft.EffectSpecial" Label='@L["Fields.EffectSpecial"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="effectDraft.Update" Label='@L["Fields.Update"]' /></FluentGridItem>
                        </FluentGrid>
                    }
                </section>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveItem"]</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <FluentMessageBar Title="@message" Intent="MessageBarIntent.Info" />
                    }
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <FluentMessageBar Title="@errorMessage" Intent="MessageBarIntent.Error" />
                    }
                    <EditorSaveFailure Exception="@saveException" Context="Item editor save" />
                </FluentStack>
            </FluentStack>
        </EditForm>
    }
</FluentStack>

@code {
    [Parameter] public string ItemId { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private bool IsCreate => ItemId.Equals("new", StringComparison.OrdinalIgnoreCase);
    private string RecoveryKey => $"item:{ItemId}";
    private Item? currentItem;
    private string itemIdInput = string.Empty;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private Exception? saveException;
    private bool isBusy;
    private IngameItemEffect? effectDraft;
    private ItemDataFields? itemDataFields;

    private string[] EffectTypeOptions
    {
        get
        {
            var options = new[]
            {
                $" — {L["Options.EffectTypeNone"].Value}",
                $"E — {L["Options.EffectTypeExpPlus"].Value}",
                $"P — {L["Options.EffectTypeMaxPointPlus"].Value}",
                $"R — {L["Options.EffectTypeRecover"].Value}",
                $"H — {L["Options.EffectTypeHpPlus"].Value}",
                $"O — {L["Options.EffectTypeAntiGameOver"].Value}",
                $"C — {L["Options.EffectTypeAntiEffector"].Value}",
                $"A — {L["Options.EffectTypeBreakShield"].Value}",
                $"F — {L["Options.EffectTypeFeverPlus"].Value}",
                $"G — {L["Options.EffectTypeGaugeRefill"].Value}",
                $"lucky — {L["Options.EffectTypeLuckyPlus"].Value}",
                $"maxpoint — {L["Options.EffectTypeMaxPointPlus"].Value}",
                $"qpoint — {L["Options.ItemTypeQPoint"].Value}"
            };

            return string.IsNullOrWhiteSpace(effectDraft?.EffectType)
                   || options.Any(option => option.StartsWith(effectDraft.EffectType + " — ", StringComparison.OrdinalIgnoreCase))
                ? options
                : [.. options, $"{effectDraft.EffectType} — {L["Fields.ExistingValue"].Value}"];
        }
    }

    private string GetSelectedEffectType()
        => string.IsNullOrWhiteSpace(effectDraft?.EffectType)
            ? EffectTypeOptions[0]
            : EffectTypeOptions.FirstOrDefault(option => option.StartsWith(effectDraft.EffectType + " — ", StringComparison.OrdinalIgnoreCase))
              ?? $"{effectDraft.EffectType} — {L["Fields.ExistingValue"].Value}";

    private void SetEffectType(string value)
    {
        if (effectDraft is not null)
            effectDraft.EffectType = GetOptionValue(value);
    }

    private static string GetOptionValue(string option)
    {
        var separatorIndex = option.LastIndexOf(" — ", StringComparison.Ordinal);
        return separatorIndex < 0 ? option : option[..separatorIndex];
    }

    private IReadOnlyList<Item> Catalog =>
        State.CurrentPackage is null ? [] : ItemCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);

    protected override void OnParametersSet()
    {
        if (DraftStore.TryGet<ItemDraft>(RecoveryKey, out var recovered) && recovered is not null)
        {
            currentItem = recovered.Item;
            itemIdInput = recovered.ItemIdInput;
            effectDraft = recovered.EffectDraft;
            return;
        }

        if (IsCreate)
        {
            currentItem ??= new Item { Id = string.Empty };
            effectDraft = null;
            return;
        }

        var source = Catalog.FirstOrDefault(item =>
            item.Id.Equals(ItemId, StringComparison.OrdinalIgnoreCase));
        currentItem = source is null ? null : ItemEditSvc.CreateDraft(source);
        effectDraft = source is null || State.CurrentPackage is null
            ? null
            : ItemEditSvc.CreateEffectDraft(State.CurrentPackage, source.Id, State.SelectedExportPlatform);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (currentItem is not null)
            DraftStore.Set(RecoveryKey, new ItemDraft(currentItem, itemIdInput, effectDraft));
    }

    private void NavigateBack()
    {
        DraftStore.Remove(RecoveryKey);
        Navigation.NavigateTo(TableNavigationState.ResolveReturnUrl(Navigation, ReturnUrl, "/items"));
    }

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null || currentItem is null) return;

        isBusy = true;
        message = string.Empty;
        errorMessage = string.Empty;
        saveException = null;

        try
        {
            if (itemDataFields?.IsSyncOriginalText == true)
                itemDataFields.SyncLocalizedFields();

            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(itemIdInput))
                {
                    errorMessage = L["Editor.ItemIdRequired"].Value;
                    return;
                }

                var item = ItemEditSvc.CreateDraft(currentItem, itemIdInput.Trim());
                ItemEditSvc.AddItem(State.CurrentPackage, item, State.SelectedExportPlatform);
                var wasDirty = State.IsDirty;
                try
                {
                    ItemEditSvc.ApplyEffectDraft(State.CurrentPackage, item.Id, effectDraft, State.SelectedExportPlatform);
                    State.IsDirty = true;
                    await Workflow.SaveProjectAsync();
                }
                catch
                {
                    ItemEditSvc.RemoveItem(State.CurrentPackage, item.Id, State.SelectedExportPlatform);
                    State.IsDirty = wasDirty;
                    throw;
                }
                State.Diagnostics.Add($"Item added: {item.Id}");
                NavigateBack();
            }
            else
            {
                ItemEditSvc.UpdateItem(State.CurrentPackage, currentItem, State.SelectedExportPlatform);
                ItemEditSvc.ApplyEffectDraft(State.CurrentPackage, currentItem.Id, effectDraft, State.SelectedExportPlatform);
                State.IsDirty = true;
                await Workflow.SaveProjectAsync();
                State.Diagnostics.Add($"Item edited: {currentItem.Id}");
                NavigateBack();
            }
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void AddEffect()
        => effectDraft = new IngameItemEffect
        {
            Id = currentItem?.Id ?? itemIdInput
        };

    private void RemoveEffect() => effectDraft = null;

    private sealed record ItemDraft(Item Item, string ItemIdInput, IngameItemEffect? EffectDraft);
}
