@page "/items/editor/{ItemId}"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ItemEditService ItemEditSvc
@inject ItemCatalogService ItemCatalog

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch">
    <FluentBreadcrumb>
        <FluentBreadcrumbItem Href="/items">@L["Nav.Items"]</FluentBreadcrumbItem>
        <FluentBreadcrumbItem>@(IsCreate ? L["Editor.NewItem"] : L["Editor.Edit", currentItem?.Id ?? string.Empty])</FluentBreadcrumbItem>
    </FluentBreadcrumb>

    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenProjectFirst"]' Intent="MessageIntent.Warning" />
    }
    else if (currentItem is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Items"].Value, ItemId]' Intent="MessageIntent.Error" />
        <FluentButton Appearance="Appearance.Neutral" OnClick="NavigateBack">@L["Editor.BackTo", L["Nav.Items"].Value]</FluentButton>
    }
    else
    {
        <EditForm Model="@currentItem" OnValidSubmit="SaveAsync" FormName="item-editor">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="24" HorizontalAlignment="HorizontalAlignment.Stretch">
                <ItemDataFields Content="@(currentItem!)"
                                ShowItemId="true"
                                ItemId="@(IsCreate ? itemIdInput : currentItem!.Id)"
                                ItemIdChanged="@(value => itemIdInput = value)"
                                IsItemIdReadOnly="@(!IsCreate)"
                                IsItemIdRequired="@IsCreate" />

                <section>
                    <div class="section-title-row">
                        <div>
                            <h2 class="section-heading">@L["Editor.ItemEffect"]</h2>
                            <p class="section-hint">@L["Editor.ItemEffectHint"]</p>
                        </div>
                        @if (effectDraft is null)
                        {
                            <FluentButton Appearance="Appearance.Neutral" OnClick="AddEffect"
                                          IconStart="@(new Icons.Regular.Size20.Add())">@L["Editor.AddEffect"]</FluentButton>
                        }
                        else
                        {
                            <FluentButton Appearance="Appearance.Neutral" OnClick="RemoveEffect"
                                          IconStart="@(new Icons.Regular.Size20.Delete())">@L["Editor.RemoveEffect"]</FluentButton>
                        }
                    </div>
                    @if (effectDraft is null)
                    {
                        <FluentMessageBar Title='@L["Editor.NoItemEffect"]' Intent="MessageIntent.Info" />
                    }
                    else
                    {
                        <FluentGrid Spacing="3">
                            <FluentGridItem xs="12" md="4"><FluentTextField style="width: 100%;" @bind-Value="effectDraft.EffectType" Label='@L["Fields.EffectType"]' /></FluentGridItem>
                            <FluentGridItem xs="12" md="4"><FluentTextField style="width: 100%;" @bind-Value="effectDraft.EffectPoint" Label='@L["Fields.EffectPoint"]' /></FluentGridItem>
                            <FluentGridItem xs="12" md="4"><FluentTextField style="width: 100%;" @bind-Value="effectDraft.EffectCount" Label='@L["Fields.EffectCount"]' /></FluentGridItem>
                            <FluentGridItem xs="12" md="8"><FluentTextField style="width: 100%;" @bind-Value="effectDraft.EffectSpecial" Label='@L["Fields.EffectSpecial"]' /></FluentGridItem>
                            <FluentGridItem xs="12" md="4"><FluentTextField style="width: 100%;" @bind-Value="effectDraft.Update" Label='@L["Fields.Update"]' /></FluentGridItem>
                        </FluentGrid>
                    }
                </section>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveItem"]</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <FluentMessageBar Title="@message" Intent="MessageIntent.Info" />
                    }
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <FluentMessageBar Title="@errorMessage" Intent="MessageIntent.Error" />
                    }
                </FluentStack>
            </FluentStack>
        </EditForm>
    }
</FluentStack>

@code {
    [Parameter] public string ItemId { get; set; } = default!;

    private bool IsCreate => ItemId.Equals("new", StringComparison.OrdinalIgnoreCase);
    private Item? currentItem;
    private string itemIdInput = string.Empty;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private bool isBusy;
    private IngameItemEffect? effectDraft;

    private IReadOnlyList<Item> Catalog =>
        State.CurrentPackage is null ? [] : ItemCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);

    protected override void OnParametersSet()
    {
        if (IsCreate)
        {
            currentItem ??= new Item { Id = string.Empty };
            effectDraft = null;
            return;
        }

        var source = Catalog.FirstOrDefault(item =>
            item.Id.Equals(ItemId, StringComparison.OrdinalIgnoreCase));
        currentItem = source is null ? null : ItemEditSvc.CreateDraft(source);
        effectDraft = source is null || State.CurrentPackage is null
            ? null
            : ItemEditSvc.CreateEffectDraft(State.CurrentPackage, source.Id, State.SelectedExportPlatform);
    }

    private void NavigateBack() => Navigation.NavigateTo("/items");

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null || currentItem is null) return;

        isBusy = true;
        message = string.Empty;
        errorMessage = string.Empty;

        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(itemIdInput))
                {
                    errorMessage = L["Editor.ItemIdRequired"].Value;
                    return;
                }

                var item = ItemEditSvc.CreateDraft(currentItem, itemIdInput.Trim());
                ItemEditSvc.AddItem(State.CurrentPackage, item, State.SelectedExportPlatform);
                ItemEditSvc.ApplyEffectDraft(State.CurrentPackage, item.Id, effectDraft, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                State.Diagnostics.Add($"Item added: {item.Id}");
                Navigation.NavigateTo($"/items/editor/{Uri.EscapeDataString(item.Id)}");
            }
            else
            {
                ItemEditSvc.UpdateItem(State.CurrentPackage, currentItem, State.SelectedExportPlatform);
                ItemEditSvc.ApplyEffectDraft(State.CurrentPackage, currentItem.Id, effectDraft, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                State.Diagnostics.Add($"Item edited: {currentItem.Id}");
                message = L["Editor.Saved", L["Nav.Items"].Value].Value;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Item save error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void AddEffect()
        => effectDraft = new IngameItemEffect
        {
            Id = currentItem?.Id ?? itemIdInput
        };

    private void RemoveEffect() => effectDraft = null;
}
