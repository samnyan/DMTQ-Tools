@page "/slang"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject SlangEditService EditService
@inject IDialogService DialogService

<ProjectListShell TItem="SlangEntry" Title='@L["Nav.Slang"]' ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoSlang"]' FilteredItems="@FilteredItems" Pagination="@pagination"
                  Message="@message" ErrorMessage="@errorMessage">
    <Toolbar><div class="list-toolbar-layout">
        <div class="list-toolbar-filters">
            <ToolbarField Unlabeled Search>
                <FluentTextInput Value="@filter" ValueChanged="SetFilterAsync" Immediate="true" Placeholder='@L["Lists.FilterSlang"]' class="list-filter" />
            </ToolbarField>
        </div>
        <div class="list-toolbar-actions">
            <ToolbarField Unlabeled>
                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="CreateNew">@L["Lists.AddSlang"]</FluentButton>
            </ToolbarField>
        </div>
    </div></Toolbar>
    <Metrics><FluentGrid class="metric-grid" Spacing="3"><FluentGridItem Xs="12" Sm="6" Md="3"><FluentCard><span class="metric-label">@L["Lists.SlangEntries"]</span><strong>@Catalog.Count</strong></FluentCard></FluentGridItem></FluentGrid></Metrics>
    <Columns>
        <PropertyColumn TGridItem="SlangEntry" TProp="string" Property="@(entry => entry.Value)" Title='@L["Fields.SlangValue"]' Sortable="true" />
        <TemplateColumn TGridItem="SlangEntry" Title='@L["Lists.Actions"]' Context="entry"><FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" Size="ButtonSize.Small" OnClick="() => Edit(entry.Id)" Title='@L["Common.Edit"]'>
                    @L["Common.Edit"]
                </FluentButton>
            <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())" Size="ButtonSize.Small" OnClick="() => DeleteAsync(entry)" Title='@L["Common.Delete"]' />
        </FluentStack></TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    private string filter => SearchQuery ?? string.Empty;
    private string? message;
    private string? errorMessage;
    private IReadOnlyList<SlangEntry> Catalog => State.CurrentPackage is null ? [] : EditService.BuildCatalog(State.CurrentPackage);
    private IEnumerable<SlangEntry> FilteredItems => string.IsNullOrWhiteSpace(filter) ? Catalog : Catalog.Where(entry => entry.Value.Contains(filter, StringComparison.OrdinalIgnoreCase));
    private Task SetFilterAsync(string? value)
    {
        SearchQuery = value;
        TableNavigationState.UpdateQuery(Navigation, ("q", value), ("page", "1"));
        return Task.CompletedTask;
    }

    private void CreateNew() => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, "/slang/editor/new"));
    private void Edit(string id) => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, $"/slang/editor/{Uri.EscapeDataString(id)}"));
    private async Task DeleteAsync(SlangEntry entry)
    {
        if (State.CurrentPackage is null) return;
        var result = await DialogService.ShowConfirmationAsync(message: L["Lists.DeleteConfirm", L["Nav.Slang"].Value, entry.Value].Value,
            title: L["Nav.Slang"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;
        try { EditService.Remove(State.CurrentPackage, entry.Id); await Workflow.SaveProjectAsync(); message = L["Lists.Deleted", L["Nav.Slang"].Value, entry.Value].Value; }
        catch (Exception ex) { errorMessage = ex.Message; }
    }
}
