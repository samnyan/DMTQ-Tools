@page "/quests/editor/{QuestId}"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject QuestCatalogService CatalogService
@inject QuestEditService EditService
@inject EditorDraftStore DraftStore

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch">
    @if (State.CurrentPackage is null) { <FluentMessageBar Title='@L["Editor.OpenProjectFirst"]' Intent="MessageBarIntent.Warning" /> }
    else if (draft is null && !IsCreate) { <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Quests"].Value, QuestId]' Intent="MessageBarIntent.Error" /> }
    else
    {
        <EditForm Model="@draft" OnValidSubmit="SaveAsync" FormName="quest-editor" class="editor-form">
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" class="editor-form-sections">
                <section>
                    <h2 class="section-heading">@L["Editor.QuestDescriptions"]</h2>
                    @if (IsCreate) { <FluentTextInput @bind-Value="idInput" Label='@L["Fields.QuestId"]' Required /> }
                    else { <FluentTextInput Value="@draft!.Id" Label='@L["Fields.QuestId"]' ReadOnly="true" /> }
                    @foreach (var language in Languages)
                    {
                        <div class="language-panel"><h3 class="lang-heading">@language</h3><FluentGrid Spacing="1">
                            <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" Value="@draft!.NamesByLanguage[language]" ValueChanged="@(value => draft!.NamesByLanguage[language] = value)" Label='@L["Fields.Name"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="8"><FluentTextArea style="width:100%" Value="@draft!.DescriptionsByLanguage[language]" ValueChanged="@(value => draft!.DescriptionsByLanguage[language] = value)" Label='@L["Fields.Description"]' Height="100px" Resize="TextAreaResize.Vertical" /></FluentGridItem>
                        </FluentGrid></div>
                    }
                </section>
                <section>
                    <div class="section-title-row"><div><h2 class="section-heading">@L["Editor.Missions"]</h2><p class="section-hint">@L["Editor.MissionsHint"]</p></div>
                        <FluentButton Appearance="ButtonAppearance.Default" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="AddMission">@L["Editor.AddMission"]</FluentButton></div>
                    @if (draft!.Missions.Count == 0) { <FluentMessageBar Title='@L["Editor.NoMissions"]' Intent="MessageBarIntent.Info" /> }
                    @for (var index = 0; index < draft.Missions.Count; index++)
                    {
                        var mission = draft.Missions[index];
                        <div class="mission-card" @key="mission">
                            <div class="section-title-row"><strong>@L["Editor.MissionNumber", index + 1]</strong><FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                                <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(index == 0)" OnClick="() => MoveMission(mission, -1)" IconStart="@(new Icons.Regular.Size20.ArrowUp())" Title='@L["Common.MoveUp"]' />
                                <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(index == draft.Missions.Count - 1)" OnClick="() => MoveMission(mission, 1)" IconStart="@(new Icons.Regular.Size20.ArrowDown())" Title='@L["Common.MoveDown"]' />
                                <FluentButton Appearance="ButtonAppearance.Default" OnClick="() => RemoveMission(mission)" IconStart="@(new Icons.Regular.Size20.Delete())" Title='@L["Common.Delete"]' />
                            </FluentStack></div>
                            <div class="mission-language-grid">
                                @foreach (var language in Languages)
                                {
                                    <FluentTextArea Value="@mission.DescriptionsByLanguage[language]" ValueChanged="@(value => mission.DescriptionsByLanguage[language] = value)" Label="@language" Height="100px" Resize="TextAreaResize.Vertical" />
                                }
                            </div>
                        </div>
                    }
                </section>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                    <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveQuest"]</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                    @if (!string.IsNullOrWhiteSpace(message)) { <FluentMessageBar Title="@message" Intent="MessageBarIntent.Info" /> }
                    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <FluentMessageBar Title="@errorMessage" Intent="MessageBarIntent.Error" /> }
                    <EditorSaveFailure Exception="@saveException" Context="Quest editor save" />
                </FluentStack>
            </FluentStack>
        </EditForm>
    }
</FluentStack>

@code {
    [Parameter] public string QuestId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private static readonly string[] Languages = ["CN", "JP", "KR", "TW", "US"];
    private bool IsCreate => QuestId.Equals("new", StringComparison.OrdinalIgnoreCase);
    private string RecoveryKey => $"quest:{QuestId}";
    private Quest? draft;
    private string idInput = string.Empty;
    private string? message;
    private string? errorMessage;
    private Exception? saveException;
    private bool isBusy;

    protected override void OnParametersSet()
    {
        if (DraftStore.TryGet<QuestDraft>(RecoveryKey, out var recovered) && recovered is not null)
        {
            draft = recovered.Draft;
            idInput = recovered.IdInput;
            EnsureLanguages(draft);
            return;
        }

        if (IsCreate) draft ??= new Quest { Id = string.Empty };
        else if (State.CurrentPackage is not null)
        {
            var source = CatalogService.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform).FirstOrDefault(q => q.Id.Equals(QuestId, StringComparison.OrdinalIgnoreCase));
            draft = source is null ? null : EditService.CreateDraft(source);
        }
        if (draft is not null) EnsureLanguages(draft);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (draft is not null)
            DraftStore.Set(RecoveryKey, new QuestDraft(draft, idInput));
    }

    private static void EnsureLanguages(Quest quest)
    {
        foreach (var language in Languages) { quest.NamesByLanguage.TryAdd(language, string.Empty); quest.DescriptionsByLanguage.TryAdd(language, string.Empty); }
        foreach (var mission in quest.Missions) foreach (var language in Languages) mission.DescriptionsByLanguage.TryAdd(language, string.Empty);
    }

    private void AddMission() { if (draft is null) return; EditService.AddMission(draft); EnsureLanguages(draft); }
    private void RemoveMission(QuestMission mission) { if (draft is not null) EditService.RemoveMission(draft, mission); }
    private void MoveMission(QuestMission mission, int offset) { if (draft is not null) EditService.MoveMission(draft, mission, offset); }
    private void NavigateBack()
    {
        DraftStore.Remove(RecoveryKey);
        Navigation.NavigateTo(TableNavigationState.ResolveReturnUrl(Navigation, ReturnUrl, "/quests"));
    }
    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null || draft is null) return;
        isBusy = true; message = null; errorMessage = null; saveException = null;
        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(idInput)) { errorMessage = L["Editor.QuestIdRequired"].Value; return; }
                var created = EditService.CreateDraft(draft, idInput.Trim());
                EditService.AddQuest(State.CurrentPackage, created, State.SelectedExportPlatform);
                var wasDirty = State.IsDirty;
                State.IsDirty = true;
                try { await Workflow.SaveProjectAsync(); }
                catch
                {
                    EditService.RemoveQuest(State.CurrentPackage, created.Id, State.SelectedExportPlatform);
                    State.IsDirty = wasDirty;
                    throw;
                }
                NavigateBack();
            }
            else
            {
                EditService.UpdateQuest(State.CurrentPackage, draft, State.SelectedExportPlatform);
                State.IsDirty = true;
                await Workflow.SaveProjectAsync();
                NavigateBack();
            }
        }
        catch (Exception ex) { saveException = ex; }
        finally { isBusy = false; }
    }

    private sealed record QuestDraft(Quest Draft, string IdInput);
}
