@page "/achievements"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject AchievementCatalogService CatalogService
@inject AchievementEditService EditService
@inject IDialogService DialogService

<ProjectListShell TItem="Achievement"
                  Title='@L["Nav.Achievements"]'
                  ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoAchievements"]'
                  FilteredItems="@FilteredItems"
                  Pagination="@pagination"
                  Message="@message"
                  ErrorMessage="@errorMessage">
    <Toolbar>
        <div class="list-toolbar-layout">
            <div class="list-toolbar-filters">
                <ToolbarField Unlabeled Search>
                    <FluentTextInput Value="@filter" ValueChanged="SetFilterAsync" Immediate="true" Placeholder='@L["Lists.FilterAchievements"]' class="list-filter" />
                </ToolbarField>
            </div>
            <div class="list-toolbar-actions">
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="CreateNew">@L["Lists.AddAchievement"]</FluentButton>
                </ToolbarField>
            </div>
        </div>
    </Toolbar>
    <Metrics>
        <FluentGrid class="metric-grid" Spacing="3"><FluentGridItem Xs="12" Sm="6" Md="3"><FluentCard><span class="metric-label">@L["Nav.Achievements"]</span><strong>@Catalog.Count</strong></FluentCard></FluentGridItem></FluentGrid>
    </Metrics>
    <Columns>
        <PropertyColumn TGridItem="Achievement" TProp="string" Property="@(item => item.Id)" Title='@L["Fields.AchievementId"]' Sortable="true" Width="6rem" MinWidth="6rem" />
        <TemplateColumn TGridItem="Achievement" Title='@L["Fields.Name"]' Width="2.5fr" MinWidth="20rem" Context="item">@CatalogService.GetDisplayName(item, PreviewLanguage)</TemplateColumn>
        <PropertyColumn TGridItem="Achievement" TProp="string" Property="@(item => item.ConditionType)" Title='@L["Fields.ConditionType"]' Sortable="true" Width="1fr" MinWidth="14rem" />
        <PropertyColumn TGridItem="Achievement" TProp="string" Property="@(item => item.AchievementTier)" Title='@L["Fields.Tier"]' Width="7.75rem" MinWidth="7.75rem" />
        <PropertyColumn TGridItem="Achievement" TProp="string" Property="@(item => item.ObtainPoint)" Title='@L["Fields.ObtainPoint"]' Width="7rem" MinWidth="7rem" />
        <TemplateColumn TGridItem="Achievement" Title='@L["Lists.Actions"]' Width="16.5rem" MinWidth="16.5rem" Context="item">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" Appearance="ButtonAppearance.Default" OnClick="() => Edit(item.Id)" Title='@L["Common.Edit"]' />
                <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())" Appearance="ButtonAppearance.Default" OnClick="() => DeleteAsync(item)" Title='@L["Common.Delete"]' />
            </FluentStack>
        </TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    private const string PreviewLanguage = "CN";
    private readonly PaginationState pagination = new() { ItemsPerPage = 25 };
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    private string filter => SearchQuery ?? string.Empty;
    private string? message;
    private string? errorMessage;

    private IReadOnlyList<Achievement> Catalog => State.CurrentPackage is null
        ? []
        : CatalogService.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);

    private IEnumerable<Achievement> FilteredItems => string.IsNullOrWhiteSpace(filter)
        ? Catalog
        : Catalog.Where(item => item.Id.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || CatalogService.GetDisplayName(item, PreviewLanguage).Contains(filter, StringComparison.OrdinalIgnoreCase)
            || item.ConditionType.Contains(filter, StringComparison.OrdinalIgnoreCase));

    private Task SetFilterAsync(string? value)
    {
        SearchQuery = value;
        TableNavigationState.UpdateQuery(Navigation, ("q", value), ("page", "1"));
        return Task.CompletedTask;
    }

    private void CreateNew() => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, "/achievements/editor/new"));
    private void Edit(string id) => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, $"/achievements/editor/{Uri.EscapeDataString(id)}"));

    private async Task DeleteAsync(Achievement item)
    {
        if (State.CurrentPackage is null) return;
        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", L["Nav.Achievements"].Value, item.Id].Value,
            title: L["Nav.Achievements"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;
        try
        {
            EditService.RemoveAchievement(State.CurrentPackage, item.Id, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            message = L["Lists.Deleted", L["Nav.Achievements"].Value, item.Id].Value;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }
}
