@page "/achievements/editor/{AchievementId}"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject AchievementCatalogService CatalogService
@inject AchievementEditService EditService

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch">
    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenProjectFirst"]' Intent="MessageBarIntent.Warning" />
    }
    else if (draft is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Achievements"].Value, AchievementId]' Intent="MessageBarIntent.Error" />
    }
    else
    {
        <EditForm Model="@draft" OnValidSubmit="SaveAsync" FormName="achievement-editor" class="editor-form">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Stretch" class="editor-form-sections">
                <section>
                    <h2 class="section-heading">@L["Editor.AchievementRules"]</h2>
                    <FluentGrid Spacing="2">
                        <FluentGridItem Xs="12" Md="4">@if (IsCreate) { <FluentTextInput style="width:100%" @bind-Value="idInput" Label='@L["Fields.AchievementId"]' Required /> } else { <FluentTextInput style="width:100%" Value="@draft!.Id" Label='@L["Fields.AchievementId"]' ReadOnly="true" /> }</FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.ConditionType" Label='@L["Fields.ConditionType"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.ConditionValue" Label='@L["Fields.ConditionValue"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.ConditionCount" Label='@L["Fields.ConditionCount"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="8"><FluentTextInput style="width:100%" @bind-Value="draft!.ConditionSpecial" Label='@L["Fields.ConditionSpecial"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.ImgUrl" Label='@L["Fields.ImageUrl"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.AchievementTier" Label='@L["Fields.Tier"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.ObtainPoint" Label='@L["Fields.ObtainPoint"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.Name" Label='@L["Fields.BaseName"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.PreDescription" Label='@L["Fields.PreDescription"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.AfterDescription" Label='@L["Fields.AfterDescription"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.Update" Label='@L["Fields.Update"]' /></FluentGridItem>
                    </FluentGrid>
                </section>
                <section>
                    <h2 class="section-heading">@L["Editor.LocalizedDescriptions"]</h2>
                    <p class="section-hint">@L["Editor.AchievementDescriptionsHint"]</p>
                    @foreach (var language in Languages)
                    {
                        <div class="language-panel">
                            <h3 class="lang-heading">@language</h3>
                            <FluentGrid Spacing="2">
                                <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.NamesByLanguage[language]" Label='@L["Fields.Name"]' /></FluentGridItem>
                                <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.PreDescriptionsByLanguage[language]" Label='@L["Fields.PreDescription"]' /></FluentGridItem>
                                <FluentGridItem Xs="12" Md="4"><FluentTextInput style="width:100%" @bind-Value="draft!.AfterDescriptionsByLanguage[language]" Label='@L["Fields.AfterDescription"]' /></FluentGridItem>
                            </FluentGrid>
                        </div>
                    }
                </section>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                    <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveAchievement"]</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                    @if (!string.IsNullOrWhiteSpace(message)) { <FluentMessageBar Title="@message" Intent="MessageBarIntent.Info" /> }
                    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <FluentMessageBar Title="@errorMessage" Intent="MessageBarIntent.Error" /> }
                </FluentStack>
            </FluentStack>
        </EditForm>
    }
</FluentStack>

@code {
    [Parameter] public string AchievementId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private static readonly string[] Languages = ["CN", "JP", "KR", "TW", "US"];
    private bool IsCreate => AchievementId.Equals("new", StringComparison.OrdinalIgnoreCase);
    private Achievement? draft;
    private string idInput = string.Empty;
    private string? message;
    private string? errorMessage;
    private bool isBusy;

    protected override void OnParametersSet()
    {
        if (IsCreate) draft ??= new Achievement { Id = string.Empty };
        else if (State.CurrentPackage is not null)
        {
            var source = CatalogService.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform)
                .FirstOrDefault(item => item.Id.Equals(AchievementId, StringComparison.OrdinalIgnoreCase));
            draft = source is null ? null : EditService.CreateDraft(source);
        }
        if (draft is not null) EnsureLanguages(draft);
    }

    private static void EnsureLanguages(Achievement achievement)
    {
        foreach (var language in Languages)
        {
            achievement.NamesByLanguage.TryAdd(language, string.Empty);
            achievement.PreDescriptionsByLanguage.TryAdd(language, string.Empty);
            achievement.AfterDescriptionsByLanguage.TryAdd(language, string.Empty);
        }
    }

    private void NavigateBack() => Navigation.NavigateTo(TableNavigationState.ResolveReturnUrl(Navigation, ReturnUrl, "/achievements"));

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null || draft is null) return;
        isBusy = true; message = null; errorMessage = null;
        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(idInput)) { errorMessage = L["Editor.AchievementIdRequired"].Value; return; }
                var created = EditService.CreateDraft(draft, idInput.Trim());
                EditService.AddAchievement(State.CurrentPackage, created, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                NavigateBack();
            }
            else
            {
                EditService.UpdateAchievement(State.CurrentPackage, draft, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                NavigateBack();
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isBusy = false; }
    }
}
