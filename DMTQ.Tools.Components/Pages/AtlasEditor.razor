@page "/atlas-editor"
@using System.Globalization
@using Assets.Lib.Models
@using Assets.Lib.Services
@using AssetsTools.NET.Texture
@using DMTQ.Tools.Core.Services
@using Microsoft.JSInterop
@using StbImageSharp
@inject SpriteAtlasBundleService BundleService
@inject IProjectFilePicker FilePicker
@inject IProjectFileSaver FileSaver
@inject IAtlasDummyTemplateProvider TemplateProvider
@inject IDialogService DialogService
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject EyecatchIndexService EyecatchIndexService
@inject EyecatchBundleBuildService EyecatchBundleBuildService
@inject NavigationManager Navigation
@inject INotificationService NotificationService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="atlas-editor-page">
    <header class="atlas-editor-heading">
        <div><h1>@L["AtlasEditor.Title"]</h1><p>@L["AtlasEditor.Subtitle"]</p></div>
        @if (_document is not null)
        {
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CloseAtlasAsync" Disabled="@_isBusy">@L["AtlasEditor.CloseAtlas"]</FluentButton>
        }
    </header>
    @if (_document is null && !_isConfiguringNew)
    {
        <section class="atlas-entry panel-surface">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="BeginNewAtlas">@L["AtlasEditor.New"]</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="OpenBundleAsync" Disabled="@_isBusy">@L["AtlasEditor.OpenBundle"]</FluentButton>
        </section>
    }
    @if (_isConfiguringNew)
    {
        <section class="atlas-settings panel-surface">
            <FluentSelect TOption="string" TValue="string" Items="@AtlasKinds" OptionText="AtlasKindLabel" OptionValue="@(kind => kind)"
                          @bind-Value="_kindValue" @bind-Value:after="UpdateNewAtlasKind" Label='@L["AtlasEditor.Kind"]' />
            <FluentTextInput Label='@L["AtlasEditor.Width"]' TextInputType="TextInputType.Number" ControlStyle="width:100%" @bind-Value="_atlasWidthText" />
            <FluentTextInput Label='@L["AtlasEditor.Height"]' TextInputType="TextInputType.Number" ControlStyle="width:100%" @bind-Value="_atlasHeightText" />
            <FluentTextInput Label='@L["AtlasEditor.AtlasName"]' @bind-Value="_atlasName" />
            <div class="atlas-entry-actions">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateNewAtlas">@L["AtlasEditor.Create"]</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="CancelNewAtlas">@L["Common.Cancel"]</FluentButton>
            </div>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <FluentMessageBar Intent="@_statusIntent">@_status</FluentMessageBar>
    }
    @if (_document is not null && _previewPng.Length > 0)
    {
        <section class="atlas-info panel-surface">
            <div><span>@L["AtlasEditor.AtlasName"]</span><strong>@_document.AtlasName</strong></div>
            <div><span>@L["AtlasEditor.Kind"]</span><strong>@AtlasKindLabel(_document.Kind.ToString())</strong></div>
            <div><span>@L["AtlasEditor.Size"]</span><strong>@_document.TextureWidth × @_document.TextureHeight</strong></div>
            <div><span>@L["AtlasEditor.Sprites"]</span><strong>@_sprites.Count</strong></div>
        </section>
        @if (_projectContext is not null)
        {
            <section class="atlas-variant-switch panel-surface">
                <strong>@L["AtlasEditor.Variant"]</strong>
                <div class="atlas-variant-buttons">
                    @foreach (var variant in _projectVariantChoices.Where(choice => choice.Kind == SpriteAtlasKind.NGUI3))
                    {
                        var selected = variant.Kind == _document.Kind
                            && variant.Platform.Equals(_projectContext.Platform, StringComparison.OrdinalIgnoreCase);
                        <FluentButton Size="ButtonSize.Small"
                                      Appearance="@(selected ? ButtonAppearance.Primary : ButtonAppearance.Default)"
                                      OnClick="@(() => SwitchProjectVariantAsync(variant))"
                                      Disabled="@(_isBusy || !variant.Exists || selected)">
                            @KindShortLabel(variant.Kind) · @PlatformLabel(variant.Platform)
                        </FluentButton>
                    }
                </div>
                @if (_projectVariantChoices.Any(choice => choice.Kind == SpriteAtlasKind.NGUI2))
                {
                    <details class="atlas-legacy-variants">
                        <summary>@L["AtlasEditor.NGUI2Compatibility"]</summary>
                        <div class="atlas-variant-buttons">
                            @foreach (var variant in _projectVariantChoices.Where(choice => choice.Kind == SpriteAtlasKind.NGUI2))
                            {
                                var selected = variant.Kind == _document.Kind
                                    && variant.Platform.Equals(_projectContext.Platform, StringComparison.OrdinalIgnoreCase);
                                <FluentButton Size="ButtonSize.Small"
                                              Appearance="@(selected ? ButtonAppearance.Primary : ButtonAppearance.Default)"
                                              OnClick="@(() => SwitchProjectVariantAsync(variant))"
                                              Disabled="@(_isBusy || !variant.Exists || selected)">
                                    @KindShortLabel(variant.Kind) · @PlatformLabel(variant.Platform)
                                </FluentButton>
                            }
                        </div>
                    </details>
                }
                <div class="atlas-family-check">
                    <div>
                        <span>@L["AtlasEditor.ContentConsistency"]</span>
                        <strong class="@(_familyContentMismatch ? "is-warning" : null)">@FamilyContentStatus</strong>
                    </div>
                    <div>
                        <span>@L["AtlasEditor.LayoutConsistency"]</span>
                        <strong class="@(_familyLayoutMismatch ? "is-warning" : null)">@FamilyLayoutStatus</strong>
                    </div>
                    <FluentButton Size="ButtonSize.Small" Appearance="ButtonAppearance.Default"
                                  OnClick="CheckAtlasesAsync" Disabled="@(_isBusy || State.CurrentPackage is null)">
                        @if (_checkingFamily) { <FluentSpinner /> }
                        @L["AtlasEditor.CheckFourAtlases"]
                    </FluentButton>
                </div>
            </section>
        }
        <div class="atlas-workspace">
            <section class="atlas-preview-column panel-surface">
                <div class="atlas-section-heading">
                    <div><h2>@L["AtlasEditor.Preview"]</h2><span>@_document.TextureWidth × @_document.TextureHeight · @L["AtlasEditor.SpriteCount", _sprites.Count]</span></div>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="ExportAtlasPngAsync" Disabled="@_isBusy">@L["AtlasEditor.ExportTexture"]</FluentButton>
                </div>
                <div class="atlas-canvas-scroll">
                    <canvas id="@_previewCanvasId" class="atlas-canvas" aria-label='@L["AtlasEditor.Preview"]' role="img"></canvas>
                </div>
            </section>
            <section class="atlas-sprite-column">
                <div class="atlas-section-heading sprite-list-heading">
                    <div><h2>@L["AtlasEditor.Sprites"]</h2><span>@L["AtlasEditor.SpriteCount", _sprites.Count]</span></div>
                    <span class="atlas-coordinate-origin">@L["AtlasEditor.CoordinateOrigin"]</span>
                </div>
                @for (var index = 0; index < _sprites.Count; index++)
                {
                    var spriteIndex = index;
                    var image = _sprites[spriteIndex];
                    var region = _document.Sprites[spriteIndex];
                    <article class="atlas-sprite-row @(spriteIndex == _selectedSpriteIndex ? "is-selected" : null)"
                             @onclick="() => SelectSprite(spriteIndex)">
                        @if (image.HasImage)
                        {
                            <img class="sprite-thumb" src="@image.PreviewDataUrl" alt="" />
                        }
                        else
                        {
                            <div class="sprite-thumb sprite-placeholder">@L["AtlasEditor.EmptySprite"]</div>
                        }
                        <div class="sprite-row-content">
                            <FluentTextInput Class="sprite-name" AriaLabel='@L["AtlasEditor.Name"]' @bind-Value="image.Name"
                                             @bind-Value:after="() => RenameSprite(spriteIndex)" />
                            <div class="sprite-region-fields" aria-label='@L["AtlasEditor.Region"]'>
                                <label>X<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="X" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].X" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.X))" /></label>
                                <label>Y<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="Y" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].Y" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.Y))" /></label>
                                <label>W<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="W" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].Width" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.Width))" /></label>
                                <label>H<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="H" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].Height" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.Height))" /></label>
                            </div>
                        </div>
                        <div class="sprite-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(() => ReplaceSpriteAsync(spriteIndex))" Disabled="@_isBusy">@L["AtlasEditor.ReplaceImage"]</FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(() => ExportSpriteAsync(spriteIndex))" Disabled="@(_isBusy || !image.HasImage)">@L["AtlasEditor.ExportImage"]</FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Subtle" Class="delete-sprite" OnClick="@(() => ConfirmRemoveSpriteAsync(spriteIndex))" Disabled="@_isBusy">@L["AtlasEditor.Remove"]</FluentButton>
                        </div>
                    </article>
                }
                <FluentButton Class="add-sprite-button" Appearance="ButtonAppearance.Default" OnClick="AddSprite" Disabled="@_isBusy">@L["AtlasEditor.AddSprite"]</FluentButton>
            </section>
        </div>
        <section class="atlas-save-options panel-surface @(_projectContext is not null || _isNewAtlas ? "has-project-save" : null)">
            @if (_projectContext is not null)
            {
                <section class="atlas-save-panel project-save-panel">
                    <h2>@L["AtlasEditor.ProjectSave"]</h2>
                    <div class="project-save-location">
                        <span>@L["AtlasEditor.ProjectPath"]</span><code>@_projectContext.RelativePath</code>
                        <span>@L["AtlasEditor.ProjectPlatform"]</span><strong>@PlatformLabel(_projectContext.Platform)</strong>
                    </div>
                    <div class="atlas-save-actions">
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveToProjectAsync" Disabled="@_isBusy">
                            <span class="atlas-save-button-content">
                                @if (_busyOperation == AtlasBusyOperation.SaveToProject) { <FluentSpinner /> }
                                @L["AtlasEditor.SaveToProject"]
                            </span>
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Default" OnClick="SaveAllVariantsAsync"
                                      Disabled="@(_isBusy || !CanSaveAllVariants)">
                            <span class="atlas-save-button-content">
                                @if (_busyOperation == AtlasBusyOperation.SaveAllVariants) { <FluentSpinner /> }
                                @L["AtlasEditor.SaveAllVariants"]
                            </span>
                        </FluentButton>
                    </div>
                </section>
            }
            else if (_isNewAtlas && State.CurrentPackage is not null && !string.IsNullOrWhiteSpace(State.ProjectRoot))
            {
                <section class="atlas-save-panel project-save-panel">
                    <h2>@L["Eyecatch.CreateFamily"]</h2>
                    <p>@L["Eyecatch.CreateFamilyHint"]</p>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveNewFamilyAsync" Disabled="@_isBusy">
                        <span class="atlas-save-button-content">
                            @if (_busyOperation == AtlasBusyOperation.SaveToProject) { <FluentSpinner /> }
                            @L["Eyecatch.CreateFamily"]
                        </span>
                    </FluentButton>
                </section>
            }
            <section class="atlas-save-panel bundle-export-panel">
                <h2>@L["AtlasEditor.ProjectExport"]</h2>
                <div class="atlas-export-grid bundle-export-grid">
                    <FluentSelect TOption="UnityTargetPlatform" TValue="UnityTargetPlatform" Items="@Platforms"
                                  OptionText="PlatformLabel" OptionValue="@(platform => platform)" @bind-Value="_platform" Label='@L["AtlasEditor.Platform"]' />
                    <span class="template-name">@L["AtlasEditor.TemplateForPlatform", TemplateFileName(SelectedKind, _platform)].Value</span>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="ExportBundleAsync" Disabled="@_isBusy">
                        <span class="atlas-save-button-content">
                            @if (_busyOperation == AtlasBusyOperation.ExportBundle) { <FluentSpinner /> }
                            @L["AtlasEditor.ExportBundle"]
                        </span>
                    </FluentButton>
                </div>
            </section>
        </section>
    }
    @if (_isBusy)
    {
        <div class="atlas-busy"><FluentSpinner /> <span>@_busyMessage</span></div>
    }
</div>

@code {
    private static readonly string[] AtlasKinds = ["NGUI2", "NGUI3"];
    private static readonly UnityTargetPlatform[] Platforms = [UnityTargetPlatform.Android, UnityTargetPlatform.IOS];

    private enum AtlasBusyOperation
    {
        SaveToProject,
        SaveAllVariants,
        ExportBundle
    }

    private readonly List<AtlasEditorImage> _sprites = [];
    private readonly List<AtlasRegionValues> _regionValues = [];
    private readonly List<ProjectAtlasVariantChoice> _projectVariantChoices = [];
    private string? _lastProjectRequest;
    private AtlasProjectContext? _projectContext;
    private bool _hasUnsavedEdits;
    private bool _familyCheckPerformed;
    private bool _familyContentMismatch;
    private bool _familyLayoutMismatch;
    private bool _familyOrderMismatch;
    private int _familyReadyCount;
    private bool _checkingFamily;
    private bool _isNewAtlas;
    private readonly string _previewCanvasId = $"atlas-preview-{Guid.NewGuid():N}";
    private IJSObjectReference? _previewModule;
    private SpriteAtlasDocument? _document;
    private byte[] _previewPng = [];
    private string _atlasName = "d3_e10";
    private string _kindValue = "NGUI3";
    private int _atlasWidth = 512;
    private int _atlasHeight = 512;
    private int _selectedSpriteIndex;
    private UnityTargetPlatform _platform = UnityTargetPlatform.Android;
    private string? _status;
    private string _busyMessage = string.Empty;
    private MessageBarIntent _statusIntent = MessageBarIntent.Info;
    private bool _isBusy;
    private AtlasBusyOperation? _busyOperation;
    private IToastInstance? _progressToast;
    private const string OperationProgressToastId = "atlas-editor-operation-progress";

    private bool _canvasNeedsRender;
    private bool _isConfiguringNew;
    private string _atlasWidthText { get => _atlasWidth.ToString(CultureInfo.InvariantCulture); set { if (int.TryParse(value, out var parsed)) _atlasWidth = parsed; } }
    private string _atlasHeightText { get => _atlasHeight.ToString(CultureInfo.InvariantCulture); set { if (int.TryParse(value, out var parsed)) _atlasHeight = parsed; } }
    private bool CanSaveAllVariants => _projectContext is not null && _document is not null
        && State.CurrentPackage is not null && !string.IsNullOrWhiteSpace(AtlasKeyFromName(_document.AtlasName));
    private string FamilyContentStatus => !_familyCheckPerformed
        ? L["AtlasEditor.CheckNotRun"].Value
        : _familyReadyCount < 2
            ? L["AtlasEditor.CheckIncomplete", _familyReadyCount].Value
            : _familyContentMismatch ? L["AtlasEditor.ContentMismatch"].Value : L["AtlasEditor.ContentMatch"].Value;
    private string FamilyLayoutStatus => !_familyCheckPerformed
        ? L["AtlasEditor.CheckNotRun"].Value
        : _familyReadyCount < 2
            ? L["AtlasEditor.CheckIncomplete", _familyReadyCount].Value
            : _familyContentMismatch ? L["AtlasEditor.LayoutNotCompared"].Value
            : _familyLayoutMismatch ? L["AtlasEditor.LayoutMismatch"].Value
            : _familyOrderMismatch ? L["AtlasEditor.OrderMismatch"].Value
            : L["AtlasEditor.LayoutMatch"].Value;

    [Parameter]
    public string? ProjectFile { get; set; }

    [Parameter]
    public string? ProjectPlatform { get; set; }

    [Parameter]
    public bool NewAtlasRequest { get; set; }

    [SupplyParameterFromQuery(Name = "projectFile")]
    public string? QueryProjectFile { get; set; }

    [SupplyParameterFromQuery(Name = "platform")]
    public string? QueryProjectPlatform { get; set; }

    [SupplyParameterFromQuery(Name = "new")]
    public bool QueryNewAtlasRequest { get; set; }

    [Parameter]
    public string? InitialAtlasName { get; set; }

    [Parameter]
    public string? InitialSpriteName { get; set; }

    [Parameter]
    public bool IsDialogMode { get; set; }

    [Parameter]
    public EventCallback CloseRequested { get; set; }

    [Parameter]
    public string? ExternalFile { get; set; }

    [SupplyParameterFromQuery(Name = "externalFile")]
    public string? QueryExternalFile { get; set; }

    private string? RequestedProjectFile => IsDialogMode ? ProjectFile : QueryProjectFile;
    private string? RequestedProjectPlatform => IsDialogMode ? ProjectPlatform : QueryProjectPlatform;
    private bool IsNewAtlasRequested => IsDialogMode ? NewAtlasRequest : QueryNewAtlasRequest;
    private string? RequestedExternalFile => IsDialogMode ? ExternalFile : QueryExternalFile;

    protected override async Task OnParametersSetAsync()
    {
        var externalFile = RequestedExternalFile;
        var projectFile = RequestedProjectFile;
        var projectPlatform = RequestedProjectPlatform;
        if (!string.IsNullOrWhiteSpace(externalFile)
            && string.IsNullOrWhiteSpace(projectFile)
            && string.IsNullOrWhiteSpace(projectPlatform))
        {
            var externalRequestKey = $"external|{externalFile}";
            if (!string.Equals(_lastProjectRequest, externalRequestKey, StringComparison.Ordinal))
            {
                _lastProjectRequest = externalRequestKey;
                await OpenExternalBundleAsync(externalFile);
            }
            return;
        }

        if (IsNewAtlasRequested && string.IsNullOrWhiteSpace(projectFile) && string.IsNullOrWhiteSpace(projectPlatform))
        {
            if (!string.Equals(_lastProjectRequest, "new-atlas", StringComparison.Ordinal))
            {
                _lastProjectRequest = "new-atlas";
                BeginNewAtlas();
                if (!string.IsNullOrWhiteSpace(InitialAtlasName))
                    _atlasName = NormalizeAtlasName(InitialAtlasName, SelectedKind);
            }
            return;
        }
        if (string.IsNullOrWhiteSpace(projectFile) && string.IsNullOrWhiteSpace(projectPlatform))
            return;

        var requestKey = $"{projectPlatform}|{projectFile}";
        if (string.Equals(_lastProjectRequest, requestKey, StringComparison.Ordinal))
            return;

        _lastProjectRequest = requestKey;
        await OpenProjectAtlasAsync(projectFile, projectPlatform);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _previewModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DMTQ.Tools.Components/atlasPreview.js?v=5");

        if (!_canvasNeedsRender || _previewModule is null || _document is null || _previewPng.Length == 0)
            return;

        _canvasNeedsRender = false;
        var entries = _document.Sprites.Select(sprite => new
        {
            sprite.Name,
            sprite.X,
            sprite.Y,
            sprite.Width,
            sprite.Height
        });
        await _previewModule.InvokeVoidAsync("drawAtlas", _previewCanvasId, Convert.ToBase64String(_previewPng),
            _document.TextureWidth, _document.TextureHeight, entries, _selectedSpriteIndex);
    }

    public async ValueTask DisposeAsync()
    {
        if (_previewModule is not null)
        {
            try { await _previewModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private string AtlasKindLabel(string value) => value == "NGUI3" ? L["AtlasEditor.NGUI3"].Value : L["AtlasEditor.NGUI2"].Value;

    private string PlatformLabel(string value) => TryParsePlatform(value, out var platform) ? PlatformLabel(platform) : value;

    private string PlatformLabel(UnityTargetPlatform value) => value switch
    {
        UnityTargetPlatform.Android => "Android",
        UnityTargetPlatform.IOS => "iOS",
        UnityTargetPlatform.Windows => "Windows",
        _ => value.ToString()
    };

    private void BeginNewAtlas()
    {
        _isConfiguringNew = true;
        _atlasName = DefaultAtlasName(SelectedKind);
        _atlasWidth = _atlasHeight = 512;
        _atlasWidthText = "512";
        _atlasHeightText = "512";
    }

    private void UpdateNewAtlasKind() => _atlasName = DefaultAtlasName(SelectedKind);

    private void CreateNewAtlas()
    {
        _atlasWidth = Math.Clamp(_atlasWidth, 32, 4096);
        _atlasHeight = Math.Clamp(_atlasHeight, 32, 4096);
        _atlasName = NormalizeAtlasName(_atlasName, SelectedKind);
        _document = CreateEmptyDocument();
        _previewPng = SpriteAtlasImage.Compose(_document, new Dictionary<string, byte[]>(StringComparer.Ordinal));
        _sprites.Clear();
        _regionValues.Clear();
        _projectContext = null;
        _projectVariantChoices.Clear();
        _hasUnsavedEdits = true;
        _isNewAtlas = true;
        _isConfiguringNew = false;
        _canvasNeedsRender = true;
        _status = null;
        if (!string.IsNullOrWhiteSpace(InitialSpriteName))
        {
            AddSprite();
            if (_sprites.Count > 0)
            {
                var spriteName = InitialSpriteName.Trim();
                _sprites[^1].Name = spriteName;
                _document.Sprites[^1].Name = spriteName;
                ComposePreview();
            }
        }
    }

    private async Task OpenBundleAsync()
    {
        var path = await FilePicker.PickFileAsync([".unity", ".unity3d", ".lz4"]);
        if (string.IsNullOrWhiteSpace(path)) return;
        await OpenExternalBundleAsync(path);
    }

    private async Task OpenExternalBundleAsync(string path)
    {
        _isBusy = true;
        _busyMessage = L["AtlasEditor.OpenBundle"].Value;
        try
        {
            SetFromBundle(path, BundleService.Read(path));
        }
        catch (Exception exception)
        {
            ShowError(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OpenProjectAtlasAsync(string? projectFile, string? platformKey)
    {
        _isBusy = true;
        _busyMessage = L["AtlasEditor.OpenBundle"].Value;
        string? temporaryPath = null;
        try
        {
            if (string.IsNullOrWhiteSpace(projectFile) || string.IsNullOrWhiteSpace(platformKey))
                throw new InvalidDataException("Both project file and platform are required.");
            if (State.CurrentPackage is null || string.IsNullOrWhiteSpace(State.ProjectRoot))
                throw new InvalidOperationException("Open a project before editing a project atlas.");

            var relativePath = FileUtility.NormalizePackageRelativePath(projectFile);
            if (!IsAtlasResourcePath(relativePath))
                throw new InvalidDataException($"'{relativePath}' is not a supported song atlas resource.");
            if (!TryParsePlatform(platformKey, out var projectPlatform))
                throw new InvalidDataException($"Unsupported project platform '{platformKey}'.");

            var resource = State.CurrentPackage.Resources.FirstOrDefault(item =>
                item.FileName.Equals(relativePath, StringComparison.OrdinalIgnoreCase));
            var platformResource = resource?.PlatformManifest.FirstOrDefault(item =>
                item.Platform.Equals(platformKey, StringComparison.OrdinalIgnoreCase) && item.Exist);
            if (resource is null || platformResource is null)
                throw new FileNotFoundException($"The project does not contain '{relativePath}' for {platformKey}.");

            var projectRoot = Path.GetFullPath(State.ProjectRoot);
            var platformRoot = Path.GetFullPath(Path.Combine(projectRoot, "resources", platformKey));
            var sourcePath = Path.GetFullPath(Path.Combine(platformRoot, relativePath.Replace('/', Path.DirectorySeparatorChar)));
            var platformRootPrefix = platformRoot.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
            if (!sourcePath.StartsWith(platformRootPrefix, StringComparison.OrdinalIgnoreCase))
                throw new InvalidDataException("The project resource path is outside its platform directory.");

            if (!File.Exists(sourcePath))
            {
                var compressedPath = sourcePath + ".lz4";
                if (!File.Exists(compressedPath))
                    throw new FileNotFoundException($"The project atlas file was not found: {sourcePath}");

                temporaryPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N") + Path.GetExtension(sourcePath));
                await FileUtility.DecompressFileAsync(compressedPath, temporaryPath);
                sourcePath = temporaryPath;
            }

            var content = BundleService.Read(sourcePath);
            if (File.Exists(Path.Combine(projectRoot, "eyecatch.json")))
            {
                var index = await EyecatchIndexService.LoadAsync(projectRoot);
                var variant = index.Atlases
                    .SelectMany(atlas => atlas.Variants)
                    .FirstOrDefault(item => item.Kind == content.Document.Kind
                        && item.Platform.Equals(platformKey, StringComparison.OrdinalIgnoreCase)
                        && item.ResourcePath.Equals(relativePath, StringComparison.OrdinalIgnoreCase)
                        && item.IsDirty);
                var indexedAtlas = await EyecatchIndexService.ReadImageBytesAsync(projectRoot, variant?.AtlasImagePath);
                if (variant?.Document is not null && indexedAtlas is not null)
                {
                    content.Document = variant.Document.Clone();
                    content.AtlasPng = indexedAtlas;
                }
            }

            SetFromBundle(relativePath, content, new AtlasProjectContext(projectRoot, relativePath, platformKey, resource.Compressed));
            _platform = projectPlatform;
            await LoadProjectVariantChoicesAsync(content.Document, relativePath, platformKey, projectRoot);
        }
        catch (Exception exception)
        {
            ShowError(exception);
        }
        finally
        {
            if (temporaryPath is not null && File.Exists(temporaryPath))
                File.Delete(temporaryPath);
            _isBusy = false;
        }
    }

    private void SetFromBundle(string path, SpriteAtlasBundleContent content, AtlasProjectContext? projectContext = null)
    {
        _isConfiguringNew = false;
        _projectVariantChoices.Clear();
        _projectContext = projectContext;
        _isNewAtlas = false;
        _hasUnsavedEdits = false;
        _document = content.Document;
        _atlasName = content.Document.AtlasName;
        _kindValue = content.Document.Kind.ToString();
        _atlasWidth = content.Document.TextureWidth;
        _atlasHeight = content.Document.TextureHeight;
        _previewPng = content.AtlasPng;
        _platform = projectContext is null
            ? GuessPlatform(path) ?? _platform
            : TryParsePlatform(projectContext.Platform, out var projectPlatform) ? projectPlatform : _platform;
        _sprites.Clear();
        foreach (var sprite in content.Document.Sprites)
        {
            var cropped = SpriteAtlasImage.Crop(content.AtlasPng, content.Document.TextureWidth, content.Document.TextureHeight, sprite);
            var dimensions = ImageResult.FromMemory(cropped, ColorComponents.RedGreenBlueAlpha);
            _sprites.Add(new AtlasEditorImage(sprite.Name, cropped, "image/png", dimensions.Width, dimensions.Height));
        }
        SyncRegionValues();
        _canvasNeedsRender = true;
        _selectedSpriteIndex = 0;
        _status = L["AtlasEditor.Loaded", Path.GetFileName(path), content.OriginalTextureFormat, _sprites.Count].Value;
        _statusIntent = MessageBarIntent.Success;
    }

    private async Task LoadProjectVariantChoicesAsync(
        SpriteAtlasDocument currentDocument,
        string currentPath,
        string currentPlatform,
        string projectRoot)
    {
        _projectVariantChoices.Clear();
        if (State.CurrentPackage is null) return;

        var atlasKey = AtlasKeyFromName(currentDocument.AtlasName);
        if (string.IsNullOrWhiteSpace(atlasKey)) return;
        var index = await EyecatchIndexService.LoadAsync(projectRoot);
        var family = index.Atlases.FirstOrDefault(atlas => atlas.AtlasKey.Equals(atlasKey, StringComparison.OrdinalIgnoreCase));
        if (family is null)
            ClearFamilyCheck();
        else
            UpdateFamilyCheck(family);

        foreach (var kind in Enum.GetValues<SpriteAtlasKind>())
        foreach (var platform in new[] { "android", "ios" })
        {
            var atlasName = (kind == SpriteAtlasKind.NGUI3 ? "d3_" : "d_") + atlasKey;
            var indexedVariant = family?.Variants.FirstOrDefault(variant => variant.Kind == kind
                && variant.Platform.Equals(platform, StringComparison.OrdinalIgnoreCase));
            var relativePath = indexedVariant?.ResourcePath;
            if (string.IsNullOrWhiteSpace(relativePath))
            {
                relativePath = State.CurrentPackage.Resources
                    .Where(resource => resource.Category.Equals("dlc", StringComparison.OrdinalIgnoreCase)
                        && Path.GetFileNameWithoutExtension(resource.FileName).Equals(atlasName, StringComparison.OrdinalIgnoreCase)
                        && resource.PlatformManifest.Any(entry => entry.Platform.Equals(platform, StringComparison.OrdinalIgnoreCase)))
                    .OrderBy(resource => Path.GetExtension(resource.FileName).Equals(".unity3d", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                    .Select(resource => resource.FileName)
                    .FirstOrDefault();
            }

            relativePath ??= $"dlc/{atlasName}.unity3d";
            relativePath = FileUtility.NormalizePackageRelativePath(relativePath);
            var fullPath = Path.Combine(projectRoot, "resources", platform, relativePath.Replace('/', Path.DirectorySeparatorChar));
            var exists = (kind == currentDocument.Kind && platform.Equals(currentPlatform, StringComparison.OrdinalIgnoreCase)
                    && relativePath.Equals(currentPath, StringComparison.OrdinalIgnoreCase))
                || File.Exists(fullPath) || File.Exists(fullPath + ".lz4");
            _projectVariantChoices.Add(new ProjectAtlasVariantChoice(kind, platform, relativePath, exists));
        }
    }

    private async Task CheckAtlasesAsync()
    {
        if (_isBusy || State.CurrentPackage is null || _projectContext is null || _document is null
            || string.IsNullOrWhiteSpace(State.ProjectRoot)) return;

        _isBusy = true;
        _checkingFamily = true;
        _busyMessage = L["AtlasEditor.CheckFourAtlases"].Value;
        try
        {
            var projectRoot = Path.GetFullPath(State.ProjectRoot);
            var atlasKey = AtlasKeyFromName(_document.AtlasName);
            var index = await EyecatchIndexService.CheckNGUI3FamilyAsync(State.CurrentPackage, projectRoot, atlasKey);
            var family = index.Atlases.FirstOrDefault(atlas => atlas.AtlasKey.Equals(atlasKey, StringComparison.OrdinalIgnoreCase));
            if (family is null)
                ClearFamilyCheck(checkedCompleted: true);
            else
                UpdateFamilyCheck(family);

            await LoadProjectVariantChoicesAsync(_document, _projectContext.RelativePath, _projectContext.Platform, projectRoot);
        }
        catch (Exception exception)
        {
            ShowError(exception);
        }
        finally
        {
            _checkingFamily = false;
            _isBusy = false;
            _busyMessage = string.Empty;
        }
    }

    private void UpdateFamilyCheck(EyecatchAtlasFamily family)
    {
        var ready = family.Variants
            .Where(variant => variant.Kind == SpriteAtlasKind.NGUI3
                && variant.Status == EyecatchVariantStatus.Ready && variant.Document is not null)
            .GroupBy(variant => $"{variant.Kind}/{variant.Platform}", StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToArray();
        _familyCheckPerformed = true;
        _familyReadyCount = ready.Length;
        _familyContentMismatch = false;
        _familyLayoutMismatch = false;
        _familyOrderMismatch = false;
        if (ready.Length < 2) return;

        var reference = ready[0].Document;
        var referenceNames = reference.Sprites.Select(sprite => sprite.Name).ToHashSet(StringComparer.Ordinal);
        _familyContentMismatch = ready.Skip(1).Any(variant =>
        {
            var names = variant.Document.Sprites.Select(sprite => sprite.Name).ToHashSet(StringComparer.Ordinal);
            return names.Count != reference.Sprites.Count || !names.SetEquals(referenceNames);
        });
        if (_familyContentMismatch) return;

        _familyOrderMismatch = ready.Skip(1).Any(variant =>
            !reference.Sprites.Select(sprite => sprite.Name)
                .SequenceEqual(variant.Document.Sprites.Select(sprite => sprite.Name), StringComparer.Ordinal));
        _familyLayoutMismatch = ready.Skip(1).Any(variant => !SameSpriteLayout(reference, variant.Document));
    }

    private void ClearFamilyCheck(bool checkedCompleted = false)
    {
        _familyCheckPerformed = checkedCompleted;
        _familyReadyCount = 0;
        _familyContentMismatch = false;
        _familyLayoutMismatch = false;
        _familyOrderMismatch = false;
    }

    private static bool SameSpriteLayout(SpriteAtlasDocument left, SpriteAtlasDocument right)
    {
        if (left.TextureWidth != right.TextureWidth || left.TextureHeight != right.TextureHeight
            || left.Sprites.Count != right.Sprites.Count) return false;
        if (right.Sprites.Select(sprite => sprite.Name).Distinct(StringComparer.Ordinal).Count() != right.Sprites.Count)
            return false;
        var rightByName = right.Sprites.ToDictionary(sprite => sprite.Name, StringComparer.Ordinal);
        return left.Sprites.All(sprite => rightByName.TryGetValue(sprite.Name, out var other)
            && sprite.X == other.X && sprite.Y == other.Y
            && sprite.Width == other.Width && sprite.Height == other.Height
            && sprite.InnerX == other.InnerX && sprite.InnerY == other.InnerY
            && sprite.InnerWidth == other.InnerWidth && sprite.InnerHeight == other.InnerHeight);
    }

    private async Task SwitchProjectVariantAsync(ProjectAtlasVariantChoice variant)
    {
        if (_isBusy || _projectContext is null || !variant.Exists) return;
        if (_hasUnsavedEdits)
        {
            var confirmation = await DialogService.ShowConfirmationAsync(
                message: L["AtlasEditor.DiscardVariantEdits"].Value,
                title: L["AtlasEditor.Variant"].Value,
                primaryButton: L["AtlasEditor.ConfirmSwitchVariant"].Value,
                secondaryButton: L["Common.Cancel"].Value);
            if (confirmation.Cancelled) return;
        }

        await OpenProjectAtlasAsync(variant.RelativePath, variant.Platform);
        if (_projectContext is null
            || !_projectContext.RelativePath.Equals(variant.RelativePath, StringComparison.OrdinalIgnoreCase)
            || !_projectContext.Platform.Equals(variant.Platform, StringComparison.OrdinalIgnoreCase))
            return;

        ProjectFile = variant.RelativePath;
        ProjectPlatform = variant.Platform;
        _lastProjectRequest = $"{ProjectPlatform}|{ProjectFile}";
        if (!IsDialogMode)
            Navigation.NavigateTo($"/atlas-editor?projectFile={Uri.EscapeDataString(ProjectFile)}&platform={Uri.EscapeDataString(ProjectPlatform)}", replace: true);
    }

