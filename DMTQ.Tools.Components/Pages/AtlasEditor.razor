    }

    private void AddSprite()
    {
        if (_document is null) return;
        const int width = 256;
        const int height = 149;
        var slot = FindAvailableSlot(width, height);
        if (slot is null)
        {
            _status = L["AtlasEditor.NoSpriteSlot"].Value;
            _statusIntent = MessageBarIntent.Warning;
            return;
        }
        var (x, y) = slot.Value;
        var prefix = _document.AtlasName.StartsWith("d3_", StringComparison.Ordinal) ? _document.AtlasName[3..] : _document.AtlasName.StartsWith("d_", StringComparison.Ordinal) ? _document.AtlasName[2..] : "sprite";
        var name = MakeUniqueName($"{prefix}_sprite");
        var blank = CreateTransparentPng(width, height);
        var sprite = new SpriteAtlasEntry { Name = name, X = x, Y = y, Width = width, Height = height,
            InnerX = x, InnerY = y, InnerWidth = width, InnerHeight = height };
        _document.Sprites.Add(sprite);
        _sprites.Add(new AtlasEditorImage(name, blank, "image/png", width, height, hasImage: false));
        _selectedSpriteIndex = _sprites.Count - 1;
        ComposePreview();
    }

    private (int X, int Y)? FindAvailableSlot(int width, int height)
    {
        if (_document is null) return null;
        for (var y = _document.TextureHeight - height; y >= 0; y -= height)
        for (var x = 0; x + width <= _document.TextureWidth; x += width)
        {
            var overlaps = _document.Sprites.Any(sprite => x < sprite.X + sprite.Width && x + width > sprite.X && y < sprite.Y + sprite.Height && y + height > sprite.Y);
            if (!overlaps) return (x, y);
        }
        return null;
    }

    private static byte[] CreateTransparentPng(int width, int height)
    {
        using var stream = new MemoryStream();
        new StbImageWriteSharp.ImageWriter().WritePng(new byte[checked(width * height * 4)], width, height,
            StbImageWriteSharp.ColorComponents.RedGreenBlueAlpha, stream);
        return stream.ToArray();
    }

    private string MakeUniqueName(string baseName)
    {
        var existing = _sprites.Select(sprite => sprite.Name).ToHashSet(StringComparer.Ordinal);
        var candidate = baseName;
        var suffix = 2;
        while (existing.Contains(candidate)) candidate = $"{baseName}_{suffix++}";
        return candidate;
    }

    private async Task ExportBundleAsync()
    {
        if (_isBusy) return;
        if (!TryValidateDocument(out var document)) return;
        await BeginSaveOperationAsync(AtlasBusyOperation.ExportBundle, L["AtlasEditor.ExportBundle"].Value);
        var temporaryPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N") + ".unity3d");
        try
        {
            await BuildBundleAsync(document, _platform, temporaryPath);
            await using var output = File.OpenRead(temporaryPath);
            var saved = await FileSaver.SaveFileAsync(document.AtlasName + ".unity3d", output);
            if (saved is not null)
                ShowOperationToast(ToastIntent.Success, L["AtlasEditor.Title"].Value,
                    L["AtlasEditor.Exported", Path.GetFileName(saved)].Value);
        }
        catch (Exception exception)
        {
            ShowOperationToast(ToastIntent.Error, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.Error", exception.Message].Value);
        }
        finally
        {
            try
            {
                if (File.Exists(temporaryPath)) File.Delete(temporaryPath);
            }
            finally
            {
                await FinishSaveOperationAsync();
            }
        }
    }

    private async Task SaveToProjectAsync()
    {
        if (_isBusy) return;
        if (_projectContext is null || !TryValidateDocument(out var document)) return;

        await BeginSaveOperationAsync(AtlasBusyOperation.SaveToProject, L["AtlasEditor.ProjectSave"].Value);
        var temporaryPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N") + Path.GetExtension(_projectContext.RelativePath));
        try
        {
            if (string.IsNullOrWhiteSpace(State.ProjectRoot)
                || !Path.GetFullPath(State.ProjectRoot).Equals(_projectContext.ProjectRoot, StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidOperationException("The active project changed after this atlas was opened.");
            }

            if (!TryParsePlatform(_projectContext.Platform, out var projectPlatform))
                throw new InvalidDataException($"Unsupported project platform '{_projectContext.Platform}'.");

            await BuildBundleAsync(document, projectPlatform, temporaryPath);
            await Workflow.AddOrReplaceResourceAsync(
                temporaryPath,
                _projectContext.RelativePath,
                _projectContext.Platform,
                [],
                _projectContext.Compressed);
            await EyecatchIndexService.ApplyEditedVariantAsync(
                _projectContext.ProjectRoot,
                _projectContext.Platform,
                _projectContext.RelativePath,
                document,
                _previewPng);
            _hasUnsavedEdits = false;
            ShowOperationToast(ToastIntent.Success, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.SavedToProject", _projectContext.RelativePath].Value);
        }
        catch (Exception exception)
        {
            ShowOperationToast(ToastIntent.Error, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.Error", exception.Message].Value);
        }
        finally
        {
            try
            {
                if (File.Exists(temporaryPath)) File.Delete(temporaryPath);
            }
            finally
            {
                await FinishSaveOperationAsync();
            }
        }
    }

    private async Task SaveAllVariantsAsync()
    {
        if (_isBusy || !CanSaveAllVariants || !TryValidateDocument(out var document)) return;
        var projectContext = _projectContext!;
        var projectRoot = Path.GetFullPath(State.ProjectRoot!);
        if (!projectRoot.Equals(projectContext.ProjectRoot, StringComparison.OrdinalIgnoreCase))
        {
            ShowOperationToast(ToastIntent.Error, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.Error", "The active project changed after this atlas was opened."].Value);
            return;
        }

        await BeginSaveOperationAsync(AtlasBusyOperation.SaveAllVariants, L["AtlasEditor.SaveAllVariants"].Value);
        try
        {
            var atlasKey = AtlasKeyFromName(document.AtlasName);
            var index = await EyecatchIndexService.CheckNGUI3FamilyAsync(State.CurrentPackage!, projectRoot, atlasKey);
            var family = index.Atlases.FirstOrDefault(atlas => atlas.AtlasKey.Equals(atlasKey, StringComparison.OrdinalIgnoreCase));
            if (family is null)
                throw new FileNotFoundException(L["AtlasEditor.CheckFamilyMissing"].Value);

            UpdateFamilyCheck(family);
            await LoadProjectVariantChoicesAsync(document, projectContext.RelativePath, projectContext.Platform, projectRoot);

            if (_familyContentMismatch)
            {
                await ShowFamilySaveWarningAsync(L["AtlasEditor.ContentMismatchSaveBlocked"].Value);
                return;
            }
            if (HasContentMismatch(document, family))
            {
                await ShowFamilySaveWarningAsync(L["AtlasEditor.ContentMismatchSaveBlocked"].Value);
                return;
            }
            if (family.Variants.Any(variant => variant.Kind == SpriteAtlasKind.NGUI3
                && variant.Status == EyecatchVariantStatus.SourceChanged))
            {
                await ShowFamilySaveWarningAsync(L["AtlasEditor.SourceChangedSaveBlocked"].Value);
                return;
            }

            if (HasLayoutMismatch(document, family))
            {
                var confirmation = await DialogService.ShowConfirmationAsync(
                    message: L["AtlasEditor.ConfirmSaveAllVariants"].Value,
                    title: L["AtlasEditor.SaveAllVariants"].Value,
                    primaryButton: L["AtlasEditor.SaveAllVariants"].Value,
                    secondaryButton: L["Common.Cancel"].Value);
                if (confirmation.Cancelled) return;
            }

            await EyecatchBundleBuildService.ApplyDocumentToFamilyAsync(
                State.CurrentPackage!, projectRoot, atlasKey, document, _previewPng);
            await LoadProjectVariantChoicesAsync(document, projectContext.RelativePath, projectContext.Platform, projectRoot);
            _hasUnsavedEdits = false;
            ShowOperationToast(ToastIntent.Success, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.SavedAllVariants", atlasKey].Value);
        }
        catch (Exception exception)
        {
            ShowOperationToast(ToastIntent.Error, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.Error", exception.Message].Value);
        }
        finally
        {
            await FinishSaveOperationAsync();
        }
    }

    private async Task ShowFamilySaveWarningAsync(string message)
    {
        await DialogService.ShowDialogAsync<AtlasFamilyWarningDialog>(options =>
        {
            options.Header.Title = L["AtlasEditor.CheckFourAtlases"].Value;
            options.Width = "min(560px, 92vw)";
            options.Footer.PrimaryAction.Label = L["Common.Close"].Value;
            options.Parameters = new Dictionary<string, object?>
            {
                [nameof(AtlasFamilyWarningDialog.Message)] = message
            };
