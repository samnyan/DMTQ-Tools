@page "/atlas-editor"
@using System.Globalization
@using Assets.Lib.Models
@using Assets.Lib.Services
@using AssetsTools.NET.Texture
@using DMTQ.Tools.Core.Services
@using Microsoft.JSInterop
@using StbImageSharp
@inject SpriteAtlasBundleService BundleService
@inject IProjectFilePicker FilePicker
@inject IProjectFileSaver FileSaver
@inject IAtlasDummyTemplateProvider TemplateProvider
@inject IDialogService DialogService
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject NavigationManager Navigation
@inject INotificationService NotificationService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="atlas-editor-page">
    <header class="atlas-editor-heading">
        <div><h1>@L["AtlasEditor.Title"]</h1><p>@L["AtlasEditor.Subtitle"]</p></div>
        @if (_document is not null)
        {
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="ResetWorkspace" Disabled="@_isBusy">@L["AtlasEditor.CloseAtlas"]</FluentButton>
        }
    </header>
    @if (_document is null && !_isConfiguringNew)
    {
        <section class="atlas-entry panel-surface">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="BeginNewAtlas">@L["AtlasEditor.New"]</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" OnClick="OpenBundleAsync" Disabled="@_isBusy">@L["AtlasEditor.OpenBundle"]</FluentButton>
        </section>
    }
    @if (_isConfiguringNew)
    {
        <section class="atlas-settings panel-surface">
            <FluentSelect TOption="string" TValue="string" Items="@AtlasKinds" OptionText="AtlasKindLabel" OptionValue="@(kind => kind)"
                          @bind-Value="_kindValue" @bind-Value:after="UpdateNewAtlasKind" Label='@L["AtlasEditor.Kind"]' />
            <FluentTextInput Label='@L["AtlasEditor.Width"]' TextInputType="TextInputType.Number" ControlStyle="width:100%" @bind-Value="_atlasWidthText" />
            <FluentTextInput Label='@L["AtlasEditor.Height"]' TextInputType="TextInputType.Number" ControlStyle="width:100%" @bind-Value="_atlasHeightText" />
            <FluentTextInput Label='@L["AtlasEditor.AtlasName"]' @bind-Value="_atlasName" />
            <div class="atlas-entry-actions">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateNewAtlas">@L["AtlasEditor.Create"]</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="CancelNewAtlas">@L["Common.Cancel"]</FluentButton>
            </div>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <FluentMessageBar Intent="@_statusIntent">@_status</FluentMessageBar>
    }
    @if (_document is not null && _previewPng.Length > 0)
    {
        <section class="atlas-info panel-surface">
            <div><span>@L["AtlasEditor.AtlasName"]</span><strong>@_document.AtlasName</strong></div>
            <div><span>@L["AtlasEditor.Kind"]</span><strong>@AtlasKindLabel(_document.Kind.ToString())</strong></div>
            <div><span>@L["AtlasEditor.Size"]</span><strong>@_document.TextureWidth × @_document.TextureHeight</strong></div>
            <div><span>@L["AtlasEditor.Sprites"]</span><strong>@_sprites.Count</strong></div>
        </section>
        <div class="atlas-workspace">
            <section class="atlas-preview-column panel-surface">
                <div class="atlas-section-heading">
                    <div><h2>@L["AtlasEditor.Preview"]</h2><span>@_document.TextureWidth × @_document.TextureHeight · @L["AtlasEditor.SpriteCount", _sprites.Count]</span></div>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="ExportAtlasPngAsync" Disabled="@_isBusy">@L["AtlasEditor.ExportTexture"]</FluentButton>
                </div>
                <div class="atlas-canvas-scroll">
                    <canvas class="atlas-canvas" aria-label='@L["AtlasEditor.Preview"]' role="img" @ref="_previewCanvas"></canvas>
                </div>
            </section>
            <section class="atlas-sprite-column">
                <div class="atlas-section-heading sprite-list-heading">
                    <div><h2>@L["AtlasEditor.Sprites"]</h2><span>@L["AtlasEditor.SpriteCount", _sprites.Count]</span></div>
                    <span class="atlas-coordinate-origin">@L["AtlasEditor.CoordinateOrigin"]</span>
                </div>
                @for (var index = 0; index < _sprites.Count; index++)
                {
                    var spriteIndex = index;
                    var image = _sprites[spriteIndex];
                    var region = _document.Sprites[spriteIndex];
                    <article class="atlas-sprite-row @(spriteIndex == _selectedSpriteIndex ? "is-selected" : null)"
                             @onclick="() => SelectSprite(spriteIndex)">
                        @if (image.HasImage)
                        {
                            <img class="sprite-thumb" src="@image.PreviewDataUrl" alt="" />
                        }
                        else
                        {
                            <div class="sprite-thumb sprite-placeholder">@L["AtlasEditor.EmptySprite"]</div>
                        }
                        <div class="sprite-row-content">
                            <FluentTextInput Class="sprite-name" AriaLabel='@L["AtlasEditor.Name"]' @bind-Value="image.Name"
                                             @bind-Value:after="() => RenameSprite(spriteIndex)" />
                            <div class="sprite-region-fields" aria-label='@L["AtlasEditor.Region"]'>
                                <label>X<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="X" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].X" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.X))" /></label>
                                <label>Y<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="Y" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].Y" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.Y))" /></label>
                                <label>W<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="W" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].Width" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.Width))" /></label>
                                <label>H<FluentTextInput TextInputType="TextInputType.Number" AriaLabel="H" ControlStyle="width:100%" @bind-Value="_regionValues[spriteIndex].Height" @bind-Value:after="() => UpdateRegion(spriteIndex, nameof(region.Height))" /></label>
                            </div>
                        </div>
                        <div class="sprite-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(() => ReplaceSpriteAsync(spriteIndex))" Disabled="@_isBusy">@L["AtlasEditor.ReplaceImage"]</FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(() => ExportSpriteAsync(spriteIndex))" Disabled="@(_isBusy || !image.HasImage)">@L["AtlasEditor.ExportImage"]</FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Subtle" Class="delete-sprite" OnClick="@(() => ConfirmRemoveSpriteAsync(spriteIndex))" Disabled="@_isBusy">@L["AtlasEditor.Remove"]</FluentButton>
                        </div>
                    </article>
                }
                <FluentButton Class="add-sprite-button" Appearance="ButtonAppearance.Default" OnClick="AddSprite" Disabled="@_isBusy">@L["AtlasEditor.AddSprite"]</FluentButton>
            </section>
        </div>
        <section class="atlas-save-options panel-surface @(_projectContext is null ? null : "has-project-save")">
            @if (_projectContext is not null)
            {
                <section class="atlas-save-panel project-save-panel">
                    <h2>@L["AtlasEditor.ProjectSave"]</h2>
                    <div class="project-save-location">
                        <span>@L["AtlasEditor.ProjectPath"]</span><code>@_projectContext.RelativePath</code>
                        <span>@L["AtlasEditor.ProjectPlatform"]</span><strong>@PlatformLabel(_projectContext.Platform)</strong>
                    </div>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveToProjectAsync" Disabled="@_isBusy">
                        <span class="atlas-save-button-content">
                            @if (_busyOperation == AtlasBusyOperation.SaveToProject) { <FluentSpinner /> }
                            @L["AtlasEditor.SaveToProject"]
                        </span>
                    </FluentButton>
                </section>
            }
            <section class="atlas-save-panel bundle-export-panel">
                <h2>@L["AtlasEditor.ProjectExport"]</h2>
                <div class="atlas-export-grid bundle-export-grid">
                    <FluentSelect TOption="UnityTargetPlatform" TValue="UnityTargetPlatform" Items="@Platforms"
                                  OptionText="PlatformLabel" OptionValue="@(platform => platform)" @bind-Value="_platform" Label='@L["AtlasEditor.Platform"]' />
                    <span class="template-name">@L["AtlasEditor.TemplateForPlatform", TemplateFileName(SelectedKind, _platform)].Value</span>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="ExportBundleAsync" Disabled="@_isBusy">
                        <span class="atlas-save-button-content">
                            @if (_busyOperation == AtlasBusyOperation.ExportBundle) { <FluentSpinner /> }
                            @L["AtlasEditor.ExportBundle"]
                        </span>
                    </FluentButton>
                </div>
            </section>
        </section>
    }
    @if (_isBusy)
    {
        <div class="atlas-busy"><FluentSpinner /> <span>@_busyMessage</span></div>
    }
</div>

@code {
    private static readonly string[] AtlasKinds = ["NGUI2", "NGUI3"];
    private static readonly UnityTargetPlatform[] Platforms = [UnityTargetPlatform.Android, UnityTargetPlatform.IOS];

    private enum AtlasBusyOperation
    {
        SaveToProject,
        ExportBundle
    }

    private readonly List<AtlasEditorImage> _sprites = [];
    private readonly List<AtlasRegionValues> _regionValues = [];
    private string? _lastProjectRequest;
    private AtlasProjectContext? _projectContext;
    private ElementReference _previewCanvas;
    private IJSObjectReference? _previewModule;
    private SpriteAtlasDocument? _document;
    private byte[] _previewPng = [];
    private string _atlasName = "d_e10";
    private string _kindValue = "NGUI2";
    private int _atlasWidth = 512;
    private int _atlasHeight = 512;
    private int _selectedSpriteIndex;
    private UnityTargetPlatform _platform = UnityTargetPlatform.Android;
    private string? _status;
    private string _busyMessage = string.Empty;
    private MessageBarIntent _statusIntent = MessageBarIntent.Info;
    private bool _isBusy;
    private AtlasBusyOperation? _busyOperation;
    private IToastInstance? _progressToast;
    private const string OperationProgressToastId = "atlas-editor-operation-progress";

    private bool _canvasNeedsRender;
    private bool _isConfiguringNew;
    private string _atlasWidthText { get => _atlasWidth.ToString(CultureInfo.InvariantCulture); set { if (int.TryParse(value, out var parsed)) _atlasWidth = parsed; } }
    private string _atlasHeightText { get => _atlasHeight.ToString(CultureInfo.InvariantCulture); set { if (int.TryParse(value, out var parsed)) _atlasHeight = parsed; } }

    [SupplyParameterFromQuery(Name = "projectFile")]
    public string? ProjectFile { get; set; }

    [SupplyParameterFromQuery(Name = "platform")]
    public string? ProjectPlatform { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectFile) && string.IsNullOrWhiteSpace(ProjectPlatform))
            return;

        var requestKey = $"{ProjectPlatform}|{ProjectFile}";
        if (string.Equals(_lastProjectRequest, requestKey, StringComparison.Ordinal))
            return;

        _lastProjectRequest = requestKey;
        await OpenProjectAtlasAsync(ProjectFile, ProjectPlatform);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _previewModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DMTQ.Tools.Components/atlasPreview.js?v=4");

        if (!_canvasNeedsRender || _previewModule is null || _document is null || _previewPng.Length == 0)
            return;

        _canvasNeedsRender = false;
        var entries = _document.Sprites.Select(sprite => new
        {
            sprite.Name,
            sprite.X,
            sprite.Y,
            sprite.Width,
            sprite.Height
        });
        await _previewModule.InvokeVoidAsync("drawAtlas", _previewCanvas, Convert.ToBase64String(_previewPng),
            _document.TextureWidth, _document.TextureHeight, entries, _selectedSpriteIndex);
    }

    public async ValueTask DisposeAsync()
    {
        if (_previewModule is not null)
        {
            try { await _previewModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private string AtlasKindLabel(string value) => value == "NGUI3" ? L["AtlasEditor.NGUI3"].Value : L["AtlasEditor.NGUI2"].Value;

    private string PlatformLabel(string value) => TryParsePlatform(value, out var platform) ? PlatformLabel(platform) : value;

    private string PlatformLabel(UnityTargetPlatform value) => value switch
    {
        UnityTargetPlatform.Android => "Android",
        UnityTargetPlatform.IOS => "iOS",
        UnityTargetPlatform.Windows => "Windows",
        _ => value.ToString()
    };

    private void BeginNewAtlas()
    {
        _isConfiguringNew = true;
        _atlasName = DefaultAtlasName(SelectedKind);
        _atlasWidth = _atlasHeight = 512;
        _atlasWidthText = "512";
        _atlasHeightText = "512";
    }

    private void UpdateNewAtlasKind() => _atlasName = DefaultAtlasName(SelectedKind);

    private void CreateNewAtlas()
    {
        _atlasWidth = Math.Clamp(_atlasWidth, 32, 4096);
        _atlasHeight = Math.Clamp(_atlasHeight, 32, 4096);
        _atlasName = NormalizeAtlasName(_atlasName, SelectedKind);
        _document = CreateEmptyDocument();
        _previewPng = SpriteAtlasImage.Compose(_document, new Dictionary<string, byte[]>(StringComparer.Ordinal));
        _sprites.Clear();
        _regionValues.Clear();
        _projectContext = null;
        _isConfiguringNew = false;
        _canvasNeedsRender = true;
        _status = null;
    }

    private async Task OpenBundleAsync()
    {
        var path = await FilePicker.PickFileAsync([".unity", ".unity3d", ".lz4"]);
        if (string.IsNullOrWhiteSpace(path)) return;
        _isBusy = true;
        _busyMessage = L["AtlasEditor.OpenBundle"].Value;
        try
        {
            SetFromBundle(path, BundleService.Read(path));
        }
        catch (Exception exception)
        {
            ShowError(exception);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OpenProjectAtlasAsync(string? projectFile, string? platformKey)
    {
        _isBusy = true;
        _busyMessage = L["AtlasEditor.OpenBundle"].Value;
        string? temporaryPath = null;
        try
        {
            if (string.IsNullOrWhiteSpace(projectFile) || string.IsNullOrWhiteSpace(platformKey))
                throw new InvalidDataException("Both project file and platform are required.");
            if (State.CurrentPackage is null || string.IsNullOrWhiteSpace(State.ProjectRoot))
                throw new InvalidOperationException("Open a project before editing a project atlas.");

            var relativePath = FileUtility.NormalizePackageRelativePath(projectFile);
            if (!IsAtlasResourcePath(relativePath))
                throw new InvalidDataException($"'{relativePath}' is not a supported song atlas resource.");
            if (!TryParsePlatform(platformKey, out var projectPlatform))
                throw new InvalidDataException($"Unsupported project platform '{platformKey}'.");

            var resource = State.CurrentPackage.Resources.FirstOrDefault(item =>
                item.FileName.Equals(relativePath, StringComparison.OrdinalIgnoreCase));
            var platformResource = resource?.PlatformManifest.FirstOrDefault(item =>
                item.Platform.Equals(platformKey, StringComparison.OrdinalIgnoreCase) && item.Exist);
            if (resource is null || platformResource is null)
                throw new FileNotFoundException($"The project does not contain '{relativePath}' for {platformKey}.");

            var projectRoot = Path.GetFullPath(State.ProjectRoot);
            var platformRoot = Path.GetFullPath(Path.Combine(projectRoot, "resources", platformKey));
            var sourcePath = Path.GetFullPath(Path.Combine(platformRoot, relativePath.Replace('/', Path.DirectorySeparatorChar)));
            var platformRootPrefix = platformRoot.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
            if (!sourcePath.StartsWith(platformRootPrefix, StringComparison.OrdinalIgnoreCase))
                throw new InvalidDataException("The project resource path is outside its platform directory.");

            if (!File.Exists(sourcePath))
            {
                var compressedPath = sourcePath + ".lz4";
                if (!File.Exists(compressedPath))
                    throw new FileNotFoundException($"The project atlas file was not found: {sourcePath}");

                temporaryPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N") + Path.GetExtension(sourcePath));
                await FileUtility.DecompressFileAsync(compressedPath, temporaryPath);
                sourcePath = temporaryPath;
            }

            SetFromBundle(relativePath, BundleService.Read(sourcePath), new AtlasProjectContext(projectRoot, relativePath, platformKey, resource.Compressed));
            _platform = projectPlatform;
        }
        catch (Exception exception)
        {
            ShowError(exception);
        }
        finally
        {
            if (temporaryPath is not null && File.Exists(temporaryPath))
                File.Delete(temporaryPath);
            _isBusy = false;
        }
    }

    private void SetFromBundle(string path, SpriteAtlasBundleContent content, AtlasProjectContext? projectContext = null)
    {
        _isConfiguringNew = false;
        _projectContext = projectContext;
        _document = content.Document;
        _atlasName = content.Document.AtlasName;
        _kindValue = content.Document.Kind.ToString();
        _atlasWidth = content.Document.TextureWidth;
        _atlasHeight = content.Document.TextureHeight;
        _previewPng = content.AtlasPng;
        _platform = projectContext is null
            ? GuessPlatform(path) ?? _platform
            : TryParsePlatform(projectContext.Platform, out var projectPlatform) ? projectPlatform : _platform;
        _sprites.Clear();
        foreach (var sprite in content.Document.Sprites)
        {
            var cropped = SpriteAtlasImage.Crop(content.AtlasPng, content.Document.TextureWidth, content.Document.TextureHeight, sprite);
            var dimensions = ImageResult.FromMemory(cropped, ColorComponents.RedGreenBlueAlpha);
            _sprites.Add(new AtlasEditorImage(sprite.Name, cropped, "image/png", dimensions.Width, dimensions.Height));
        }
        SyncRegionValues();
        _canvasNeedsRender = true;
        _selectedSpriteIndex = 0;
        _status = L["AtlasEditor.Loaded", Path.GetFileName(path), content.OriginalTextureFormat, _sprites.Count].Value;
        _statusIntent = MessageBarIntent.Success;
    }

    private async Task ExportAtlasPngAsync()
    {
        if (!TryValidateDocument(out var document)) return;
        try
        {
            await using var png = new MemoryStream(_previewPng, writable: false);
            var saved = await FileSaver.SaveFileAsync(document.AtlasName + ".png", png);
            if (saved is not null) ShowSuccess(Path.GetFileName(saved));
        }
        catch (Exception exception)
        {
            ShowError(exception);
        }
    }

    private async Task ExportSpriteAsync(int index)
    {
        if (_document is null || index < 0 || index >= _document.Sprites.Count || !_sprites[index].HasImage) return;
        try
        {
            var sprite = _document.Sprites[index];
            var cropped = SpriteAtlasImage.Crop(_previewPng, _document.TextureWidth, _document.TextureHeight, sprite);
            await using var stream = new MemoryStream(cropped, writable: false);
            var saved = await FileSaver.SaveFileAsync(sprite.Name + ".png", stream);
            if (saved is not null) ShowSuccess(Path.GetFileName(saved));
        }
        catch (Exception exception) { ShowError(exception); }
    }

    private async Task ReplaceSpriteAsync(int index)
    {
        if (_document is null || index < 0 || index >= _sprites.Count) return;
        var path = await FilePicker.PickFileAsync([".png", ".jpg", ".jpeg"]);
        if (string.IsNullOrWhiteSpace(path)) return;
        try
        {
            var bytes = await File.ReadAllBytesAsync(path);
            var image = ImageResult.FromMemory(bytes, ColorComponents.RedGreenBlueAlpha);
            var region = _document.Sprites[index];
            var width = (int)Math.Round(region.Width);
            var height = (int)Math.Round(region.Height);
            if ((image.Width != width || image.Height != height) &&
                (await DialogService.ShowConfirmationAsync(
                    message: L["AtlasEditor.StretchConfirm", image.Width, image.Height, width, height].Value,
                    title: L["AtlasEditor.ReplaceImage"].Value,
                    primaryButton: L["AtlasEditor.Stretch"].Value,
                    secondaryButton: L["Common.Cancel"].Value)).Cancelled)
                return;

            _sprites[index].SetImage(bytes, Path.GetExtension(path).Equals(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg", image.Width, image.Height);
            ComposePreview();
        }
        catch (Exception exception) { ShowError(exception); }
    }

    private async Task ConfirmRemoveSpriteAsync(int index)
    {
        if (_document is null || index < 0 || index >= _sprites.Count) return;
        var name = _sprites[index].Name;
        var result = await DialogService.ShowConfirmationAsync(
            message: L["AtlasEditor.DeleteConfirm", name].Value,
            title: L["AtlasEditor.DeleteTitle"].Value,
            primaryButton: L["AtlasEditor.Remove"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (!result.Cancelled) RemoveSprite(index);
    }

    private void AddSprite()
    {
        if (_document is null) return;
        const int width = 256;
        const int height = 149;
        var slot = FindAvailableSlot(width, height);
        if (slot is null)
        {
            _status = L["AtlasEditor.NoSpriteSlot"].Value;
            _statusIntent = MessageBarIntent.Warning;
            return;
        }
        var (x, y) = slot.Value;
        var prefix = _document.AtlasName.StartsWith("d3_", StringComparison.Ordinal) ? _document.AtlasName[3..] : _document.AtlasName.StartsWith("d_", StringComparison.Ordinal) ? _document.AtlasName[2..] : "sprite";
        var name = MakeUniqueName($"{prefix}_sprite");
        var blank = CreateTransparentPng(width, height);
        var sprite = new SpriteAtlasEntry { Name = name, X = x, Y = y, Width = width, Height = height,
            InnerX = x, InnerY = y, InnerWidth = width, InnerHeight = height };
        _document.Sprites.Add(sprite);
        _sprites.Add(new AtlasEditorImage(name, blank, "image/png", width, height, hasImage: false));
        _selectedSpriteIndex = _sprites.Count - 1;
        ComposePreview();
    }

    private (int X, int Y)? FindAvailableSlot(int width, int height)
    {
        if (_document is null) return null;
        for (var y = _document.TextureHeight - height; y >= 0; y -= height)
        for (var x = 0; x + width <= _document.TextureWidth; x += width)
        {
            var overlaps = _document.Sprites.Any(sprite => x < sprite.X + sprite.Width && x + width > sprite.X && y < sprite.Y + sprite.Height && y + height > sprite.Y);
            if (!overlaps) return (x, y);
        }
        return null;
    }

    private static byte[] CreateTransparentPng(int width, int height)
    {
        using var stream = new MemoryStream();
        new StbImageWriteSharp.ImageWriter().WritePng(new byte[checked(width * height * 4)], width, height,
            StbImageWriteSharp.ColorComponents.RedGreenBlueAlpha, stream);
        return stream.ToArray();
    }

    private string MakeUniqueName(string baseName)
    {
        var existing = _sprites.Select(sprite => sprite.Name).ToHashSet(StringComparer.Ordinal);
        var candidate = baseName;
        var suffix = 2;
        while (existing.Contains(candidate)) candidate = $"{baseName}_{suffix++}";
        return candidate;
    }

    private async Task ExportBundleAsync()
    {
        if (_isBusy) return;
        if (!TryValidateDocument(out var document)) return;
        await BeginSaveOperationAsync(AtlasBusyOperation.ExportBundle, L["AtlasEditor.ExportBundle"].Value);
        var temporaryPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N") + ".unity3d");
        try
        {
            await BuildBundleAsync(document, _platform, temporaryPath);
            await using var output = File.OpenRead(temporaryPath);
            var saved = await FileSaver.SaveFileAsync(document.AtlasName + ".unity3d", output);
            if (saved is not null)
                ShowOperationToast(ToastIntent.Success, L["AtlasEditor.Title"].Value,
                    L["AtlasEditor.Exported", Path.GetFileName(saved)].Value);
        }
        catch (Exception exception)
        {
            ShowOperationToast(ToastIntent.Error, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.Error", exception.Message].Value);
        }
        finally
        {
            try
            {
                if (File.Exists(temporaryPath)) File.Delete(temporaryPath);
            }
            finally
            {
                await FinishSaveOperationAsync();
            }
        }
    }

    private async Task SaveToProjectAsync()
    {
        if (_isBusy) return;
        if (_projectContext is null || !TryValidateDocument(out var document)) return;

        await BeginSaveOperationAsync(AtlasBusyOperation.SaveToProject, L["AtlasEditor.ProjectSave"].Value);
        var temporaryPath = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N") + Path.GetExtension(_projectContext.RelativePath));
        try
        {
            if (string.IsNullOrWhiteSpace(State.ProjectRoot)
                || !Path.GetFullPath(State.ProjectRoot).Equals(_projectContext.ProjectRoot, StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidOperationException("The active project changed after this atlas was opened.");
            }

            if (!TryParsePlatform(_projectContext.Platform, out var projectPlatform))
                throw new InvalidDataException($"Unsupported project platform '{_projectContext.Platform}'.");

            await BuildBundleAsync(document, projectPlatform, temporaryPath);
            await Workflow.AddOrReplaceResourceAsync(
                temporaryPath,
                _projectContext.RelativePath,
                _projectContext.Platform,
                [],
                _projectContext.Compressed);
            ShowOperationToast(ToastIntent.Success, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.SavedToProject", _projectContext.RelativePath].Value);
        }
        catch (Exception exception)
        {
            ShowOperationToast(ToastIntent.Error, L["AtlasEditor.Title"].Value,
                L["AtlasEditor.Error", exception.Message].Value);
        }
        finally
        {
            try
            {
                if (File.Exists(temporaryPath)) File.Delete(temporaryPath);
            }
            finally
            {
                await FinishSaveOperationAsync();
            }
        }
    }

    private async Task BeginSaveOperationAsync(AtlasBusyOperation operation, string message)
    {
        _isBusy = true;
        _busyOperation = operation;
        _busyMessage = message;
        _progressToast = null;
        _ = NotificationService.ShowToastAsync(options =>
        {
            options.Id = OperationProgressToastId;
            options.Intent = ToastIntent.Progress;
            options.Title = message;
            options.Message = message;
            options.Lifetime = TimeSpan.Zero;
            options.AllowDismiss = false;
            options.OnStatusChange = args => _progressToast = args.Instance;
        });
        _progressToast = NotificationService.GetToastInstance(OperationProgressToastId);
        await Task.Yield();
    }

    private async Task FinishSaveOperationAsync()
    {
        var toast = _progressToast ?? NotificationService.GetToastInstance(OperationProgressToastId);
        _progressToast = null;
        try
        {
            if (toast is not null) await toast.CloseAsync();
        }
        finally
        {
            _busyOperation = null;
            _isBusy = false;
        }
    }

    private void ShowOperationToast(ToastIntent intent, string title, string message)
    {
        _ = NotificationService.ShowToastAsync(options =>
        {
            options.Intent = intent;
            options.Title = title;
            options.Message = message;
        });
    }

    private async Task BuildBundleAsync(SpriteAtlasDocument document, UnityTargetPlatform platform, string outputPath)
    {
        var templatePath = await TemplateProvider.GetTemplatePathAsync(document.Kind.ToString(), PlatformKey(platform));
        var template = new UnityBundleTemplate { Platform = platform, BundlePath = templatePath };
        BundleService.Export(template, document, _previewPng, outputPath);
    }

    private bool TryValidateDocument(out SpriteAtlasDocument document)
    {
        document = _document!;
        if (_document is null || _sprites.Count == 0)
        {
            _status = L["AtlasEditor.NoSprites"].Value;
            _statusIntent = MessageBarIntent.Warning;
            return false;
        }
        try
        {
            document.AtlasName = _atlasName.Trim();
            document.Validate();
            var byName = _sprites.ToDictionary(sprite => sprite.Name, StringComparer.Ordinal);
            if (document.Sprites.Any(sprite => !byName.ContainsKey(sprite.Name)))
                throw new InvalidDataException("Every atlas region must match an image name.");
            _previewPng = SpriteAtlasImage.Compose(document,
                byName.ToDictionary(pair => pair.Key, pair => pair.Value.Png, StringComparer.Ordinal));
            return true;
        }
        catch (Exception exception)
        {
            ShowError(exception);
            return false;
        }
    }

    private void RemoveSprite(int index)
    {
        if (index < 0 || index >= _sprites.Count) return;
        _sprites.RemoveAt(index);
        if (_document is not null && index < _document.Sprites.Count) _document.Sprites.RemoveAt(index);
        _selectedSpriteIndex = Math.Clamp(_selectedSpriteIndex, 0, Math.Max(0, _sprites.Count - 1));
        if (_sprites.Count == 0)
        {
            _previewPng = SpriteAtlasImage.Compose(_document, new Dictionary<string, byte[]>(StringComparer.Ordinal));
            SyncRegionValues();
            _canvasNeedsRender = true;
            return;
        }
        ComposePreview();
    }

    private void RenameSprite(int index)
    {
        if (_document is null || index >= _sprites.Count) return;
        _document.Sprites[index].Name = _sprites[index].Name.Trim();
        ComposePreview();
    }

    private void UpdateRegion(int index, string field)
    {
        if (_document is null || index < 0 || index >= _document.Sprites.Count || index >= _regionValues.Count) return;
        var values = _regionValues[index];
        var text = field switch
        {
            nameof(SpriteAtlasEntry.X) => values.X,
            nameof(SpriteAtlasEntry.Y) => values.Y,
            nameof(SpriteAtlasEntry.Width) => values.Width,
            nameof(SpriteAtlasEntry.Height) => values.Height,
            _ => string.Empty
        };
        if (!float.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var value)) return;
        var sprite = _document.Sprites[index];
        switch (field)
        {
            case nameof(sprite.X): sprite.X = value; break;
            case nameof(sprite.Y): sprite.Y = value; break;
            case nameof(sprite.Width): sprite.Width = value; break;
            case nameof(sprite.Height): sprite.Height = value; break;
        }
        sprite.InnerX = sprite.X;
        sprite.InnerY = sprite.Y;
        sprite.InnerWidth = sprite.Width;
        sprite.InnerHeight = sprite.Height;
        ComposePreview();
    }

    private void ComposePreview()
    {
        if (_document is null || _sprites.Count == 0) return;
        try
        {
            _document.AtlasName = _atlasName.Trim();
            var images = _sprites.ToDictionary(sprite => sprite.Name.Trim(), sprite => sprite.Png, StringComparer.Ordinal);
            foreach (var sprite in _document.Sprites) sprite.Name = sprite.Name.Trim();
            _previewPng = SpriteAtlasImage.Compose(_document, images);
            SyncRegionValues();
            _canvasNeedsRender = true;
            _status = null;
        }
        catch (Exception exception)
        {
            ShowError(exception);
        }
    }

    private void SyncRegionValues()
    {
        _regionValues.Clear();
        if (_document is null) return;
        _regionValues.AddRange(_document.Sprites.Select(sprite => new AtlasRegionValues
        {
            X = PixelValue(sprite.X),
            Y = PixelValue(sprite.Y),
            Width = PixelValue(sprite.Width),
            Height = PixelValue(sprite.Height)
        }));
    }

    private void SelectSprite(int index)
    {
        _selectedSpriteIndex = index;
        _canvasNeedsRender = true;
    }

    private SpriteAtlasKind SelectedKind => _kindValue == "NGUI3" ? SpriteAtlasKind.NGUI3 : SpriteAtlasKind.NGUI2;

    private void ResetWorkspace()
    {
        var wasProjectAtlas = _projectContext is not null;
        _sprites.Clear();
        _isConfiguringNew = false;
        _document = null;
        _projectContext = null;
        _atlasName = "d_e10";
        _kindValue = "NGUI2";
        _atlasWidth = 512;
        _atlasHeight = 512;
        _selectedSpriteIndex = 0;
        _platform = UnityTargetPlatform.Android;
        _previewPng = [];
        _regionValues.Clear();
        _status = null;
        if (wasProjectAtlas)
            Navigation.NavigateTo("/atlas-editor", replace: true);
    }

    private void CancelNewAtlas() => _isConfiguringNew = false;

    private static string DefaultAtlasName(SpriteAtlasKind kind) => kind == SpriteAtlasKind.NGUI3 ? "d3_e10" : "d_e10";
    private static string PlatformKey(UnityTargetPlatform platform) => platform switch
    {
        UnityTargetPlatform.IOS => "ios",
        UnityTargetPlatform.Android => "android",
        UnityTargetPlatform.Windows => "windows",
        _ => throw new ArgumentOutOfRangeException(nameof(platform), platform, null)
    };

    private static bool TryParsePlatform(string platformKey, out UnityTargetPlatform platform)
        => Enum.TryParse(platformKey, ignoreCase: true, out platform)
            && Enum.IsDefined(platform);

    private static bool IsAtlasResourcePath(string path)
    {
        if (!path.StartsWith("dlc/", StringComparison.OrdinalIgnoreCase)) return false;

        var fileName = Path.GetFileName(path);
        var isAtlasName = fileName.StartsWith("d_e", StringComparison.OrdinalIgnoreCase)
            || fileName.StartsWith("d3_e", StringComparison.OrdinalIgnoreCase);
        var extension = Path.GetExtension(fileName);
        var isUnityBundle = extension.Equals(".unity", StringComparison.OrdinalIgnoreCase)
            || extension.Equals(".unity3d", StringComparison.OrdinalIgnoreCase);
        return isAtlasName && isUnityBundle;
    }

    private static string TemplateFileName(SpriteAtlasKind kind, UnityTargetPlatform platform)
        => $"{(kind == SpriteAtlasKind.NGUI3 ? "d3" : "d")}_{PlatformKey(platform)}_dummy.unity3d";

    private static string NormalizeAtlasName(string name, SpriteAtlasKind kind)
    {
        var suffix = name.Trim();
        if (suffix.StartsWith("d3_", StringComparison.Ordinal)) suffix = suffix[3..];
        else if (suffix.StartsWith("d_", StringComparison.Ordinal)) suffix = suffix[2..];
        return (kind == SpriteAtlasKind.NGUI3 ? "d3_" : "d_") + suffix;
    }

    private SpriteAtlasDocument CreateEmptyDocument() => new()
    {
        AtlasName = _atlasName,
        Kind = SelectedKind,
        TextureWidth = Math.Max(32, _atlasWidth),
        TextureHeight = Math.Max(32, _atlasHeight)
    };

    private static string PixelValue(float value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static UnityTargetPlatform? GuessPlatform(string path)
    {
        var normalized = path.Replace('\\', '/').ToLowerInvariant();
        if (normalized.Contains("/android/") || normalized.Contains("android")) return UnityTargetPlatform.Android;
        if (normalized.Contains("/ios/") || normalized.Contains("iphone") || normalized.Contains("ios")) return UnityTargetPlatform.IOS;
        if (normalized.Contains("/windows/") || normalized.Contains("windows") || normalized.Contains("win64")) return UnityTargetPlatform.Windows;
        return null;
    }

    private void ShowSuccess(string fileName)
    {
        _status = L["AtlasEditor.Exported", fileName].Value;
        _statusIntent = MessageBarIntent.Success;
    }

    private void ShowError(Exception exception)
    {
        _status = L["AtlasEditor.Error", exception.Message].Value;
        _statusIntent = MessageBarIntent.Error;
    }

    private sealed class AtlasEditorImage(string name, byte[] png, string contentType, int width, int height, bool hasImage = true)
    {
        public string Name { get; set; } = name;
        public byte[] Png { get; private set; } = png;
        public string ContentType { get; private set; } = contentType;
        public int Width { get; private set; } = width;
        public int Height { get; private set; } = height;
        public bool HasImage { get; private set; } = hasImage;
        public string PreviewDataUrl => $"data:{ContentType};base64,{Convert.ToBase64String(Png)}";

        public void SetImage(byte[] png, string contentType, int width, int height)
        {
            Png = png;
            ContentType = contentType;
            Width = width;
            Height = height;
            HasImage = true;
        }
    }

    private sealed class AtlasRegionValues
    {
        public string X { get; set; } = "0";
        public string Y { get; set; } = "0";
        public string Width { get; set; } = "1";
        public string Height { get; set; } = "1";
    }

    private sealed record AtlasProjectContext(string ProjectRoot, string RelativePath, string Platform, bool Compressed);
}
