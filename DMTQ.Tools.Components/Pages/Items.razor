@page "/items"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ItemEditService ItemEditor
@inject ItemCatalogService ItemCatalog
@inject IDialogService DialogService

<ProjectListShell TItem="Item"
                  Title='@L["Nav.Items"]'
                  ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoItemsDetailed"]'
                  FilteredItems="@FilteredItems"
                  Pagination="@pagination"
                  Message="@message"
                  ErrorMessage="@errorMessage">
    <Toolbar>
        <div class="list-toolbar-layout">
            <div class="list-toolbar-filters">
                <ToolbarField Unlabeled Search>
                    <FluentTextInput Value="@filter" ValueChanged="SetFilterAsync" Immediate="true" Placeholder='@L["Lists.FilterItems"]'
                                     class="list-filter" />
                </ToolbarField>
                <ToolbarField>
                    <FluentSelect Items="Languages"
                                  OptionText="@(language => language)"
                                  OptionValue="@(language => language)"
                                  @bind-Value="selectedLanguage"
                                  @bind-Value:after="UpdateLanguageQueryAsync"
                                  Label='@L["Lists.Language"]'
                                  class="list-select" />
                </ToolbarField>
            </div>
            <div class="list-toolbar-actions">
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  OnClick="CreateNewItem">@L["Lists.AddItem"]</FluentButton>
                </ToolbarField>
            </div>
        </div>
    </Toolbar>

    <Metrics>
        <FluentGrid class="metric-grid" Spacing="3" AdaptiveRendering="true">
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Nav.Items"]</span><strong>@Catalog.Count</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">Active</span><strong>@Catalog.Count(item => item.Status.Equals("Y", StringComparison.OrdinalIgnoreCase))</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Lists.LocalizedNames"]</span><strong>@Catalog.Count(item => item.NamesByLanguage.ContainsKey(selectedLanguage))</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">Item types</span><strong>@Catalog.Select(item => item.ItemType).Where(type => !string.IsNullOrWhiteSpace(type)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong></FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </Metrics>

    <Columns>
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.Id)" Title="Item ID" Sortable="true" Width="8.25rem" MinWidth="8.25rem" />
        <TemplateColumn TGridItem="Item" Title="Name" Sortable="true" SortBy="@(GridSort<Item>.ByAscending(item => item.ItemName))" Width="1fr" MinWidth="14rem" Context="item">
            <strong>@ItemCatalog.GetDisplayName(item, selectedLanguage)</strong>
        </TemplateColumn>
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.ItemType)" Title="Type" Sortable="true" Width="6.25rem" MinWidth="6.25rem" />
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.Status)" Title="Status" Sortable="true" Width="6.25rem" MinWidth="6.25rem" />
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.BuyLevel)" Title="Buy Level" Width="6.25rem" MinWidth="6.25rem" />
        <TemplateColumn TGridItem="Item" Title="Summary" Width="2fr" MinWidth="18rem" Context="item">
            @ItemCatalog.GetLocalizedSummary(item, selectedLanguage)
        </TemplateColumn>
        <TemplateColumn TGridItem="Item" Title="Actions" Width="14rem" MinWidth="14rem" Context="item">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                              Appearance="ButtonAppearance.Default"
                              OnClick="() => EditItem(item.Id)"
                              Title='@L["Common.Edit"]' />
                <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                              Appearance="ButtonAppearance.Default"
                              OnClick="() => DeleteItemAsync(item)"
                              Title='@L["Common.Delete"]' />
            </FluentStack>
        </TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    private static readonly IReadOnlyList<string> Languages = ["CN", "JP", "KR", "TW", "US"];
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "lang")] public string? LanguageQuery { get; set; }
    private string filter => SearchQuery ?? string.Empty;
    private string selectedLanguage
    {
        get => LanguageQuery ?? "CN";
        set => LanguageQuery = value;
    }
    private string? message;
    private string? errorMessage;
    private PaginationState pagination = new() { ItemsPerPage = 25 };

    private PatchPackage? _lastPackage;
    private string? _lastPlatform;
    private IReadOnlyList<Item> _catalog = [];

    private IReadOnlyList<Item> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)
                && string.Equals(State.SelectedExportPlatform, _lastPlatform, StringComparison.OrdinalIgnoreCase)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _lastPlatform = State.SelectedExportPlatform;
            _catalog = State.CurrentPackage is null ? [] : ItemCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            return _catalog;
        }
    }

    private IEnumerable<Item> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filter)) return Catalog;

            return Catalog.Where(item =>
                item.Id.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || item.ItemName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || ItemCatalog.GetDisplayName(item, selectedLanguage).Contains(filter, StringComparison.OrdinalIgnoreCase)
                || item.ItemType.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }
    }

    private Task SetFilterAsync(string? value)
    {
        SearchQuery = value;
        TableNavigationState.UpdateQuery(Navigation, ("q", value), ("page", "1"));
        return Task.CompletedTask;
    }

    private Task UpdateLanguageQueryAsync()
    {
        TableNavigationState.UpdateQuery(Navigation, ("lang", selectedLanguage), ("page", "1"));
        return Task.CompletedTask;
    }

    private void CreateNewItem() => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, "/items/editor/new"));
    private void EditItem(string itemId) => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, $"/items/editor/{Uri.EscapeDataString(itemId)}"));

    private async Task DeleteItemAsync(Item item)
    {
        if (State.CurrentPackage is null) return;

        message = null;
        errorMessage = null;
        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", L["Nav.Items"].Value.ToLowerInvariant(), ItemCatalog.GetDisplayName(item, selectedLanguage)].Value,
            title: L["Nav.Items"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;

        try
        {
            ItemEditor.RemoveItem(State.CurrentPackage, item.Id, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            State.Diagnostics.Add($"Item deleted: {item.Id}");
            message = L["Lists.Deleted", L["Nav.Items"].Value, item.Id].Value;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Delete item error: " + ex.Message);
        }
    }
}
