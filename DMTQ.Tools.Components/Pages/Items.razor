@page "/items"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ItemEditService ItemEditor
@inject ItemCatalogService ItemCatalog
@inject IDialogService DialogService

<ProjectListShell TItem="Item"
                  Title='@L["Nav.Items"]'
                  ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoItemsDetailed"]'
                  FilteredItems="@FilteredItems"
                  Pagination="@pagination"
                  Message="@message"
                  ErrorMessage="@errorMessage">
    <Toolbar>
        <div class="list-toolbar-layout">
            <div class="list-toolbar-filters">
                <ToolbarField>
                    <FluentNumberInput @bind-Value="itemIdFilter" @bind-Value:after="ResetPagination" Label='@L["Fields.ItemId"]' />
                </ToolbarField>
                <ToolbarField Search>
                    <FluentTextInput Value="@itemNameFilter" ValueChanged="SetItemNameFilter" Immediate="true"
                                     Label='@L["Fields.ItemName"]' Placeholder='@L["Fields.ItemName"]' class="list-filter" />
                </ToolbarField>
                <ToolbarField>
                    <FluentSelect TOption="string" TValue="string"
                                  Items="@AvailableItemTypes"
                                  OptionText="GetItemTypeDisplay"
                                  OptionValue="@(type => type)"
                                  Multiple="true"
                                  IsImmediate="true"
                                  SelectedItems="@selectedItemTypes"
                                  SelectedItemsChanged="OnItemTypesChanged"
                                  Placeholder='@L["Lists.SelectItemTypes"]'
                                  Label='@L["Fields.ItemType"]'
                                  class="list-select item-type-select" />
                </ToolbarField>
                <ToolbarField>
                    <FluentSelect Items="Languages"
                                  OptionText="@(language => language)"
                                  OptionValue="@(language => language)"
                                  @bind-Value="selectedLanguage"
                                  @bind-Value:after="UpdateLanguageQueryAsync"
                                  Label='@L["Lists.Language"]'
                                  class="list-select" />
                </ToolbarField>
            </div>
            <div class="list-toolbar-actions">
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  OnClick="CreateNewItem">@L["Lists.AddItem"]</FluentButton>
                </ToolbarField>
            </div>
        </div>
    </Toolbar>

    <Metrics>
        <FluentGrid class="metric-grid" Spacing="3" AdaptiveRendering="true">
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Nav.Items"]</span><strong>@Catalog.Count</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Lists.Active"]</span><strong>@Catalog.Count(item => item.Status.Equals("Y", StringComparison.OrdinalIgnoreCase))</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Lists.LocalizedNames"]</span><strong>@Catalog.Count(item => item.NamesByLanguage.ContainsKey(selectedLanguage))</strong></FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard><span class="metric-label">@L["Lists.ItemTypes"]</span><strong>@Catalog.Select(item => GetItemTypeCode(item.ItemType)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong></FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </Metrics>

    <Columns>
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.Id)" Title='@L["Fields.ItemId"]' Sortable="true" Width="8.25rem" MinWidth="8.25rem" />
        <TemplateColumn TGridItem="Item" Title='@L["Fields.ItemName"]' Sortable="true" SortBy="@(GridSort<Item>.ByAscending(item => item.ItemName))" Width="1fr" MinWidth="14rem" Context="item">
            <strong>@ItemCatalog.GetDisplayName(item, selectedLanguage)</strong>
        </TemplateColumn>
        <TemplateColumn TGridItem="Item" Title='@L["Fields.ItemType"]' Sortable="true" SortBy="@(GridSort<Item>.ByAscending(item => item.ItemType))" Width="9rem" MinWidth="9rem" Context="item">
            @GetItemTypeDisplay(item.ItemType)
        </TemplateColumn>
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.ImgUrl1)" Title='@L["Fields.ImageUrl1"]' Width="1fr" MinWidth="12rem" />
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.RepeatCount)" Title='@L["Fields.RepeatCount"]' Width="8rem" MinWidth="8rem" />
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.Status)" Title='@L["Fields.Status"]' Sortable="true" Width="6.25rem" MinWidth="6.25rem" />
        <PropertyColumn TGridItem="Item" TProp="string" Property="@(item => item.BuyLevel)" Title='@L["Fields.BuyLevel"]' Width="8rem" MinWidth="8rem" />
        <TemplateColumn TGridItem="Item" Title='@L["Fields.Summary"]' Width="2fr" MinWidth="18rem" Context="item">
            @ItemCatalog.GetLocalizedSummary(item, selectedLanguage)
        </TemplateColumn>
        <TemplateColumn TGridItem="Item" Title='@L["Lists.Actions"]' Width="14rem" MinWidth="14rem" Context="item">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                              Size="ButtonSize.Small"
                              OnClick="() => EditItem(item.Id)"
                              Title='@L["Common.Edit"]'>
                    @L["Common.Edit"]
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                              Size="ButtonSize.Small"
                              OnClick="() => DeleteItemAsync(item)"
                              Title='@L["Common.Delete"]' />
            </FluentStack>
        </TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    private static readonly IReadOnlyList<string> Languages = ["CN", "JP", "KR", "TW", "US"];
    [SupplyParameterFromQuery(Name = "lang")] public string? LanguageQuery { get; set; }
    private int? itemIdFilter;
    private string itemNameFilter = string.Empty;
    private IEnumerable<string> selectedItemTypes = Array.Empty<string>();
    private string selectedLanguage
    {
        get => LanguageQuery ?? "CN";
        set => LanguageQuery = value;
    }
    private string? message;
    private string? errorMessage;
    private PaginationState pagination = new() { ItemsPerPage = 25 };

    private PatchPackage? _lastPackage;
    private string? _lastPlatform;
    private IReadOnlyList<Item> _catalog = [];

    private IReadOnlyList<Item> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)
                && string.Equals(State.SelectedExportPlatform, _lastPlatform, StringComparison.OrdinalIgnoreCase)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _lastPlatform = State.SelectedExportPlatform;
            _catalog = State.CurrentPackage is null ? [] : ItemCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            return _catalog;
        }
    }

    private IEnumerable<Item> FilteredItems
    {
        get
        {
            IEnumerable<Item> items = Catalog;
            if (itemIdFilter is not null)
                items = items.Where(item => int.TryParse(item.Id, out var id) && id == itemIdFilter.Value);
            if (!string.IsNullOrWhiteSpace(itemNameFilter))
                items = items.Where(item => ItemCatalog.GetDisplayName(item, selectedLanguage).Contains(itemNameFilter, StringComparison.OrdinalIgnoreCase)
                    || item.ItemName.Contains(itemNameFilter, StringComparison.OrdinalIgnoreCase));
            if (selectedItemTypes.Any())
                items = items.Where(item => selectedItemTypes.Contains(GetItemTypeCode(item.ItemType)));
            return items;
        }
    }

    private IReadOnlyList<string> AvailableItemTypes => Catalog.Select(item => GetItemTypeCode(item.ItemType))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private static string GetItemTypeCode(string? itemType)
    {
        var code = itemType?.Trim() ?? string.Empty;
        if (code.Length == 1)
        {
            var normalized = code.ToUpperInvariant();
            if (normalized is "S" or "N" or "K" or "C" or "F" or "M" or "Q" or "T" or "I" or "P" or "L")
                return normalized;
        }
        if (code.Equals("itempack", StringComparison.OrdinalIgnoreCase)) return "itempack";
        if (code.Equals("ticket", StringComparison.OrdinalIgnoreCase)) return "ticket";
        return code;
    }

    private string GetItemTypeDisplay(string? itemType)
    {
        var code = GetItemTypeCode(itemType);
        var label = code switch
        {
            "" => L["Options.EffectTypeNone"].Value,
            "S" => L["Options.ItemTypeMusic"].Value,
            "N" => L["Options.ItemTypeNoteSkin"].Value,
            "K" => L["Options.ItemTypeStatusBarSkin"].Value,
            "C" => L["Options.ItemTypePartner"].Value,
            "F" => L["Options.ItemTypeAddOn"].Value,
            "M" => L["Options.ItemTypeMaxPoint"].Value,
            "Q" => L["Options.ItemTypeQPoint"].Value,
            "T" => L["Options.ItemTypeUnlock"].Value,
            "I" => L["Options.ItemTypeIngame"].Value,
            "P" => L["Options.ItemTypeMusicPack"].Value,
            "itempack" => L["Options.ItemTypeItemPack"].Value,
            "ticket" => L["Options.ItemTypeTicket"].Value,
            "L" => L["Options.ItemTypeRawCode"].Value,
            _ => L["Fields.ExistingValue"].Value
        };
        return code.Length == 0 ? label : $"({code}){label}";
    }

    private Task SetItemNameFilter(string? value)
    {
        itemNameFilter = value ?? string.Empty;
        ResetPagination();
        return Task.CompletedTask;
    }

    private async Task OnItemTypesChanged(IEnumerable<string> types)
    {
        selectedItemTypes = types.ToArray();
        await pagination.SetCurrentPageIndexAsync(0);
        await InvokeAsync(StateHasChanged);
    }

    private void ResetPagination() => _ = pagination.SetCurrentPageIndexAsync(0);

    private Task UpdateLanguageQueryAsync()
    {
        TableNavigationState.UpdateQuery(Navigation, ("lang", selectedLanguage), ("page", "1"));
        return Task.CompletedTask;
    }

    private void CreateNewItem() => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, "/items/editor/new"));
    private void EditItem(string itemId) => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, $"/items/editor/{Uri.EscapeDataString(itemId)}"));

    private async Task DeleteItemAsync(Item item)
    {
        if (State.CurrentPackage is null) return;

        message = null;
        errorMessage = null;
        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", L["Nav.Items"].Value.ToLowerInvariant(), ItemCatalog.GetDisplayName(item, selectedLanguage)].Value,
            title: L["Nav.Items"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;

        try
        {
            ItemEditor.RemoveItem(State.CurrentPackage, item.Id, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            State.Diagnostics.Add($"Item deleted: {item.Id}");
            message = L["Lists.Deleted", L["Nav.Items"].Value, item.Id].Value;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Delete item error: " + ex.Message);
        }
    }
}
