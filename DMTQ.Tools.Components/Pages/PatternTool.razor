@page "/patterns"
@using System.Globalization
@using System.Text
@using DMTQ.Tools.Core.Models.Pattern
@using DMTQ.Tools.Core.Services.Pattern
@inject IProjectFilePicker FilePicker
@inject IProjectFileSaver FileSaver
@inject PatternBinarySerializer Serializer
@inject PatternTextSerializer TextSerializer
@inject PatternCompatibilityValidator CompatibilityValidator

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <FluentMessageBar Intent="@statusIntent">@statusMessage</FluentMessageBar>
}

@if (!Embedded)
{
    <PageTitle>@L["Pattern.Title"]</PageTitle>
    <h1>@L["Pattern.Title"]</h1>
}

<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalGap="16" class="pattern-tool-stack">
    <section class="toolbar-panel pattern-toolbar pattern-tool-width @(Embedded ? "pattern-toolbar-embedded" : null)">
        <div class="pattern-toolbar-layout">
            @ToolbarContent
            @if (!Embedded)
            {
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  OnClick="LoadPatternAsync"
                                  Disabled="@isBusy">
                        @L["Pattern.Open"]
                    </FluentButton>
                </ToolbarField>
            }
            <ToolbarField>
                <FluentSelect TOption="PatternFormat"
                              TValue="PatternFormat"
                              Items="TargetFormats"
                              OptionText="@(format => FormatName(format))"
                              OptionValue="@(format => format)"
                              @bind-Value="targetFormat"
                              Label='@L["Pattern.ExportFormat"]'
                              Disabled="@(pattern is null || isBusy)"
                              class="pattern-format-select" />
            </ToolbarField>
            <ToolbarField Unlabeled>
                <FluentButton Appearance="ButtonAppearance.Default"
                              OnClick="SavePatternAsync"
                              Disabled="@(pattern is null || isBusy)">
                    @L["Pattern.SaveAs"]
                </FluentButton>
            </ToolbarField>
            @if (isBusy)
            {
                <FluentSpinner />
            }
        </div>
        @if (!Embedded)
        {
            <p class="section-hint">@L["Pattern.OpenHintWithText"]</p>
        }
    </section>

    @if (pattern is null)
    {
        <FluentCard>
            <p class="status-message">@L["Pattern.NoPattern"]</p>
        </FluentCard>
    }
    else
    {
        var validationIssues = CompatibilityValidator.Validate(pattern);
        <section class="pattern-overview-layout pattern-tool-width">
            <section class="pattern-info-section">
                <h2 class="section-heading">@L["Pattern.BasicInfo"]</h2>
                <div class="pattern-info-grid">
                    <div><span>@L["Pattern.File"]</span><strong title="@fileName">@fileName</strong></div>
                    <div><span>@L["Pattern.SourceFormat"]</span><strong>@FormatName(pattern.SourceFormat)</strong></div>
                    @if (pattern.SourceFormat == PatternFormat.Pt)
                    {
                        <div><span>@L["Pattern.Encrypted"]</span><strong>@(pattern.WasEncrypted ? L["Pattern.Yes"] : L["Pattern.No"])</strong></div>
                        <div><span>@L["Pattern.Version"]</span><strong>@pattern.Header.PtVersion</strong></div>
                        <div><span>@L["Pattern.PtRawHeaderFieldB"]</span><strong>@pattern.Header.TagB</strong></div>
                    }
                    @if (pattern.SourceFormat == PatternFormat.Bytes || pattern.Header.BytesTick != 0 || pattern.Header.BytesPlayTime != 0)
                    {
                        <div><span>@L["Pattern.BytesTick"]</span><strong>@pattern.Header.BytesTick</strong></div>
                        <div><span>@L["Pattern.BytesPlayTime"]</span><strong>@pattern.Header.BytesPlayTime.ToString("0.###", CultureInfo.InvariantCulture)</strong></div>
                    }
                    <div><span>@L["Pattern.PositionsPerMeasure"]</span><strong>@pattern.Header.PositionsPerMeasure</strong></div>
                    <div><span>@L["Pattern.InitialBpm"]</span><strong>@pattern.Header.InitialBpm.ToString("0.###", CultureInfo.InvariantCulture)</strong></div>
                    <div><span>@L["Pattern.EndPosition"]</span><strong>@pattern.Header.EndPosition</strong></div>
                    <div><span>@L["Pattern.Events"]</span><strong>@pattern.CommandCount</strong></div>
                    <div><span>@L["Pattern.Tracks"]</span><strong>@pattern.Tracks.Count</strong></div>
                    <div><span>@L["Pattern.Sounds"]</span><strong>@pattern.Sounds.Count</strong></div>
                </div>
            </section>

            <section class="pattern-sounds-section">
                <h2 class="section-heading">@L["Pattern.SoundList"] <span class="table-counts">(@pattern.Sounds.Count)</span></h2>
                <div class="grid-scroll pattern-grid">
                    <FluentDataGrid Items="@SoundItems" TGridItem="PatternSound">
                        <PropertyColumn TGridItem="PatternSound" TProp="ushort" Property="@(sound => sound.Id)" Title='@L["Pattern.SoundId"]' Sortable="true" Width="4.5rem" MinWidth="4.5rem" />
                        <PropertyColumn TGridItem="PatternSound" TProp="ushort" Property="@(sound => sound.Flags)" Title='@L["Pattern.Flags"]' Width="4.5rem" MinWidth="4.5rem" />
                        <PropertyColumn TGridItem="PatternSound" TProp="string" Property="@(sound => sound.FileName)" Title='@L["Pattern.FileName"]' Width="1fr" MinWidth="8rem" />
                    </FluentDataGrid>
                </div>
            </section>
        </section>

        <section class="pattern-tool-width">
            <h2 class="section-heading">@L["Pattern.Validation.Title"]</h2>
            @if (validationIssues.Count == 0)
            {
                <FluentMessageBar Intent="MessageBarIntent.Success">@L["Pattern.Validation.Passed"]</FluentMessageBar>
            }
            else
            {
                <div class="pattern-validation-list">
                    @foreach (var issue in validationIssues)
                    {
                        <FluentMessageBar Intent="@(issue.Severity == PatternValidationSeverity.Warning ? MessageBarIntent.Warning : MessageBarIntent.Info)">
                            @(issue.Argument is null ? L[issue.ResourceKey] : L[issue.ResourceKey, issue.Argument])
                        </FluentMessageBar>
                    }
                </div>
            }
        </section>

        <section class="pattern-tool-width">
            <h2 class="section-heading">@L["Pattern.EventList"] <span class="table-counts">(@pattern.CommandCount)</span></h2>
            <div class="grid-scroll pattern-grid">
                <FluentDataGrid Items="@EventItems" TGridItem="PatternEventRow">
                    <PropertyColumn TGridItem="PatternEventRow" TProp="int" Property="@(item => item.Track)" Title='@L["Pattern.Track"]' Sortable="true" Width="4rem" MinWidth="4rem" />
                    <PropertyColumn TGridItem="PatternEventRow" TProp="long" Property="@(item => item.Position)" Title='@L["Pattern.Position"]' Sortable="true" Width="6rem" MinWidth="6rem" />
                    <PropertyColumn TGridItem="PatternEventRow" TProp="string" Property="@(item => item.Type)" Title='@L["Pattern.Type"]' Width="7rem" MinWidth="7rem" />
                    <PropertyColumn TGridItem="PatternEventRow" TProp="string" Property="@(item => item.Details)" Title='@L["Pattern.Details"]' Width="1fr" MinWidth="16rem" />
                </FluentDataGrid>
            </div>
        </section>
    }
</FluentStack>

@code {
    private static readonly IReadOnlyList<PatternFormat> TargetFormats =
        [PatternFormat.Pt, PatternFormat.Bytes, PatternFormat.Text];

    private PatternDocument? pattern;
    private PatternFormat targetFormat = PatternFormat.Pt;
    private string fileName = string.Empty;
    private string? statusMessage;
    private MessageBarIntent statusIntent = MessageBarIntent.Info;
    private bool isBusy;
    private string? loadedInitialFilePath;

    [Parameter] public string? InitialFilePath { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    private IQueryable<PatternSound> SoundItems =>
        pattern?.Sounds.AsQueryable() ?? Enumerable.Empty<PatternSound>().AsQueryable();

    private IQueryable<PatternEventRow> EventItems =>
        pattern is null
            ? Enumerable.Empty<PatternEventRow>().AsQueryable()
            : pattern.Tracks
                .SelectMany((track, trackIndex) => track.Commands.Select((command, eventIndex) => (Track: trackIndex, EventIndex: eventIndex, Command: command)))
                .OrderBy(item => item.Command.Position)
                .ThenBy(item => item.Track)
                .ThenBy(item => item.EventIndex)
                .Select((item, index) => new PatternEventRow(
                    index,
                    item.Track,
                    item.Command.Position,
                    CommandName(item.Command),
                    CommandDetails(item.Command)))
                .AsQueryable();

    private string FormatName(PatternFormat format) => format switch
    {
        PatternFormat.Bytes => "bytes",
        PatternFormat.Pt => "pt",
        PatternFormat.Text => "text",
        _ => format.ToString()
    };

    private string FormatValue(PatternFormat format) => format.ToString();

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(InitialFilePath)
            || string.Equals(InitialFilePath, loadedInitialFilePath, StringComparison.OrdinalIgnoreCase))
            return;

        loadedInitialFilePath = InitialFilePath;
        await LoadPatternFromPathAsync(InitialFilePath);
    }

    private async Task LoadPatternAsync()
    {
        var path = await FilePicker.PickFileAsync();
        if (string.IsNullOrWhiteSpace(path))
            return;

        await LoadPatternFromPathAsync(path);
    }

    private async Task LoadPatternFromPathAsync(string path)
    {
        var format = GetFormat(path);
        if (format is null)
        {
            ShowStatus(L["Pattern.UnsupportedExtensionWithText"].Value, MessageBarIntent.Warning);
            return;
        }

        isBusy = true;
        ShowStatus(L["Pattern.Loading"].Value, MessageBarIntent.Info);
        try
        {
            await using var stream = File.OpenRead(path);
            pattern = format.Value == PatternFormat.Text
                ? await TextSerializer.DeserializeAsync(stream)
                : await Serializer.DeserializeAsync(stream, format.Value);
            fileName = Path.GetFileName(path);
            targetFormat = format.Value;
            ShowStatus(L["Pattern.Loaded", fileName].Value, MessageBarIntent.Success);
        }
        catch (Exception ex)
        {
            pattern = null;
            fileName = string.Empty;
            ShowStatus(L["Pattern.LoadFailed", ex.Message].Value, MessageBarIntent.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SavePatternAsync()
    {
        if (pattern is null)
            return;

        isBusy = true;
        statusMessage = null;
        try
        {
            var options = new PatternSerializationOptions
            {
                PtVersion = pattern.Header.PtVersion is 1 or 1536 ? pattern.Header.PtVersion : (short)1,
                BytesMagic = pattern.Header.BytesMagic
            };
            var data = targetFormat == PatternFormat.Text
                ? Encoding.UTF8.GetBytes(TextSerializer.Serialize(pattern))
                : Serializer.Serialize(pattern, targetFormat, options);
            var suggestedName = BuildSuggestedFileName(targetFormat);
            await using var content = new MemoryStream(data, writable: false);
            var savedPath = await FileSaver.SaveFileAsync(suggestedName, content);
            if (savedPath is not null)
            {
                fileName = Path.GetFileName(savedPath);
                ShowStatus(L["Pattern.Saved", fileName].Value, MessageBarIntent.Success);
            }
        }
        catch (Exception ex)
        {
            ShowStatus(L["Pattern.SaveFailed", ex.Message].Value, MessageBarIntent.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private string BuildSuggestedFileName(PatternFormat format)
    {
        var stem = Path.GetFileNameWithoutExtension(fileName);
        if (string.IsNullOrWhiteSpace(stem))
            stem = "pattern";

        return $"{stem}.{FormatExtension(format)}";
    }

    private static string FormatExtension(PatternFormat format) => format switch
    {
        PatternFormat.Bytes => "bytes",
        PatternFormat.Pt => "pt",
        PatternFormat.Text => "txt",
        _ => format.ToString().ToLowerInvariant()
    };

    private static PatternFormat? GetFormat(string path)
        => Path.GetExtension(path).ToLowerInvariant() switch
        {
            ".bytes" => PatternFormat.Bytes,
            ".pt" => PatternFormat.Pt,
            ".txt" => PatternFormat.Text,
            "" => PatternFormat.Bytes,
            _ => null
        };

    private static string CommandName(PatternCommand command) => command.Type switch
    {
        1 => "Default (1)",
        2 => "Volume (2)",
        3 => "Tempo (3)",
        _ => $"Any ({command.Type})"
    };

    private static string CommandDetails(PatternCommand command) => command.Type switch
    {
        1 => $"Ins={command.SoundIndex}, Vel={command.Volume}, Pan={command.Pan}, Attr={command.Attribute}, Dur={command.BytesDuration?.ToString(CultureInfo.InvariantCulture) ?? command.Length.ToString(CultureInfo.InvariantCulture)}, Extra=0x{command.RawParameters[7]:X2}",
        2 => $"Volume={command.Volume}, Reserved={Convert.ToHexString(command.RawParameters.AsSpan(1, 7))}",
        3 => $"Tempo={command.Bpm.ToString("0.###", CultureInfo.InvariantCulture)}, Reserved={Convert.ToHexString(command.RawParameters.AsSpan(4, 4))}",
        4 => $"Beat={command.Beat}, Reserved={Convert.ToHexString(command.RawParameters.AsSpan(1, 7))}",
        _ when command.BytesUnknownData1 is not null && command.BytesUnknownData2 is not null => $"Data1={command.BytesUnknownData1}, Data2={command.BytesUnknownData2}",
        _ => Convert.ToHexString(command.RawParameters)
    };

    private void ShowStatus(string message, MessageBarIntent intent)
    {
        statusMessage = message;
        statusIntent = intent;
    }

    private sealed record PatternEventRow(int RowIndex, int Track, long Position, string Type, string Details);
}
