@page "/songs"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject SongEditService SongEditor
@inject SongCatalogService SongCatalog
@inject IDialogService DialogService

<ProjectListShell TItem="Song"
                  Title='@L["Nav.Songs"]'
                  ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoSongs"]'
                  FilteredItems="@FilteredSongs"
                  Pagination="@pagination"
                  Message="@message"
                  ErrorMessage="@errorMessage">
    <Toolbar>
        <div class="list-toolbar-layout">
            <div class="list-toolbar-filters">
                <ToolbarField Unlabeled Search>
                    <FluentTextInput Value="@filter" ValueChanged="SetFilterAsync" Immediate="true" Placeholder='@L["Lists.FilterSongs"]'
                                     class="list-filter" />
                </ToolbarField>
                <ToolbarField>
                    <FluentSelect Items="Languages"
                                  OptionText="@(l => l)"
                                  OptionValue="@(l => l)"
                                  @bind-Value="selectedLanguage"
                                  @bind-Value:after="UpdateLanguageQueryAsync"
                                  Label='@L["Lists.PreviewLanguage"]'
                                  class="list-select" />
                </ToolbarField>
            </div>
            <div class="list-toolbar-actions">
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  OnClick="CreateNewSong">@L["Lists.AddSong"]</FluentButton>
                </ToolbarField>
            </div>
        </div>
    </Toolbar>

    <Metrics>
        <FluentGrid class="metric-grid" Spacing="3" AdaptiveRendering="true">
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">@L["Nav.Songs"]</span><strong>@Catalog.Count</strong>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">@L["Lists.Patterns"]</span><strong>@Catalog.Sum(s => s.Patterns.Count)</strong>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">@L["Lists.WithPreview"]</span><strong>@Catalog.Count(s => s.HasPreview)</strong>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">@L["Common.Languages"]</span><strong>@Languages.Count</strong>
                </FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </Metrics>

    <Columns>
        <PropertyColumn TGridItem="Song" TProp="int" Property="@(s => s.Id)" Title="Song ID" Sortable="true" Width="6.25rem" MinWidth="6.25rem" />
        <TemplateColumn TGridItem="Song" Title='@L["Lists.Name"]' Sortable="true" SortBy="@(GridSort<Song>.ByAscending(s => s.Name))" Width="2fr" MinWidth="14rem" Context="song">
            <strong>@DisplayTitle(song)</strong>
        </TemplateColumn>
        <PropertyColumn TGridItem="Song" TProp="string" Property="@(s => s.Genre)" Title="Genre" Sortable="true" Width="1fr" MinWidth="10rem" />
        <PropertyColumn TGridItem="Song" TProp="string" Property="@(s => s.ArtistName)" Title='@L["Lists.Artist"]' Sortable="true" Width="1.75fr" MinWidth="12rem" />
        <TemplateColumn TGridItem="Song" Title='@L["Lists.Patterns"]' Width="6.25rem" MinWidth="6.25rem" Context="song">
            @song.Patterns.Count
        </TemplateColumn>
        <TemplateColumn TGridItem="Song" Title='@L["Lists.ItemCover"]' Width="0.9fr" MinWidth="7rem" Context="song">
            @{
                var spriteName = ItemCover(song);
            }
            @if (string.IsNullOrWhiteSpace(spriteName))
            {
                @L["Lists.None"]
            }
            else
            {
                <a href="#" class="song-cover-preview-link" @onclick="@(() => ShowCoverPreviewAsync(spriteName))"
                   @onclick:preventDefault="true">@spriteName</a>
            }
        </TemplateColumn>
        <TemplateColumn TGridItem="Song" Title='@L["Lists.HasPreview"]' Width="8rem" MinWidth="8rem" Context="song">
            @(song.HasPreview ? L["Lists.Yes"] : L["Lists.No"])
        </TemplateColumn>
        <TemplateColumn TGridItem="Song" Title="Actions" Width="10rem" MinWidth="10rem" Context="song">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                              Appearance="ButtonAppearance.Default"
                              OnClick="() => EditSong(song.Id.ToString())"
                              Title='@L["Common.Edit"]' />
                <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                              Appearance="ButtonAppearance.Default"
                              OnClick="() => DeleteSongAsync(song)"
                              Title='@L["Common.Delete"]' />
            </FluentStack>
        </TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "lang")] public string? LanguageQuery { get; set; }
    private string filter => SearchQuery ?? string.Empty;
    private string selectedLanguage
    {
        get => LanguageQuery ?? "CN";
        set => LanguageQuery = value;
    }
    private string? message;
    private string? errorMessage;
    private PaginationState pagination = new() { ItemsPerPage = 25 };

    private PatchPackage? _lastPackage;
    private string? _lastPlatform;
    private IReadOnlyList<Song> _catalog = [];
    private IReadOnlyDictionary<string, Item> _songItems = new Dictionary<string, Item>(StringComparer.OrdinalIgnoreCase);
    private static readonly IReadOnlyList<string> _languages = ["CN", "JP", "KR", "TW", "US"];

    private IReadOnlyList<Song> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)
                && string.Equals(State.SelectedExportPlatform, _lastPlatform, StringComparison.OrdinalIgnoreCase)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _lastPlatform = State.SelectedExportPlatform;
            _catalog = State.CurrentPackage is null ? [] : SongCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            _songItems = State.CurrentPackage is null
                ? new Dictionary<string, Item>(StringComparer.OrdinalIgnoreCase)
                : State.CurrentPackage.GetPlatformTables(State.SelectedExportPlatform).Items
                    .Where(item => item.ItemType.Equals("S", StringComparison.OrdinalIgnoreCase))
                    .GroupBy(item => item.Id, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);
            return _catalog;
        }
    }

    private IReadOnlyList<string> Languages => _languages;

    private IEnumerable<Song> FilteredSongs
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filter)) return Catalog;
            return Catalog.Where(song =>
                song.Id.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase)
                || song.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || song.ArtistName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || song.Genre.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string DisplayTitle(Song song)
    {
        var lang = selectedLanguage ?? "CN";
        if (song.Localizations.TryGetValue(lang, out var loc) && !string.IsNullOrWhiteSpace(loc.FullName))
            return loc.FullName;
        return string.IsNullOrWhiteSpace(song.Name) ? song.Id.ToString() : song.Name;
    }

    private string? ItemCover(Song song)
    {
        var itemId = song.ItemId.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return _songItems.TryGetValue(itemId, out var item) ? item.ImgUrl1 : null;
    }

    private async Task ShowCoverPreviewAsync(string spriteName)
    {
        await DialogService.ShowDialogAsync<SongCoverPreviewDialog>(options =>
        {
            options.Header.Title = L["SongCoverPreview.Title", spriteName].Value;
            options.Width = "min(1000px, 95vw)";
            options.Footer.PrimaryAction.Label = L["Common.Close"].Value;
            options.Parameters = new Dictionary<string, object?>
            {
                [nameof(SongCoverPreviewDialog.SpriteName)] = spriteName
            };
        });
    }

    private Task SetFilterAsync(string? value)
    {
        SearchQuery = value;
        TableNavigationState.UpdateQuery(Navigation, ("q", value), ("page", "1"));
        return Task.CompletedTask;
    }

    private Task UpdateLanguageQueryAsync()
    {
        TableNavigationState.UpdateQuery(Navigation, ("lang", selectedLanguage), ("page", "1"));
        return Task.CompletedTask;
    }

    private void CreateNewSong() => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, "/songs/editor/new"));
    private void EditSong(string songId) => Navigation.NavigateTo(TableNavigationState.CreateEditorUrl(Navigation, $"/songs/editor/{Uri.EscapeDataString(songId)}"));

    private async Task DeleteSongAsync(Song song)
    {
        if (State.CurrentPackage is null) return;

        message = null;
        errorMessage = null;

        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", "song", DisplayTitle(song)].Value,
            title: L["Nav.Songs"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;

        try
        {
            SongEditor.RemoveSong(State.CurrentPackage, song.Id, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            _lastPackage = null; // invalidate catalog cache
            State.Diagnostics.Add($"Song deleted: {song.Id}");
            message = L["Lists.Deleted", L["Nav.Songs"].Value, DisplayTitle(song)].Value;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Delete song error: " + ex.Message);
        }
    }

}
