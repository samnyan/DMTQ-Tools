@page "/songs"
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject SongCatalogService SongCatalog
@inject SongEditService SongEditor

<h1>Songs</h1>

@if (State.CurrentPackage is null)
{
    <section class="toolbar-panel">
        <div class="status-message">Import or open a project before editing songs.</div>
    </section>
}
else
{
    <section class="toolbar-panel song-toolbar">
        <input class="form-control" @bind="filter" @bind:event="oninput" placeholder="Filter by song ID, title, product, item..." />
        <label class="form-label">
            Language
            <select class="form-control" @bind="selectedLanguage">
                @foreach (var language in Languages)
                {
                    <option value="@language">@language</option>
                }
            </select>
        </label>
    </section>

    <section class="metrics-grid">
        <div class="metric"><span class="metric-label">Songs</span><strong>@Catalog.Count</strong></div>
        <div class="metric"><span class="metric-label">Patterns</span><strong>@Catalog.Sum(s => s.Patterns.Count)</strong></div>
        <div class="metric"><span class="metric-label">With preview</span><strong>@Catalog.Count(s => s.HasPreview)</strong></div>
        <div class="metric"><span class="metric-label">Languages</span><strong>@string.Join(", ", Languages)</strong></div>
    </section>

    <section class="song-browser">
        <aside class="song-list">
            @foreach (var song in FilteredSongs.Take(300))
            {
                <button class="song-list-item @(song.Id == SelectedSong?.Id ? "selected" : "")"
                    @onclick="() => SelectSong(song.Id)">
                    <strong>@DisplayTitle(song)</strong>
                    <span>@song.Id / @song.Patterns.Count pattern(s) / @(song.HasPreview ? "preview" : "no preview")</span>
                </button>
            }
            <div class="song-add-section">
                <button class="btn btn-primary" @onclick="() => showAddSong = !showAddSong">+ Add Song</button>
                @if (showAddSong)
                {
                    <div class="song-add-form">
                        <input class="form-control" @bind="newSongId" placeholder="Song ID" />
                        <input class="form-control" @bind="newProductId" placeholder="Product ID" />
                        <input class="form-control" @bind="newItemId" placeholder="Item ID" />
                        <input class="form-control" @bind="newCategoryId" placeholder="Category ID" />
                        <button class="btn btn-secondary" @onclick="AddSong" disabled="@isBusy">Create</button>
                        <span class="status-message">@addMessage</span>
                    </div>
                }
            </div>
        </aside>

        <section class="song-detail">
            @if (SelectedSong is null)
            {
                <div class="status-message">Select a song from the list.</div>
            }
            else
            {
                @* ── Song Info ── *@
                <div class="table-header">
                    <h2>@DisplayTitle(SelectedSong)</h2>
                    <span class="song-id-badge">@SelectedSong.Id</span>
                </div>

                <div class="song-form-grid">
                    <label class="form-label">Item ID <input class="form-control" @bind="SelectedSong.ItemId" /></label>
                    <label class="form-label">Name <input class="form-control" @bind="SelectedSong.Name" /></label>
                    <label class="form-label">Full Name <input class="form-control" @bind="SelectedSong.FullName" /></label>
                    <label class="form-label">Genre <input class="form-control" @bind="SelectedSong.Genre" /></label>
                    <label class="form-label">Artist Name <input class="form-control" @bind="SelectedSong.ArtistName" /></label>
                    <label class="form-label">Original BGA <input class="form-control" @bind="SelectedSong.OriginalBgaYn" /></label>
                    <label class="form-label">Loop BGA <input class="form-control" @bind="SelectedSong.LoopBgaYn" /></label>
                    <label class="form-label">Composed By <input class="form-control" @bind="SelectedSong.ComposedBy" /></label>
                    <label class="form-label">Singer <input class="form-control" @bind="SelectedSong.Singer" /></label>
                    <label class="form-label">Feat By <input class="form-control" @bind="SelectedSong.FeatBy" /></label>
                    <label class="form-label">Arranged By <input class="form-control" @bind="SelectedSong.ArrangedBy" /></label>
                    <label class="form-label">Visualized By <input class="form-control" @bind="SelectedSong.VisualizedBy" /></label>
                    <label class="form-label">Cost Game Point <input class="form-control" @bind="SelectedSong.CostGamePoint" /></label>
                    <label class="form-label">Cost Game Cash <input class="form-control" @bind="SelectedSong.CostGameCash" /></label>
                    <label class="form-label">Flag <input class="form-control" @bind="SelectedSong.Flag" /></label>
                    <label class="form-label">Status <input class="form-control" @bind="SelectedSong.Status" /></label>
                    <label class="form-label">Free <input class="form-control" @bind="SelectedSong.FreeYn" /></label>
                    <label class="form-label">Hidden <input class="form-control" @bind="SelectedSong.HiddenYn" /></label>
                    <label class="form-label">Open <input class="form-control" @bind="SelectedSong.OpenYn" /></label>
                    <label class="form-label">Track ID <input class="form-control" @bind="SelectedSong.TrackId" /></label>
                    <label class="form-label">Mod Date <input class="form-control" @bind="SelectedSong.ModDate" /></label>
                    <label class="form-label">Update <input class="form-control" @bind="SelectedSong.Update" /></label>
                </div>
                <div class="song-form-grid">
                    <label class="form-label">Preview path <input class="form-control" @bind="SelectedSong.PreviewPackageRelativePath" /></label>
                    <label class="form-label">Title (@selectedLanguage) <input class="form-control" @bind="editTitle" /></label>
                    <label class="form-label">Description (@selectedLanguage) <input class="form-control" @bind="editDescription" /></label>
                </div>
                <div class="input-row">
                    <button class="btn btn-primary" @onclick="SaveSelectedSong" disabled="@isBusy">Save Song</button>
                    <span class="status-message">@editMessage</span>
                </div>

                @* ── Localization table ── *@
                <h2 class="section-heading">Localized Texts</h2>
                <div class="grid-scroll compact-grid-scroll">
                    <table class="data-grid">
                        <thead><tr><th>Language</th><th>Title</th><th>Description</th><th>Item Name</th></tr></thead>
                        <tbody>
                            @foreach (var lang in Languages)
                            {
                                <tr>
                                    <td>@lang</td>
                                    <td>@GetLocalized(SelectedSong.TitlesByLanguage, lang)</td>
                                    <td>@GetLocalized(SelectedSong.DescriptionsByLanguage, lang)</td>
                                    <td>@GetLocalized(SelectedSong.ItemNamesByLanguage, lang)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h2 class="section-heading">Linked IDs</h2>
                <div class="song-summary-grid">
                    <div><span class="metric-label">Products</span><strong>@string.Join(", ", SelectedSong.ProductIds)</strong></div>
                    <div><span class="metric-label">Items</span><strong>@string.Join(", ", SelectedSong.ItemIds)</strong></div>
                    <div><span class="metric-label">Categories</span><strong>@string.Join(", ", SelectedSong.CategoryIds)</strong></div>
                </div>

                @* ── Patterns ── *@
                <div class="table-header">
                    <h2 class="section-heading">Song Patterns</h2>
                    <button class="btn btn-secondary" @onclick="() => showAddPattern = !showAddPattern">+ Add Pattern</button>
                </div>
                @if (showAddPattern)
                {
                    <div class="song-add-form">
                        <input class="form-control" @bind="newPatternId" placeholder="Pattern ID" />
                        <input class="form-control" @bind="newPatternLine" placeholder="Line (2Line/3Line/4Line)" />
                        <input class="form-control" @bind="newPatternSignature" placeholder="Signature (1/2/3)" />
                        <input class="form-control" @bind="newPatternDifficulty" placeholder="Difficulty" />
                        <button class="btn btn-secondary" @onclick="AddPattern" disabled="@isBusy">Add Pattern</button>
                    </div>
                }
                <div class="grid-scroll compact-grid-scroll">
                    <table class="data-grid">
                        <thead><tr><th>Pattern ID</th><th>Line</th><th>Signature</th><th>Difficulty</th><th>Level</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var pattern in SortedPatterns)
                            {
                                <tr>
                                    <td>@pattern.PatternId</td>
                                    <td><input class="cell-input" @bind="pattern.Line" /></td>
                                    <td><input class="cell-input" @bind="pattern.Signature" /></td>
                                    <td><input class="cell-input" @bind="pattern.Difficulty" /></td>
                                    <td><input class="cell-input" @bind="pattern.Level" /></td>
                                    <td><button class="btn btn-secondary btn-small" @onclick="() => SavePattern(pattern)"
                                        disabled="@isBusy">Save</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>
}

@code {
    private string filter = string.Empty;
    private string selectedLanguage = "us";
    private string? selectedSongId;
    private bool isBusy;
    private string? editMessage;
    private string? addMessage;
    private string editTitle = string.Empty;
    private string editDescription = string.Empty;
    private string newSongId = string.Empty;
    private string newProductId = string.Empty;
    private string newItemId = string.Empty;
    private string newCategoryId = string.Empty;
    private string newPatternId = string.Empty;
    private string newPatternLine = string.Empty;
    private string newPatternSignature = string.Empty;
    private string newPatternDifficulty = string.Empty;
    private bool showAddSong;
    private bool showAddPattern;

    private PatchPackage? _lastPackage;
    private IReadOnlyList<Song> _catalog = [];
    private IReadOnlyList<string> _cachedLanguages = [];

    private IReadOnlyList<Song> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _catalog = State.CurrentPackage is null ? [] : SongCatalog.BuildCatalog(State.CurrentPackage);
            _cachedLanguages = ComputeLanguages(_catalog);
            return _catalog;
        }
    }

    private IReadOnlyList<string> Languages => _cachedLanguages;

    private IEnumerable<Song> FilteredSongs
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filter)) return Catalog;
            return Catalog.Where(song =>
                song.Id.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || song.GetTitle(selectedLanguage).Contains(filter, StringComparison.OrdinalIgnoreCase)
                || song.GetItemName(selectedLanguage).Contains(filter, StringComparison.OrdinalIgnoreCase)
                || song.ProductIds.Any(id => id.Contains(filter, StringComparison.OrdinalIgnoreCase))
                || song.ItemIds.Any(id => id.Contains(filter, StringComparison.OrdinalIgnoreCase))
                || song.CategoryIds.Any(id => id.Contains(filter, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private Song? SelectedSong
        => Catalog.FirstOrDefault(s => s.Id == selectedSongId) ?? FilteredSongs.FirstOrDefault();

    private IEnumerable<SongPattern> SortedPatterns
    {
        get
        {
            if (SelectedSong is null) return [];
            return SelectedSong.Patterns
                .OrderBy(p => p.Line.Length).ThenBy(p => p.Line)
                .ThenBy(p => p.Signature.Length).ThenBy(p => p.Signature);
        }
    }

    private void SelectSong(string songId)
    {
        selectedSongId = songId;
        showAddPattern = false;
        if (SelectedSong is not null)
        {
            editTitle = SelectedSong.GetTitle(selectedLanguage);
            editDescription = SelectedSong.GetDescription(selectedLanguage);
        }
        editMessage = null;
    }

    private string DisplayTitle(Song song)
    {
        var title = song.GetTitle(selectedLanguage);
        return string.IsNullOrWhiteSpace(title) ? song.Id : title;
    }

    private static string GetLocalized(Dictionary<string, string> dict, string lang)
        => dict.TryGetValue(lang, out var v) ? v : "";

    // ── Save Song ──

    private async Task SaveSelectedSong()
    {
        if (State.CurrentPackage is null || SelectedSong is null) return;
        isBusy = true;
        try
        {
            SelectedSong.TitlesByLanguage[selectedLanguage] = editTitle;
            SelectedSong.DescriptionsByLanguage[selectedLanguage] = editDescription;

            SongEditor.UpdateSong(State.CurrentPackage, SelectedSong);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            editMessage = "Song saved.";
            State.Diagnostics.Add($"Song edited: {SelectedSong.Id}");
        }
        catch (Exception ex)
        {
            editMessage = ex.Message;
            State.Diagnostics.Add("Song edit error: " + ex.Message);
        }
        finally { isBusy = false; }
    }

    // ── Save Pattern ──

    private async Task SavePattern(SongPattern pattern)
    {
        if (State.CurrentPackage is null || SelectedSong is null) return;
        isBusy = true;
        try
        {
            SongEditor.UpdatePattern(State.CurrentPackage, SelectedSong.Id, pattern.PatternId, pattern);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            editMessage = $"Pattern {pattern.PatternId} saved.";
            State.Diagnostics.Add($"Pattern edited: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            editMessage = ex.Message;
            State.Diagnostics.Add("Pattern edit error: " + ex.Message);
        }
        finally { isBusy = false; }
    }

    // ── Add Pattern ──

    private async Task AddPattern()
    {
        if (State.CurrentPackage is null || SelectedSong is null) return;
        isBusy = true;
        try
        {
            var pattern = new SongPattern { PatternId = newPatternId, SongId = SelectedSong.Id };
            if (!string.IsNullOrWhiteSpace(newPatternLine)) pattern.Line = newPatternLine;
            if (!string.IsNullOrWhiteSpace(newPatternSignature)) pattern.Signature = newPatternSignature;
            if (!string.IsNullOrWhiteSpace(newPatternDifficulty)) pattern.Difficulty = newPatternDifficulty;

            SongEditor.AddPattern(State.CurrentPackage, SelectedSong.Id, pattern);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            newPatternId = string.Empty;
            newPatternLine = string.Empty;
            newPatternSignature = string.Empty;
            newPatternDifficulty = string.Empty;
            showAddPattern = false;
            editMessage = $"Pattern {pattern.PatternId} added.";
            State.Diagnostics.Add($"Pattern added: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            editMessage = ex.Message;
            State.Diagnostics.Add("Add pattern error: " + ex.Message);
        }
        finally { isBusy = false; }
    }

    // ── Add Song ──

    private async Task AddSong()
    {
        if (State.CurrentPackage is null) return;
        isBusy = true;
        try
        {
            var song = new Song { Id = newSongId };
            if (!string.IsNullOrWhiteSpace(newProductId)) song.ProductIds.Add(newProductId);
            if (!string.IsNullOrWhiteSpace(newItemId)) song.ItemIds.Add(newItemId);
            if (!string.IsNullOrWhiteSpace(newCategoryId)) song.CategoryIds.Add(newCategoryId);

            SongEditor.AddSong(State.CurrentPackage, song);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            selectedSongId = newSongId;
            newSongId = string.Empty;
            newProductId = string.Empty;
            newItemId = string.Empty;
            newCategoryId = string.Empty;
            showAddSong = false;
            addMessage = $"Song {song.Id} created.";
            State.Diagnostics.Add($"Song added: {song.Id}");
        }
        catch (Exception ex)
        {
            addMessage = ex.Message;
            State.Diagnostics.Add("Add song error: " + ex.Message);
        }
        finally { isBusy = false; }
    }

    private static IReadOnlyList<string> ComputeLanguages(IReadOnlyList<Song> catalog)
    {
        var langs = catalog
            .SelectMany(s => s.TitlesByLanguage.Keys.Concat(s.DescriptionsByLanguage.Keys).Concat(s.ItemNamesByLanguage.Keys))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(l => l, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        return langs.Length == 0 ? ["us"] : langs;
    }
}
