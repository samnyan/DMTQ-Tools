    protected override void OnParametersSet()
    {
        if (!string.Equals(loadedSongId, SongId, StringComparison.Ordinal))
        {
            loadedSongId = SongId;
            currentSong = null;
            songIdInput = string.Empty;
            songItemDraft = null;
            songItemIdInput = null;
            originalSongItemId = null;
            songProductDrafts = [];
            originalSongProductIds.Clear();
            songProductIdDrafts.Clear();
            pendingSongProductDeletionIds.Clear();
            itemIdWasConflictSuggested = false;
        }

        if (DraftStore.TryGet<SongDraft>(RecoveryKey, out var recovered) && recovered is not null)
        {
            currentSong = recovered.Song;
            songIdInput = recovered.SongIdInput;
            songItemDraft = recovered.SongItemDraft;
            songItemIdInput = recovered.SongItemIdInput;
            originalSongItemId = recovered.OriginalSongItemId;
            songProductDrafts = recovered.SongProductDrafts;
            originalSongProductIds = recovered.OriginalSongProductIds;
            songProductIdDrafts = recovered.SongProductIdDrafts;
            pendingSongProductDeletionIds = recovered.PendingSongProductDeletionIds;
            itemIdWasConflictSuggested = recovered.ItemIdWasConflictSuggested;
            _syncOriginalText = recovered.SyncOriginalText;
            RemoveExternallyDeletedSongItem();
            RemoveExternallyDeletedSongProducts();
            return;
        }

        if (IsCreate)
        {
            currentSong ??= new Song { Id = 0 };
        }
        else if (int.TryParse(SongId, out var id) && currentSong?.Id != id)
        {
            var source = Catalog.FirstOrDefault(s => s.Id == id);
            currentSong = source is null ? null : SongEditSvc.CreateDraft(source);
            LoadSongCommerceDrafts();
        }
        else if (IsCreate && songItemDraft is null)
            songProductDrafts = [];
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (currentSong is not null)
        {
            DraftStore.Set(RecoveryKey, new SongDraft(
                currentSong,
                songIdInput,
                songItemDraft,
                songItemIdInput,
                originalSongItemId,
                songProductDrafts,
                originalSongProductIds,
                songProductIdDrafts,
                pendingSongProductDeletionIds,
                itemIdWasConflictSuggested,
                _syncOriginalText));
        }
    }

