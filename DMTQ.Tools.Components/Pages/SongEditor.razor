@page "/songs/editor/{SongId}"
@using DMTQ.Tools.Components.Models
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject SongEditService SongEditSvc
@inject EditorDraftStore DraftStore
@inject SongCatalogService SongCatalog
@inject ItemCatalogService ItemCatalog
@inject ItemEditService ItemEditSvc
@inject IDialogService DialogService

<div class="song-editor-page">

    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenSongsProject"]' Intent="MessageBarIntent.Warning" />
    }
    else if (currentSong is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Songs"].Value, SongId]' Intent="MessageBarIntent.Error" />
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Editor.BackTo", L["Nav.Songs"].Value]</FluentButton>
    }
    else
    {
        <EditForm Model="@currentSong" OnValidSubmit="SaveAsync" FormName="song-editor" class="song-editor-form editor-form">
            <div class="song-editor-scroll">
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" class="editor-form-sections">

                <section>
                    <h2 class="section-heading">@L["Editor.BasicInfo"]</h2>
                    <FluentGrid Spacing="1">
                        <FluentGridItem Xs="12" Sm="6" Md="3">
                            @if (IsCreate)
                            {
                                <FluentTextInput style="width: 100%;" Value="@songIdInput" ValueChanged="SetSongIdInput" Label='@(L["Fields.SongId"].Value + " *")' Placeholder="1" Required />
                            }
                            else
                            {
                                <FluentTextInput style="width: 100%;" Value="@(currentSong?.Id.ToString() ?? "")" Label='@L["Fields.SongId"]' ReadOnly="true" />
                            }
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="3"><FluentTextInput style="width: 100%;" @bind-Value="currentSong!.Name" Label='@L["Fields.SongName"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="3"><FluentTextInput style="width: 100%;" @bind-Value="songFullName" Label='@L["Fields.FullName"]' Immediate="true" /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="3"><FluentTextInput style="width: 100%;" @bind-Value="songGenre" Label='@L["Fields.Genre"]' Immediate="true" /></FluentGridItem>
                    </FluentGrid>
                </section>

                <section>
                    <h2 class="section-heading">@L["Editor.Credits"]</h2>
                    <FluentGrid Spacing="1">
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songArtistName" Label='@L["Fields.Artist"]' Immediate="true" /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songComposedBy" Label='@L["Fields.Composer"]' Immediate="true" /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songSinger" Label='@L["Fields.Singer"]' Immediate="true" /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songFeatBy" Label='@L["Fields.FeaturedArtist"]' Immediate="true" /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songArrangedBy" Label='@L["Fields.Arranger"]' Immediate="true" /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songVisualizedBy" Label='@L["Fields.Visualizer"]' Immediate="true" /></FluentGridItem>
                    </FluentGrid>
                </section>

                <section>
                    <h2 class="section-heading">@L["Editor.GameplaySettings"]</h2>
                    <p class="section-hint">@L["Editor.SongCodesHint"]</p>
                    <FluentGrid Spacing="1">
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentSwitch @bind-Value="bgaOriginal" Label='@L["Fields.OriginalBga"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentSwitch @bind-Value="bgaLoop" Label='@L["Fields.LoopBga"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentNumberInput @bind-Value="costPoint" Label='@L["Fields.CostGamePoint"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentNumberInput @bind-Value="costCash" Label='@L["Fields.CostGameCash"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentNumberInput @bind-Value="currentSong!.Flag" Label='@L["Fields.SongFlag"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="currentSong!.Status" Label='@L["Fields.SongStatus"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentSwitch @bind-Value="freeYn" Label='@L["Fields.FreeSong"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentSwitch @bind-Value="hiddenYn" Label='@L["Fields.HiddenSong"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentSwitch @bind-Value="openYn" Label='@L["Fields.OpenSong"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentNumberInput @bind-Value="currentSong!.TrackId" Label='@L["Fields.TrackId"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="currentSong!.ModDate" Label='@L["Fields.ModDate"]' /></FluentGridItem>
                        <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="currentSong!.Update" Label='@L["Fields.UpdateValue"]' /></FluentGridItem>
                    </FluentGrid>
                </section>

                @* ════════════════════════════════════════════
                   Row 2: Link ID (full width)
                   ════════════════════════════════════════════ *@
                <section>
                    <h2 class="section-heading">@L["Editor.GameItemLink"]</h2>
                    <p class="section-hint">@L["Editor.SongItemHint"]</p>
                    <div class="linked-item-card">
                        <div class="linked-item-card-header">
                            <span class="linked-item-state">@(linkedItemDraft is not null ? L["Editor.LinkedItemWillBeCreated"] : selectedLinkedItem is not null ? L["Editor.ExistingLinkedItem"] : !IsCreate && currentSong!.ItemId > 0 ? L["Editor.MissingLinkedItem"] : L["Editor.NoGameItemSelected"])</span>
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="OpenLinkedItemPickerAsync">@L["Editor.ChangeOrCreateLinkedItem"]</FluentButton>
                        </div>
                        @if (linkedItemDraft is { } linkedDraft)
                        {
                            <dl class="linked-item-details">
                                <dt>@L["Fields.ItemId"]</dt><dd>@linkedDraft.Id</dd>
                                <dt>@L["Fields.Name"]</dt><dd>@ItemDisplayName(linkedDraft)</dd>
                                <dt>@L["Fields.Summary"]</dt><dd>@ItemCatalog.GetLocalizedSummary(linkedDraft, CurrentItemLanguage)</dd>
                            </dl>
                        }
                        else if (selectedLinkedItem is { } existingItem)
                        {
                            <dl class="linked-item-details">
                                <dt>@L["Fields.ItemId"]</dt><dd>@existingItem.Id</dd>
                                <dt>@L["Fields.Name"]</dt><dd>@ItemDisplayName(existingItem)</dd>
                                <dt>@L["Fields.Summary"]</dt><dd>@ItemCatalog.GetLocalizedSummary(existingItem, CurrentItemLanguage)</dd>
                            </dl>
                        }
                        else
                        {
                            @if (!IsCreate && currentSong!.ItemId > 0)
                            {
                                <dl class="linked-item-details">
                                    <dt>@L["Fields.ItemId"]</dt><dd>@currentSong.ItemId</dd>
                                </dl>
                                <p class="section-hint">@L["Editor.LinkedItemMissingHint"]</p>
                            }
                            else
                            {
                                <p class="section-hint">@L["Editor.NoGameItemSelected"]</p>
                            }
                        }
                    </div>
                </section>

                @if (linkedItemDraft is not null)
                {
                    <ItemDataFields Content="@linkedItemDraft"
                                    ShowItemId="true"
                                    ItemId="@linkedItemDraft.Id"
                                    IsItemIdReadOnly="true"
                                    IsItemIdRequired="true" />
                }

                @* ════════════════════════════════════════════
                   Row 3: Descriptions (multi-language, full width)
                   ════════════════════════════════════════════ *@
                <section>
                    <h2 class="section-heading">@L["Editor.LocalizedDescriptions"]</h2>
                    <div class="section-inline-control">
                        <FluentSwitch @bind-Value="syncOriginalText" Label='@L["Editor.SyncAllLanguages"]' />
                    </div>
                    <p class="section-hint">@(syncOriginalText ? L["Editor.SyncAllLanguagesHint"] : L["Editor.DescriptionsHint"])</p>
                    @if (!syncOriginalText)
                    {
                        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch">
                            @foreach (var lang in DefaultLanguages)
                            {
                                var loc = GetOrCreateLocalization(lang);
                                <div>
                                    <h3 class="lang-heading">@LanguageLabel(lang)</h3>
                                    <FluentGrid Spacing="1">
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.FullName" Label='@L["Fields.FullName"]' />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.Genre" Label='@L["Fields.Genre"]' />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.ArtistName" Label='@L["Fields.Artist"]' />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.ComposedBy" Label='@L["Fields.Composer"]' />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.Singer" Label='@L["Fields.Singer"]' />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.FeatBy" Label='@L["Fields.FeaturedArtist"]' />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.ArrangedBy" Label='@L["Fields.Arranger"]' />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                            <FluentTextInput style="width: 100%;" @bind-Value="loc.VisualizedBy" Label='@L["Fields.Visualizer"]' />
                                        </FluentGridItem>
                                    </FluentGrid>
                                </div>
                            }
                        </FluentStack>
                    }
                </section>

                @* ════════════════════════════════════════════
                   Row 4: Patterns (full width, DataGrid + Dialog)
                   ════════════════════════════════════════════ *@
                <section>
                    <div class="table-header">
                        <h2 class="section-heading">@L["Editor.Patterns"]</h2>
                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      IconStart="@(new Icons.Regular.Size20.Add())"
                                      OnClick="OpenAddPatternDialog">@L["Editor.AddPattern"]</FluentButton>
                    </div>

                    @if (currentSong?.Patterns.Count > 0)
                    {
                        <div class="grid-scroll">
                            <FluentDataGrid Items="@SortedPatterns.AsQueryable()" TGridItem="SongPattern"
                                            ShowHover="true" ResizableColumns="true">
                                <PropertyColumn Property="@(p => p.PatternId)" Title='@L["Fields.PatternId"]' Sortable="true" />
                                <TemplateColumn Title='@L["Fields.ChartLine"]' Context="p">
                                    @FormatChartLine(p.Line)
                                </TemplateColumn>
                                <TemplateColumn Title='@L["Fields.ChartDifficulty"]' Context="p">
                                    @FormatChartDifficulty(p.Signature)
                                </TemplateColumn>
                                <PropertyColumn Property="@(p => p.Difficulty)" Title='@L["Fields.StarRating"]' />
                                <TemplateColumn Title='@L["Fields.PointType"]' Context="p">
                                    @FormatPointType(p.PointType)
                                </TemplateColumn>
                                <PropertyColumn Property="@(p => p.PointValue)" Title='@L["Fields.PointValue"]' />
                                <TemplateColumn Title='@L["Fields.PatternEnabled"]' Context="p">
                                    @(p.Flg == "Y" ? "✓" : "")
                                </TemplateColumn>
                                <TemplateColumn Title='@L["Common.Actions"]' Context="p">
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                                        <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                                                      Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                                      Title='@L["Common.Edit"]'
                                                      OnClick="() => OpenEditPatternDialog(p)" />
                                        <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                                                      Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                                      Title='@L["Common.Delete"]'
                                                      OnClick="() => RemovePatternAsync(p)" />
                                    </FluentStack>
                                </TemplateColumn>
                            </FluentDataGrid>
                        </div>
                    }
                    else
                    {
                        <FluentMessageBar Title='@L["Editor.NoPatterns"]' Intent="MessageBarIntent.Info" />
                    }
                </section>

                </FluentStack>
            </div>
            <div class="song-editor-actions">
                <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveSong"]</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                @if (!string.IsNullOrEmpty(message))
                {
                    <span class="song-editor-status">@message</span>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <FluentMessageBar Title="@errorMessage" Intent="MessageBarIntent.Error" />
                }
                <EditorSaveFailure Exception="@saveException" Context="Song editor save" />
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string SongId { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private static readonly string[] DefaultLanguages = ["CN", "JP", "KR", "TW", "US"];

    private bool IsCreate => SongId == "new";
    private string RecoveryKey => $"song:{SongId}";
    private string? loadedSongId;
    private Song? currentSong;
    private string songIdInput = string.Empty;
    private bool hasExplicitLinkedItemChoice;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private Exception? saveException;
    private bool isBusy;
    private bool _syncOriginalText = true;
    private Item? linkedItemDraft;
    private Item? selectedLinkedItem;

    private bool syncOriginalText
    {
        get => _syncOriginalText;
        set
        {
            _syncOriginalText = value;
            if (value) SyncOriginalToAllLanguages();
        }
    }

    private string songFullName { get => currentSong?.FullName ?? string.Empty; set => SetOriginalField(song => song.FullName = value); }
    private string songGenre { get => currentSong?.Genre ?? string.Empty; set => SetOriginalField(song => song.Genre = value); }
    private string songArtistName { get => currentSong?.ArtistName ?? string.Empty; set => SetOriginalField(song => song.ArtistName = value); }
    private string songComposedBy { get => currentSong?.ComposedBy ?? string.Empty; set => SetOriginalField(song => song.ComposedBy = value); }
    private string songSinger { get => currentSong?.Singer ?? string.Empty; set => SetOriginalField(song => song.Singer = value); }
    private string songFeatBy { get => currentSong?.FeatBy ?? string.Empty; set => SetOriginalField(song => song.FeatBy = value); }
    private string songArrangedBy { get => currentSong?.ArrangedBy ?? string.Empty; set => SetOriginalField(song => song.ArrangedBy = value); }
    private string songVisualizedBy { get => currentSong?.VisualizedBy ?? string.Empty; set => SetOriginalField(song => song.VisualizedBy = value); }

    // YN ↔ bool wrappers
    private bool bgaOriginal { get => currentSong?.OriginalBgaYn == "Y"; set => currentSong!.OriginalBgaYn = value ? "Y" : "N"; }
    private bool bgaLoop { get => currentSong?.LoopBgaYn == "Y"; set => currentSong!.LoopBgaYn = value ? "Y" : "N"; }
    private bool freeYn { get => currentSong?.FreeYn == "Y"; set => currentSong!.FreeYn = value ? "Y" : "N"; }
    private bool hiddenYn { get => currentSong?.HiddenYn == "Y"; set => currentSong!.HiddenYn = value ? "Y" : "N"; }
    private bool openYn { get => currentSong?.OpenYn == "Y"; set => currentSong!.OpenYn = value ? "Y" : "N"; }

    // Numeric wrappers (int? ↔ int)
    private int? costPoint { get => currentSong?.CostGamePoint; set { if (currentSong is not null && value.HasValue) currentSong.CostGamePoint = value.Value; } }
    private int? costCash { get => currentSong?.CostGameCash; set { if (currentSong is not null && value.HasValue) currentSong.CostGameCash = value.Value; } }

    private PatchPackage? _lastPackage;
    private string? _lastPlatform;
    private IReadOnlyList<Song> _catalog = [];
    private PatchPackage? _lastItemPackage;
    private string? _lastItemPlatform;
    private IReadOnlyList<Item> _itemOptions = [];

    private IReadOnlyList<Song> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)
                && string.Equals(State.SelectedExportPlatform, _lastPlatform, StringComparison.OrdinalIgnoreCase)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _lastPlatform = State.SelectedExportPlatform;
            _catalog = State.CurrentPackage is null ? [] : SongCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            return _catalog;
        }
    }

    private IEnumerable<SongPattern> SortedPatterns
    {
        get
        {
            if (currentSong is null) return [];
            return currentSong.Patterns
                .OrderBy(p => p.Line)
                .ThenBy(p => p.Signature);
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(loadedSongId, SongId, StringComparison.Ordinal))
        {
            loadedSongId = SongId;
            currentSong = null;
            songIdInput = string.Empty;
            hasExplicitLinkedItemChoice = false;
            linkedItemDraft = null;
            selectedLinkedItem = null;
        }

        if (DraftStore.TryGet<SongDraft>(RecoveryKey, out var recovered) && recovered is not null)
        {
            currentSong = recovered.Song;
            songIdInput = recovered.SongIdInput;
            hasExplicitLinkedItemChoice = recovered.HasExplicitLinkedItemChoice;
            linkedItemDraft = recovered.LinkedItemDraft;
            selectedLinkedItem = recovered.SelectedLinkedItem;
            _syncOriginalText = recovered.SyncOriginalText;
            return;
        }

        if (IsCreate)
        {
            currentSong ??= new Song { Id = 0 };
        }
        else if (int.TryParse(SongId, out var id) && currentSong?.Id != id)
        {
            var source = Catalog.FirstOrDefault(s => s.Id == id);
            currentSong = source is null ? null : SongEditSvc.CreateDraft(source);
            selectedLinkedItem = currentSong is null
                ? null
                : AvailableGameItems.FirstOrDefault(item => item.Id.Equals(currentSong.ItemId.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (currentSong is not null)
        {
            DraftStore.Set(RecoveryKey, new SongDraft(
                currentSong,
                songIdInput,
                hasExplicitLinkedItemChoice,
                linkedItemDraft,
                selectedLinkedItem,
                _syncOriginalText));
        }
    }

    private SongLocalization GetOrCreateLocalization(string lang)
    {
        if (!currentSong!.Localizations.TryGetValue(lang, out var loc))
        {
            loc = new SongLocalization();
            currentSong.Localizations[lang] = loc;
        }
        return loc;
    }

    private IReadOnlyList<Item> AvailableGameItems
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastItemPackage)
                && string.Equals(State.SelectedExportPlatform, _lastItemPlatform, StringComparison.OrdinalIgnoreCase))
            {
                return _itemOptions;
            }

            _lastItemPackage = State.CurrentPackage;
            _lastItemPlatform = State.SelectedExportPlatform;
            _itemOptions = State.CurrentPackage is null
                ? []
                : ItemCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            return _itemOptions;
        }
    }

    private Item? SelectedLinkedItem => linkedItemDraft is null ? selectedLinkedItem : null;

    private string CurrentItemLanguage => Language.CurrentCulture.Name == "zh-CN" ? "CN" : "US";
    private string ItemDisplayName(Item item)
        => ItemCatalog.GetDisplayName(item, CurrentItemLanguage);

    private Task SetSongIdInput(string? value)
    {
        songIdInput = value ?? string.Empty;
        if (!hasExplicitLinkedItemChoice && linkedItemDraft is null
            && int.TryParse(songIdInput, out var songId))
        {
            currentSong!.ItemId = songId;
            selectedLinkedItem = AvailableGameItems.FirstOrDefault(item => item.Id.Equals(songIdInput, StringComparison.OrdinalIgnoreCase));
        }

        return Task.CompletedTask;
    }

    private string LanguageLabel(string language) => L[$"Editor.Language.{language}"].Value;

    private string FormatChartLine(int value) => value switch
    {
        3 => $"3 — {L["Options.PatternLine2"].Value}",
        4 => $"4 — {L["Options.PatternLine3"].Value}",
        5 => $"5 — {L["Options.PatternLine4"].Value}",
        _ => $"{value} — {L["Fields.ExistingValue"].Value}"
    };

    private string FormatChartDifficulty(int value) => value switch
    {
        0 => $"0 — {L["Options.PatternEasy"].Value}",
        1 => $"1 — {L["Options.PatternNormal"].Value}",
        2 => $"2 — {L["Options.PatternHard"].Value}",
        3 => $"3 — {L["Options.PatternExpert"].Value}",
        _ => $"{value} — {L["Fields.ExistingValue"].Value}"
    };

    private string FormatPointType(int value) => value switch
    {
        0 => $"0 — {L["Options.PointQ"].Value}",
        1 => $"1 — {L["Options.PointMax"].Value}",
        _ => $"{value} — {L["Fields.ExistingValue"].Value}"
    };

    private bool TryGetSuggestedItemId(out string itemId)
    {
        var existingSongItemId = currentSong is null
            ? string.Empty
            : currentSong.ItemId > 0
                ? currentSong.ItemId.ToString(System.Globalization.CultureInfo.InvariantCulture)
                : currentSong.Id.ToString(System.Globalization.CultureInfo.InvariantCulture);
        itemId = linkedItemDraft?.Id ?? SelectedLinkedItem?.Id ?? (IsCreate ? songIdInput : existingSongItemId);
        return int.TryParse(itemId, out var parsedId) && parsedId > 0;
    }

    private string SuggestedLinkedItemName
        => !string.IsNullOrWhiteSpace(currentSong?.FullName) ? currentSong.FullName : currentSong?.Name ?? string.Empty;

    private async Task OpenLinkedItemPickerAsync()
    {
        if (currentSong is null)
            return;

        TryGetSuggestedItemId(out var suggestedId);
        var pickerState = new LinkedItemPickerState
        {
            Items = AvailableGameItems,
            ItemId = suggestedId,
            ItemName = linkedItemDraft?.ItemName ?? SuggestedLinkedItemName,
            Summary = linkedItemDraft?.Summary ?? string.Empty,
            IsCreateMode = selectedLinkedItem is null && linkedItemDraft is not null
        };

        await DialogService.ShowDialogAsync<LinkedItemPickerDialog>(options =>
        {
            options.Header.Title = L["Editor.ChangeOrCreateLinkedItem"].Value;
            options.Footer.PrimaryAction.Visible = false;
            options.Footer.SecondaryAction.Label = L["Common.Cancel"].Value;
            options.Width = "800px";
            options.Parameters = new Dictionary<string, object?>
            {
                [nameof(LinkedItemPickerDialog.State)] = pickerState
            };
        });

        if (!pickerState.Accepted || pickerState.ResultItem is null)
            return;

        hasExplicitLinkedItemChoice = true;
        if (pickerState.ResultIsNew)
        {
            linkedItemDraft = pickerState.ResultItem;
            selectedLinkedItem = null;
        }
        else
        {
            linkedItemDraft = null;
            selectedLinkedItem = pickerState.ResultItem;
        }
        currentSong.ItemId = int.Parse(pickerState.ResultItem.Id, System.Globalization.CultureInfo.InvariantCulture);
    }

    private void SetOriginalField(Action<Song> update)
    {
        if (currentSong is null) return;
        update(currentSong);
        if (_syncOriginalText) SyncOriginalToAllLanguages();
    }

    private void SyncOriginalToAllLanguages()
    {
        if (currentSong is null) return;

        foreach (var language in DefaultLanguages)
        {
            var localization = GetOrCreateLocalization(language);
            localization.FullName = currentSong.FullName;
            localization.Genre = currentSong.Genre;
            localization.ArtistName = currentSong.ArtistName;
            localization.ComposedBy = currentSong.ComposedBy;
            localization.Singer = currentSong.Singer;
            localization.FeatBy = currentSong.FeatBy;
            localization.ArrangedBy = currentSong.ArrangedBy;
            localization.VisualizedBy = currentSong.VisualizedBy;
        }
    }

    private void NavigateBack()
    {
        DraftStore.Remove(RecoveryKey);
        Navigation.NavigateTo(TableNavigationState.ResolveReturnUrl(Navigation, ReturnUrl, "/songs"));
    }

    // ── Save Song ──

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null) return;

        isBusy = true;
        message = string.Empty;
        errorMessage = string.Empty;
        saveException = null;

        var linkedItemAdded = false;
        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(songIdInput) || !int.TryParse(songIdInput, out var newId))
                {
                    errorMessage = L["Editor.SongIdRequired"].Value;
                    return;
                }
                var linkedItem = SelectedLinkedItem;
                var linkedItemId = linkedItemDraft?.Id ?? linkedItem?.Id;
                if (int.TryParse(linkedItemId, out var parsedLinkedItemId) && parsedLinkedItemId > 0)
                {
                    currentSong!.ItemId = parsedLinkedItemId;
                }
                else
                {
                    currentSong!.ItemId = 0;
                }
                if (_syncOriginalText) SyncOriginalToAllLanguages();
                var song = SongEditSvc.CreateDraft(currentSong, newId);
                if (linkedItemDraft is not null)
                    SongEditSvc.AddSongWithItem(State.CurrentPackage, song, linkedItemDraft, State.SelectedExportPlatform);
                else
                    SongEditSvc.AddSong(State.CurrentPackage, song, State.SelectedExportPlatform);
                var wasDirty = State.IsDirty;
                State.IsDirty = true;
                try { await Workflow.SaveProjectAsync(); }
                catch
                {
                    SongEditSvc.RemoveSong(State.CurrentPackage, song.Id, State.SelectedExportPlatform);
                    if (linkedItemDraft is not null)
                        ItemEditSvc.RemoveItem(State.CurrentPackage, song.ItemId.ToString(System.Globalization.CultureInfo.InvariantCulture), State.SelectedExportPlatform);
                    State.IsDirty = wasDirty;
                    throw;
                }
                State.Diagnostics.Add($"Song added: {song.Id}");
                _lastPackage = null;
                NavigateBack();
            }
            else if (currentSong is not null)
            {
                var linkedItem = SelectedLinkedItem;
                var linkedItemId = linkedItemDraft?.Id ?? linkedItem?.Id;
                if (int.TryParse(linkedItemId, out var parsedLinkedItemId) && parsedLinkedItemId > 0)
                    currentSong.ItemId = parsedLinkedItemId;
                if (_syncOriginalText) SyncOriginalToAllLanguages();
                try
                {
                    if (linkedItemDraft is not null)
                    {
                        ItemEditSvc.AddItem(State.CurrentPackage, linkedItemDraft, State.SelectedExportPlatform);
                        linkedItemAdded = true;
                    }
                    SongEditSvc.UpdateSong(State.CurrentPackage, currentSong, State.SelectedExportPlatform);
                    State.IsDirty = true;
                    await Workflow.SaveProjectAsync();
                }
                catch
                {
                    if (linkedItemAdded)
                        ItemEditSvc.RemoveItem(State.CurrentPackage, linkedItemDraft!.Id, State.SelectedExportPlatform);
                    throw;
                }
                _lastPackage = null;
                State.Diagnostics.Add($"Song edited: {currentSong.Id}");
                NavigateBack();
            }
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

    // ── Pattern: Add via Dialog ──

    private async Task OpenAddPatternDialog()
    {
        if (currentSong is null) return;

        var nextPatternId = Catalog.SelectMany(song => song.Patterns)
            .Concat(currentSong.Patterns)
            .Select(pattern => pattern.PatternId)
            .DefaultIfEmpty(0)
            .Max() + 1;
        var pattern = new SongPattern { PatternId = nextPatternId, SongId = currentSong.Id };

        var result = await DialogService.ShowDialogAsync<PatternDialog>(options =>
        {
            options.Header.Title = L["Editor.AddPattern"].Value;
            options.Footer.PrimaryAction.Label = L["Common.Save"].Value;
            options.Footer.SecondaryAction.Label = L["Common.Cancel"].Value;
            options.Width = "480px";
            options.Parameters = new Dictionary<string, object?> { [nameof(PatternDialog.Content)] = pattern };
        });
        if (result.Cancelled || pattern.PatternId == 0)
            return;

        try
        {
            saveException = null;
            isBusy = true;
            SongEditSvc.AddPattern(currentSong, pattern);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
            }
            else
            {
                SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
                State.IsDirty = true;
                await Workflow.SaveProjectAsync();
                message = L["Editor.Saved", L["Editor.Patterns"].Value].Value;
            }
            _lastPackage = null;
            State.Diagnostics.Add($"Pattern added: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

    // ── Pattern: Edit via Dialog ──

    private async Task OpenEditPatternDialog(SongPattern pattern)
    {
        if (currentSong is null) return;

        // Clone so Cancel doesn't mutate original
        var clone = new SongPattern
        {
            PatternId = pattern.PatternId,
            SongId = pattern.SongId,
            Name = pattern.Name,
            Line = pattern.Line,
            Signature = pattern.Signature,
            Difficulty = pattern.Difficulty,
            PointType = pattern.PointType,
            PointValue = pattern.PointValue,
            Flg = pattern.Flg,
            Update = pattern.Update,
        };

        var result = await DialogService.ShowDialogAsync<PatternDialog>(options =>
        {
            options.Header.Title = L["Editor.Edit", pattern.PatternId].Value;
            options.Footer.PrimaryAction.Label = L["Common.Save"].Value;
            options.Footer.SecondaryAction.Label = L["Common.Cancel"].Value;
            options.Width = "480px";
            options.Parameters = new Dictionary<string, object?> { [nameof(PatternDialog.Content)] = clone };
        });
        if (result.Cancelled) return;

        try
        {
            saveException = null;
            isBusy = true;
            SongEditSvc.UpdatePattern(currentSong, pattern.PatternId, clone);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
                return;
            }
            SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
            State.IsDirty = true;
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            message = L["Editor.Saved", L["Editor.Patterns"].Value].Value;
            State.Diagnostics.Add($"Pattern edited: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

    // ── Pattern: Delete ──

    private async Task RemovePatternAsync(SongPattern pattern)
    {
        if (currentSong is null) return;

        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", L["Editor.Patterns"].Value, pattern.PatternId].Value,
            title: L["Editor.Patterns"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;

        isBusy = true;
        saveException = null;
        try
        {
            SongEditSvc.RemovePattern(currentSong, pattern.PatternId);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
                return;
            }
            SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
            State.IsDirty = true;
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            message = L["Lists.Deleted", L["Editor.Patterns"].Value, pattern.PatternId].Value;
            State.Diagnostics.Add($"Pattern removed: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

    private sealed record SongDraft(
        Song Song,
        string SongIdInput,
        bool HasExplicitLinkedItemChoice,
        Item? LinkedItemDraft,
        Item? SelectedLinkedItem,
        bool SyncOriginalText);
}
