@page "/songs/editor/{SongId}"
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject SongEditService SongEditSvc
@inject SongCatalogService SongCatalog
@inject ItemCatalogService ItemCatalog
@inject ItemEditService ItemEditSvc
@inject IDialogService DialogService

<div class="song-editor-page">

    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenSongsProject"]' Intent="MessageIntent.Warning" />
    }
    else if (currentSong is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Songs"].Value, SongId]' Intent="MessageIntent.Error" />
        <FluentButton Appearance="Appearance.Neutral" OnClick="NavigateBack">@L["Editor.BackTo", L["Nav.Songs"].Value]</FluentButton>
    }
    else
    {
        <EditForm Model="@currentSong" OnValidSubmit="SaveAsync" FormName="song-editor" class="song-editor-form">
            <div class="song-editor-scroll">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="24" HorizontalAlignment="HorizontalAlignment.Stretch">

                @* ════════════════════════════════════════════
                   Row 1: Basic Info | Gameplay Settings
                   ════════════════════════════════════════════ *@
                <FluentGrid Spacing="3">
                    <FluentGridItem xs="12" md="6">
                        <section>
                            <h2 class="section-heading">@L["Editor.BasicInfo"]</h2>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                @if (IsCreate)
                                {
                                    <FluentTextField style="width: 100%;" Value="@songIdInput" ValueChanged="SetSongIdInput" Label='@(L["Fields.SongId"].Value + " *")' Placeholder="1" Required />
                                }
                                else
                                {
                                    <FluentTextField style="width: 100%;" Value="@(currentSong?.Id.ToString() ?? "")" Label='@L["Fields.SongId"]' ReadOnly="true" />
                                }
                                <FluentTextField style="width: 100%;" @bind-Value="currentSong!.Name" Label='@L["Fields.SongName"]' />
                                <FluentTextField style="width: 100%;" @bind-Value="songFullName" Label='@L["Fields.FullName"]' Immediate="true" />
                                <FluentTextField style="width: 100%;" @bind-Value="songGenre" Label='@L["Fields.Genre"]' Immediate="true" />
                                <FluentTextField style="width: 100%;" @bind-Value="songArtistName" Label='@L["Fields.Artist"]' Immediate="true" />
                                <FluentTextField style="width: 100%;" @bind-Value="songComposedBy" Label='@L["Fields.Composer"]' Immediate="true" />
                                <FluentTextField style="width: 100%;" @bind-Value="songSinger" Label='@L["Fields.Singer"]' Immediate="true" />
                                <FluentTextField style="width: 100%;" @bind-Value="songFeatBy" Label='@L["Fields.FeaturedArtist"]' Immediate="true" />
                                <FluentTextField style="width: 100%;" @bind-Value="songArrangedBy" Label='@L["Fields.Arranger"]' Immediate="true" />
                                <FluentTextField style="width: 100%;" @bind-Value="songVisualizedBy" Label='@L["Fields.Visualizer"]' Immediate="true" />
                            </FluentStack>
                        </section>
                    </FluentGridItem>

                    <FluentGridItem xs="12" md="6">
                        <section>
                            <h2 class="section-heading">@L["Editor.GameplaySettings"]</h2>
                            <p class="section-hint">@L["Editor.SongCodesHint"]</p>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                <FluentSwitch @bind-Value="bgaOriginal" Label='@L["Fields.OriginalBga"]' />
                                <FluentSwitch @bind-Value="bgaLoop" Label='@L["Fields.LoopBga"]' />
                                <FluentNumberField @bind-Value="costPoint" Label='@L["Fields.CostGamePoint"]' />
                                <FluentNumberField @bind-Value="costCash" Label='@L["Fields.CostGameCash"]' />
                                <FluentNumberField @bind-Value="currentSong!.Flag" Label='@L["Fields.SongFlag"]' />
                                <FluentTextField style="width: 100%;" @bind-Value="currentSong!.Status" Label='@L["Fields.SongStatus"]' />
                                <FluentSwitch @bind-Value="freeYn" Label='@L["Fields.FreeSong"]' />
                                <FluentSwitch @bind-Value="hiddenYn" Label='@L["Fields.HiddenSong"]' />
                                <FluentSwitch @bind-Value="openYn" Label='@L["Fields.OpenSong"]' />
                                <FluentNumberField @bind-Value="currentSong!.TrackId" Label='@L["Fields.TrackId"]' />
                                <FluentTextField style="width: 100%;" @bind-Value="currentSong!.ModDate" Label='@L["Fields.ModDate"]' />
                                <FluentTextField style="width: 100%;" @bind-Value="currentSong!.Update" Label='@L["Fields.UpdateValue"]' />
                            </FluentStack>
                        </section>
                    </FluentGridItem>
                </FluentGrid>

                @* ════════════════════════════════════════════
                   Row 2: Link ID (full width)
                   ════════════════════════════════════════════ *@
                <section>
                    <h2 class="section-heading">@L["Editor.GameItemLink"]</h2>
                    <p class="section-hint">@L["Editor.SongItemHint"]</p>
                    <div class="linked-item-picker">
                        @if (linkedItemDraft is null)
                        {
                            <FluentTextField Value="@linkedItemSearchText"
                                             ValueChanged="SearchLinkedItems"
                                             Immediate="true"
                                             Label='@L["Editor.SelectGameItem"]'
                                             Placeholder='@L["Editor.SearchGameItem"]'
                                             Style="width: 100%;" />
                            @if (MatchingGameItems.Count > 0)
                            {
                                <div class="linked-item-results" role="listbox" aria-label='@L["Editor.SelectGameItem"]'>
                                    @foreach (var item in MatchingGameItems)
                                    {
                                        <button type="button" class="linked-item-result" role="option" @onclick="() => SelectLinkedItem(item)">
                                            <span class="linked-item-result-id">@item.Id</span>
                                            <span>@ItemDisplayName(item)</span>
                                        </button>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(linkedItemSearchText))
                            {
                                <p class="section-hint">@L["Editor.NoGameItemMatches"]</p>
                            }

                            @if (SelectedLinkedItem is null)
                            {
                                <FluentButton Appearance="Appearance.Neutral"
                                              IconStart="@(new Icons.Regular.Size20.Add())"
                                              OnClick="BeginLinkedItemCreation"
                                              Disabled="@(!TryGetSuggestedItemId(out _))">
                                    @L["Editor.AddLinkedGameItem"]
                                </FluentButton>
                            }
                        }
                        else
                        {
                            <div class="linked-item-draft-header">
                                <span>@L["Editor.AddLinkedGameItem"] (@linkedItemDraft.Id)</span>
                                <FluentButton Appearance="Appearance.Neutral" OnClick="CancelLinkedItemCreation">@L["Editor.CancelLinkedGameItem"]</FluentButton>
                            </div>
                        }
                    </div>
                </section>

                @if (linkedItemDraft is not null)
                {
                    <ItemDataFields Content="@linkedItemDraft"
                                    ShowItemId="true"
                                    ItemId="@linkedItemDraft.Id"
                                    IsItemIdReadOnly="true"
                                    IsItemIdRequired="true" />
                }

                @* ════════════════════════════════════════════
                   Row 3: Descriptions (multi-language, full width)
                   ════════════════════════════════════════════ *@
                <section>
                    <div class="section-title-row">
                        <div>
                            <h2 class="section-heading">@L["Editor.LocalizedDescriptions"]</h2>
                            <p class="section-hint">@(syncOriginalText ? L["Editor.SyncAllLanguagesHint"] : L["Editor.DescriptionsHint"])</p>
                        </div>
                        <FluentSwitch @bind-Value="syncOriginalText" Label='@L["Editor.SyncAllLanguages"]' />
                    </div>
                    @if (!syncOriginalText)
                    {
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Stretch">
                            @foreach (var lang in DefaultLanguages)
                            {
                                var loc = GetOrCreateLocalization(lang);
                                <div>
                                    <h3 class="lang-heading">@LanguageLabel(lang)</h3>
                                    <FluentGrid Spacing="2">
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.FullName" Label='@L["Fields.FullName"]' />
                                        </FluentGridItem>
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.Genre" Label='@L["Fields.Genre"]' />
                                        </FluentGridItem>
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.ArtistName" Label='@L["Fields.Artist"]' />
                                        </FluentGridItem>
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.ComposedBy" Label='@L["Fields.Composer"]' />
                                        </FluentGridItem>
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.Singer" Label='@L["Fields.Singer"]' />
                                        </FluentGridItem>
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.FeatBy" Label='@L["Fields.FeaturedArtist"]' />
                                        </FluentGridItem>
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.ArrangedBy" Label='@L["Fields.Arranger"]' />
                                        </FluentGridItem>
                                        <FluentGridItem xs="12" sm="6" md="4" lg="2">
                                            <FluentTextField style="width: 100%;" @bind-Value="loc.VisualizedBy" Label='@L["Fields.Visualizer"]' />
                                        </FluentGridItem>
                                    </FluentGrid>
                                </div>
                            }
                        </FluentStack>
                    }
                </section>

                @* ════════════════════════════════════════════
                   Row 4: Patterns (full width, DataGrid + Dialog)
                   ════════════════════════════════════════════ *@
                <section>
                    <div class="table-header">
                        <h2 class="section-heading">@L["Editor.Patterns"]</h2>
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size20.Add())"
                                      OnClick="OpenAddPatternDialog">@L["Editor.AddPattern"]</FluentButton>
                    </div>

                    @if (currentSong?.Patterns.Count > 0)
                    {
                        <div class="grid-scroll">
                            <FluentDataGrid Items="@SortedPatterns.AsQueryable()" TGridItem="SongPattern"
                                            ShowHover="true" ResizableColumns="true">
                                <PropertyColumn Property="@(p => p.PatternId)" Title='@L["Fields.PatternId"]' Sortable="true" />
                                <TemplateColumn Title='@L["Fields.ChartLine"]' Context="p">
                                    @FormatChartLine(p.Line)
                                </TemplateColumn>
                                <TemplateColumn Title='@L["Fields.ChartDifficulty"]' Context="p">
                                    @FormatChartDifficulty(p.Signature)
                                </TemplateColumn>
                                <PropertyColumn Property="@(p => p.Difficulty)" Title='@L["Fields.StarRating"]' />
                                <TemplateColumn Title='@L["Fields.PointType"]' Context="p">
                                    @FormatPointType(p.PointType)
                                </TemplateColumn>
                                <PropertyColumn Property="@(p => p.PointValue)" Title='@L["Fields.PointValue"]' />
                                <TemplateColumn Title='@L["Fields.PatternEnabled"]' Context="p">
                                    @(p.Flg == "Y" ? "✓" : "")
                                </TemplateColumn>
                                <TemplateColumn Title='@L["Common.Actions"]' Context="p">
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                                        <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                                                      Appearance="Appearance.Neutral" Size="FluentUI.AspNetCore.Components.Size.Small"
                                                      Title='@L["Common.Edit"]'
                                                      OnClick="() => OpenEditPatternDialog(p)" />
                                        <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                                                      Appearance="Appearance.Neutral" Size="FluentUI.AspNetCore.Components.Size.Small"
                                                      Title='@L["Common.Delete"]'
                                                      OnClick="() => RemovePatternAsync(p)" />
                                    </FluentStack>
                                </TemplateColumn>
                            </FluentDataGrid>
                        </div>
                    }
                    else
                    {
                        <FluentMessageBar Title='@L["Editor.NoPatterns"]' Intent="MessageIntent.Info" />
                    }
                </section>

                </FluentStack>
            </div>
            <div class="song-editor-actions">
                <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveSong"]</FluentButton>
                <FluentButton Appearance="Appearance.Neutral" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                @if (!string.IsNullOrEmpty(message))
                {
                    <span class="song-editor-status">@message</span>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <FluentMessageBar Title="@errorMessage" Intent="MessageIntent.Error" />
                }
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string SongId { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private static readonly string[] DefaultLanguages = ["CN", "JP", "KR", "TW", "US"];

    private bool IsCreate => SongId == "new";
    private Song? currentSong;
    private string songIdInput = string.Empty;
    private bool hasExplicitLinkedItemChoice;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private bool isBusy;
    private bool _syncOriginalText = true;
    private Item? linkedItemDraft;
    private Item? selectedLinkedItem;
    private string linkedItemSearchText = string.Empty;

    private bool syncOriginalText
    {
        get => _syncOriginalText;
        set
        {
            _syncOriginalText = value;
            if (value) SyncOriginalToAllLanguages();
        }
    }

    private string songFullName { get => currentSong?.FullName ?? string.Empty; set => SetOriginalField(song => song.FullName = value); }
    private string songGenre { get => currentSong?.Genre ?? string.Empty; set => SetOriginalField(song => song.Genre = value); }
    private string songArtistName { get => currentSong?.ArtistName ?? string.Empty; set => SetOriginalField(song => song.ArtistName = value); }
    private string songComposedBy { get => currentSong?.ComposedBy ?? string.Empty; set => SetOriginalField(song => song.ComposedBy = value); }
    private string songSinger { get => currentSong?.Singer ?? string.Empty; set => SetOriginalField(song => song.Singer = value); }
    private string songFeatBy { get => currentSong?.FeatBy ?? string.Empty; set => SetOriginalField(song => song.FeatBy = value); }
    private string songArrangedBy { get => currentSong?.ArrangedBy ?? string.Empty; set => SetOriginalField(song => song.ArrangedBy = value); }
    private string songVisualizedBy { get => currentSong?.VisualizedBy ?? string.Empty; set => SetOriginalField(song => song.VisualizedBy = value); }

    // YN ↔ bool wrappers
    private bool bgaOriginal { get => currentSong?.OriginalBgaYn == "Y"; set => currentSong!.OriginalBgaYn = value ? "Y" : "N"; }
    private bool bgaLoop { get => currentSong?.LoopBgaYn == "Y"; set => currentSong!.LoopBgaYn = value ? "Y" : "N"; }
    private bool freeYn { get => currentSong?.FreeYn == "Y"; set => currentSong!.FreeYn = value ? "Y" : "N"; }
    private bool hiddenYn { get => currentSong?.HiddenYn == "Y"; set => currentSong!.HiddenYn = value ? "Y" : "N"; }
    private bool openYn { get => currentSong?.OpenYn == "Y"; set => currentSong!.OpenYn = value ? "Y" : "N"; }

    // Numeric wrappers (int? ↔ int)
    private int? costPoint { get => currentSong?.CostGamePoint; set { if (currentSong is not null && value.HasValue) currentSong.CostGamePoint = value.Value; } }
    private int? costCash { get => currentSong?.CostGameCash; set { if (currentSong is not null && value.HasValue) currentSong.CostGameCash = value.Value; } }

    private PatchPackage? _lastPackage;
    private string? _lastPlatform;
    private IReadOnlyList<Song> _catalog = [];
    private PatchPackage? _lastItemPackage;
    private string? _lastItemPlatform;
    private IReadOnlyList<Item> _itemOptions = [];

    private IReadOnlyList<Song> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)
                && string.Equals(State.SelectedExportPlatform, _lastPlatform, StringComparison.OrdinalIgnoreCase)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _lastPlatform = State.SelectedExportPlatform;
            _catalog = State.CurrentPackage is null ? [] : SongCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            return _catalog;
        }
    }

    private IEnumerable<SongPattern> SortedPatterns
    {
        get
        {
            if (currentSong is null) return [];
            return currentSong.Patterns
                .OrderBy(p => p.Line)
                .ThenBy(p => p.Signature);
        }
    }

    protected override void OnParametersSet()
    {
        if (IsCreate)
        {
            currentSong ??= new Song { Id = 0 };
        }
        else if (int.TryParse(SongId, out var id) && currentSong?.Id != id)
        {
            var source = Catalog.FirstOrDefault(s => s.Id == id);
            currentSong = source is null ? null : SongEditSvc.CreateDraft(source);
            selectedLinkedItem = currentSong is null
                ? null
                : AvailableGameItems.FirstOrDefault(item => item.Id.Equals(currentSong.ItemId.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.OrdinalIgnoreCase));
            linkedItemSearchText = selectedLinkedItem is null ? string.Empty : FormatItemOption(selectedLinkedItem);
        }
    }

    private SongLocalization GetOrCreateLocalization(string lang)
    {
        if (!currentSong!.Localizations.TryGetValue(lang, out var loc))
        {
            loc = new SongLocalization();
            currentSong.Localizations[lang] = loc;
        }
        return loc;
    }

    private IReadOnlyList<Item> AvailableGameItems
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastItemPackage)
                && string.Equals(State.SelectedExportPlatform, _lastItemPlatform, StringComparison.OrdinalIgnoreCase))
            {
                return _itemOptions;
            }

            _lastItemPackage = State.CurrentPackage;
            _lastItemPlatform = State.SelectedExportPlatform;
            _itemOptions = State.CurrentPackage is null
                ? []
                : ItemCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);
            return _itemOptions;
        }
    }

    private Item? SelectedLinkedItem => linkedItemDraft is null ? selectedLinkedItem : null;

    private IReadOnlyList<Item> MatchingGameItems
    {
        get
        {
            var query = linkedItemSearchText.Trim();
            if (query.Length == 0) return [];

            return AvailableGameItems
                .Select(item => new { Item = item, Rank = MatchRank(item, query) })
                .Where(match => match.Rank < 3)
                .OrderBy(match => match.Rank)
                .ThenBy(match => match.Item.Id, StringComparer.OrdinalIgnoreCase)
                .Take(5)
                .Select(match => match.Item)
                .ToArray();
        }
    }

    private string FormatItemOption(Item item)
    {
        var name = ItemDisplayName(item);
        return name.Equals(item.Id, StringComparison.OrdinalIgnoreCase) ? item.Id : $"{item.Id} — {name}";
    }

    private string ItemDisplayName(Item item)
        => ItemCatalog.GetDisplayName(item, Language.CurrentCulture.Name == "zh-CN" ? "CN" : "US");

    private int MatchRank(Item item, string query)
    {
        var terms = new[] { item.Id, item.ItemName }
            .Concat(item.NamesByLanguage.Values)
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var rank = 3;
        foreach (var term in terms)
        {
            if (term.Equals(query, StringComparison.OrdinalIgnoreCase)) return 0;
            if (term.StartsWith(query, StringComparison.OrdinalIgnoreCase)) rank = Math.Min(rank, 1);
            else if (term.Contains(query, StringComparison.OrdinalIgnoreCase)) rank = Math.Min(rank, 2);
        }
        return rank;
    }

    private Task SetSongIdInput(string? value)
    {
        songIdInput = value ?? string.Empty;
        if (!hasExplicitLinkedItemChoice && linkedItemDraft is null
            && int.TryParse(songIdInput, out var songId))
        {
            currentSong!.ItemId = songId;
            selectedLinkedItem = AvailableGameItems.FirstOrDefault(item => item.Id.Equals(songIdInput, StringComparison.OrdinalIgnoreCase));
            linkedItemSearchText = selectedLinkedItem is null ? string.Empty : FormatItemOption(selectedLinkedItem);
        }

        return Task.CompletedTask;
    }

    private Task SelectLinkedItem(Item? item)
    {
        if (currentSong is null || item is null || !int.TryParse(item.Id, out var itemId))
            return Task.CompletedTask;

        currentSong.ItemId = itemId;
        selectedLinkedItem = item;
        linkedItemSearchText = FormatItemOption(item);
        hasExplicitLinkedItemChoice = true;
        linkedItemDraft = null;
        return Task.CompletedTask;
    }

    private Task SearchLinkedItems(string? value)
    {
        linkedItemSearchText = value ?? string.Empty;
        if (selectedLinkedItem is not null
            && !FormatItemOption(selectedLinkedItem).Equals(linkedItemSearchText, StringComparison.OrdinalIgnoreCase))
        {
            selectedLinkedItem = null;
            hasExplicitLinkedItemChoice = false;
        }
        return Task.CompletedTask;
    }

    private void CancelLinkedItemCreation()
    {
        linkedItemDraft = null;
        selectedLinkedItem = null;
        linkedItemSearchText = string.Empty;
        hasExplicitLinkedItemChoice = false;
    }

    private string LanguageLabel(string language) => L[$"Editor.Language.{language}"].Value;

    private string FormatChartLine(int value) => value switch
    {
        3 => $"3 — {L["Options.PatternLine2"].Value}",
        4 => $"4 — {L["Options.PatternLine3"].Value}",
        5 => $"5 — {L["Options.PatternLine4"].Value}",
        _ => $"{value} — {L["Fields.ExistingValue"].Value}"
    };

    private string FormatChartDifficulty(int value) => value switch
    {
        0 => $"0 — {L["Options.PatternEasy"].Value}",
        1 => $"1 — {L["Options.PatternNormal"].Value}",
        2 => $"2 — {L["Options.PatternHard"].Value}",
        3 => $"3 — {L["Options.PatternExpert"].Value}",
        _ => $"{value} — {L["Fields.ExistingValue"].Value}"
    };

    private string FormatPointType(int value) => value switch
    {
        0 => $"0 — {L["Options.PointNone"].Value}",
        1 => $"1 — {L["Options.PointMax"].Value}",
        2 => $"2 — {L["Options.PointQ"].Value}",
        _ => $"{value} — {L["Fields.ExistingValue"].Value}"
    };

    private bool TryGetSuggestedItemId(out string itemId)
    {
        var existingSongItemId = currentSong is null
            ? string.Empty
            : currentSong.ItemId > 0
                ? currentSong.ItemId.ToString(System.Globalization.CultureInfo.InvariantCulture)
                : currentSong.Id.ToString(System.Globalization.CultureInfo.InvariantCulture);
        itemId = SelectedLinkedItem?.Id ?? (IsCreate ? songIdInput : existingSongItemId);
        return int.TryParse(itemId, out var parsedId) && parsedId > 0;
    }

    private void BeginLinkedItemCreation()
    {
        if (currentSong is null || !TryGetSuggestedItemId(out var itemId))
            return;

        linkedItemDraft = new Item
        {
            Id = itemId,
            ItemType = "S",
            RepeatCount = "0",
            LimitMinute = "0",
            Status = "N",
            BuyLevel = "0",
            BuyLimitCount = "1",
            BuyLimitType = "F",
            Update = "0"
        };
        currentSong.ItemId = int.Parse(itemId, System.Globalization.CultureInfo.InvariantCulture);
        selectedLinkedItem = null;
        linkedItemSearchText = string.Empty;
        hasExplicitLinkedItemChoice = true;
    }

    private void SetOriginalField(Action<Song> update)
    {
        if (currentSong is null) return;
        update(currentSong);
        if (_syncOriginalText) SyncOriginalToAllLanguages();
    }

    private void SyncOriginalToAllLanguages()
    {
        if (currentSong is null) return;

        foreach (var language in DefaultLanguages)
        {
            var localization = GetOrCreateLocalization(language);
            localization.FullName = currentSong.FullName;
            localization.Genre = currentSong.Genre;
            localization.ArtistName = currentSong.ArtistName;
            localization.ComposedBy = currentSong.ComposedBy;
            localization.Singer = currentSong.Singer;
            localization.FeatBy = currentSong.FeatBy;
            localization.ArrangedBy = currentSong.ArrangedBy;
            localization.VisualizedBy = currentSong.VisualizedBy;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo(TableNavigationState.ResolveReturnUrl(Navigation, ReturnUrl, "/songs"));

    // ── Save Song ──

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null) return;

        isBusy = true;
        message = string.Empty;
        errorMessage = string.Empty;

        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(songIdInput) || !int.TryParse(songIdInput, out var newId))
                {
                    errorMessage = L["Editor.SongIdRequired"].Value;
                    return;
                }
                var linkedItem = SelectedLinkedItem;
                var linkedItemId = linkedItemDraft?.Id ?? linkedItem?.Id;
                if (string.IsNullOrWhiteSpace(linkedItemId)
                    || !int.TryParse(linkedItemId, out var parsedLinkedItemId)
                    || parsedLinkedItemId < 1)
                {
                    errorMessage = L["Editor.SongItemIdRequired"].Value;
                    return;
                }
                currentSong!.ItemId = parsedLinkedItemId;
                if (_syncOriginalText) SyncOriginalToAllLanguages();
                var song = SongEditSvc.CreateDraft(currentSong, newId);
                if (linkedItemDraft is not null)
                    SongEditSvc.AddSongWithItem(State.CurrentPackage, song, linkedItemDraft, State.SelectedExportPlatform);
                else
                    SongEditSvc.AddSong(State.CurrentPackage, song, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                State.Diagnostics.Add($"Song added: {song.Id}");
                _lastPackage = null;
                NavigateBack();
            }
            else if (currentSong is not null)
            {
                var linkedItem = SelectedLinkedItem;
                var linkedItemId = linkedItemDraft?.Id ?? linkedItem?.Id;
                if (string.IsNullOrWhiteSpace(linkedItemId)
                    || !int.TryParse(linkedItemId, out var parsedLinkedItemId)
                    || parsedLinkedItemId < 1)
                {
                    errorMessage = L["Editor.SongItemIdRequired"].Value;
                    return;
                }

                currentSong.ItemId = parsedLinkedItemId;
                if (_syncOriginalText) SyncOriginalToAllLanguages();
                if (linkedItemDraft is not null)
                    ItemEditSvc.AddItem(State.CurrentPackage, linkedItemDraft, State.SelectedExportPlatform);
                SongEditSvc.UpdateSong(State.CurrentPackage, currentSong, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                _lastPackage = null;
                State.Diagnostics.Add($"Song edited: {currentSong.Id}");
                NavigateBack();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Song save error: " + ex.Message);
        }
        finally { isBusy = false; }
    }

    // ── Pattern: Add via Dialog ──

    private async Task OpenAddPatternDialog()
    {
        if (currentSong is null) return;

        var nextPatternId = Catalog.SelectMany(song => song.Patterns)
            .Concat(currentSong.Patterns)
            .Select(pattern => pattern.PatternId)
            .DefaultIfEmpty(0)
            .Max() + 1;
        var pattern = new SongPattern { PatternId = nextPatternId, SongId = currentSong.Id };

        var dialog = await DialogService.ShowDialogAsync<PatternDialog, SongPattern>(
            pattern,
            new DialogParameters
            {
                Title = L["Editor.AddPattern"].Value,
                PrimaryAction = L["Common.Save"].Value,
                SecondaryAction = L["Common.Cancel"].Value,
                Width = "480px",
                PreventDismissOnOverlayClick = true,
            });

        var result = await dialog.Result;
        if (result.Cancelled || pattern.PatternId == 0)
            return;

        try
        {
            isBusy = true;
            SongEditSvc.AddPattern(currentSong, pattern);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
            }
            else
            {
                SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                message = L["Editor.Saved", L["Editor.Patterns"].Value].Value;
            }
            _lastPackage = null;
            State.Diagnostics.Add($"Pattern added: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Add pattern error: " + ex.Message);
        }
        finally { isBusy = false; }
    }

    // ── Pattern: Edit via Dialog ──

    private async Task OpenEditPatternDialog(SongPattern pattern)
    {
        if (currentSong is null) return;

        // Clone so Cancel doesn't mutate original
        var clone = new SongPattern
        {
            PatternId = pattern.PatternId,
            SongId = pattern.SongId,
            Name = pattern.Name,
            Line = pattern.Line,
            Signature = pattern.Signature,
            Difficulty = pattern.Difficulty,
            PointType = pattern.PointType,
            PointValue = pattern.PointValue,
            Flg = pattern.Flg,
            Update = pattern.Update,
        };

        var dialog = await DialogService.ShowDialogAsync<PatternDialog, SongPattern>(
            clone,
            new DialogParameters
            {
                Title = L["Editor.Edit", pattern.PatternId].Value,
                PrimaryAction = L["Common.Save"].Value,
                SecondaryAction = L["Common.Cancel"].Value,
                Width = "480px",
                PreventDismissOnOverlayClick = true,
            });

        var result = await dialog.Result;
        if (result.Cancelled) return;

        try
        {
            isBusy = true;
            SongEditSvc.UpdatePattern(currentSong, pattern.PatternId, clone);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
                return;
            }
            SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            message = L["Editor.Saved", L["Editor.Patterns"].Value].Value;
            State.Diagnostics.Add($"Pattern edited: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Pattern edit error: " + ex.Message);
        }
        finally { isBusy = false; }
    }

    // ── Pattern: Delete ──

    private async Task RemovePatternAsync(SongPattern pattern)
    {
        if (currentSong is null) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            L["Lists.DeleteConfirm", L["Editor.Patterns"].Value, pattern.PatternId].Value,
            L["Common.Delete"].Value, L["Common.Cancel"].Value, L["Editor.Patterns"].Value);

        var result = await dialog.Result;
        if (result.Cancelled) return;

        isBusy = true;
        try
        {
            SongEditSvc.RemovePattern(currentSong, pattern.PatternId);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
                return;
            }
            SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            message = L["Lists.Deleted", L["Editor.Patterns"].Value, pattern.PatternId].Value;
            State.Diagnostics.Add($"Pattern removed: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally { isBusy = false; }
    }
}
