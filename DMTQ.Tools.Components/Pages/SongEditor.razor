@page "/songs/editor/{SongId}"
@using DMTQ.Tools.Components.Models
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject SongEditService SongEditSvc
@inject EditorDraftStore DraftStore
@inject SongCatalogService SongCatalog
@inject ItemEditService ItemEditSvc
@inject ProductEditService ProductEditSvc
@inject IDialogService DialogService
@inject EyecatchIndexService EyecatchIndex

<div class="song-editor-page">

    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenSongsProject"]' Intent="MessageBarIntent.Warning" />
    }
    else if (currentSong is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Songs"].Value, SongId]' Intent="MessageBarIntent.Error" />
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Editor.BackTo", L["Nav.Songs"].Value]</FluentButton>
    }
    else
    {
        <EditForm Model="@currentSong" OnValidSubmit="SaveAsync" FormName="song-editor" class="song-editor-form editor-form">
            <div class="song-editor-scroll">
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" class="editor-form-sections">

                    <section>
                        <h4 class="mb-1">@L["Editor.BasicInfo"]</h4>
                        <FluentGrid Spacing="1">
                            <FluentGridItem Xs="12" Sm="6" Md="3">
                                @if (IsCreate)
                                {
                                    <FluentTextInput style="width: 100%;" Value="@songIdInput" ValueChanged="SetSongIdInput" Label='@(L["Fields.SongId"].Value + " *")' Placeholder="1" Required />
                                }
                                else
                                {
                                    <FluentTextInput style="width: 100%;" Value="@(currentSong?.Id.ToString() ?? "")" Label='@L["Fields.SongId"]' ReadOnly="true" />
                                }
                            </FluentGridItem>
                            
                            <FluentGridItem Xs="12" Sm="6" Md="3"><FluentTextInput style="width: 100%;" @bind-Value="currentSong!.Name" Label='@L["Fields.SongName"]' /></FluentGridItem>

                            <FluentGridItem HiddenWhen="GridItemHidden.Xs" Md="6">
                            </FluentGridItem>

                            <FluentGridItem Xs="12" Sm="6" Md="3"><FluentTextInput style="width: 100%;" @bind-Value="songFullName" Label='@L["Fields.FullName"]' Immediate="true" /></FluentGridItem>
                            <FluentGridItem Xs="12" Sm="6" Md="3"><FluentTextInput style="width: 100%;" @bind-Value="songGenre" Label='@L["Fields.Genre"]' Immediate="true" /></FluentGridItem>
                        </FluentGrid>
                    </section>

                    <section>
                        <h4 class="mb-1">@L["Editor.Credits"]</h4>
                        <FluentGrid Spacing="1">
                            <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songArtistName" Label='@L["Fields.Artist"]' Immediate="true" /></FluentGridItem>
                            <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songComposedBy" Label='@L["Fields.Composer"]' Immediate="true" /></FluentGridItem>
                            <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songSinger" Label='@L["Fields.Singer"]' Immediate="true" /></FluentGridItem>
                            <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songFeatBy" Label='@L["Fields.FeaturedArtist"]' Immediate="true" /></FluentGridItem>
                            <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songArrangedBy" Label='@L["Fields.Arranger"]' Immediate="true" /></FluentGridItem>
                            <FluentGridItem Xs="12" Sm="6" Md="4"><FluentTextInput style="width: 100%;" @bind-Value="songVisualizedBy" Label='@L["Fields.Visualizer"]' Immediate="true" /></FluentGridItem>
                        </FluentGrid>
                    </section>

                    <section>
                        <h4 class="mb-1">@L["Editor.GameplaySettings"]</h4>
                        <p class="section-hint">@L["Editor.SongCodesHint"]</p>
                        <FluentGrid Spacing="1">
                            <FluentGridItem Xs="12" Md="3" style="display: flex; flex-direction: column;">
                                <FluentSwitch @bind-Value="openYn" Label='@L["Fields.OpenSong"]' />
                                <FluentSwitch @bind-Value="freeYn" Label='@L["Fields.FreeSong"]' />
                                <FluentSwitch @bind-Value="hiddenYn" Label='@L["Fields.HiddenSong"]' />
                            </FluentGridItem>
                            <FluentGridItem Xs="12" Md="3"><FluentNumberInput @bind-Value="costPoint" Label='@L["Fields.CostGamePoint"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="3"><FluentNumberInput @bind-Value="costCash" Label='@L["Fields.CostGameCash"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="3">
                                <p class="section-hint">
                                @L["Editor.SongPriceNotice"]
                                </p>
                            </FluentGridItem>

                            <FluentGridItem Xs="12" Md="3" style="display: flex; flex-direction: column;">
                                <FluentSwitch @bind-Value="bgaOriginal" Label='@L["Fields.OriginalBga"]' />
                                <FluentSwitch @bind-Value="bgaLoop" Label='@L["Fields.LoopBga"]' />
                            </FluentGridItem>
                            <FluentGridItem Xs="12" Md="3"><FluentNumberInput @bind-Value="currentSong!.Flag" Label='@L["Fields.SongFlag"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="3"><FluentTextInput style="width: 100%;" @bind-Value="currentSong!.Status" Label='@L["Fields.SongStatus"]' /></FluentGridItem>
                            <FluentGridItem HiddenWhen="GridItemHidden.Xs" Md="3">
                            </FluentGridItem>

                            <FluentGridItem Xs="12" Md="3"><FluentNumberInput @bind-Value="currentSong!.TrackId" Label='@L["Fields.TrackId"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="3"><FluentTextInput @bind-Value="currentSong!.ModDate" Label='@L["Fields.ModDate"]' /></FluentGridItem>
                            <FluentGridItem Xs="12" Md="3"><FluentTextInput @bind-Value="currentSong!.Update" Label='@L["Fields.UpdateValue"]' /></FluentGridItem>
                        </FluentGrid>
                    </section>

                    <FluentDivider class="song-section-divider" />

                    @* 道具 *@
                    <section>
                        <div class="section-title-row">
                            <div>
                                <h4 class="mb-1">@L["Editor.SongCommerce"]</h4>
                                <p class="section-hint">@L["Editor.SongCommerceHint"]</p>
                            </div>
                            @if (songItemDraft is null)
                            {
                                <FluentButton Appearance="ButtonAppearance.Default" OnClick="CreateSongItem"
                                              Disabled="@(!CanCreateSongItem)"
                                              IconStart="@(new Icons.Regular.Size20.Add())">@L["Editor.CreateSongItem"]</FluentButton>
                            }
                        </div>
                        @if (songItemDraft is null)
                        {
                            <FluentMessageBar Title='@L["Editor.NoSongItem"]' Intent="MessageBarIntent.Info" />
                        }
                        else
                        {
                            <FluentCard class="song-item-card" Padding="Padding.All4">
                                <div class="song-related-card-heading">
                                    <h3>@L["Editor.SongItemCardTitle"]</h3>
                                    <span>@L["Editor.SongItemCardLink", currentSong!.Id]</span>
                                </div>
                                <FluentGrid Spacing="1">
                                    <FluentGridItem Xs="12" Md="3" Sm="3">
                                        <FluentNumberInput @bind-Value="songItemIdInput" Label='@L["Fields.ItemId"]' Min="1" />
                                    </FluentGridItem>
                                    <FluentGridItem Xs="12" Md="3" Sm="3">
                                        <FluentTextInput @bind-Value="songItemDraft.ItemName" Label='@L["Fields.ItemName"]' Width="100%" />
                                    </FluentGridItem>
                                    <FluentGridItem Xs="12" Md="3" Sm="3">
                                        <FluentTextInput Value="S" Label='@L["Fields.ItemType"]' ReadOnly="true" />
                                    </FluentGridItem>
                                    <FluentGridItem Xs="12" Md="3" Sm="3">
                                        <FluentTextInput @bind-Value="songItemDraft.RepeatCount" Label='@L["Fields.RepeatCount"]' Width="100%" />
                                    </FluentGridItem>

                                    <FluentGridItem Xs="12" Sm="6" Md="6">
                                        <div class="song-item-cover-editor">
                                            <FluentTextInput @bind-Value="songItemDraft.ImgUrl1" Label='@L["Fields.ImageUrl1"]' Width="100%" />
                                            <div class="song-item-cover-preview-row">
                                                <button type="button" class="song-item-cover-preview"
                                                        disabled="@string.IsNullOrWhiteSpace(songItemDraft.ImgUrl1)"
                                                        title='@L["SongCoverPreview.Title", songItemDraft.ImgUrl1]'
                                                        @onclick="ShowSongItemCoverPreviewAsync">
                                                    @if (!string.IsNullOrWhiteSpace(songItemCoverImageUrl))
                                                    {
                                                        <img src="@songItemCoverImageUrl" alt="@songItemDraft.ImgUrl1" />
                                                    }
                                                    else
                                                    {
                                                        <span aria-hidden="true">?</span>
                                                    }
                                                </button>
                                                <div class="song-item-cover-actions">
                                                    <FluentButton Appearance="ButtonAppearance.Default"
                                                                  OnClick="OpenSongItemAtlasEditorAsync"
                                                                  Disabled="@(string.IsNullOrWhiteSpace(songItemDraft.ImgUrl1) || State.CurrentPackage is null || string.IsNullOrWhiteSpace(State.ProjectRoot))">
                                                        @L["SongCoverPreview.EditAtlas"]
                                                    </FluentButton>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(songItemCoverMessage))
                                            {
                                                <p class="song-item-cover-message">@songItemCoverMessage</p>
                                            }
                                        </div>
                                    </FluentGridItem>
                                    <FluentGridItem Xs="12" Sm="6" Md="6">
                                        <FluentTextInput @bind-Value="songItemDraft.ImgUrl2" Label='@L["Fields.ImageUrl2"]' Width="100%" />
                                    </FluentGridItem>
                                    <FluentGridItem Sm="6">
                                    </FluentGridItem>
                                    <FluentGridItem Sm="6">
                                    </FluentGridItem>
                                    <FluentGridItem Xs="12">
                                        <FluentTextArea @bind-Value="songItemDraft.Description" Label='@L["Fields.Description"]' Height="80px" Width="100%" Resize="TextAreaResize.Vertical" />
                                    </FluentGridItem>
                                </FluentGrid>
                            </FluentCard>
                            @if (IsSuggestedItemIdConflict)
                            {
                                <FluentMessageBar Title='@L["Editor.SongItemIdConflict", SongIdForItem, songItemIdInput ?? 0]' Intent="MessageBarIntent.Warning" />
                            }

                        
                            @* 商品 *@
                            <FluentDivider class="song-section-divider" />
                            <div class="section-title-row">
                                <h4 class="mb-1">@L["Editor.SongProducts"]</h4>
                                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="AddSongProduct"
                                              IconStart="@(new Icons.Regular.Size20.Add())">@L["Editor.AddSongProduct"]</FluentButton>
                                @if (!songProductDrafts.Any(product => !IsSongProductMarkedForDeletion(product)))
                                {
                                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateStandardSongProducts"
                                                  IconStart="@(new Icons.Regular.Size20.Add())">@L["Editor.CreateStandardSongProducts"]</FluentButton>
                                }
                            </div>
                            @if (songProductDrafts.Count == 0)
                            {
                                <FluentMessageBar Title='@L["Editor.NoSongProducts"]' Intent="MessageBarIntent.Info" />
                            }
                            else
                            {
                                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalGap="12" class="song-product-cards">
                                    @foreach (var product in songProductDrafts)
                                    {
                                        <FluentCard class="@SongProductCardClass(product)" Padding="Padding.All4">
                                            <div class="song-related-card-heading">
                                                <h4>@L["Editor.SongProductCardTitle", GetSongProductId(product), songItemIdInput ?? 0]</h4>
                                                @if (IsSongProductMarkedForDeletion(product))
                                                {
                                                    <FluentButton Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                                                  OnClick="() => RestoreSongProduct(product)">@L["Editor.RestoreSongProduct"]</FluentButton>
                                                }
                                                else
                                                {
                                                    <FluentButton Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                                                  IconStart="@(new Icons.Regular.Size20.Delete())"
                                                                  Color="var(--error)"
                                                                  OnClick="() => RequestDeleteSongProductAsync(product)">@L["Common.Delete"]</FluentButton>
                                                }
                                            </div>
                                            @if (IsSongProductMarkedForDeletion(product))
                                            {
                                                <FluentMessageBar Title='@L["Editor.SongProductPendingDelete"]' Intent="MessageBarIntent.Warning" />
                                            }
                                            <FluentGrid Spacing="1">
                                                <FluentGridItem Xs="12" Sm="6" Md="3">
                                                    <FluentTextInput Value="@GetSongProductId(product)"
                                                                     ValueChanged="@(value => SetSongProductId(product, value))"
                                                                     Label='@L["Fields.ProductId"]'
                                                                     Disabled="@IsSongProductMarkedForDeletion(product)" Width="100%" />
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="6" Md="3">
                                                    <FluentTextInput Value="@(songItemIdInput?.ToString() ?? string.Empty)" Label='@L["Fields.ItemId"]' ReadOnly="true" Width="100%" />
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="6" Md="3">
                                                    <FluentSelect TOption="string" TValue="string" Items="@ProductTypeOptions"
                                                                  Value="@GetProductTypeOption(product)"
                                                                  ValueChanged="@(value => SetProductTypeOption(product, value))"
                                                                  Disabled="@IsSongProductMarkedForDeletion(product)"
                                                                  Label='@L["Fields.ProductType"]' Width="100%" />
                                                </FluentGridItem>
                                                <FluentGridItem HiddenWhen="GridItemHidden.Xs" Sm="6" Md="3">
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="3">
                                                    <FluentTextInput @bind-Value="product.PlatformProductId" Label='@L["Fields.PlatformProductId"]'
                                                                     Disabled="@IsSongProductMarkedForDeletion(product)" Width="100%" />
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="9">
                                                    <FluentTextInput @bind-Value="product.StoreProductId" Label='@L["Fields.StoreProductId"]' Width="100%"
                                                                     Disabled="@IsSongProductMarkedForDeletion(product)" />
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="6" Md="3">
                                                    <FluentTextInput @bind-Value="product.CostGamePoint" Label='@L["Fields.CostGamePoint"]' Disabled="@IsSongProductMarkedForDeletion(product)" Width="100%" />
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="6" Md="3">
                                                    <FluentTextInput @bind-Value="product.CostGameCash" Label='@L["Fields.CostGameCash"]' Disabled="@IsSongProductMarkedForDeletion(product)" Width="100%" />
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="6" Md="3">
                                                    <FluentSelect TOption="string" TValue="string" Items="@ProductStatusOptions"
                                                                  Value="@GetProductStatusOption(product)"
                                                                  ValueChanged="@(value => SetProductStatusOption(product, value))"
                                                                  Disabled="@IsSongProductMarkedForDeletion(product)"
                                                                  Label='@L["Fields.Status"]' Width="100%" />
                                                </FluentGridItem>

                                                <FluentGridItem HiddenWhen="GridItemHidden.Sm" Md="3">
                                                </FluentGridItem>
                                            </FluentGrid>
                                            <FluentGrid Spacing="1" class="song-product-date-row">
                                                <FluentGridItem Xs="12" Sm="6">
                                                    <FluentTextInput @bind-Value="product.SaleStartDate" Label='@L["Fields.SaleStartDate"]' Disabled="@IsSongProductMarkedForDeletion(product)" Width="100%" />
                                                </FluentGridItem>
                                                <FluentGridItem Xs="12" Sm="6">
                                                    <FluentTextInput @bind-Value="product.SaleEndDate" Label='@L["Fields.SaleEndDate"]' Disabled="@IsSongProductMarkedForDeletion(product)" Width="100%" />
                                                </FluentGridItem>
                                            </FluentGrid>
                                        </FluentCard>
                                    }
                                </FluentStack>
                            }
                        }
                    </section>

                    @* ════════════════════════════════════════════
                   Row 3: Descriptions (multi-language, full width)
                   ════════════════════════════════════════════ *@
                    <FluentDivider class="song-section-divider" />
                    <section class="song-localized-section">
                        <h4 class="mb-1">@L["Editor.LocalizedDescriptions"]</h4>
                        <div class="section-inline-control">
                            <FluentSwitch @bind-Value="syncOriginalText" Label='@L["Editor.SyncAllLanguages"]' />
                        </div>
                        <p class="section-hint">@(syncOriginalText ? L["Editor.SyncAllLanguagesHint"] : L["Editor.DescriptionsHint"])</p>
                        @if (!syncOriginalText)
                        {
                            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch">
                                @foreach (var lang in DefaultLanguages)
                                {
                                    var loc = GetOrCreateLocalization(lang);
                                    <div>
                                        <h3 class="lang-heading">@LanguageLabel(lang)</h3>
                                        <FluentGrid Spacing="1">
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.FullName" Label='@L["Fields.FullName"]' />
                                            </FluentGridItem>
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.Genre" Label='@L["Fields.Genre"]' />
                                            </FluentGridItem>
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.ArtistName" Label='@L["Fields.Artist"]' />
                                            </FluentGridItem>
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.ComposedBy" Label='@L["Fields.Composer"]' />
                                            </FluentGridItem>
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.Singer" Label='@L["Fields.Singer"]' />
                                            </FluentGridItem>
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.FeatBy" Label='@L["Fields.FeaturedArtist"]' />
                                            </FluentGridItem>
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.ArrangedBy" Label='@L["Fields.Arranger"]' />
                                            </FluentGridItem>
                                            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="2">
                                                <FluentTextInput style="width: 100%;" @bind-Value="loc.VisualizedBy" Label='@L["Fields.Visualizer"]' />
                                            </FluentGridItem>
                                        </FluentGrid>
                                    </div>
                                }
                            </FluentStack>
                        }
                    </section>

                    @* ════════════════════════════════════════════
                   Row 4: Patterns (full width, DataGrid + Dialog)
                   ════════════════════════════════════════════ *@
                    <section>
                        <div class="table-header">
                            <h4 class="mb-1">@L["Editor.Patterns"]</h4>
                            <FluentButton Appearance="ButtonAppearance.Primary"
                                          IconStart="@(new Icons.Regular.Size20.Add())"
                                          OnClick="OpenAddPatternDialog">@L["Editor.AddPattern"]</FluentButton>
                        </div>

                        @if (currentSong?.Patterns.Count > 0)
                        {
                            <div class="grid-scroll">
                                <FluentDataGrid Items="@SortedPatterns.AsQueryable()" TGridItem="SongPattern"
                                                ShowHover="true" ResizableColumns="true">
                                    <PropertyColumn Property="@(p => p.PatternId)" Title='@L["Fields.PatternId"]' Sortable="true" />
                                    <TemplateColumn Title='@L["Fields.ChartLine"]' Context="p">
                                        @FormatChartLine(p.Line)
                                    </TemplateColumn>
                                    <TemplateColumn Title='@L["Fields.ChartDifficulty"]' Context="p">
                                        @FormatChartDifficulty(p.Signature)
                                    </TemplateColumn>
                                    <PropertyColumn Property="@(p => p.Difficulty)" Title='@L["Fields.StarRating"]' />
                                    <TemplateColumn Title='@L["Fields.PointType"]' Context="p">
                                        @FormatPointType(p.PointType)
                                    </TemplateColumn>
                                    <PropertyColumn Property="@(p => p.PointValue)" Title='@L["Fields.PointValue"]' />
                                    <TemplateColumn Title='@L["Fields.PatternEnabled"]' Context="p">
                                        @(p.Flg == "Y" ? "✓" : "")
                                    </TemplateColumn>
                                    <TemplateColumn Title='@L["Common.Actions"]' Context="p">
                                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                                            <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                                                          Size="ButtonSize.Small"
                                                          Title='@L["Common.Edit"]'
                                                          OnClick="() => OpenEditPatternDialog(p)">
                                                @L["Common.Edit"]
                                            </FluentButton>
                                            <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                                                          Size="ButtonSize.Small"
                                                          Title='@L["Common.Delete"]'
                                                          OnClick="() => RemovePatternAsync(p)" />
                                        </FluentStack>
                                    </TemplateColumn>
                                </FluentDataGrid>
                            </div>
                        }
                        else
                        {
                            <FluentMessageBar Title='@L["Editor.NoPatterns"]' Intent="MessageBarIntent.Info" />
                        }
                    </section>

                </FluentStack>
            </div>
            <div class="song-editor-actions">
                <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveSong"]</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                @if (!string.IsNullOrEmpty(message))
                {
                    <span class="song-editor-status">@message</span>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <FluentMessageBar Title="@errorMessage" Intent="MessageBarIntent.Error" />
                }
                <EditorSaveFailure Exception="@saveException" Context="Song editor save" />
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string SongId { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private static readonly string[] DefaultLanguages = ["CN", "JP", "KR", "TW", "US"];

    private bool IsCreate => SongId == "new";
    private string RecoveryKey => $"song:{SongId}";
    private string? loadedSongId;
    private Song? currentSong;
    private string songIdInput = string.Empty;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private Exception? saveException;
    private bool isBusy;
    private bool _syncOriginalText = true;
    private Item? songItemDraft;
    private string? songItemCoverImageUrl;
    private string? lastCoverSpriteName;
    private string? lastCoverProjectRoot;
    private string songItemCoverMessage = string.Empty;
    private int? songItemIdInput;
    private string? originalSongItemId;
    private bool itemIdWasConflictSuggested;
    private List<Product> songProductDrafts = [];
    private HashSet<string> originalSongProductIds = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> songProductIdDrafts = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> pendingSongProductDeletionIds = new(StringComparer.OrdinalIgnoreCase);

    private bool syncOriginalText
    {
        get => _syncOriginalText;
        set
        {
            _syncOriginalText = value;
            if (value) SyncOriginalToAllLanguages();
        }
    }

    private string songFullName { get => currentSong?.FullName ?? string.Empty; set => SetOriginalField(song => song.FullName = value); }
    private string songGenre { get => currentSong?.Genre ?? string.Empty; set => SetOriginalField(song => song.Genre = value); }
    private string songArtistName { get => currentSong?.ArtistName ?? string.Empty; set => SetOriginalField(song => song.ArtistName = value); }
    private string songComposedBy { get => currentSong?.ComposedBy ?? string.Empty; set => SetOriginalField(song => song.ComposedBy = value); }
    private string songSinger { get => currentSong?.Singer ?? string.Empty; set => SetOriginalField(song => song.Singer = value); }
    private string songFeatBy { get => currentSong?.FeatBy ?? string.Empty; set => SetOriginalField(song => song.FeatBy = value); }
    private string songArrangedBy { get => currentSong?.ArrangedBy ?? string.Empty; set => SetOriginalField(song => song.ArrangedBy = value); }
    private string songVisualizedBy { get => currentSong?.VisualizedBy ?? string.Empty; set => SetOriginalField(song => song.VisualizedBy = value); }

    // YN ↔ bool wrappers
    private bool bgaOriginal { get => currentSong?.OriginalBgaYn == "Y"; set => currentSong!.OriginalBgaYn = value ? "Y" : "N"; }
    private bool bgaLoop { get => currentSong?.LoopBgaYn == "Y"; set => currentSong!.LoopBgaYn = value ? "Y" : "N"; }
    private bool freeYn { get => currentSong?.FreeYn == "Y"; set => currentSong!.FreeYn = value ? "Y" : "N"; }
