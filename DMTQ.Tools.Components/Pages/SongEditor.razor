    private async Task RemovePatternAsync(SongPattern pattern)
    {
        if (currentSong is null) return;

        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", L["Editor.Patterns"].Value, pattern.PatternId].Value,
            title: L["Editor.Patterns"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;

        isBusy = true;
        saveException = null;
        try
        {
            SongEditSvc.RemovePattern(currentSong, pattern.PatternId);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
                return;
            }
            SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
            State.IsDirty = true;
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            message = L["Lists.Deleted", L["Editor.Patterns"].Value, pattern.PatternId].Value;
            State.Diagnostics.Add($"Pattern removed: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

    private async Task SaveSongAndCommerceAsync(Song song)
    {
        var package = State.CurrentPackage!;
        var tables = package.GetPlatformTables(State.SelectedExportPlatform);
        var wasDirty = State.IsDirty;
        var oldSongs = tables.Songs.Select(existing => SongEditSvc.CreateDraft(existing)).ToList();
        var oldItems = tables.Items.Select(existing => ItemEditSvc.CreateDraft(existing)).ToList();
        var oldProducts = tables.Products.Select(existing => ProductEditSvc.CreateDraft(existing)).ToList();
        var oldIngameItems = tables.IngameItems.Select(existing => new IngameItem
        {
            Id = existing.Id,
            ItemType = existing.ItemType,
            ItemLevel = existing.ItemLevel,
            ProductId = existing.ProductId,
            Update = existing.Update
        }).ToList();

        try
        {
            if (songItemDraft is not null)
            {
                if (songItemIdInput is not > 0)
                    throw new InvalidOperationException(L["Editor.SongItemIdRequired"].Value);
                var newItemId = songItemIdInput.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var conflictingItem = tables.Items.FirstOrDefault(item => item.Id == newItemId && item.Id != originalSongItemId);
                if (conflictingItem is not null)
                    throw new InvalidOperationException(L["Editor.SongItemIdTaken", newItemId].Value);
                songItemDraft = ItemEditSvc.CreateDraft(songItemDraft, newItemId);
                songItemDraft.ItemType = "S";
                song.ItemId = songItemIdInput.Value;

                if (originalSongItemId is not null && originalSongItemId != newItemId)
                    tables.Items.RemoveAll(item => item.Id == originalSongItemId);
                if (tables.Items.Any(item => item.Id == newItemId))
                    ItemEditSvc.UpdateItem(package, songItemDraft, State.SelectedExportPlatform);
                else
                    ItemEditSvc.AddItem(package, songItemDraft, State.SelectedExportPlatform);

                foreach (var productId in pendingSongProductDeletionIds)
                {
                    if (tables.Products.Any(existing => existing.Id.Equals(productId, StringComparison.OrdinalIgnoreCase)))
                        ProductEditSvc.RemoveProduct(package, productId, State.SelectedExportPlatform);
                }

                var activeSongProducts = songProductDrafts
                    .Where(productDraft => !IsSongProductMarkedForDeletion(productDraft))
                    .ToList();
                var requestedProductIds = activeSongProducts
                    .Select(GetSongProductId)
                    .Select(id => id.Trim())
                    .ToArray();
                if (requestedProductIds.Any(string.IsNullOrWhiteSpace))
                    throw new InvalidOperationException(L["Editor.ProductIdRequired"].Value);
                if (requestedProductIds.Distinct(StringComparer.OrdinalIgnoreCase).Count() != requestedProductIds.Length)
                    throw new InvalidOperationException(L["Editor.SongProductIdDuplicate"].Value);

                for (var index = 0; index < activeSongProducts.Count; index++)
                {
                    var productDraft = activeSongProducts[index];
                    var oldProductId = productDraft.Id;
                    var newProductId = requestedProductIds[index];
                    var product = ProductEditSvc.CreateDraft(productDraft, newProductId);
                    product.ItemId = newItemId;

                    var existingProduct = tables.Products.FirstOrDefault(existing => existing.Id == oldProductId);
                    if (existingProduct is not null && !oldProductId.Equals(newProductId, StringComparison.OrdinalIgnoreCase))
                    {
                        if (tables.Products.Any(existing => existing.Id.Equals(newProductId, StringComparison.OrdinalIgnoreCase)))
                            throw new InvalidOperationException(L["Editor.SongProductIdTaken", newProductId].Value);

                        var movedIngameItems = tables.IngameItems
                            .Where(item => item.ProductId.Equals(oldProductId, StringComparison.OrdinalIgnoreCase))
                            .Select(item => new IngameItem
                            {
                                Id = item.Id,
                                ItemType = item.ItemType,
                                ItemLevel = item.ItemLevel,
                                ProductId = newProductId,
                                Update = item.Update
                            })
                            .ToList();
                        tables.Products.Remove(existingProduct);
                        tables.IngameItems.RemoveAll(item => item.ProductId.Equals(oldProductId, StringComparison.OrdinalIgnoreCase));
                        ProductEditSvc.AddProduct(package, product, movedIngameItems, State.SelectedExportPlatform);
                    }
                    else if (existingProduct is not null)
                        ProductEditSvc.UpdateProduct(package, product, State.SelectedExportPlatform);
                    else
                    {
                        if (tables.Products.Any(existing => existing.Id.Equals(newProductId, StringComparison.OrdinalIgnoreCase)))
                            throw new InvalidOperationException(L["Editor.SongProductIdTaken", newProductId].Value);
                        ProductEditSvc.AddProduct(package, product, [], State.SelectedExportPlatform);
                    }
                }
            }

            if (IsCreate)
                SongEditSvc.AddSong(package, SongEditSvc.CreateDraft(song), State.SelectedExportPlatform);
            else
                SongEditSvc.UpdateSong(package, song, State.SelectedExportPlatform);

            State.IsDirty = true;
            await Workflow.SaveProjectAsync();
        }
        catch
        {
            tables.Songs.Clear(); tables.Songs.AddRange(oldSongs);
            tables.Items.Clear(); tables.Items.AddRange(oldItems);
            tables.Products.Clear(); tables.Products.AddRange(oldProducts);
            tables.IngameItems.Clear(); tables.IngameItems.AddRange(oldIngameItems);
            State.IsDirty = wasDirty;
            throw;
        }
    }

    private sealed record SongDraft(
        Song Song,
        string SongIdInput,
        Item? SongItemDraft,
        int? SongItemIdInput,
        string? OriginalSongItemId,
        List<Product> SongProductDrafts,
        HashSet<string> OriginalSongProductIds,
        Dictionary<string, string> SongProductIdDrafts,
        HashSet<string> PendingSongProductDeletionIds,
        bool ItemIdWasConflictSuggested,
        bool SyncOriginalText);
}
