    private async Task OpenEditPatternDialog(SongPattern pattern)
    {
        if (currentSong is null) return;

        // Clone so Cancel doesn't mutate original
        var clone = new SongPattern
        {
            PatternId = pattern.PatternId,
            SongId = pattern.SongId,
            Name = pattern.Name,
            Line = pattern.Line,
            Signature = pattern.Signature,
            Difficulty = pattern.Difficulty,
            PointType = pattern.PointType,
            PointValue = pattern.PointValue,
            Flg = pattern.Flg,
            Update = pattern.Update,
        };

        var result = await DialogService.ShowDialogAsync<PatternDialog>(options =>
        {
            options.Header.Title = L["Editor.Edit", pattern.PatternId].Value;
            options.Footer.PrimaryAction.Label = L["Common.Save"].Value;
            options.Footer.SecondaryAction.Label = L["Common.Cancel"].Value;
            options.Width = "480px";
            options.Parameters = new Dictionary<string, object?> { [nameof(PatternDialog.Content)] = clone };
        });
        if (result.Cancelled) return;

        try
        {
            saveException = null;
            isBusy = true;
            SongEditSvc.UpdatePattern(currentSong, pattern.PatternId, clone);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
                return;
            }
            SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
            State.IsDirty = true;
            await Workflow.SaveProjectAsync();
            _lastPackage = null;
            message = L["Editor.Saved", L["Editor.Patterns"].Value].Value;
            State.Diagnostics.Add($"Pattern edited: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

