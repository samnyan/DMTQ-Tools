    private void CreateSongItem()
    {
        if (State.CurrentPackage is null || currentSong is null) return;
        var tables = State.CurrentPackage.GetPlatformTables(State.SelectedExportPlatform);
        var desiredId = currentSong.ItemId > 0 ? currentSong.ItemId : (IsCreate && int.TryParse(songIdInput, out var createId) ? createId : currentSong.Id);
        var conflict = tables.Items.Any(item => item.Id == desiredId.ToString(System.Globalization.CultureInfo.InvariantCulture));
        var id = conflict
            ? NextNumericId(tables.Items.Select(item => item.Id))
            : desiredId;
        if (id <= 0) id = NextNumericId(tables.Items.Select(item => item.Id));

        songItemIdInput = id;
        itemIdWasConflictSuggested = conflict;
        songItemDraft = new Item
        {
            Id = id.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ItemName = currentSong.Name,
            ImgUrl1 = string.Empty,
            ImgUrl2 = string.Empty,
            Description = string.Empty,
            RepeatCount = "0",
            ItemType = "S",
            LimitMinute = "0",
            Status = "N",
            BuyLevel = "0",
            BuyLimitCount = "1",
            BuyLimitType = "F",
            Summary = string.IsNullOrWhiteSpace(currentSong.FullName) ? currentSong.Name : currentSong.FullName,
            Update = "0"
        };
        originalSongItemId = null;
        songProductDrafts = [];
        songProductIdDrafts.Clear();
    }

    private void AddSongProduct()
    {
        if (State.CurrentPackage is null || songItemDraft is null || songItemIdInput is not > 0) return;
        var tables = State.CurrentPackage.GetPlatformTables(State.SelectedExportPlatform);
        var productId = NextNumericId(tables.Products.Select(product => product.Id).Concat(songProductDrafts.Select(product => product.Id)));
        var platformProductId = NextNumericId(tables.Products.Select(product => product.PlatformProductId).Concat(songProductDrafts.Select(product => product.PlatformProductId)));
        var product = CreateSongProduct(productId, platformProductId, "com.neowizInternet.game.dmtq.", songItemDraft.ItemName);
        songProductDrafts.Add(product);
        songProductIdDrafts[product.Id] = product.Id;
    }

    private void CreateStandardSongProducts()
    {
        if (State.CurrentPackage is null || songItemDraft is null || songItemIdInput is not > 0
            || songProductDrafts.Any(product => !IsSongProductMarkedForDeletion(product))) return;
        var tables = State.CurrentPackage.GetPlatformTables(State.SelectedExportPlatform);
        var nextPlatformProductId = NextNumericId(tables.Products.Select(product => product.PlatformProductId));
        var itemId = songItemIdInput.Value;
        songProductDrafts =
        [
            CreateStandardSongProduct(itemId, nextPlatformProductId, "com.neowizInternet.game.dmtq.", "3", songItemDraft.ItemName),
            CreateStandardSongProduct((long)itemId + 1_000_000, nextPlatformProductId + 1, "com.neowizInternet.game.dmtq_a.", "103", songItemDraft.ItemName)
        ];
        ResetSongProductIds();
    }

    private static Product CreateStandardSongProduct(long productId, int platformProductId, string skuPrefix, string categoryId, string itemName)
    {
        var product = CreateSongProduct(productId, platformProductId, skuPrefix, itemName);
        product.AddCategoryId(categoryId);
        return product;
    }

    private void ResetSongProductIds()
        => songProductIdDrafts = songProductDrafts.ToDictionary(product => product.Id, product => product.Id, StringComparer.OrdinalIgnoreCase);

    private string GetSongProductId(Product product)
        => songProductIdDrafts.TryGetValue(product.Id, out var value) ? value : product.Id;

    private void SetSongProductId(Product product, string? value)
        => songProductIdDrafts[product.Id] = value ?? string.Empty;

    private bool IsSongProductMarkedForDeletion(Product product)
        => pendingSongProductDeletionIds.Contains(product.Id);

    private string SongProductCardClass(Product product)
        => IsSongProductMarkedForDeletion(product)
            ? "song-product-card song-product-card-pending"
            : "song-product-card";

