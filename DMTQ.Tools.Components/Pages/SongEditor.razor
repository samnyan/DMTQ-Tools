    private async Task OpenSongItemAtlasEditorAsync()
    {
        var spriteName = songItemDraft?.ImgUrl1;
        if (string.IsNullOrWhiteSpace(spriteName) || State.CurrentPackage is null || string.IsNullOrWhiteSpace(State.ProjectRoot)) return;

        var separator = spriteName.IndexOf('_');
        var atlasKey = separator > 1 ? spriteName[..separator] : string.Empty;
        if (atlasKey.Length < 2 || !atlasKey.StartsWith("e", StringComparison.OrdinalIgnoreCase)
            || !int.TryParse(atlasKey.AsSpan(1), out _))
        {
            songItemCoverMessage = L["SongCoverPreview.InvalidSprite"].Value;
            return;
        }

        var atlasNames = new[] { $"d_{atlasKey}", $"d3_{atlasKey}" };
        var candidates = State.CurrentPackage.Resources
            .Where(resource => resource.Category.Equals("dlc", StringComparison.OrdinalIgnoreCase)
                && atlasNames.Contains(Path.GetFileNameWithoutExtension(resource.FileName), StringComparer.OrdinalIgnoreCase))
            .SelectMany(resource => resource.PlatformManifest
                .Where(file => file.Exist)
                .Select(file => new { Resource = resource, file.Platform }))
            .Where(candidate => candidate.Platform.Equals("android", StringComparison.OrdinalIgnoreCase)
                || candidate.Platform.Equals("ios", StringComparison.OrdinalIgnoreCase))
            .Select(candidate => new
            {
                candidate.Resource.FileName,
                candidate.Platform,
                IsNgui2 = Path.GetFileNameWithoutExtension(candidate.Resource.FileName).StartsWith("d_", StringComparison.OrdinalIgnoreCase),
                PlatformPath = Path.GetFullPath(Path.Combine(State.ProjectRoot, "resources", candidate.Platform,
                    candidate.Resource.FileName.Replace('/', Path.DirectorySeparatorChar).Replace('\\', Path.DirectorySeparatorChar)))
            })
            .Where(candidate => File.Exists(candidate.PlatformPath) || File.Exists(candidate.PlatformPath + ".lz4"))
            .OrderBy(candidate => candidate.Platform.Equals(State.SelectedExportPlatform, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(candidate => candidate.IsNgui2 ? 1 : 0)
            .ToArray();

        var selected = candidates.FirstOrDefault();
        var isNew = selected is null;
        var projectFile = selected?.FileName;
        var platform = selected?.Platform;
        await DialogService.ShowDialogAsync<SongItemAtlasEditorDialog>(options =>
        {
            options.Header.Title = L["AtlasEditor.Title"].Value;
            options.Width = "min(1500px, 98vw)";
            options.Height = "94vh";
            options.Footer.PrimaryAction.Label = L["Common.Close"].Value;
            options.Parameters = new Dictionary<string, object?>
            {
                [nameof(SongItemAtlasEditorDialog.ProjectFile)] = projectFile,
                [nameof(SongItemAtlasEditorDialog.Platform)] = platform,
                [nameof(SongItemAtlasEditorDialog.IsNewAtlas)] = isNew,
                [nameof(SongItemAtlasEditorDialog.InitialAtlasName)] = $"d3_{atlasKey}",
                [nameof(SongItemAtlasEditorDialog.InitialSpriteName)] = spriteName
            };
        });
        songItemCoverMessage = string.Empty;
    }

    private void LoadSongCommerceDrafts()
    {
        songItemDraft = null;
        songItemIdInput = null;
        originalSongItemId = null;
        songProductDrafts = [];
        originalSongProductIds.Clear();
        songProductIdDrafts.Clear();
        if (currentSong is null || State.CurrentPackage is null || currentSong.ItemId <= 0) return;

        var itemId = currentSong.ItemId.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var tables = State.CurrentPackage.GetPlatformTables(State.SelectedExportPlatform);
        var item = tables.Items.FirstOrDefault(candidate => candidate.Id == itemId
            && candidate.ItemType.Equals("S", StringComparison.OrdinalIgnoreCase));
        if (item is null) return;

        songItemDraft = ItemEditSvc.CreateDraft(item);
        songItemIdInput = currentSong.ItemId;
        originalSongItemId = item.Id;
        songProductDrafts = tables.Products
            .Where(product => product.ItemId == item.Id)
            .Select(product => ProductEditSvc.CreateDraft(product))
            .ToList();
        originalSongProductIds = songProductDrafts.Select(product => product.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        ResetSongProductIds();
    }

    private void RemoveExternallyDeletedSongProducts()
    {
        if (State.CurrentPackage is null) return;
        var existingIds = State.CurrentPackage.GetPlatformTables(State.SelectedExportPlatform).Products
            .Select(product => product.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var removedIds = songProductDrafts
            .Where(product => originalSongProductIds.Contains(product.Id) && !existingIds.Contains(product.Id))
            .Select(product => product.Id)
            .ToArray();
        if (removedIds.Length == 0) return;

        songProductDrafts.RemoveAll(product => removedIds.Contains(product.Id, StringComparer.OrdinalIgnoreCase));
        foreach (var id in removedIds)
        {
            songProductIdDrafts.Remove(id);
            pendingSongProductDeletionIds.Remove(id);
        }
    }

    private void RemoveExternallyDeletedSongItem()
    {
        if (State.CurrentPackage is null || originalSongItemId is null) return;
        var itemExists = State.CurrentPackage.GetPlatformTables(State.SelectedExportPlatform).Items
            .Any(item => item.Id.Equals(originalSongItemId, StringComparison.OrdinalIgnoreCase));
        if (itemExists) return;

        songItemDraft = null;
        songItemIdInput = null;
        originalSongItemId = null;
        songProductDrafts.Clear();
        originalSongProductIds.Clear();
        songProductIdDrafts.Clear();
        pendingSongProductDeletionIds.Clear();
        itemIdWasConflictSuggested = false;
    }

    private SongLocalization GetOrCreateLocalization(string lang)
    {
        if (!currentSong!.Localizations.TryGetValue(lang, out var loc))
        {
            loc = new SongLocalization();
            currentSong.Localizations[lang] = loc;
        }
        return loc;
    }

