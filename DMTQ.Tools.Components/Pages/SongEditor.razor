    // ── Save Song ──

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null) return;

        isBusy = true;
        message = string.Empty;
        errorMessage = string.Empty;
        saveException = null;

        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(songIdInput) || !int.TryParse(songIdInput, out var newId))
                {
                    errorMessage = L["Editor.SongIdRequired"].Value;
                    return;
                }
                var song = SongEditSvc.CreateDraft(currentSong!, newId);
                await SaveSongAndCommerceAsync(song);
                State.Diagnostics.Add($"Song added: {song.Id}");
                _lastPackage = null;
                NavigateBack();
            }
            else if (currentSong is not null)
            {
                await SaveSongAndCommerceAsync(currentSong);
                _lastPackage = null;
                State.Diagnostics.Add($"Song edited: {currentSong.Id}");
                NavigateBack();
            }
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

    // ── Pattern: Add via Dialog ──

    private async Task OpenAddPatternDialog()
    {
        if (currentSong is null) return;

        var nextPatternId = Catalog.SelectMany(song => song.Patterns)
            .Concat(currentSong.Patterns)
            .Select(pattern => pattern.PatternId)
            .DefaultIfEmpty(0)
            .Max() + 1;
        var pattern = new SongPattern { PatternId = nextPatternId, SongId = currentSong.Id };

        var result = await DialogService.ShowDialogAsync<PatternDialog>(options =>
        {
            options.Header.Title = L["Editor.AddPattern"].Value;
            options.Footer.PrimaryAction.Label = L["Common.Save"].Value;
            options.Footer.SecondaryAction.Label = L["Common.Cancel"].Value;
            options.Width = "480px";
            options.Parameters = new Dictionary<string, object?> { [nameof(PatternDialog.Content)] = pattern };
        });
        if (result.Cancelled || pattern.PatternId == 0)
            return;

        try
        {
            saveException = null;
            isBusy = true;
            SongEditSvc.AddPattern(currentSong, pattern);
            if (IsCreate)
            {
                message = L["Editor.PatternDraftSavedWithSong"].Value;
            }
            else
            {
                SongEditSvc.UpdateSong(State.CurrentPackage!, currentSong, State.SelectedExportPlatform);
                State.IsDirty = true;
                await Workflow.SaveProjectAsync();
                message = L["Editor.Saved", L["Editor.Patterns"].Value].Value;
            }
            _lastPackage = null;
            State.Diagnostics.Add($"Pattern added: {pattern.PatternId}");
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally { isBusy = false; }
    }

