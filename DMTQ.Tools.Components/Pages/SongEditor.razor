    private static Product CreateSongProduct(long productId, int platformProductId, string skuPrefix, string itemName)
    {
        var skuName = string.Concat(itemName.Trim().ToLowerInvariant().Where(char.IsLetterOrDigit));
        return new Product
        {
            Id = productId.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ItemId = string.Empty,
            PlatformProductId = platformProductId.ToString(System.Globalization.CultureInfo.InvariantCulture),
            StoreProductId = skuPrefix + skuName,
            ProductType = "I",
            CostGamePoint = "0",
            CostGameCash = "20",
            Status = "N",
            SaleStartDate = string.Empty,
            SaleEndDate = string.Empty,
            Update = "0"
        };
    }

    private static int NextNumericId(IEnumerable<string> ids)
        => ids.Select(id => int.TryParse(id, out var value) ? value : 0).DefaultIfEmpty(0).Max() + 1;

    private string[] BuildProductTypeOptions()
    {
        var observed = State.CurrentPackage?.GetPlatformTables(State.SelectedExportPlatform).Products
            .Select(product => product.ProductType) ?? [];
        var types = observed.Append("I").Append("ticket")
            .Where(type => !string.IsNullOrWhiteSpace(type))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(type => type, StringComparer.OrdinalIgnoreCase);
        return [.. new[] { $" — {L["Options.EffectTypeNone"].Value}" }, .. types.Select(type => $"{type} — {ProductTypeDisplay.GetName(type, L)}")];
    }

    private string GetProductTypeOption(Product product)
        => ProductTypeOptions.FirstOrDefault(option => option.StartsWith(product.ProductType + " — ", StringComparison.OrdinalIgnoreCase))
           ?? $"{product.ProductType} — {L["Fields.ExistingValue"].Value}";

