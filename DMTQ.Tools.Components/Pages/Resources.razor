@page "/resources"
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ResourceManagerService ResourceMgr

<h1>Resources</h1>

@if (State.CurrentPackage is null)
{
    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 1rem;">
        <FluentMessageBar Title="Import or open a project before managing resources." Intent="MessageIntent.Warning" />
    </FluentStack>
}
else
{
    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 1rem;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentTextField @bind-Value="filter" Immediate="true" Placeholder="Filter resources" />
            <FluentSelect Items="@(new List<string> { "" }.Concat(Catalog.Select(r => r.Category).Distinct().OrderBy(v => v)))"
                          OptionText="@(i => string.IsNullOrEmpty(i) ? "All categories" : i)"
                          OptionValue="@(i => i)"
                          @bind-SelectedOption="categoryFilter"
                          Label="Category" />
        </FluentStack>
    </FluentStack>

    <FluentGrid Spacing="3" AdaptiveRendering="true">
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard>
                <span class="metric-label">Resources</span>
                <strong>@Catalog.Count</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard>
                <span class="metric-label">Preview</span>
                <strong>@Catalog.Count(r => r.Category == "preview")</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard>
                <span class="metric-label">Platform-specific</span>
                <strong>@Catalog.Count(r => !string.IsNullOrWhiteSpace(r.Platform))</strong>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="4">
            <FluentCard>
                <span class="metric-label">Compressed</span>
                <strong>@Catalog.Count(r => r.Compressed)</strong>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Style="min-height: 34rem;">
        <FluentStack Orientation="Orientation.Vertical" Style="width: 300px; overflow-y: auto;">
            @foreach (var resource in FilteredResources.Take(500))
            {
                <FluentButton Style="width: 100%;"
                              Appearance="@(IsSelected(resource) ? Appearance.Accent : Appearance.Neutral)"
                              OnClick="() => SelectResource(resource)">
                    <FluentStack Orientation="Orientation.Vertical">
                        <strong>@resource.PackageRelativePath</strong>
                        <span>@resource.Category / @(resource.Platform ?? "shared") / @(resource.Compressed ? "compressed" : "uncompressed")</span>
                    </FluentStack>
                </FluentButton>
            }
        </FluentStack>

        <FluentStack Orientation="Orientation.Vertical" Style="flex: 1;">
            @if (SelectedResource is null)
            {
                <FluentMessageBar Title="Select a resource." Intent="MessageIntent.Info" />
            }
            else
            {
                <FluentStack Orientation="Orientation.Horizontal" Style="justify-content: space-between; align-items: center;">
                    <div>
                        <h2>@SelectedResource.PackageRelativePath</h2>
                        <p>@SelectedResource.ProjectRelativePath</p>
                    </div>
                    <div class="table-counts">@SelectedResource.Category</div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
                    <FluentTextField @bind-Value="sourceFilePath" Label="Source file for replacement" />
                    <FluentSelect Items="@(new[] { "true", "false" })"
                                  OptionText="@(i => i == "true" ? "Compressed" : "Uncompressed")"
                                  OptionValue="@(i => i)"
                                  @bind-SelectedOption="selectedCompressedText"
                                  Label="Compression" />
                </FluentStack>

                @if (SelectedResource.IsSharedPreview)
                {
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
                        <FluentCheckbox @bind-Value="includeAndroid" Label="android" />
                        <FluentCheckbox @bind-Value="includeIos" Label="ios" />
                    </FluentStack>
                }

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                    <FluentButton Appearance="Appearance.Accent" OnClick="ReplaceSelected" Disabled="@isBusy">Replace</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" OnClick="SaveSelectedMetadata" Disabled="@isBusy">Save Metadata</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" OnClick="RemoveSelected" Disabled="@isBusy">Remove</FluentButton>
                </FluentStack>
            }
        </FluentStack>
    </FluentStack>

    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 1rem;">
        <h2 class="section-heading">Add Resource</h2>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
            <FluentTextField @bind-Value="newSourceFilePath" Label="Source file" />
            <FluentTextField @bind-Value="newPackagePath" Placeholder="preview/song.p.opus or dlc/file.bundle" Label="Package path" />
            <FluentSelect Items="@(new[] { "", "android", "ios" })"
                          OptionText="@(i => string.IsNullOrEmpty(i) ? "shared preview" : i)"
                          OptionValue="@(i => i)"
                          @bind-SelectedOption="newPlatform"
                          Label="Platform" />
            <FluentSelect Items="@(new[] { "true", "false" })"
                          OptionText="@(i => i == "true" ? "Compressed" : "Uncompressed")"
                          OptionValue="@(i => i)"
                          @bind-SelectedOption="newCompressedText"
                          Label="Compression" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
            <FluentCheckbox @bind-Value="newIncludeAndroid" Label="android preview inclusion" />
            <FluentCheckbox @bind-Value="newIncludeIos" Label="ios preview inclusion" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentButton Appearance="Appearance.Accent" OnClick="AddResource" Disabled="@isBusy">Add Resource</FluentButton>
            @if (message is not null)
            {
                <FluentMessageBar Title="@message" Intent="MessageIntent.Info" />
            }
        </FluentStack>
    </FluentStack>
}

@code {
    private string filter = string.Empty;
    private string categoryFilter = string.Empty;
    private string? selectedPath;
    private string? selectedPlatform;
    private string sourceFilePath = string.Empty;
    private string selectedCompressedText = "false";
    private bool includeAndroid;
    private bool includeIos;
    private string newSourceFilePath = string.Empty;
    private string newPackagePath = string.Empty;
    private string newPlatform = string.Empty;
    private string newCompressedText = "false";
    private bool newIncludeAndroid = true;
    private bool newIncludeIos;
    private bool isBusy;
    private string? message;

    private IReadOnlyList<ResourceCatalogEntry> Catalog => State.CurrentPackage is null
        ? []
        : ResourceMgr.BuildCatalog(State.CurrentPackage);

    private IEnumerable<ResourceCatalogEntry> FilteredResources
    {
        get
        {
            var query = Catalog.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(categoryFilter))
            {
                query = query.Where(resource => resource.Category.Equals(categoryFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filter))
            {
                query = query.Where(resource =>
                    resource.PackageRelativePath.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || resource.ProjectRelativePath.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || (resource.Platform?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true));
            }

            return query;
        }
    }

    private ResourceCatalogEntry? SelectedResource => Catalog.FirstOrDefault(resource =>
        resource.PackageRelativePath == selectedPath
        && resource.Platform == selectedPlatform);

    private bool IsSelected(ResourceCatalogEntry resource)
        => resource.PackageRelativePath == selectedPath && resource.Platform == selectedPlatform;

    private void SelectResource(ResourceCatalogEntry resource)
    {
        selectedPath = resource.PackageRelativePath;
        selectedPlatform = resource.Platform;
        sourceFilePath = string.Empty;
        selectedCompressedText = resource.Compressed ? "true" : "false";
        includeAndroid = resource.IncludedPlatforms.Contains("android", StringComparer.OrdinalIgnoreCase);
        includeIos = resource.IncludedPlatforms.Contains("ios", StringComparer.OrdinalIgnoreCase);
        message = null;
    }

    private async Task ReplaceSelected()
    {
        if (SelectedResource is null)
        {
            return;
        }

        await RunResourceAction(async () =>
        {
            await Workflow.AddOrReplaceResourceAsync(
                sourceFilePath,
                SelectedResource.PackageRelativePath,
                SelectedResource.Platform,
                SelectedResource.IsSharedPreview ? SelectedPreviewPlatforms() : [],
                bool.Parse(selectedCompressedText));
            message = "Resource replaced.";
        });
    }

    private async Task SaveSelectedMetadata()
    {
        if (SelectedResource is null)
        {
            return;
        }

        await RunResourceAction(async () =>
        {
            await Workflow.SetResourceCompressionAsync(SelectedResource.PackageRelativePath, SelectedResource.Platform, bool.Parse(selectedCompressedText));
            if (SelectedResource.IsSharedPreview)
            {
                await Workflow.SetPreviewIncludedPlatformsAsync(SelectedResource.PackageRelativePath, SelectedPreviewPlatforms());
            }
            message = "Resource metadata saved.";
        });
    }

    private async Task RemoveSelected()
    {
        if (SelectedResource is null)
        {
            return;
        }

        await RunResourceAction(async () =>
        {
            await Workflow.RemoveResourceAsync(SelectedResource.PackageRelativePath, SelectedResource.Platform);
            selectedPath = null;
            selectedPlatform = null;
            message = "Resource removed from project.";
        });
    }

    private async Task AddResource()
    {
        await RunResourceAction(async () =>
        {
            await Workflow.AddOrReplaceResourceAsync(
                newSourceFilePath,
                newPackagePath,
                string.IsNullOrWhiteSpace(newPlatform) ? null : newPlatform,
                SelectedNewPreviewPlatforms(),
                bool.Parse(newCompressedText));
            selectedPath = newPackagePath;
            selectedPlatform = string.IsNullOrWhiteSpace(newPlatform) ? null : newPlatform;
            message = "Resource added.";
        });
    }

    private IReadOnlyCollection<string> SelectedPreviewPlatforms()
    {
        var platforms = new List<string>();
        if (includeAndroid)
        {
            platforms.Add("android");
        }

        if (includeIos)
        {
            platforms.Add("ios");
        }

        return platforms;
    }

    private IReadOnlyCollection<string> SelectedNewPreviewPlatforms()
    {
        var platforms = new List<string>();
        if (newIncludeAndroid)
        {
            platforms.Add("android");
        }

        if (newIncludeIos)
        {
            platforms.Add("ios");
        }

        return platforms;
    }

    private async Task RunResourceAction(Func<Task> action)
    {
        isBusy = true;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Resource manager error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
