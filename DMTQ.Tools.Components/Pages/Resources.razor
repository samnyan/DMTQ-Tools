@page "/resources"
@using DMTQ.Tools.Components.Models
@using DMTQ.Tools.Core.Services
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ResourceManagerService ResourceMgr
@inject IDialogService DialogService

<ProjectListShell TItem="ResourceCatalogEntry"
                  Title='@L["Nav.Resources"]'
                  ProjectMissingMessage='@L["Common.NoProject"]'
                  EmptyMessage='@L["Lists.NoResources"]'
                  FilteredItems="@FilteredResources"
                  Pagination="@pagination"
                  Message="@message"
                  ErrorMessage="@errorMessage">
    <Toolbar>
        <div class="list-toolbar-layout">
            <div class="list-toolbar-filters">
                <ToolbarField>
                    <FluentSelect Items="@(new[] { "All", "dlc", "preview", "slang" })"
                                  OptionText="@(i => i == "All" ? L["Lists.AllCategories"].Value : i)"
                                  OptionValue="@(i => i)"
                                  @bind-Value="categoryFilter"
                                  @bind-Value:after="UpdateCategoryQueryAsync"
                                  Label='@L["Lists.Category"]'
                                  class="list-select" />
                </ToolbarField>
                <ToolbarField Unlabeled Search>
                    <FluentTextInput Value="@filter" ValueChanged="SetFilterAsync" Immediate="true" Placeholder='@L["Lists.FilterResources"]'
                                     class="list-filter" />
                </ToolbarField>
            </div>
            <div class="list-toolbar-actions">
                <ToolbarField Unlabeled>
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  class="list-toolbar-action-button"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  OnClick="AddNewResource"><span class="button-label-nowrap">@L["Lists.AddResource"]</span></FluentButton>
                </ToolbarField>
            </div>
        </div>
    </Toolbar>

    <Metrics>
        <FluentGrid class="metric-grid" Spacing="3" AdaptiveRendering="true">
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">@L["Lists.TotalResources"]</span><strong>@Catalog.Count</strong>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">dlc</span><strong>@Catalog.Count(r => r.Category == "dlc")</strong>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">preview</span><strong>@Catalog.Count(r => r.Category == "preview")</strong>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem Xs="12" Sm="6" Md="3">
                <FluentCard>
                    <span class="metric-label">@L["Lists.Others"]</span><strong>@Catalog.Count(r => r.Category != "dlc" && r.Category != "preview")</strong>
                </FluentCard>
            </FluentGridItem>
        </FluentGrid>
    </Metrics>

    <Columns>
        <PropertyColumn TGridItem="ResourceCatalogEntry" TProp="string" Property="@(r => r.FileName)" Title='@L["Lists.FileName"]' Sortable="true" />
        <PropertyColumn TGridItem="ResourceCatalogEntry" TProp="string" Property="@(r => r.Category)" Title='@L["Lists.Category"]' Sortable="true" />
        <TemplateColumn TGridItem="ResourceCatalogEntry" Title='@L["Lists.Platforms"]' Context="resource">
            @string.Join(", ", resource.PlatformManifest.Select(PlatformStatusLabel))
        </TemplateColumn>
        <TemplateColumn TGridItem="ResourceCatalogEntry" Title='@L["Lists.Size"]' Context="resource">
            @FormatFileSize(resource.PlatformManifest.FirstOrDefault()?.SourceFileSize ?? 0)
        </TemplateColumn>
        <TemplateColumn TGridItem="ResourceCatalogEntry" Title='@L["Lists.Compressed"]' Context="resource">
            @(resource.Compressed ? L["Lists.Yes"] : L["Lists.No"])
        </TemplateColumn>
        <TemplateColumn TGridItem="ResourceCatalogEntry" Title='@L["Lists.Actions"]' Context="resource">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
                <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())"
                              Size="ButtonSize.Small"
                              OnClick="() => OpenEditDialog(resource)"
                              Title='@L["Common.Edit"]'>
                    @L["Common.Edit"]
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Regular.Size20.Delete())"
                              Size="ButtonSize.Small"
                              OnClick="() => DeleteResourceAsync(resource)"
                              Title='@L["Common.Delete"]' />
            </FluentStack>
        </TemplateColumn>
    </Columns>
</ProjectListShell>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryQuery { get; set; }
    private string filter => SearchQuery ?? string.Empty;
    private string categoryFilter
    {
        get => CategoryQuery ?? "All";
        set => CategoryQuery = value;
    }
    private string? message;
    private string? errorMessage;
    private PaginationState pagination = new() { ItemsPerPage = 25 };

    private PatchPackage? _lastPackage;
    private IReadOnlyList<ResourceCatalogEntry> _catalog = [];

    private IReadOnlyList<ResourceCatalogEntry> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage)) return _catalog;
            _lastPackage = State.CurrentPackage;
            _catalog = State.CurrentPackage is null ? [] : ResourceMgr.BuildCatalog(State.CurrentPackage);
            return _catalog;
        }
    }

    private IEnumerable<ResourceCatalogEntry> FilteredResources
    {
        get
        {
            var query = Catalog.AsEnumerable();
            if (!string.Equals(categoryFilter, "All", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(r => r.Category.Equals(categoryFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(filter))
            {
                query = query.Where(r => r.FileName.Contains(filter, StringComparison.OrdinalIgnoreCase));
            }
            return query.ByIdentifierDescending(resource => $"{resource.Category}/{resource.FileName}");
        }
    }

    private Task SetFilterAsync(string? value)
    {
        SearchQuery = value;
        TableNavigationState.UpdateQuery(Navigation, ("q", value), ("page", "1"));
        return Task.CompletedTask;
    }

    private Task UpdateCategoryQueryAsync()
    {
        TableNavigationState.UpdateQuery(Navigation, ("category", categoryFilter == "All" ? null : categoryFilter), ("page", "1"));
        return Task.CompletedTask;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes}B";
        if (bytes < 1048576) return $"{bytes / 1024}KB";
        return $"{bytes / 1048576}MB";
    }

    private string PlatformStatusLabel(PlatformManifestInfo entry)
    {
        var builtIn = L["Resources.BuiltInMarker"].Value;
        return entry.IsInstallPack
            ? $"{entry.Platform} {builtIn}"
            : $"{entry.Platform} {(entry.Exist ? "✓" : "✗")}";
    }

    private static ResourceDialogData BuildDialogData(ResourceCatalogEntry entry)
    {
        var (category, fileNameOnly) = FileUtility.ParseResourcePath(entry.FileName);
        return new ResourceDialogData
        {
            IsNew = false,
            FileName = fileNameOnly,
            Category = category,
            Compressed = entry.Compressed,
            Platforms = entry.PlatformManifest.Select(m => new PlatformCardData
            {
                Platform = m.Platform,
                Exist = m.Exist,
                IsInstallPack = m.IsInstallPack,
                SourceFileSize = m.SourceFileSize,
                SourceChecksum = m.SourceChecksum
            }).ToList()
        };
    }

    private static string BuildResourcePath(string category, string fileName)
    {
        var prefix = FileUtility.GetCategoryPathPrefix(category);
        return string.IsNullOrEmpty(prefix) ? fileName : $"{prefix}/{fileName}";
    }

    private async Task AddNewResource()
    {
        message = null;
        errorMessage = null;
        var data = new ResourceDialogData { IsNew = true };
        var result = await DialogService.ShowDialogAsync<ResourceEditDialog>(options =>
        {
            options.Header.Title = L["Dialog.AddResource"].Value;
            options.Footer.PrimaryAction.Label = L["Common.Save"].Value;
            options.Footer.SecondaryAction.Label = L["Common.Cancel"].Value;
            options.Width = "640px";
            options.Parameters = new Dictionary<string, object?> { [nameof(ResourceEditDialog.Content)] = data };
        });
        if (!result.Cancelled)
            await ApplyDialogChanges(data, null);
    }

    private async Task OpenEditDialog(ResourceCatalogEntry entry)
    {
        message = null;
        errorMessage = null;
        var data = BuildDialogData(entry);
        var result = await DialogService.ShowDialogAsync<ResourceEditDialog>(options =>
        {
            options.Header.Title = L["Dialog.EditResource"].Value;
            options.Footer.PrimaryAction.Label = L["Common.Save"].Value;
            options.Footer.SecondaryAction.Label = L["Common.Cancel"].Value;
            options.Width = "640px";
            options.Parameters = new Dictionary<string, object?> { [nameof(ResourceEditDialog.Content)] = data };
        });
        if (!result.Cancelled)
        {
            if (!string.IsNullOrWhiteSpace(data.RequestedAtlasPlatform))
            {
                var relativePath = BuildResourcePath(data.Category, data.FileName);
                var route = $"/atlas-editor?projectFile={Uri.EscapeDataString(relativePath)}&platform={Uri.EscapeDataString(data.RequestedAtlasPlatform)}";
                Navigation.NavigateTo(route);
                return;
            }

            await ApplyDialogChanges(data, entry);
        }
    }

    private async Task DeleteResourceAsync(ResourceCatalogEntry entry)
    {
        if (State.CurrentPackage is null) return;

        message = null;
        errorMessage = null;

        var result = await DialogService.ShowConfirmationAsync(
            message: L["Lists.DeleteConfirm", L["Nav.Resources"].Value.ToLowerInvariant(), entry.FileName].Value,
            title: L["Nav.Resources"].Value,
            primaryButton: L["Common.Delete"].Value,
            secondaryButton: L["Common.Cancel"].Value);
        if (result.Cancelled) return;

        try
        {
            await Workflow.RemoveResourceAsync(entry.FileName, null);
            _lastPackage = null; // invalidate catalog cache
            State.Diagnostics.Add($"Resource deleted: {entry.FileName}");
            message = L["Lists.Deleted", L["Nav.Resources"].Value, entry.FileName].Value;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Delete resource error: " + ex.Message);
        }
    }

    private async Task ApplyDialogChanges(ResourceDialogData data, ResourceCatalogEntry? original)
    {
        if (string.IsNullOrWhiteSpace(data.FileName))
        {
            errorMessage = "File name is required.";
            return;
        }

        var prefix = FileUtility.GetCategoryPathPrefix(data.Category);
        var fullPath = string.IsNullOrEmpty(prefix)
            ? data.FileName
            : $"{prefix}/{data.FileName}";

        try
        {
            if (original is null)
            {
                await Workflow.AddResourceStubAsync(fullPath, data.Compressed);
            }

            foreach (var card in data.Platforms)
            {
                if (card.MarkedForDeletion)
                {
                    await Workflow.RemoveResourceAsync(fullPath, card.Platform);
                }
                else if (card.IsNew || card.PendingFilePath is not null)
                {
                    var sourcePath = card.PendingFilePath ?? "";
                    if (!string.IsNullOrEmpty(sourcePath))
                    {
                        var isShared = data.Category is "preview" or "slang";
                        await Workflow.AddOrReplaceResourceAsync(
                            sourcePath,
                            fullPath,
                            isShared ? null : card.Platform,
                            isShared ? [card.Platform] : [],
                            data.Compressed);
                    }
                }
            }

            // Update compression if changed
            if (original is not null && original.Compressed != data.Compressed)
            {
                await Workflow.SetResourceCompressionAsync(fullPath, null, data.Compressed);
            }

            foreach (var card in data.Platforms.Where(card => !card.MarkedForDeletion))
            {
                var originalEntry = original?.PlatformManifest.FirstOrDefault(entry =>
                    entry.Platform.Equals(card.Platform, StringComparison.OrdinalIgnoreCase));
                if (card.IsInstallPack != (originalEntry?.IsInstallPack ?? false))
                    await Workflow.SetResourceInstallPackAsync(fullPath, card.Platform, card.IsInstallPack);
            }

            await Workflow.SaveProjectAsync();
            _lastPackage = null; // invalidate catalog
            State.Diagnostics.Add($"Resource updated: {fullPath}");
            message = $"Resource '{fullPath}' saved.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Resource edit error: " + ex.Message);
        }
    }
}
