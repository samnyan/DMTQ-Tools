@using DMTQ.Tools.Components.Models
@using DMTQ.Tools.Core.Services
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IProjectFilePicker FilePicker
@inherits FluentDialogInstance

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" Style="min-width: 520px;">

    @* Resource path *@
    <section>
        <h2 class="section-heading">@L["Dialog.BasicInfo"]</h2>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                <FluentSelect Items="@_categoryOptions"
                              OptionText="@(category => FileUtility.GetCategoryPathPrefix(category) + "/")"
                              OptionValue="@(category => category)"
                              @bind-Value="Content.Category"
                              Label="Category"
                              Style="min-width: 140px;"
                              Disabled="@(!Content.IsNew)" />
                <FluentTextInput @bind-Value="Content.FileName"
                                 Label="File Name"
                                 ReadOnly="@(!Content.IsNew)"
                                 Style="flex: 1;" />
            </FluentStack>
            <div style="font-size: 0.85rem; color: var(--colorNeutralForeground1); padding-left: 4px;">
                Full path: <code style="font-weight: 600;">@FullPathPreview</code>
            </div>
            <FluentSwitch @bind-Value="Content.Compressed" Label="Compressed" />
        </FluentStack>
    </section>

    @* Platform Files Section *@
    <section>
        <h2 class="section-heading">@L["Dialog.PlatformFiles"]</h2>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            @foreach (var card in Content.Platforms.Where(p => !p.MarkedForDeletion))
            {
                <FluentCard Style="border: 1px solid var(--colorNeutralStroke1);">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" Style="padding: 12px;">
                        <div style="font-weight: 600; font-size: 1rem;">@card.Platform</div>
                        <div style="font-size: 0.85rem; color: var(--colorNeutralForeground1);">
                            @L["Dialog.ExistSizeChecksum", card.Exist ? "✓" : "✗", FormatSize(card.SourceFileSize), card.SourceChecksum]
                        </div>
                        @if (!string.IsNullOrEmpty(card.SourceChecksum))
                        {
                            <div style="font-size: 0.85rem; color: var(--colorNeutralForeground1);">
                                @L["Dialog.Source", card.SourceChecksum]
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(card.PendingFilePath))
                        {
                            <div style="font-size: 0.85rem; color: var(--colorBrandForeground1);">
                                @L["Dialog.WillReplace", card.PendingFilePath]
                            </div>
                        }
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 8px;">
                            <FluentButton Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                          OnClick="() => PickAndReplaceFile(card)">@L["Dialog.ReplaceFile"]</FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                          OnClick="() => RemovePlatform(card)">@L["Common.Delete"]</FluentButton>
                        </FluentStack>
                    </FluentStack>
                </FluentCard>
            }

            @if (!string.IsNullOrEmpty(_addPlatformMessage))
            {
                <FluentMessageBar Title="@_addPlatformMessage" Intent="MessageBarIntent.Warning" />
            }

            @if (Content.Category.Equals("dlc", StringComparison.OrdinalIgnoreCase) && _showPlatformChoices)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <span style="font-weight: 500;">@L["Dialog.SelectPlatform"]</span>
                    @foreach (var plat in _availablePlatforms)
                    {
                        <FluentButton Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                      OnClick="() => AddPlatformFor(plat)">@plat</FluentButton>
                    }
                    <FluentButton Appearance="ButtonAppearance.Default" Size="ButtonSize.Small"
                                  OnClick="CancelAddPlatform">@L["Common.Cancel"]</FluentButton>
                </FluentStack>
            }
            else if (Content.Category.Equals("dlc", StringComparison.OrdinalIgnoreCase))
            {
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="ShowAddPlatformOptions"
                              IconStart="@(new Icons.Regular.Size20.Add())">@L["Dialog.AddPlatform"]</FluentButton>
            }
            else
            {
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="PickSharedFileAsync"
                              IconStart="@(new Icons.Regular.Size20.Add())">Select File</FluentButton>
            }
        </FluentStack>
    </section>

</FluentStack>
</FluentDialogBody>

@code {
    [Parameter] public ResourceDialogData Content { get; set; } = default!;

    private static readonly List<string> _categoryOptions = ["dlc", "preview", "slang"];
    private static readonly string[] _allPlatforms = ["android", "ios"];

    private bool _showPlatformChoices;
    private List<string> _availablePlatforms = [];
    private string _addPlatformMessage = string.Empty;

    protected override Task OnActionClickedAsync(bool primary)
        => primary ? DialogInstance.CloseAsync(Content) : DialogInstance.CancelAsync();

    private string FullPathPreview => string.IsNullOrWhiteSpace(Content.FileName)
        ? "(enter a file name)"
        : BuildFullPath(Content.Category, Content.FileName);

    private static string BuildFullPath(string category, string fileName)
    {
        var prefix = FileUtility.GetCategoryPathPrefix(category);
        return string.IsNullOrEmpty(prefix) ? fileName : $"{prefix}/{fileName}";
    }

    private void ShowAddPlatformOptions()
    {
        _addPlatformMessage = string.Empty;
        _availablePlatforms = _allPlatforms
            .Where(p => !Content.Platforms.Any(c => c.Platform == p && !c.MarkedForDeletion))
            .ToList();

        if (_availablePlatforms.Count == 0)
        {
            _addPlatformMessage = L["Dialog.AllPlatformsAdded"].Value;
            return;
        }

        if (_availablePlatforms.Count == 1)
        {
            _ = AddPlatformFor(_availablePlatforms[0]);
            return;
        }

        _showPlatformChoices = true;
    }

    private void CancelAddPlatform()
    {
        _showPlatformChoices = false;
    }

    private async Task AddPlatformFor(string platform)
    {
        _showPlatformChoices = false;

        var path = await FilePicker.PickFileAsync();
        if (path is null) return;

        var md5 = ComputeMd5(path);
        var fileInfo = new FileInfo(path);

        var card = new PlatformCardData
        {
            Platform = platform,
            IsNew = true,
            PendingFilePath = path,
            LocalChecksum = md5,
            SourceFileSize = fileInfo.Length,
            Exist = false,
            SourceChecksum = "",
        };

        Content.Platforms.Add(card);
    }

    private async Task PickAndReplaceFile(PlatformCardData card)
    {
        var path = await FilePicker.PickFileAsync();
        if (path is null) return;

        card.PendingFilePath = path;
        card.LocalChecksum = ComputeMd5(path);
        card.SourceFileSize = new FileInfo(path).Length;
    }

    private async Task PickSharedFileAsync()
    {
        var path = await FilePicker.PickFileAsync();
        if (path is null) return;

        var existing = Content.Platforms.FirstOrDefault(card =>
            card.Platform.Equals("share", StringComparison.OrdinalIgnoreCase)
            && !card.MarkedForDeletion);
        if (existing is not null)
        {
            existing.PendingFilePath = path;
            existing.LocalChecksum = ComputeMd5(path);
            existing.SourceFileSize = new FileInfo(path).Length;
            return;
        }

        Content.Platforms.Add(new PlatformCardData
        {
            Platform = "share",
            IsNew = true,
            PendingFilePath = path,
            LocalChecksum = ComputeMd5(path),
            SourceFileSize = new FileInfo(path).Length,
            Exist = false
        });
    }

    private void RemovePlatform(PlatformCardData card)
    {
        if (card.IsNew)
        {
            Content.Platforms.Remove(card);
        }
        else
        {
            card.MarkedForDeletion = true;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string ComputeMd5(string path)
    {
        using var md5 = System.Security.Cryptography.MD5.Create();
        using var stream = File.OpenRead(path);
        var hash = md5.ComputeHash(stream);
        return BitConverter.ToString(hash).Replace("-", "").ToLowerInvariant();
    }
}
