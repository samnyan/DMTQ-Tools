@page "/slang/editor/{EntryId}"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject SlangEditService EditService
@inject EditorDraftStore DraftStore

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch">
    @if (State.CurrentPackage is null) { <FluentMessageBar Title='@L["Editor.OpenProjectFirst"]' Intent="MessageBarIntent.Warning" /> }
    else if (entry is null && !IsCreate) { <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Slang"].Value, EntryId]' Intent="MessageBarIntent.Error" /> }
    else
    {
        <EditForm Model="@editModel" OnValidSubmit="SaveAsync" FormName="slang-editor" class="editor-form">
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" class="editor-form-sections">
                <section><h2 class="section-heading">@L["Editor.SlangEntry"]</h2><p class="section-hint">@L["Editor.SlangHint"]</p>
                    <FluentTextInput style="width:100%" @bind-Value="editModel.Value" Label='@L["Fields.SlangValue"]' Required /></section>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                    <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@isBusy">@L["Common.Save"]</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <FluentMessageBar Title="@errorMessage" Intent="MessageBarIntent.Error" /> }
                    <EditorSaveFailure Exception="@saveException" Context="Slang editor save" />
                </FluentStack>
            </FluentStack>
        </EditForm>
    }
</FluentStack>

@code {
    [Parameter] public string EntryId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private bool IsCreate => EntryId.Equals("new", StringComparison.OrdinalIgnoreCase);
    private string RecoveryKey => $"slang:{EntryId}";
    private SlangEntry? entry;
    private SlangEditModel editModel = new();
    private bool isBusy;
    private string? errorMessage;
    private Exception? saveException;

    protected override void OnParametersSet()
    {
        if (DraftStore.TryGet<SlangDraft>(RecoveryKey, out var recovered) && recovered is not null)
        {
            entry = recovered.Entry;
            editModel = recovered.Model;
            return;
        }

        if (IsCreate) { entry = null; editModel = new(); return; }
        entry = State.CurrentPackage?.SlangEntries.FirstOrDefault(item => item.Id == EntryId);
        editModel = new SlangEditModel { Value = entry?.Value ?? string.Empty };
    }

    protected override void OnAfterRender(bool firstRender)
        => DraftStore.Set(RecoveryKey, new SlangDraft(entry, editModel));

    private void NavigateBack()
    {
        DraftStore.Remove(RecoveryKey);
        Navigation.NavigateTo(TableNavigationState.ResolveReturnUrl(Navigation, ReturnUrl, "/slang"));
    }
    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null) return;
        isBusy = true; errorMessage = null; saveException = null;
        SlangEntry? created = null;
        try
        {
            if (IsCreate) created = EditService.Add(State.CurrentPackage, editModel.Value);
            else EditService.Update(State.CurrentPackage, EntryId, editModel.Value);
            var wasDirty = State.IsDirty;
            State.IsDirty = true;
            try { await Workflow.SaveProjectAsync(); }
            catch
            {
                if (created is not null)
                {
                    State.CurrentPackage.SlangEntries.Remove(created);
                    State.IsDirty = wasDirty;
                }
                throw;
            }
            NavigateBack();
        }
        catch (Exception ex) { saveException = ex; }
        finally { isBusy = false; }
    }

    private sealed record SlangDraft(SlangEntry? Entry, SlangEditModel Model);
    private sealed class SlangEditModel { public string Value { get; set; } = string.Empty; }
}
