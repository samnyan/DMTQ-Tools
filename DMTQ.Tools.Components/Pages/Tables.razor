@page "/tables"
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject LogicalTableService LogicalTables

<h1>Tables</h1>

@if (State.CurrentPackage is null)
{
    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 1rem;">
        <div class="status-message">Import or open a project before browsing tables.</div>
    </FluentStack>
}
else
{
    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 1rem;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentTextField @bind-Value="filter"
                             Immediate="true"
                             Placeholder="Filter logical tables"
                             Style="flex: 1; max-width: 30rem;" />
            <FluentButton Appearance="Appearance.Neutral"
                          OnClick="SaveProject"
                          Disabled="@isSaving">Save</FluentButton>
        </FluentStack>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <FluentMessageBar Title="@message" Intent="MessageIntent.Info" />
        }
    </FluentStack>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Style="min-height: 32rem;">
        <FluentStack Orientation="Orientation.Vertical" Style="width: 22rem; min-width: 16rem; max-height: 32rem; overflow: auto; border: 1px solid var(--neutral-stroke-rest); border-radius: 6px; padding: 0.75rem;">
            @foreach (var table in FilteredLogicalTables)
            {
                <FluentButton Appearance="@(table.Key == SelectedLogicalTable?.Key ? Appearance.Accent : Appearance.Neutral)"
                              OnClick="@(() => SelectLogicalTable(table.Key))"
                              Style="text-align: left; margin-bottom: 0.25rem; width: 100%;">
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Start">
                        <strong>@table.DisplayName</strong>
                        <span style="color: #5f6b7a; font-size: 0.8rem;">@table.Kind / @table.Rows.Count rows / @table.SourcePackageRelativePaths.Count CSV files</span>
                    </FluentStack>
                </FluentButton>
            }
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" Style="flex: 1; min-width: 0; border: 1px solid var(--neutral-stroke-rest); border-radius: 6px; padding: 1rem;">
            @if (SelectedLogicalTable is null)
            {
                <div class="status-message">Select a logical table.</div>
            }
            else
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="margin-bottom: 0.75rem;">
                    <FluentStack Orientation="Orientation.Vertical">
                        <h2 style="font-size: 1.2rem; margin: 0;">@SelectedLogicalTable.DisplayName</h2>
                        <p style="color: #5f6b7a; margin: 0.25rem 0 0; overflow-wrap: anywhere;">@SelectedLogicalTable.Kind table backed by @SelectedLogicalTable.SourcePackageRelativePaths.Count CSV file(s)</p>
                    </FluentStack>
                    <span style="color: #5f6b7a; white-space: nowrap;">@SelectedLogicalTable.Columns.Count columns / @SelectedLogicalTable.Rows.Count rows</span>
                </FluentStack>

                @if (SelectedLogicalTable.Languages.Count > 0)
                {
                    <div style="color: #5f6b7a; font-size: 0.9rem; margin: 0.5rem 0;">Languages: @string.Join(", ", SelectedLogicalTable.Languages)</div>
                }

                <div style="overflow: auto; max-height: 34rem;">
                    <table class="data-grid editable-grid">
                        <thead>
                            <tr>
                                @foreach (var column in SelectedLogicalTable.Columns)
                                {
                                    <th>@column.DisplayName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in SelectedLogicalTable.Rows.Take(100))
                            {
                                <tr>
                                    @foreach (var column in SelectedLogicalTable.Columns)
                                    {
                                        <td>
                                            @if (column.Editable)
                                            {
                                                var value = row.Cells.TryGetValue(column.Key, out var currentValue) ? currentValue : string.Empty;
                                                <input class="cell-input" value="@value" @onchange="args => UpdateCell(row.Key, column.Key, args.Value?.ToString() ?? string.Empty)" />
                                            }
                                            else
                                            {
                                                @(row.Cells.TryGetValue(column.Key, out var currentValue) ? currentValue : string.Empty)
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="color: #5f6b7a; font-size: 0.9rem; margin-top: 0.5rem;">Showing first 100 logical rows. Add/delete rows are planned for a later round.</div>
            }
        </FluentStack>
    </FluentStack>

    <details style="margin-top: 1rem; border: 1px solid var(--neutral-stroke-rest); border-radius: 6px; padding: 1rem;">
        <summary>Advanced raw CSV files</summary>
        <div style="display: grid; gap: 0.35rem; margin-top: 0.75rem; color: #5f6b7a; font-size: 0.9rem;">
            @foreach (var table in State.CurrentPackage.Tables.Tables.OrderBy(table => table.PackageRelativePath))
            {
                <div>@table.PackageRelativePath (@table.Rows.Count rows)</div>
            }
        </div>
    </details>
}

@code {
    private string filter = string.Empty;
    private string? selectedLogicalTableKey;
    private string? message;
    private bool isSaving;
    private PatchPackage? _lastPackage;
    private IReadOnlyList<LogicalTable> _catalog = [];

    private IReadOnlyList<LogicalTable> Catalog
    {
        get
        {
            if (ReferenceEquals(State.CurrentPackage, _lastPackage))
            {
                return _catalog;
            }

            _lastPackage = State.CurrentPackage;
            _catalog = State.CurrentPackage is null
                ? []
                : LogicalTables.BuildCatalog(State.CurrentPackage);
            return _catalog;
        }
    }

    private IEnumerable<LogicalTable> FilteredLogicalTables
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filter))
            {
                return Catalog;
            }

            return Catalog.Where(table =>
                table.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || table.Kind.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || table.SourcePackageRelativePaths.Any(path => path.Contains(filter, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private LogicalTable? SelectedLogicalTable
        => Catalog.FirstOrDefault(table => table.Key == selectedLogicalTableKey)
            ?? Catalog.FirstOrDefault();

    private void SelectLogicalTable(string key)
    {
        selectedLogicalTableKey = key;
        message = null;
    }

    private void UpdateCell(string rowKey, string columnKey, string value)
    {
        if (State.CurrentPackage is null || SelectedLogicalTable is null)
        {
            return;
        }

        LogicalTables.UpdateCell(State.CurrentPackage, SelectedLogicalTable.Key, rowKey, columnKey, value);
        _lastPackage = null; // invalidate catalog cache so UI refreshes
        State.Diagnostics.Add($"Updated {SelectedLogicalTable.Key}/{rowKey}/{columnKey}.");
        message = "Unsaved changes.";
    }

    private async Task SaveProject()
    {
        isSaving = true;
        try
        {
            await Workflow.SaveProjectAsync();
            message = "Project saved.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            State.Diagnostics.Add("Save table edits error: " + ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }
}
