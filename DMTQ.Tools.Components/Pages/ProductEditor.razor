@page "/products/editor/{ProductId}"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ProductEditService ProductEditSvc
@inject ProductCatalogService ProductCatalog

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch">
    <FluentBreadcrumb>
        <FluentBreadcrumbItem Href="/products">@L["Nav.Products"]</FluentBreadcrumbItem>
        <FluentBreadcrumbItem>@(IsCreate ? L["Editor.NewProduct"] : L["Editor.Edit", currentProduct?.Id ?? string.Empty])</FluentBreadcrumbItem>
    </FluentBreadcrumb>

    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenProjectFirst"]' Intent="MessageIntent.Warning" />
    }
    else if (currentProduct is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Products"].Value, ProductId]' Intent="MessageIntent.Error" />
        <FluentButton Appearance="Appearance.Neutral" OnClick="NavigateBack">@L["Editor.BackTo", L["Nav.Products"].Value]</FluentButton>
    }
    else
    {
        <EditForm Model="@currentProduct" OnValidSubmit="SaveAsync" FormName="product-editor">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="24" HorizontalAlignment="HorizontalAlignment.Stretch">
                <section>
                    <h2 class="section-heading">@L["Editor.ProductInformation"]</h2>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            @if (IsCreate)
                            {
                                <FluentTextField style="width: 100%;" @bind-Value="productIdInput" Label="Product ID *" Placeholder="e.g. PRODUCT_001" Required />
                            }
                            else
                            {
                                <FluentTextField style="width: 100%;" Value="@(currentProduct?.Id ?? string.Empty)" Label="Product ID" ReadOnly="true" />
                            }
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.ItemId" Label="Item ID" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.PlatformProductId" Label="Platform Product ID" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.StoreProductId" Label="Store Product ID" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="4">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.ProductType" Label="Product Type" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="4">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.Status" Label="Status" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="4">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.Update" Label="Update" />
                        </FluentGridItem>
                    </FluentGrid>
                </section>

                <section>
                    <h2 class="section-heading">@L["Editor.PriceSaleWindow"]</h2>
                    <FluentGrid Spacing="3">
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.CostGamePoint" Label="Cost Game Point" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.CostGameCash" Label="Cost Game Cash" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.SaleStartDate" Label="Sale Start Date" />
                        </FluentGridItem>
                        <FluentGridItem xs="12" md="6">
                            <FluentTextField style="width: 100%;" @bind-Value="currentProduct!.SaleEndDate" Label="Sale End Date" />
                        </FluentGridItem>
                    </FluentGrid>
                </section>

                <section>
                    <h2 class="section-heading">@L["Editor.ProductCategories"]</h2>
                    <p class="section-hint">@L["Editor.ProductCategoriesHint"]</p>
                    <div class="choice-grid">
                        @foreach (var categoryId in AvailableCategoryIds)
                        {
                            <FluentCheckbox Value="@HasCategory(categoryId)"
                                            ValueChanged="@(value => ToggleCategory(categoryId, value == true))"
                                            Label="@categoryId" />
                        }
                    </div>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentTextField @bind-Value="newCategoryId" Label='@L["Fields.CategoryId"]' />
                        <FluentButton Appearance="Appearance.Neutral" OnClick="AddCategory">@L["Common.Add"]</FluentButton>
                    </FluentStack>
                </section>

                <section>
                    <div class="section-title-row">
                        <div>
                            <h2 class="section-heading">@L["Editor.IngameConfigurations"]</h2>
                            <p class="section-hint">@L["Editor.IngameConfigurationsHint"]</p>
                        </div>
                        <FluentButton Appearance="Appearance.Neutral" OnClick="AddIngameItem"
                                      IconStart="@(new Icons.Regular.Size20.Add())">@L["Editor.AddConfiguration"]</FluentButton>
                    </div>
                    @if (ingameItemDrafts.Count == 0)
                    {
                        <FluentMessageBar Title='@L["Editor.NoIngameConfigurations"]' Intent="MessageIntent.Info" />
                    }
                    else
                    {
                        @foreach (var ingameItem in ingameItemDrafts)
                        {
                            <div class="related-row" @key="ingameItem">
                                <FluentTextField @bind-Value="ingameItem.ItemType" Label='@L["Fields.ItemType"]' />
                                <FluentTextField @bind-Value="ingameItem.ItemLevel" Label='@L["Fields.ItemLevel"]' />
                                <FluentTextField Value="@(currentProduct?.Id ?? productIdInput)" Label='@L["Fields.ProductId"]' ReadOnly="true" />
                                <FluentTextField @bind-Value="ingameItem.Update" Label='@L["Fields.Update"]' />
                                <FluentButton Appearance="Appearance.Neutral" OnClick="() => RemoveIngameItem(ingameItem)"
                                              IconStart="@(new Icons.Regular.Size20.Delete())" Title='@L["Common.Delete"]' />
                            </div>
                        }
                    }
                </section>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveProduct"]</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <FluentMessageBar Title="@message" Intent="MessageIntent.Info" />
                    }
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <FluentMessageBar Title="@errorMessage" Intent="MessageIntent.Error" />
                    }
                </FluentStack>
            </FluentStack>
        </EditForm>
    }
</FluentStack>

@code {
    [Parameter] public string ProductId { get; set; } = default!;

    private bool IsCreate => ProductId.Equals("new", StringComparison.OrdinalIgnoreCase);
    private Product? currentProduct;
    private string productIdInput = string.Empty;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private bool isBusy;
    private string newCategoryId = string.Empty;
    private List<IngameItem> ingameItemDrafts = [];

    private IReadOnlyList<Product> Catalog =>
        State.CurrentPackage is null ? [] : ProductCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);

    private IEnumerable<string> AvailableCategoryIds => Catalog
        .SelectMany(product => product.CategoryIds)
        .Concat(currentProduct?.CategoryIds ?? [])
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(id => id, StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (IsCreate)
        {
            currentProduct ??= new Product { Id = string.Empty };
            ingameItemDrafts = [];
            return;
        }

        var source = Catalog.FirstOrDefault(product =>
            product.Id.Equals(ProductId, StringComparison.OrdinalIgnoreCase));
        currentProduct = source is null ? null : ProductEditSvc.CreateDraft(source);
        ingameItemDrafts = source is null || State.CurrentPackage is null
            ? []
            : ProductEditSvc.CreateIngameItemDrafts(State.CurrentPackage, source.Id, State.SelectedExportPlatform);
    }

    private void NavigateBack() => Navigation.NavigateTo("/products");

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null || currentProduct is null) return;

        isBusy = true;
        message = string.Empty;
        errorMessage = string.Empty;

        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(productIdInput))
                {
                    errorMessage = L["Editor.ProductIdRequired"].Value;
                    return;
                }

                var product = ProductEditSvc.CreateDraft(currentProduct, productIdInput.Trim());
                ProductEditSvc.AddProduct(State.CurrentPackage, product, ingameItemDrafts, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                State.Diagnostics.Add($"Product added: {product.Id}");
                Navigation.NavigateTo($"/products/editor/{Uri.EscapeDataString(product.Id)}");
            }
            else
            {
                ProductEditSvc.UpdateProduct(State.CurrentPackage, currentProduct, ingameItemDrafts, State.SelectedExportPlatform);
                await Workflow.SaveProjectAsync();
                State.Diagnostics.Add($"Product edited: {currentProduct.Id}");
                message = L["Editor.Saved", L["Nav.Products"].Value].Value;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            State.Diagnostics.Add("Product save error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool HasCategory(string categoryId) => currentProduct?.CategoryIds.Contains(categoryId, StringComparer.OrdinalIgnoreCase) == true;

    private void ToggleCategory(string categoryId, bool selected)
    {
        if (currentProduct is null) return;
        currentProduct.CategoryIds.RemoveAll(id => id.Equals(categoryId, StringComparison.OrdinalIgnoreCase));
        if (selected)
            currentProduct.CategoryIds.Add(categoryId);
    }

    private void AddCategory()
    {
        if (currentProduct is null || string.IsNullOrWhiteSpace(newCategoryId)) return;
        var categoryId = newCategoryId.Trim();
        if (!HasCategory(categoryId))
            currentProduct.CategoryIds.Add(categoryId);
        newCategoryId = string.Empty;
    }

    private void AddIngameItem()
        => ingameItemDrafts.Add(new IngameItem
        {
            Id = Guid.NewGuid().ToString("N"),
            ProductId = currentProduct?.Id ?? productIdInput
        });

    private void RemoveIngameItem(IngameItem item) => ingameItemDrafts.Remove(item);
}
