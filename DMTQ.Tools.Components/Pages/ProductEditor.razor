@page "/products/editor/{ProductId}"
@inject NavigationManager Navigation
@inject IProjectState State
@inject IProjectWorkflow Workflow
@inject ProductEditService ProductEditSvc
@inject ProductCatalogService ProductCatalog
@inject EditorDraftStore DraftStore

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" HorizontalAlignment="HorizontalAlignment.Stretch">
    @if (State.CurrentPackage is null)
    {
        <FluentMessageBar Title='@L["Editor.OpenProjectFirst"]' Intent="MessageBarIntent.Warning" />
    }
    else if (currentProduct is null && !IsCreate)
    {
        <FluentMessageBar Title='@L["Editor.NotFound", L["Nav.Products"].Value, ProductId]' Intent="MessageBarIntent.Error" />
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Editor.BackTo", L["Nav.Products"].Value]</FluentButton>
    }
    else
    {
        <EditForm Model="@currentProduct" OnValidSubmit="SaveAsync" FormName="product-editor" class="editor-form">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" HorizontalAlignment="HorizontalAlignment.Stretch" class="editor-form-sections">
                <section>
                    <h2 class="section-heading">@L["Editor.ProductInformation"]</h2>
                    <FluentGrid Spacing="2">
                        <FluentGridItem Xs="12" Md="6">
                            @if (IsCreate)
                            {
                                <FluentTextInput style="width: 100%;" @bind-Value="productIdInput" Label='@L["Fields.ProductId"]' Placeholder="e.g. PRODUCT_001" Required />
                            }
                            else
                            {
                                <FluentTextInput style="width: 100%;" Value="@(currentProduct?.Id ?? string.Empty)" Label='@L["Fields.ProductId"]' ReadOnly="true" />
                            }
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="6">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.ItemId" Label='@L["Fields.ItemId"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="6">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.PlatformProductId" Label='@L["Fields.PlatformProductId"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="6">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.StoreProductId" Label='@L["Fields.StoreProductId"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="4">
                            <FluentSelect Items="@GetProductTypeOptions()"
                                          @bind-Value="selectedProductType"
                                          Label='@L["Fields.ProductType"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="4">
                            <FluentSelect Items="@GetProductStatusOptions()"
                                          @bind-Value="selectedProductStatus"
                                          Label='@L["Fields.Status"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="4">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.Update" Label='@L["Fields.Update"]' />
                        </FluentGridItem>
                    </FluentGrid>
                </section>

                <section>
                    <h2 class="section-heading">@L["Editor.PriceSaleWindow"]</h2>
                    <FluentGrid Spacing="2">
                        <FluentGridItem Xs="12" Md="6">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.CostGamePoint" Label='@L["Fields.CostGamePoint"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="6">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.CostGameCash" Label='@L["Fields.CostGameCash"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="6">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.SaleStartDate" Label='@L["Fields.SaleStartDate"]' />
                        </FluentGridItem>
                        <FluentGridItem Xs="12" Md="6">
                            <FluentTextInput style="width: 100%;" @bind-Value="currentProduct!.SaleEndDate" Label='@L["Fields.SaleEndDate"]' />
                        </FluentGridItem>
                    </FluentGrid>
                </section>

                <section>
                    <h2 class="section-heading">@L["Editor.ProductCategories"]</h2>
                    <p class="section-hint">@L["Editor.ProductCategoriesHint"]</p>
                    <p class="section-hint">@L["Editor.CategoryIdExplanation"]</p>
                    <div class="choice-grid">
                        @foreach (var categoryId in AvailableCategoryIds)
                        {
                            <FluentCheckbox Value="@HasCategory(categoryId)"
                                            ValueChanged="@(value => ToggleCategory(categoryId, value == true))"
                                            Label="@categoryId" />
                        }
                    </div>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                        <FluentNumberInput @bind-Value="newCategoryId" Label='@L["Fields.CategoryId"]' />
                        <FluentButton Appearance="ButtonAppearance.Default" OnClick="AddCategory">@L["Common.Add"]</FluentButton>
                    </FluentStack>
                </section>

                <section>
                    <div class="section-title-row">
                        <div>
                            <h2 class="section-heading">@L["Editor.IngameConfigurations"]</h2>
                            <p class="section-hint">@L["Editor.IngameConfigurationsHint"]</p>
                        </div>
                        <FluentButton Appearance="ButtonAppearance.Default" OnClick="AddIngameItem"
                                      IconStart="@(new Icons.Regular.Size20.Add())">@L["Editor.AddConfiguration"]</FluentButton>
                    </div>
                    @if (ingameItemDrafts.Count == 0)
                    {
                        <FluentMessageBar Title='@L["Editor.NoIngameConfigurations"]' Intent="MessageBarIntent.Info" />
                    }
                    else
                    {
                        @foreach (var ingameItem in ingameItemDrafts)
                        {
                            <div class="related-row" @key="ingameItem">
                                <FluentSelect TOption="string" TValue="string"
                                              Items="@GetIngameItemTypeOptions(ingameItem)"
                                              Value="@GetSelectedIngameItemType(ingameItem)"
                                              ValueChanged="@(value => SetIngameItemType(ingameItem, value))"
                                              Label='@L["Fields.ItemType"]' />
                                <FluentTextInput @bind-Value="ingameItem.ItemLevel" Label='@L["Fields.ItemLevel"]' />
                                <FluentTextInput Value="@(currentProduct?.Id ?? productIdInput)" Label='@L["Fields.ProductId"]' ReadOnly="true" />
                                <FluentTextInput @bind-Value="ingameItem.Update" Label='@L["Fields.Update"]' />
                                <FluentButton Appearance="ButtonAppearance.Default" OnClick="() => RemoveIngameItem(ingameItem)"
                                              IconStart="@(new Icons.Regular.Size20.Delete())" Title='@L["Common.Delete"]' />
                            </div>
                        }
                    }
                </section>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <FluentButton Appearance="ButtonAppearance.Primary" Type="ButtonType.Submit" Disabled="@isBusy">@L["Editor.SaveProduct"]</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="NavigateBack">@L["Common.Cancel"]</FluentButton>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <FluentMessageBar Title="@message" Intent="MessageBarIntent.Info" />
                    }
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <FluentMessageBar Title="@errorMessage" Intent="MessageBarIntent.Error" />
                    }
                    <EditorSaveFailure Exception="@saveException" Context="Product editor save" />
                </FluentStack>
            </FluentStack>
        </EditForm>
    }
</FluentStack>

@code {
    [Parameter] public string ProductId { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private bool IsCreate => ProductId.Equals("new", StringComparison.OrdinalIgnoreCase);
    private string RecoveryKey => $"product:{ProductId}";
    private Product? currentProduct;
    private string productIdInput = string.Empty;
    private string message = string.Empty;
    private string errorMessage = string.Empty;
    private Exception? saveException;
    private bool isBusy;
    private int? newCategoryId;
    private List<IngameItem> ingameItemDrafts = [];

    private string[] GetProductTypeOptions()
    {
        var knownTypes = Catalog.Select(product => product.ProductType)
            .Append("ticket")
            .Where(type => !string.IsNullOrWhiteSpace(type))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(type => type, StringComparer.OrdinalIgnoreCase);
        var options = new[] { $" — {L["Options.EffectTypeNone"].Value}" }
            .Concat(knownTypes.Select(type => type.Equals("I", StringComparison.OrdinalIgnoreCase)
                ? $"{type} — {L["Options.ProductTypeUnlock"].Value}"
                : type.Equals("ticket", StringComparison.OrdinalIgnoreCase)
                    ? $"{type} — {L["Options.ProductTypeTicket"].Value}"
                    : $"{type} — {L["Options.ProductTypeRawCode"].Value}"))
            .ToArray();

        return currentProduct is null || string.IsNullOrWhiteSpace(currentProduct.ProductType)
               || options.Any(option => option.StartsWith(currentProduct.ProductType + " — ", StringComparison.OrdinalIgnoreCase))
            ? options
            : [.. options, $"{currentProduct.ProductType} — {L["Fields.ExistingValue"].Value}"];
    }

    private string selectedProductType
    {
        get => currentProduct is null || string.IsNullOrWhiteSpace(currentProduct.ProductType)
            ? GetProductTypeOptions()[0]
            : GetProductTypeOptions().FirstOrDefault(option => option.StartsWith(currentProduct.ProductType + " — ", StringComparison.OrdinalIgnoreCase))
              ?? $"{currentProduct.ProductType} — {L["Fields.ExistingValue"].Value}";
        set
        {
            if (currentProduct is not null)
                currentProduct.ProductType = GetOptionValue(value);
        }
    }

    private string[] GetProductStatusOptions()
    {
        var options = new[]
        {
            $" — {L["Options.EffectTypeNone"].Value}",
            $"N — {L["Options.ProductStatusNone"].Value}",
            $"F — {L["Options.ProductStatusNew"].Value}",
            $"H — {L["Options.ProductStatusHot"].Value}",
            $"B — {L["Options.ProductStatusBest"].Value}"
        };

        return currentProduct is null || string.IsNullOrWhiteSpace(currentProduct.Status)
               || options.Any(option => option.StartsWith(currentProduct.Status + " — ", StringComparison.OrdinalIgnoreCase))
            ? options
            : [.. options, $"{currentProduct.Status} — {L["Fields.ExistingValue"].Value}"];
    }

    private string selectedProductStatus
    {
        get => currentProduct is null || string.IsNullOrWhiteSpace(currentProduct.Status)
            ? GetProductStatusOptions()[0]
            : GetProductStatusOptions().FirstOrDefault(option => option.StartsWith(currentProduct.Status + " — ", StringComparison.OrdinalIgnoreCase))
              ?? $"{currentProduct.Status} — {L["Fields.ExistingValue"].Value}";
        set
        {
            if (currentProduct is not null)
                currentProduct.Status = GetOptionValue(value);
        }
    }

    private string[] GetIngameItemTypeOptions(IngameItem item)
    {
        var options = new[]
        {
            $" — {L["Options.EffectTypeNone"].Value}",
            $"AB — {L["Options.EffectTypeBreakShield"].Value}",
            $"FP — {L["Options.EffectTypeFeverPlus"].Value}",
            $"GR — {L["Options.EffectTypeGaugeRefill"].Value}"
        };

        return string.IsNullOrWhiteSpace(item.ItemType)
               || options.Any(option => option.StartsWith(item.ItemType + " — ", StringComparison.OrdinalIgnoreCase))
            ? options
            : [.. options, $"{item.ItemType} — {L["Fields.ExistingValue"].Value}"];
    }

    private string GetSelectedIngameItemType(IngameItem item)
        => GetIngameItemTypeOptions(item).FirstOrDefault(option =>
               option.StartsWith(item.ItemType + " — ", StringComparison.OrdinalIgnoreCase))
           ?? GetIngameItemTypeOptions(item)[0];

    private static void SetIngameItemType(IngameItem item, string value)
        => item.ItemType = GetOptionValue(value);

    private static string GetOptionValue(string option)
    {
        var separatorIndex = option.LastIndexOf(" — ", StringComparison.Ordinal);
        return separatorIndex < 0 ? option : option[..separatorIndex];
    }

    private IReadOnlyList<Product> Catalog =>
        State.CurrentPackage is null ? [] : ProductCatalog.BuildCatalog(State.CurrentPackage, State.SelectedExportPlatform);

    private IEnumerable<string> AvailableCategoryIds => Catalog
        .SelectMany(product => product.CategoryIds)
        .Concat(currentProduct?.CategoryIds ?? [])
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(id => id, StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (DraftStore.TryGet<ProductDraft>(RecoveryKey, out var recovered) && recovered is not null)
        {
            currentProduct = recovered.Product;
            productIdInput = recovered.ProductIdInput;
            ingameItemDrafts = recovered.IngameItemDrafts;
            newCategoryId = recovered.NewCategoryId;
            return;
        }

        if (IsCreate)
        {
            currentProduct ??= new Product { Id = string.Empty };
            ingameItemDrafts = [];
            return;
        }

        var source = Catalog.FirstOrDefault(product =>
            product.Id.Equals(ProductId, StringComparison.OrdinalIgnoreCase));
        currentProduct = source is null ? null : ProductEditSvc.CreateDraft(source);
        ingameItemDrafts = source is null || State.CurrentPackage is null
            ? []
            : ProductEditSvc.CreateIngameItemDrafts(State.CurrentPackage, source.Id, State.SelectedExportPlatform);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (currentProduct is not null)
            DraftStore.Set(RecoveryKey, new ProductDraft(currentProduct, productIdInput, ingameItemDrafts, newCategoryId));
    }

    private void NavigateBack()
    {
        DraftStore.Remove(RecoveryKey);
        Navigation.NavigateTo(TableNavigationState.ResolveReturnUrl(Navigation, ReturnUrl, "/products"));
    }

    private async Task SaveAsync()
    {
        if (State.CurrentPackage is null || currentProduct is null) return;

        isBusy = true;
        message = string.Empty;
        errorMessage = string.Empty;
        saveException = null;

        try
        {
            if (IsCreate)
            {
                if (string.IsNullOrWhiteSpace(productIdInput))
                {
                    errorMessage = L["Editor.ProductIdRequired"].Value;
                    return;
                }

                var product = ProductEditSvc.CreateDraft(currentProduct, productIdInput.Trim());
                ProductEditSvc.AddProduct(State.CurrentPackage, product, ingameItemDrafts, State.SelectedExportPlatform);
                var wasDirty = State.IsDirty;
                State.IsDirty = true;
                try { await Workflow.SaveProjectAsync(); }
                catch
                {
                    ProductEditSvc.RemoveProduct(State.CurrentPackage, product.Id, State.SelectedExportPlatform);
                    State.IsDirty = wasDirty;
                    throw;
                }
                State.Diagnostics.Add($"Product added: {product.Id}");
                NavigateBack();
            }
            else
            {
                ProductEditSvc.UpdateProduct(State.CurrentPackage, currentProduct, ingameItemDrafts, State.SelectedExportPlatform);
                State.IsDirty = true;
                await Workflow.SaveProjectAsync();
                State.Diagnostics.Add($"Product edited: {currentProduct.Id}");
                NavigateBack();
            }
        }
        catch (Exception ex)
        {
            saveException = ex;
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool HasCategory(string categoryId) => currentProduct?.CategoryIds.Contains(categoryId, StringComparer.OrdinalIgnoreCase) == true;

    private void ToggleCategory(string categoryId, bool selected)
    {
        if (currentProduct is null) return;
        currentProduct.CategoryIds.RemoveAll(id => id.Equals(categoryId, StringComparison.OrdinalIgnoreCase));
        if (selected)
            currentProduct.CategoryIds.Add(categoryId);
    }

    private void AddCategory()
    {
        if (currentProduct is null || !newCategoryId.HasValue || newCategoryId.Value < 0) return;
        var categoryId = newCategoryId.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (!HasCategory(categoryId))
            currentProduct.CategoryIds.Add(categoryId);
        newCategoryId = null;
    }

    private void AddIngameItem()
        => ingameItemDrafts.Add(new IngameItem
        {
            Id = Guid.NewGuid().ToString("N"),
            ProductId = currentProduct?.Id ?? productIdInput
        });

    private void RemoveIngameItem(IngameItem item) => ingameItemDrafts.Remove(item);

    private sealed record ProductDraft(Product Product, string ProductIdInput, List<IngameItem> IngameItemDrafts, int? NewCategoryId);
}
